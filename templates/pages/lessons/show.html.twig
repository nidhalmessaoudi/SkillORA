{% extends 'layouts/base.html.twig' %}

{% block title %}{{ lesson.title }} - {{ course.title }}{% endblock %}

{% block body %}
<div class="bg-navy-50 dark:bg-navy-900/30 min-h-screen">
  <div class="container-wide py-8">

    {# Breadcrumb #}
    <nav class="breadcrumb mb-6">
      <a href="{{ path('app_home') }}" class="breadcrumb-link">Home</a>
      <i data-lucide="chevron-right" class="w-4 h-4 breadcrumb-separator"></i>
      <a href="{{ path('courses_index') }}" class="breadcrumb-link">Courses</a>
      <i data-lucide="chevron-right" class="w-4 h-4 breadcrumb-separator"></i>
      <a href="{{ path('course_show', {courseId: course.id}) }}" class="breadcrumb-link">{{ course.title }}</a>
      <i data-lucide="chevron-right" class="w-4 h-4 breadcrumb-separator"></i>
      <span class="text-navy-900 dark:text-white">{{ lesson.title }}</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8">

      {# Sidebar - Sections + Lessons #}
      <aside class="lg:w-80 shrink-0">
        <div class="card p-4 lg:sticky lg:top-24">
          <div class="mb-4">
            <h2 class="font-display font-semibold text-navy-900 dark:text-white">
              Course content
            </h2>
            <p class="text-body-sm text-navy-500 mt-1">{{ course.title }}</p>
          </div>

          <div class="divide-y divide-navy-100 dark:divide-navy-800">
            {% for item in sections %}
              {% set s = item.section %}
              <details class="group py-2" {{ s.id == section.id ? 'open' : '' }}>
                <summary class="flex items-center justify-between px-2 py-2 cursor-pointer rounded-xl hover:bg-navy-50 dark:hover:bg-navy-800/50 transition-colors">
                  <div class="flex items-center gap-2 min-w-0">
                    <i data-lucide="chevron-down" class="w-4 h-4 text-navy-400 group-open:rotate-180 transition-transform"></i>
                    <span class="font-medium text-navy-900 dark:text-white truncate">{{ s.title }}</span>
                  </div>
                  <span class="text-caption text-navy-400">{{ item.lessons|length }}</span>
                </summary>

                <div class="mt-2 space-y-1 px-2">
                  {% for l in item.lessons %}
                    <a
                      href="{{ path('lesson_show', {courseId: course.id, lessonId: l.id}) }}"
                      class="flex items-center gap-2 rounded-xl px-3 py-2 text-body-sm transition-colors
                        {{ l.id == lesson.id
                          ? 'bg-harbor-600 text-white'
                          : 'text-navy-700 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800/50' }}"
                    >
                      {% set t = l.type|default('text') %}
                      {% if t == 'video' %}
                        <i data-lucide="play-circle" class="w-4 h-4 {{ l.id == lesson.id ? 'text-white' : 'text-navy-400' }}"></i>
                      {% elseif t == 'pdf' %}
                        <i data-lucide="file-text" class="w-4 h-4 {{ l.id == lesson.id ? 'text-white' : 'text-navy-400' }}"></i>
                      {% else %}
                        <i data-lucide="align-left" class="w-4 h-4 {{ l.id == lesson.id ? 'text-white' : 'text-navy-400' }}"></i>
                      {% endif %}
                      <span class="min-w-0 truncate">{{ l.title }}</span>
                    </a>
                  {% endfor %}
                </div>
              </details>
            {% endfor %}
          </div>
        </div>
      </aside>

      {# Main - Lesson Content #}
      <main class="flex-1">
        <div class="card overflow-hidden">
          <div class="p-6 border-b border-navy-100 dark:border-navy-800">
            <h1 class="font-display font-bold text-display-sm text-navy-900 dark:text-white">
              {{ lesson.title }}
            </h1>
            <p class="text-body-sm text-navy-500 mt-1">
              {{ section.title }} · {{ course.title }}
            </p>
          </div>

          <div class="p-6">
            {% set t = lesson.type|default('text') %}

            {% if t == 'video' %}
              {% if lesson.filePath %}
                <video controls class="w-full rounded-2xl border border-navy-100 dark:border-navy-800">
                  <source src="{{ lesson.filePath }}">
                  Your browser does not support the video tag.
                </video>
              {% else %}
                <p class="text-body-md text-navy-600 dark:text-navy-300">No video uploaded.</p>
              {% endif %}

            {% elseif t == 'pdf' %}
              {% if lesson.filePath %}
                <div class="rounded-2xl overflow-hidden border border-navy-100 dark:border-navy-800 bg-white dark:bg-navy-950">
                  <iframe
                    src="{{ lesson.filePath }}"
                    class="w-full"
                    style="height: 75vh;"
                    title="PDF preview"
                  ></iframe>
                </div>
                <p class="text-caption text-navy-500 mt-3">
                  If the preview doesn’t show, open the file in a new tab:
                  <a class="underline" href="{{ lesson.filePath }}" target="_blank" rel="noopener">Open PDF</a>
                </p>
              {% else %}
                <p class="text-body-md text-navy-600 dark:text-navy-300">No PDF uploaded.</p>
              {% endif %}

            {% else %}
              {% if lesson.content %}
                <article class="lesson-content prose dark:prose-invert max-w-none">
                  {{ lesson.content|raw }}
                </article>
              {% else %}
                <div class="rounded-2xl border border-navy-100 dark:border-navy-800 bg-navy-50 dark:bg-navy-900/30 p-6">
                  <p class="text-body-md text-navy-600 dark:text-navy-300">No content yet.</p>
                </div>
              {% endif %}
            {% endif %}
          </div>

          {# Prev / Next navigation #}
          <div class="p-6 border-t border-navy-100 dark:border-navy-800">
            <div class="flex items-center justify-between gap-4">
              {% if prev_lesson %}
                <a
                  href="{{ path('lesson_show', {courseId: course.id, lessonId: prev_lesson.id}) }}"
                  class="btn-secondary btn-sm"
                >
                  <i data-lucide="arrow-left" class="w-4 h-4"></i>
                  Previous
                </a>
              {% else %}
                <span class="btn-secondary btn-sm opacity-50 pointer-events-none select-none">
                  <i data-lucide="arrow-left" class="w-4 h-4"></i>
                  Previous
                </span>
              {% endif %}

              <a href="{{ path('course_show', {courseId: course.id}) }}" class="btn-ghost btn-sm">
                Back to course
              </a>

              {% if next_lesson %}
                <a
                  href="{{ path('lesson_show', {courseId: course.id, lessonId: next_lesson.id}) }}"
                  class="btn-primary btn-sm"
                >
                  Next
                  <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
              {% else %}
                <span class="btn-primary btn-sm opacity-50 pointer-events-none select-none">
                  Next
                  <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
              {% endif %}
            </div>
          </div>
        </div>
      </main>

    </div>
  </div>
</div>

<style>
  .lesson-content :where(h1,h2,h3,h4){ margin-top: 1.1em; margin-bottom: .5em; }
  .lesson-content :where(p,ul,ol,blockquote){ margin-top: .6em; margin-bottom: .8em; }
  .lesson-content :where(ul){ list-style: disc; padding-left: 1.25rem; }
  .lesson-content :where(ol){ list-style: decimal; padding-left: 1.25rem; }
  .lesson-content :where(li){ margin: .25em 0; }
  .lesson-content :where(blockquote){
    border-left: 4px solid rgb(229 231 235);
    padding-left: 1rem;
    color: rgb(55 65 81);
  }
  .lesson-content :where(pre){
    background: rgb(17 24 39);
    color: rgb(249 250 251);
    padding: 12px;
    border-radius: 14px;
    overflow-x: auto;
  }
  .lesson-content :where(code){
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: .95em;
  }
  .lesson-content :where(table){
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .lesson-content :where(th,td){
    border: 1px solid rgb(229 231 235);
    padding: .55rem .6rem;
    vertical-align: top;
  }
</style>
{% endblock %}