{% extends 'layouts/base.html.twig' %}

{% block title %}Create Course - Instructor Studio | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-100 dark:bg-navy-950">
    {# Header #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="{{ path('studio_index') }}" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors">
                        <i data-lucide="arrow-left" class="w-5 h-5 text-slate-500 dark:text-slate-400"></i>
                    </a>
                    <div>
                        <h1 class="text-xl font-display font-bold text-slate-900 dark:text-white">Create New Course</h1>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Fill in the details to create your course</p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <button class="btn-ghost">Save Draft</button>
                    <button class="btn-primary">
                        <i data-lucide="eye" class="w-4 h-4 mr-2"></i>
                        Preview
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Progress Steps #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                {% set steps = ['Basic Info', 'Curriculum', 'Pricing', 'Settings'] %}
                {% for step in steps %}
                <div class="flex items-center {{ not loop.last ? 'flex-1' : '' }}">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full {{ loop.index == 1 ? 'bg-harbor-600 text-white' : 'bg-slate-200 dark:bg-navy-800 text-slate-500 dark:text-slate-400' }} flex items-center justify-center font-medium text-sm">
                            {% if loop.index < 1 %}
                            <i data-lucide="check" class="w-4 h-4"></i>
                            {% else %}
                            {{ loop.index }}
                            {% endif %}
                        </div>
                        <span class="font-medium text-sm {{ loop.index == 1 ? 'text-slate-900 dark:text-white' : 'text-slate-500 dark:text-slate-400' }}">{{ step }}</span>
                    </div>
                    {% if not loop.last %}
                    <div class="flex-1 mx-4 h-0.5 bg-slate-200 dark:bg-navy-800"></div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <form class="space-y-8">
            {# Basic Information #}
            <div class="card p-6">
                <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-6">Basic Information</h2>

                <div class="space-y-6">
                    {# Title #}
                    <div>
                        <label class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Course Title *</label>
                        <input type="text" class="input" placeholder="e.g., Complete React Developer Course 2024">
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">A clear, descriptive title that tells students what they'll learn</p>
                    </div>

                    {# Subtitle #}
                    <div>
                        <label class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Subtitle</label>
                        <input type="text" class="input" placeholder="e.g., Build real-world apps with React, Redux, and more">
                    </div>

                    {# Description #}
                    <div>
                        <label class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Description *</label>
                        <textarea class="input min-h-[150px]" placeholder="Describe what students will learn and why they should take this course..."></textarea>
                    </div>

                    {# Category & Level #}
                    <div class="grid sm:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Category *</label>
                            <select class="input">
                                <option value="">Select a category...</option>
                                <option value="web-dev">Web Development</option>
                                <option value="mobile">Mobile Development</option>
                                <option value="data-science">Data Science</option>
                                <option value="design">UI/UX Design</option>
                                <option value="business">Business</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Skill Level *</label>
                            <select class="input">
                                <option value="">Select level...</option>
                                <option value="beginner">Beginner</option>
                                <option value="intermediate">Intermediate</option>
                                <option value="advanced">Advanced</option>
                                <option value="all">All Levels</option>
                            </select>
                        </div>
                    </div>

                    {# Language #}
                    <div>
                        <label class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Primary Language</label>
                        <select class="input max-w-xs">
                            <option value="en">English</option>
                            <option value="es">Spanish</option>
                            <option value="fr">French</option>
                            <option value="de">German</option>
                            <option value="pt">Portuguese</option>
                        </select>
                    </div>
                </div>
            </div>

            {# Course Thumbnail #}
            <div class="card p-6">
                <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-6">Course Thumbnail</h2>

                <div class="flex flex-col lg:flex-row gap-6">
                    <div class="lg:w-80 aspect-video rounded-2xl bg-slate-100 dark:bg-navy-800 border-2 border-dashed border-slate-300 dark:border-navy-700 flex items-center justify-center">
                        <div class="text-center">
                            <i data-lucide="image" class="w-12 h-12 text-slate-400 mx-auto mb-2"></i>
                            <p class="text-sm text-slate-500 dark:text-slate-400">No image uploaded</p>
                        </div>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">
                            Upload a high-quality image that represents your course. This will be displayed on course cards and the course page.
                        </p>
                        <div class="space-y-3 text-sm text-slate-500 dark:text-slate-400">
                            <p>• Recommended size: 1280 x 720 pixels</p>
                            <p>• Format: JPG, PNG, or WebP</p>
                            <p>• Max file size: 5MB</p>
                        </div>
                        <button type="button" class="btn-outline mt-4">
                            <i data-lucide="upload" class="w-4 h-4 mr-2"></i>
                            Upload Image
                        </button>
                    </div>
                </div>
            </div>

            {# Promo Video #}
            <div class="card p-6">
                <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-6">Promotional Video</h2>

                <div class="p-8 rounded-2xl bg-slate-100 dark:bg-navy-800 border-2 border-dashed border-slate-300 dark:border-navy-700 text-center">
                    <i data-lucide="video" class="w-12 h-12 text-slate-400 mx-auto mb-3"></i>
                    <h3 class="font-medium text-slate-900 dark:text-white mb-2">Upload a promo video</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-4 max-w-md mx-auto">
                        A short video introducing your course helps students decide to enroll. Keep it under 2 minutes.
                    </p>
                    <button type="button" class="btn-primary">
                        <i data-lucide="upload" class="w-4 h-4 mr-2"></i>
                        Upload Video
                    </button>
                </div>
            </div>

            {# Learning Objectives #}
            <div class="card p-6">
                <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-6">What Students Will Learn</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">List the key takeaways from your course. Be specific about what skills students will gain.</p>

                <div class="space-y-3" id="objectives">
                    <div class="flex items-center gap-3">
                        <input type="text" class="input flex-1" placeholder="e.g., Build real-world React applications from scratch">
                        <button type="button" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800">
                            <i data-lucide="trash-2" class="w-4 h-4 text-slate-400"></i>
                        </button>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="text" class="input flex-1" placeholder="e.g., Understand React hooks and state management">
                        <button type="button" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800">
                            <i data-lucide="trash-2" class="w-4 h-4 text-slate-400"></i>
                        </button>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="text" class="input flex-1" placeholder="e.g., Deploy applications to production">
                        <button type="button" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800">
                            <i data-lucide="trash-2" class="w-4 h-4 text-slate-400"></i>
                        </button>
                    </div>
                </div>

                <button type="button" class="btn-ghost mt-4">
                    <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                    Add Learning Objective
                </button>
            </div>

            {# Requirements #}
            <div class="card p-6">
                <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-6">Requirements</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">What do students need to know or have before starting?</p>

                <div class="space-y-3" id="requirements">
                    <div class="flex items-center gap-3">
                        <input type="text" class="input flex-1" placeholder="e.g., Basic knowledge of HTML and CSS">
                        <button type="button" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800">
                            <i data-lucide="trash-2" class="w-4 h-4 text-slate-400"></i>
                        </button>
                    </div>
                    <div class="flex items-center gap-3">
                        <input type="text" class="input flex-1" placeholder="e.g., A computer with Node.js installed">
                        <button type="button" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800">
                            <i data-lucide="trash-2" class="w-4 h-4 text-slate-400"></i>
                        </button>
                    </div>
                </div>

                <button type="button" class="btn-ghost mt-4">
                    <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                    Add Requirement
                </button>
            </div>

            {# Tags #}
            <div class="card p-6">
                <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-6">Tags</h2>
                <input type="text" class="input" placeholder="Add up to 10 tags (e.g., react, javascript, web development)">
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Tags help students find your course through search</p>
            </div>

            {# Action Buttons #}
            <div class="flex items-center justify-between pt-6 border-t border-slate-200 dark:border-navy-800">
                <button type="button" class="btn-ghost">
                    <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                    Save Draft
                </button>
                <div class="flex items-center gap-3">
                    <a href="{{ path('studio_index') }}" class="btn-outline">Cancel</a>
                    <button type="submit" class="btn-primary">
                        Continue to Curriculum
                        <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();
</script>
{% endblock %}
