{% extends 'layouts/base.html.twig' %}

{% block title %}Reset Password - SkillORA{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="min-h-screen flex bg-white dark:bg-navy-950">
    {# Left Panel - Form #}
    <div class="w-full lg:w-1/2 flex flex-col">
        {# Header #}
        <div class="flex items-center justify-between p-6">
            <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2.5 group">
                <div class="w-9 h-9 bg-gradient-to-br from-harbor-600 to-harbor-500 rounded-xl flex items-center justify-center">
                    <i data-lucide="anchor" class="w-4.5 h-4.5 text-white"></i>
                </div>
                <span class="font-display font-bold text-lg text-navy-900 dark:text-white">SkillORA</span>
            </a>
            <button onclick="toggleTheme()" class="btn-ghost btn-icon">
                <i data-lucide="sun" class="w-5 h-5 dark:hidden"></i>
                <i data-lucide="moon" class="w-5 h-5 hidden dark:block"></i>
            </button>
        </div>

        {# Form Container #}
        <div class="flex-1 flex items-center justify-center px-6 lg:px-16">
            <div class="w-full max-w-sm">
                {# Request State #}
                <div id="request-state">
                    {# Back Link #}
                    <a href="{{ path('auth_login') }}" class="inline-flex items-center gap-2 text-body-sm text-navy-500 dark:text-navy-400 hover:text-navy-700 dark:hover:text-navy-200 mb-8">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                        Back to sign in
                    </a>

                    {# Header #}
                    <div class="mb-8">
                        <div class="w-12 h-12 rounded-2xl bg-harbor-100 dark:bg-harbor-900/30 flex items-center justify-center mb-4">
                            <i data-lucide="key-round" class="w-6 h-6 text-harbor-600 dark:text-harbor-400"></i>
                        </div>
                        <h1 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-2">
                            Reset your password
                        </h1>
                        <p class="text-body-md text-navy-500 dark:text-navy-400">
                            Enter your email and we'll send you a reset link.
                        </p>
                    </div>

                    {# Form #}
                    <form id="forgot-form">
                        <div class="space-y-4">
                            <div>
                                <label for="email" class="input-label">Email</label>
                                <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" class="input" required>
                            </div>

                            <button type="submit" class="btn-primary w-full">
                                Send reset link
                            </button>
                        </div>
                    </form>
                </div>

                {# Success State #}
                <div id="success-state" class="hidden text-center">
                    <div class="w-14 h-14 rounded-full bg-success-100 dark:bg-success-900/30 flex items-center justify-center mx-auto mb-6">
                        <i data-lucide="mail-check" class="w-7 h-7 text-success-600 dark:text-success-400"></i>
                    </div>
                    <h1 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-2">
                        Check your inbox
                    </h1>
                    <p class="text-body-md text-navy-500 dark:text-navy-400 mb-6">
                        We've sent a password reset link to<br>
                        <span id="sent-email" class="font-medium text-navy-700 dark:text-navy-300"></span>
                    </p>

                    <div class="card p-4 mb-6 text-left">
                        <p class="text-body-sm text-navy-600 dark:text-navy-400">
                            <i data-lucide="info" class="w-4 h-4 inline mr-2 text-harbor-600"></i>
                            The link will expire in 1 hour. Check spam if you don't see it.
                        </p>
                    </div>

                    <button type="button" id="resend-btn" class="text-body-sm font-medium text-harbor-600 dark:text-harbor-400 hover:underline disabled:opacity-50" disabled>
                        Resend in <span id="countdown">30</span>s
                    </button>

                    <div class="mt-8 pt-6 border-t border-navy-200 dark:border-navy-800">
                        <a href="{{ path('auth_login') }}" class="inline-flex items-center gap-2 text-body-sm text-navy-500 dark:text-navy-400 hover:text-navy-700 dark:hover:text-navy-200">
                            <i data-lucide="arrow-left" class="w-4 h-4"></i>
                            Back to sign in
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Footer #}
        <div class="p-6 text-center">
            <p class="text-caption text-navy-400 flex items-center justify-center gap-2">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
                Secure password reset
            </p>
        </div>
    </div>

    {# Right Panel - Brand #}
    <div class="hidden lg:block lg:w-1/2 bg-gradient-to-br from-harbor-600 to-harbor-500 relative">
        <div class="absolute inset-0">
            <div class="absolute top-20 right-20 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-20 left-20 w-80 h-80 bg-harbor-400/20 rounded-full blur-3xl"></div>
        </div>

        <div class="relative h-full flex flex-col justify-center p-12 lg:p-16">
            <div class="max-w-md">
                <h2 class="font-display font-bold text-3xl lg:text-4xl text-white mb-4">
                    Don't worry, we've got you
                </h2>
                <p class="text-lg text-white/80 mb-10">
                    It happens to the best of us. We'll help you get back to learning in no time.
                </p>

                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center">
                            <i data-lucide="shield-check" class="w-5 h-5 text-white"></i>
                        </div>
                        <span class="text-white/90">Secure reset process</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center">
                            <i data-lucide="clock" class="w-5 h-5 text-white"></i>
                        </div>
                        <span class="text-white/90">Links expire after 1 hour</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-2xl bg-white/20 flex items-center justify-center">
                            <i data-lucide="bell-ring" class="w-5 h-5 text-white"></i>
                        </div>
                        <span class="text-white/90">Email notifications for changes</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    const form = document.getElementById('forgot-form');
    const requestState = document.getElementById('request-state');
    const successState = document.getElementById('success-state');
    const sentEmail = document.getElementById('sent-email');
    const resendBtn = document.getElementById('resend-btn');
    const countdown = document.getElementById('countdown');

    function startCountdown() {
        let seconds = 30;
        resendBtn.disabled = true;
        resendBtn.innerHTML = 'Resend in <span id="countdown">' + seconds + '</span>s';

        const interval = setInterval(() => {
            seconds--;
            resendBtn.innerHTML = 'Resend in <span id="countdown">' + seconds + '</span>s';
            if (seconds <= 0) {
                clearInterval(interval);
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend email';
            }
        }, 1000);
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        const email = document.getElementById('email').value;
        sentEmail.textContent = email;
        requestState.classList.add('hidden');
        successState.classList.remove('hidden');
        startCountdown();
        lucide.createIcons();
    });

    resendBtn.addEventListener('click', function() {
        if (!this.disabled) startCountdown();
    });
</script>
{% endblock %}
