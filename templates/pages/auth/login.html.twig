{% extends 'layouts/base.html.twig' %}

{% block title %}Sign In - SkillHarbor{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="min-h-screen flex bg-white dark:bg-navy-950">
    {# Left Panel - Form #}
    <div class="w-full lg:w-1/2 flex flex-col">
        {# Header #}
        <div class="flex items-center justify-between p-6">
            <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2.5 group">
                <div class="w-9 h-9 bg-gradient-to-br from-harbor-600 to-harbor-500 rounded-xl flex items-center justify-center">
                    <i data-lucide="anchor" class="w-4.5 h-4.5 text-white"></i>
                </div>
                <span class="font-display font-bold text-lg text-navy-900 dark:text-white">SkillHarbor</span>
            </a>
            <button onclick="toggleTheme()" class="btn-ghost btn-icon">
                <i data-lucide="sun" class="w-5 h-5 dark:hidden"></i>
                <i data-lucide="moon" class="w-5 h-5 hidden dark:block"></i>
            </button>
        </div>

        {# Form Container #}
        <div class="flex-1 flex items-center justify-center px-6 lg:px-16">
            <div class="w-full max-w-sm">
                {# Header #}
                <div class="mb-8">
                    <h1 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-2">
                        Welcome back
                    </h1>
                    <p class="text-body-md text-navy-500 dark:text-navy-400">
                        Sign in to continue learning
                    </p>
                </div>

                {# Google Button #}
                <a href="{{ path('connect_google_start') }}" class="btn-outline w-full mb-6 flex items-center justify-center gap-3">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Continue with Google
                </a>

                {# Divider #}
                <div class="flex items-center gap-4 mb-6">
                    <div class="flex-1 h-px bg-navy-200 dark:bg-navy-800"></div>
                    <span class="text-caption text-navy-400 uppercase">or</span>
                    <div class="flex-1 h-px bg-navy-200 dark:bg-navy-800"></div>
                </div>

                {# Error Message #}
                {% if error %}
                    <div class="mb-6 p-4 rounded-2xl bg-danger-100 dark:bg-danger-900/30 border border-danger-200 dark:border-danger-800 animate-shake">
                        <div class="flex items-start gap-3">
                            <i data-lucide="alert-circle" class="w-5 h-5 text-danger-600 dark:text-danger-400 flex-shrink-0 mt-0.5"></i>
                            <div class="flex-1">
                                <p class="text-body-sm font-semibold text-danger-700 dark:text-danger-300">Login Failed</p>
                                <p class="text-body-sm text-danger-600 dark:text-danger-400 mt-1">
                                    {% if error.message %}
                                        {{ error.message }}
                                    {% else %}
                                        {{ error.messageKey|trans(error.messageData, 'security') }}
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Form #}
                <form method="post" action="{{ path('auth_login') }}" id="login-form" novalidate>
                    <div class="space-y-4">
                        {# Email #}
                        <div>
                            <label for="email" class="input-label">Email</label>
                            <input
                                type="text"
                                id="email"
                                name="_username"
                                value="{{ last_username }}"
                                placeholder="you@example.com"
                                autocomplete="email"
                                class="input {{ field_errors.email is defined ? 'border-red-500 focus:border-red-500 focus:ring-red-500' : '' }}"
                                {% if rate_limited is defined and rate_limited %}disabled{% endif %}
                            >
                            {% if field_errors.email is defined %}
                                <div class="mt-1.5">
                                    {% for error in field_errors.email %}
                                        <p class="text-sm text-red-600 dark:text-red-400">{{ error|raw }}</p>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {# Password #}
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label for="password" class="input-label mb-0">Password</label>
                                <a href="{{ path('auth_forgot_password') }}" class="text-body-sm font-medium text-harbor-600 dark:text-harbor-400 hover:underline">
                                    Forgot?
                                </a>
                            </div>
                            <div class="relative">
                                <input
                                    type="password"
                                    id="password"
                                    name="_password"
                                    placeholder="Enter your password"
                                    autocomplete="current-password"
                                    class="input pr-12 {{ field_errors.password is defined ? 'border-red-500 focus:border-red-500 focus:ring-red-500' : '' }}"
                                    {% if rate_limited is defined and rate_limited %}disabled{% endif %}
                                >
                                <button
                                    type="button"
                                    onclick="togglePassword('password', 'pwd-icon')"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-navy-400 hover:text-navy-600 dark:hover:text-navy-300"
                                >
                                    <i data-lucide="eye" class="w-5 h-5" id="pwd-icon"></i>
                                </button>
                            </div>
                            {% if field_errors.password is defined %}
                                <div class="mt-1.5">
                                    {% for error in field_errors.password %}
                                        <p class="text-sm text-red-600 dark:text-red-400">{{ error|raw }}</p>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {# Remember Me #}
                        <div class="flex items-center gap-3">
                            <input type="checkbox" id="remember" name="remember" class="checkbox">
                            <label for="remember" class="text-body-sm text-navy-600 dark:text-navy-400 cursor-pointer">
                                Keep me signed in
                            </label>
                        </div>

                        {# Submit #}
                        <button type="submit" class="btn-primary w-full">
                            Sign in
                        </button>
                    </div>
                </form>

                {# Face ID Login Option #}
                <div class="mt-6">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="flex-1 h-px bg-navy-200 dark:bg-navy-800"></div>
                        <span class="text-caption text-navy-400 uppercase">Or use</span>
                        <div class="flex-1 h-px bg-navy-200 dark:bg-navy-800"></div>
                    </div>

                    <a href="{{ path('auth_face_login') }}" class="group block w-full p-4 rounded-2xl border-2 border-harbor-200 dark:border-harbor-700 bg-gradient-to-br from-harbor-50 to-sky-50 dark:from-harbor-900/20 dark:to-sky-900/20 hover:border-harbor-400 dark:hover:border-harbor-500 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-harbor-500 to-sky-500 flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <i data-lucide="scan-face" class="w-6 h-6 text-white"></i>
                                </div>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-semibold text-navy-900 dark:text-white mb-0.5">Sign in with Face ID</h4>
                                <p class="text-sm text-navy-600 dark:text-navy-400">Fast, secure, passwordless login</p>
                            </div>
                            <div class="flex-shrink-0">
                                <i data-lucide="arrow-right" class="w-5 h-5 text-harbor-600 dark:text-harbor-400 group-hover:translate-x-1 transition-transform"></i>
                            </div>
                        </div>
                    </a>
                </div>

                {# Register Link #}
                <p class="mt-8 text-center text-body-sm text-navy-500 dark:text-navy-400">
                    Don't have an account?
                    <a href="{{ path('auth_register') }}" class="font-semibold text-harbor-600 dark:text-harbor-400 hover:underline ml-1">
                        Create one
                    </a>
                </p>
            </div>
        </div>

        {# Footer #}
        <div class="p-6 text-center">
            <p class="text-caption text-navy-400 flex items-center justify-center gap-2">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
                Secure 256-bit SSL encryption
            </p>
        </div>
    </div>

    {# Right Panel - Brand #}
    <div class="hidden lg:block lg:w-1/2 bg-gradient-to-br from-harbor-600 to-harbor-500 relative">
        {# Subtle background #}
        <div class="absolute inset-0">
            <div class="absolute top-20 right-20 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-20 left-20 w-80 h-80 bg-harbor-400/20 rounded-full blur-3xl"></div>
        </div>

        {# 3D Spline Model #}
        <div class="relative h-full flex flex-col justify-center p-12 lg:p-16">
            <script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.58/build/spline-viewer.js"></script>
            <spline-viewer url="https://prod.spline.design/1V0P7xpRO0kes-qw/scene.splinecode" style="width: 100%; height: 100%;"></spline-viewer>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.setAttribute('data-lucide', 'eye-off');
        } else {
            input.type = 'password';
            icon.setAttribute('data-lucide', 'eye');
        }
        lucide.createIcons();
    }
</script>
{% endblock %}
