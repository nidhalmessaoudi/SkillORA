{% extends 'layouts/base.html.twig' %}

{% block title %}Create Account - SkillHarbor{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="min-h-screen flex bg-white dark:bg-navy-950">
    {# Left Panel - Form #}
    <div class="w-full lg:w-1/2 flex flex-col">
        {# Header #}
        <div class="flex items-center justify-between p-6">
            <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2.5 group">
                <div class="w-9 h-9 bg-gradient-to-br from-harbor-600 to-harbor-500 rounded-xl flex items-center justify-center">
                    <i data-lucide="anchor" class="w-4.5 h-4.5 text-white"></i>
                </div>
                <span class="font-display font-bold text-lg text-navy-900 dark:text-white">SkillHarbor</span>
            </a>
            <button onclick="toggleTheme()" class="btn-ghost btn-icon">
                <i data-lucide="sun" class="w-5 h-5 dark:hidden"></i>
                <i data-lucide="moon" class="w-5 h-5 hidden dark:block"></i>
            </button>
        </div>

        {# Form Container #}
        <div class="flex-1 flex items-center justify-center px-6 lg:px-16 py-8 overflow-y-auto">
            <div class="w-full max-w-md">
                {# Header #}
                <div class="mb-8">
                    <h1 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-2">
                        Create your account
                    </h1>
                    <p class="text-body-md text-navy-500 dark:text-navy-400">
                        Join 500,000+ learners today
                    </p>
                </div>

                {# Role Selection #}
                <div class="mb-6">
                    <label class="input-label">I want to</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer">
                            <input type="radio" name="role_selector" value="student" class="peer hidden" {% if (form_data.role ?? 'student') == 'student' %}checked{% endif %} onchange="document.getElementById('role-input').value = 'student'">
                            <div class="p-4 rounded-2xl border-2 border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 peer-checked:border-harbor-500 peer-checked:bg-harbor-50 dark:peer-checked:bg-harbor-900/30 transition-all text-center">
                                <i data-lucide="graduation-cap" class="w-6 h-6 mx-auto mb-2 text-harbor-600 dark:text-harbor-400"></i>
                                <div class="font-semibold text-navy-900 dark:text-white text-body-sm">Learn</div>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="role_selector" value="professor" class="peer hidden" {% if (form_data.role ?? 'student') == 'professor' %}checked{% endif %} onchange="document.getElementById('role-input').value = 'professor'">
                            <div class="p-4 rounded-2xl border-2 border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 peer-checked:border-harbor-500 peer-checked:bg-harbor-50 dark:peer-checked:bg-harbor-900/30 transition-all text-center">
                                <i data-lucide="presentation" class="w-6 h-6 mx-auto mb-2 text-coral-500 dark:text-coral-400"></i>
                                <div class="font-semibold text-navy-900 dark:text-white text-body-sm">Teach</div>
                            </div>
                        </label>
                    </div>
                </div>

                {# Google Button #}
                <a href="{{ path('connect_google_start') }}" class="btn-outline w-full mb-6 flex items-center justify-center gap-3">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Continue with Google
                </a>

                {# Divider #}
                <div class="flex items-center gap-4 mb-6">
                    <div class="flex-1 h-px bg-navy-200 dark:bg-navy-800"></div>
                    <span class="text-caption text-navy-400 uppercase">or</span>
                    <div class="flex-1 h-px bg-navy-200 dark:bg-navy-800"></div>
                </div>

                {# Error Messages #}
                {% if errors is defined and errors is not empty %}
                    <div class="mb-6 p-4 rounded-2xl bg-danger-100 dark:bg-danger-900/30 border border-danger-200 dark:border-danger-800 animate-shake">
                        <div class="flex items-start gap-3">
                            <i data-lucide="alert-circle" class="w-5 h-5 text-danger-600 dark:text-danger-400 flex-shrink-0 mt-0.5"></i>
                            <div class="flex-1">
                                <p class="text-body-sm font-semibold text-danger-700 dark:text-danger-300 mb-2">Please fix the following errors:</p>
                                <ul class="space-y-1">
                                    {% for error in errors %}
                                        <li class="text-body-sm text-danger-600 dark:text-danger-400 flex items-start gap-2">
                                            <span class="text-danger-500 mt-1 flex-shrink-0">•</span>
                                            <span>{{ error|raw }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Form #}
                <form method="post" action="{{ path('auth_register') }}" id="register-form" novalidate>
                    {# Honeypot field for bot protection (hidden from users) #}
                    <div style="position: absolute; left: -9999px;" aria-hidden="true">
                        <input type="text" name="website" tabindex="-1" autocomplete="off">
                    </div>

                    <div class="space-y-4">
                        {# Name Fields #}
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="firstname" class="input-label">First name</label>
                                <input type="text" id="firstname" name="firstname" value="{{ form_data.firstname ?? '' }}" placeholder="John" autocomplete="given-name" class="input {{ field_errors.firstname is defined ? 'border-red-500 focus:border-red-500 focus:ring-red-500' : '' }}">
                                {% if field_errors.firstname is defined %}
                                    <div class="mt-1.5">
                                        {% for error in field_errors.firstname %}
                                            <p class="text-sm text-red-600 dark:text-red-400">{{ error|raw }}</p>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                            <div>
                                <label for="lastname" class="input-label">Last name</label>
                                <input type="text" id="lastname" name="lastname" value="{{ form_data.lastname ?? '' }}" placeholder="Doe" autocomplete="family-name" class="input {{ field_errors.lastname is defined ? 'border-red-500 focus:border-red-500 focus:ring-red-500' : '' }}">
                                {% if field_errors.lastname is defined %}
                                    <div class="mt-1.5">
                                        {% for error in field_errors.lastname %}
                                            <p class="text-sm text-red-600 dark:text-red-400">{{ error|raw }}</p>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Email #}
                        <div>
                            <label for="email" class="input-label">Email</label>
                            <input type="text" id="email" name="email" value="{{ form_data.email ?? '' }}" placeholder="you@example.com" autocomplete="email" class="input {{ field_errors.email is defined ? 'border-red-500 focus:border-red-500 focus:ring-red-500' : '' }}">
                            {% if field_errors.email is defined %}
                                <div class="mt-1.5">
                                    {% for error in field_errors.email %}
                                        <p class="text-sm text-red-600 dark:text-red-400">{{ error|raw }}</p>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {# Hidden Role Field #}
                        <input type="hidden" name="role" id="role-input" value="{{ form_data.role ?? 'student' }}">

                        {# Password #}
                        <div>
                            <label for="password" class="input-label">Password</label>
                            <div class="relative">
                                <input type="password" id="password" name="password" placeholder="Min. 8 characters" autocomplete="new-password" class="input pr-12 {{ field_errors.password is defined ? 'border-red-500 focus:border-red-500 focus:ring-red-500' : '' }}">
                                <button type="button" onclick="togglePassword('password', 'pwd-icon')" class="absolute right-3 top-1/2 -translate-y-1/2 text-navy-400 hover:text-navy-600 dark:hover:text-navy-300">
                                    <i data-lucide="eye" class="w-5 h-5" id="pwd-icon"></i>
                                </button>
                            </div>
                            {% if field_errors.password is defined %}
                                <div class="mt-1.5">
                                    {% for error in field_errors.password %}
                                        <p class="text-sm text-red-600 dark:text-red-400">{{ error|raw }}</p>
                                    {% endfor %}
                                </div>
                            {% else %}
                                {# Strength Indicator #}
                                <div class="flex items-center gap-3 mt-2">
                                    <div class="flex gap-1 flex-1">
                                        <div id="str-1" class="h-1 flex-1 rounded-full bg-navy-200 dark:bg-navy-700"></div>
                                        <div id="str-2" class="h-1 flex-1 rounded-full bg-navy-200 dark:bg-navy-700"></div>
                                        <div id="str-3" class="h-1 flex-1 rounded-full bg-navy-200 dark:bg-navy-700"></div>
                                    </div>
                                    <span id="str-text" class="text-caption font-medium text-navy-400"></span>
                                </div>
                            {% endif %}
                        </div>

                        {# Confirm Password #}
                        <div>
                            <label for="password_confirm" class="input-label">Confirm password</label>
                            <div class="relative">
                                <input type="password" id="password_confirm" name="password_confirm" placeholder="Confirm your password" autocomplete="new-password" class="input pr-12 {{ field_errors.password_confirm is defined ? 'border-red-500 focus:border-red-500 focus:ring-red-500' : '' }}">
                                <button type="button" onclick="togglePassword('password_confirm', 'confirm-icon')" class="absolute right-3 top-1/2 -translate-y-1/2 text-navy-400 hover:text-navy-600 dark:hover:text-navy-300">
                                    <i data-lucide="eye" class="w-5 h-5" id="confirm-icon"></i>
                                </button>
                            </div>
                            {% if field_errors.password_confirm is defined %}
                                <div class="mt-1.5">
                                    {% for error in field_errors.password_confirm %}
                                        <p class="text-sm text-red-600 dark:text-red-400">{{ error|raw }}</p>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {# Face ID Section - Optional #}
                        <!-- ========== FACE ID SECTION STARTS HERE ========== -->
                        <div style="margin-top: 24px; padding: 24px; border-radius: 16px; background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); border: 3px solid #0284c7;">
                            <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 16px;">
                                <div style="flex-shrink: 0;">
                                    <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #0284c7, #0ea5e9); display: flex; align-items: center; justify-content: center;">
                                        <i data-lucide="scan-face" style="width: 24px; height: 24px; color: white;"></i>
                                    </div>
                                </div>
                                <div class="flex-1">
                                    <h3 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">📸 Enable Face ID (Optional)</h3>
                                    <p style="font-size: 14px; color: #475569;">Login faster and more securely with facial recognition</p>
                                </div>
                                <div class="flex-shrink-0">
                                    <label style="display: inline-flex; align-items: center; cursor: pointer;">
                                        <input type="checkbox" id="enable-face-id" style="width: 24px; height: 24px; cursor: pointer; accent-color: #0284c7;">
                                        <span style="margin-left: 8px; font-size: 14px; font-weight: 600; color: #0284c7;">Enable</span>
                                    </label>
                                </div>
                            </div>

                            {# Face ID Capture Interface #}
                            <div id="face-capture-container" class="hidden">
                                {# Start Camera Button #}
                                <div id="start-camera-section" class="text-center mb-4">
                                    <button type="button" id="start-camera-btn" class="btn-primary">
                                        <i data-lucide="video" class="w-5 h-5 mr-2"></i>
                                        Start Camera
                                    </button>
                                    <p class="text-sm text-navy-600 dark:text-navy-400 mt-2">Click to activate your camera</p>
                                </div>

                                {# Camera Active Indicator #}
                                <div id="camera-active-indicator" class="hidden text-center mb-4">
                                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-success-100 dark:bg-success-900/30 border border-success-200 dark:border-success-800">
                                        <div class="w-2 h-2 rounded-full bg-success-500 animate-pulse"></div>
                                        <span class="text-sm font-medium text-success-700 dark:text-success-300">Camera Active</span>
                                    </div>
                                </div>

                                <div class="relative mx-auto" style="max-width: 320px;">
                                    {# Video Preview #}
                                    <div class="relative rounded-2xl overflow-hidden bg-navy-900 aspect-[4/3]">
                                        <video id="face-video" autoplay playsinline class="w-full h-full object-cover"></video>
                                        
                                        {# Face Detection Overlay #}
                                        <div class="absolute inset-0 pointer-events-none">
                                            <svg class="w-full h-full" viewBox="0 0 100 100">
                                                {# Corner brackets for face frame #}
                                                <path d="M 20 30 L 20 20 L 30 20" stroke="#0ea5e9" stroke-width="2" fill="none" class="animate-pulse"/>
                                                <path d="M 70 20 L 80 20 L 80 30" stroke="#0ea5e9" stroke-width="2" fill="none" class="animate-pulse"/>
                                                <path d="M 80 70 L 80 80 L 70 80" stroke="#0ea5e9" stroke-width="2" fill="none" class="animate-pulse"/>
                                                <path d="M 30 80 L 20 80 L 20 70" stroke="#0ea5e9" stroke-width="2" fill="none" class="animate-pulse"/>
                                            </svg>
                                        </div>

                                        {# Capture Status #}
                                        <div id="capture-status" class="absolute bottom-4 left-0 right-0 text-center">
                                            <div class="inline-block px-4 py-2 rounded-full bg-black/50 backdrop-blur-sm">
                                                <p class="text-white text-sm font-medium">Position your face in the frame</p>
                                            </div>
                                        </div>
                                    </div>

                                    {# Progress Indicator #}
                                    <div class="mt-4">
                                        <div class="flex justify-center gap-2 mb-2">
                                            <div id="capture-dot-1" class="w-3 h-3 rounded-full bg-navy-300 dark:bg-navy-600 transition-all"></div>
                                            <div id="capture-dot-2" class="w-3 h-3 rounded-full bg-navy-300 dark:bg-navy-600 transition-all"></div>
                                            <div id="capture-dot-3" class="w-3 h-3 rounded-full bg-navy-300 dark:bg-navy-600 transition-all"></div>
                                        </div>
                                        <p class="text-center text-sm text-navy-600 dark:text-navy-400">
                                            <span id="capture-progress-text">Preparing...</span>
                                        </p>
                                    </div>

                                    {# Capture Button #}
                                    <button type="button" id="capture-face-btn" class="btn-primary w-full mt-4">
                                        <i data-lucide="camera" class="w-5 h-5 mr-2"></i>
                                        Capture Face
                                    </button>
                                </div>

                                {# Success Message #}
                                <div id="face-capture-success" class="hidden mt-4 p-4 rounded-xl bg-success-100 dark:bg-success-900/30 border border-success-200 dark:border-success-800">
                                    <div class="flex items-center gap-3">
                                        <i data-lucide="check-circle" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
                                        <p class="text-sm font-medium text-success-700 dark:text-success-300">Face ID captured successfully!</p>
                                    </div>
                                </div>
                            </div>

                            {# Hidden input for face data #}
                            <input type="hidden" id="face-data-input" name="face_data" value="">
                        </div>

                        {# Terms #}
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="terms" name="terms" class="checkbox mt-0.5">
                            <label for="terms" class="text-body-sm text-navy-600 dark:text-navy-400 cursor-pointer">
                                I agree to the <a href="#" class="text-harbor-600 dark:text-harbor-400 hover:underline">Terms</a> and <a href="#" class="text-harbor-600 dark:text-harbor-400 hover:underline">Privacy Policy</a>
                            </label>
                        </div>

                        {# Submit #}
                        <button type="submit" class="btn-primary w-full">
                            Create account
                        </button>
                    </div>
                </form>

                {# Login Link #}
                <p class="mt-8 text-center text-body-sm text-navy-500 dark:text-navy-400">
                    Already have an account?
                    <a href="{{ path('auth_login') }}" class="font-semibold text-harbor-600 dark:text-harbor-400 hover:underline ml-1">
                        Sign in
                    </a>
                </p>
            </div>
        </div>

        {# Footer #}
        <div class="p-6 text-center">
            <p class="text-caption text-navy-400 flex items-center justify-center gap-2">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
                Your data is protected with 256-bit encryption
            </p>
        </div>
    </div>

    {# Right Panel - Interactive 3D Experience #}
    <div class="hidden lg:block lg:w-1/2 relative overflow-hidden">
        {# Animated gradient background #}
        <div class="absolute inset-0 bg-gradient-to-br from-[#0A0E27] via-[#1A1F3A] to-[#0F1629]"></div>
        
        {# Floating orbs animation #}
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute top-1/4 -right-20 w-96 h-96 bg-gradient-to-br from-harbor-500/30 to-purple-500/30 rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute bottom-1/4 -left-20 w-80 h-80 bg-gradient-to-tr from-sky-500/20 to-harbor-400/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-gradient-to-r from-purple-500/10 to-pink-500/10 rounded-full blur-2xl animate-pulse" style="animation-delay: 2s;"></div>
        </div>

        {# Dot pattern overlay #}
        <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>

        {# Grid lines for tech feel #}
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-0 left-1/4 w-px h-full bg-gradient-to-b from-transparent via-harbor-400 to-transparent"></div>
            <div class="absolute top-0 left-2/4 w-px h-full bg-gradient-to-b from-transparent via-sky-400 to-transparent"></div>
            <div class="absolute top-0 left-3/4 w-px h-full bg-gradient-to-b from-transparent via-purple-400 to-transparent"></div>
            <div class="absolute top-1/4 left-0 w-full h-px bg-gradient-to-r from-transparent via-harbor-400 to-transparent"></div>
            <div class="absolute top-2/4 left-0 w-full h-px bg-gradient-to-r from-transparent via-sky-400 to-transparent"></div>
            <div class="absolute top-3/4 left-0 w-full h-px bg-gradient-to-r from-transparent via-purple-400 to-transparent"></div>
        </div>

        {# Glowing corners #}
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-harbor-500/40 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 bg-gradient-to-tr from-purple-500/40 to-transparent"></div>

        {# 3D Spline Model Container #}
        <div class="relative h-full flex items-center justify-center p-8">
            {# Outer glow container #}
            <div class="relative w-full h-full rounded-3xl overflow-hidden">
                {# Inner shadow for depth #}
                <div class="absolute inset-0 rounded-3xl shadow-[inset_0_0_60px_rgba(0,0,0,0.3)]"></div>
                
                {# Spline viewer #}
                <div class="relative w-full h-full">
                    <script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.58/build/spline-viewer.js"></script>
                    <spline-viewer url="https://prod.spline.design/1V0P7xpRO0kes-qw/scene.splinecode" 
                                   style="width: 100%; height: 100%; border-radius: 1.5rem;"></spline-viewer>
                </div>

                {# Subtle border glow #}
                <div class="absolute inset-0 rounded-3xl border border-white/10"></div>
                <div class="absolute inset-0 rounded-3xl ring-1 ring-harbor-400/20"></div>
            </div>
        </div>

        {# Floating particles effect (optional decorative elements) #}
        <div class="absolute top-20 right-32 w-2 h-2 bg-white/40 rounded-full animate-ping"></div>
        <div class="absolute top-40 right-20 w-1.5 h-1.5 bg-harbor-400/60 rounded-full animate-ping" style="animation-delay: 0.5s;"></div>
        <div class="absolute bottom-32 left-24 w-2 h-2 bg-sky-400/40 rounded-full animate-ping" style="animation-delay: 1s;"></div>
        <div class="absolute bottom-48 right-40 w-1 h-1 bg-purple-400/60 rounded-full animate-ping" style="animation-delay: 1.5s;"></div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="/js/face-recognition.js"></script>
<script>
    lucide.createIcons();

    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.setAttribute('data-lucide', 'eye-off');
        } else {
            input.type = 'password';
            icon.setAttribute('data-lucide', 'eye');
        }
        lucide.createIcons();
    }

    // Password strength
    const pwd = document.getElementById('password');
    const s1 = document.getElementById('str-1');
    const s2 = document.getElementById('str-2');
    const s3 = document.getElementById('str-3');
    const sText = document.getElementById('str-text');

    pwd.addEventListener('input', function() {
        const p = this.value;
        let score = 0;
        if (p.length >= 8) score++;
        if (/[0-9!@#$%^&*]/.test(p)) score++;
        if (/[A-Z]/.test(p)) score++;

        [s1, s2, s3].forEach(b => b.className = 'h-1 flex-1 rounded-full bg-navy-200 dark:bg-navy-700');

        if (p.length === 0) {
            sText.textContent = '';
        } else if (score <= 1) {
            s1.classList.remove('bg-navy-200', 'dark:bg-navy-700');
            s1.classList.add('bg-danger-500');
            sText.textContent = 'Weak';
            sText.className = 'text-caption font-medium text-danger-500';
        } else if (score === 2) {
            [s1, s2].forEach(b => {
                b.classList.remove('bg-navy-200', 'dark:bg-navy-700');
                b.classList.add('bg-warning-500');
            });
            sText.textContent = 'Good';
            sText.className = 'text-caption font-medium text-warning-500';
        } else {
            [s1, s2, s3].forEach(b => {
                b.classList.remove('bg-navy-200', 'dark:bg-navy-700');
                b.classList.add('bg-success-500');
            });
            sText.textContent = 'Strong';
            sText.className = 'text-caption font-medium text-success-500';
        }
    });

    // ===== Face ID Functionality =====
    let faceRecognition = new FaceRecognition();
    let captureCount = 0;
    const maxCaptures = 3;

    // Toggle Face ID section
    document.getElementById('enable-face-id').addEventListener('change', function() {
        const container = document.getElementById('face-capture-container');
        
        if (this.checked) {
            // Check browser support
            if (!FaceRecognition.isSupported()) {
                alert('Your browser doesn\'t support camera access. Please use a modern browser like Chrome, Firefox, or Safari.');
                this.checked = false;
                return;
            }

            container.classList.remove('hidden');
        } else {
            container.classList.add('hidden');
            faceRecognition.stopCamera();
            document.getElementById('face-data-input').value = '';
            document.getElementById('face-capture-success').classList.add('hidden');
            resetUI();
        }
        
        lucide.createIcons();
    });

    // Start Camera button
    document.getElementById('start-camera-btn').addEventListener('click', async function() {
        try {
            const video = document.getElementById('face-video');
            await faceRecognition.initCamera(video);
            
            // Hide start button, show camera active indicator
            document.getElementById('start-camera-section').classList.add('hidden');
            document.getElementById('camera-active-indicator').classList.remove('hidden');
            
            updateCaptureStatus('Camera ready! Click "Capture Face" to begin');
            document.getElementById('capture-face-btn').disabled = false;
            
            lucide.createIcons();
        } catch (error) {
            console.error('Camera error:', error);
            alert('Unable to access camera. Please allow camera access in your browser settings and try again.');
        }
    });

    // Reset UI
    function resetUI() {
        document.getElementById('start-camera-section').classList.remove('hidden');
        document.getElementById('camera-active-indicator').classList.add('hidden');
        document.getElementById('capture-face-btn').disabled = true;
        captureCount = 0;
        resetCaptureDots();
    }

    // Capture face button
    document.getElementById('capture-face-btn').addEventListener('click', async function() {
        if (captureCount >= maxCaptures) {
            return;
        }

        this.disabled = true;
        
        // Capture all 3 faces at once with progress feedback
        try {
            updateCaptureStatus('Initializing camera...');
            
            // Capture 3 descriptors with progress updates
            const finalData = await faceRecognition.captureFaceDescriptors(3, (progress) => {
                const currentCapture = Math.ceil(progress * 3);
                updateCaptureDot(currentCapture);
                updateCaptureStatus(`Capturing ${currentCapture}/3...`);
            });
            
            // Save to hidden input
            document.getElementById('face-data-input').value = JSON.stringify(finalData);
            
            // Update all dots as complete
            updateCaptureDot(1);
            updateCaptureDot(2);
            updateCaptureDot(3);
            captureCount = 3;
            
            updateCaptureStatus('All captures complete! ✓');
            document.getElementById('face-capture-success').classList.remove('hidden');
            this.disabled = true;
            
            // Stop camera after short delay
            setTimeout(() => {
                faceRecognition.stopCamera();
                document.getElementById('camera-active-indicator').classList.add('hidden');
            }, 1500);
            
            lucide.createIcons();
            
        } catch (error) {
            console.error('Capture error:', error);
            alert('Failed to capture face. Please try again.');
            this.disabled = false;
            resetCaptureDots();
            updateCaptureStatus('Capture failed. Please try again.');
        }
    });

    // Update capture dot
    function updateCaptureDot(num) {
        const dot = document.getElementById(`capture-dot-${num}`);
        if (dot) {
            dot.classList.remove('bg-navy-300', 'dark:bg-navy-600');
            dot.classList.add('bg-success-500', 'scale-125');
        }
    }

    // Reset capture dots
    function resetCaptureDots() {
        for (let i = 1; i <= 3; i++) {
            const dot = document.getElementById(`capture-dot-${i}`);
            if (dot) {
                dot.className = 'w-3 h-3 rounded-full bg-navy-300 dark:bg-navy-600 transition-all';
            }
        }
    }

    // Update capture status
    function updateCaptureStatus(message) {
        const statusDiv = document.getElementById('capture-status');
        if (statusDiv) {
            statusDiv.innerHTML = `
                <div class="inline-block px-4 py-2 rounded-full bg-black/50 backdrop-blur-sm">
                    <p class="text-white text-sm font-medium">${message}</p>
                </div>
            `;
        }
        
        const progressText = document.getElementById('capture-progress-text');
        if (progressText) {
            progressText.textContent = message;
        }
    }

    // Cleanup on page unload
    window.addEventListener('beforeunload', function() {
        faceRecognition.stopCamera();
    });
</script>
{% endblock %}