{% extends 'layouts/base.html.twig' %}

{% block title %}Events - SkillHarbor{% endblock %}

{% block body %}
<div class="bg-navy-50 dark:bg-navy-900/30 min-h-screen">
    <div class="container-wide py-10">
        <div class="relative overflow-hidden rounded-2xl border border-blue-100/60 dark:border-blue-700/60 bg-white/80 dark:bg-slate-900/40 shadow-lg mb-10">
    <!-- Decorative gradient blobs - Blue theme -->
    <div class="pointer-events-none absolute -top-24 -right-16 h-56 w-56 rounded-full bg-gradient-to-br from-blue-400/30 via-cyan-300/20 to-transparent blur-2xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-16 h-64 w-64 rounded-full bg-gradient-to-tr from-indigo-400/20 via-blue-200/15 to-transparent blur-3xl" aria-hidden="true"></div>
    
    <!-- Content wrapper -->
    <div class="relative p-6 md:p-8">
        <!-- Header section - Centré -->
        <header class="text-center mb-8">
            <h1 class="font-display font-bold text-5xl md:text-6xl lg:text-7xl leading-tight mb-4 animate-color-shift">
                Events
            </h1>
            <p class="text-base md:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
                Discover upcoming events and their salles, then narrow down the list with smart filters.
            </p>
        </header>
        
        <!-- Filters section - Centré -->
        <div class="max-w-4xl mx-auto">
            <div class="flex flex-col sm:flex-row sm:items-end gap-4 rounded-xl border border-blue-100/60 dark:border-blue-700/60 bg-gradient-to-br from-white/95 to-blue-50/30 dark:from-slate-800/60 dark:to-blue-900/20 backdrop-blur-sm p-4 shadow-md">
                <!-- Search input -->
                <div class="flex-1 min-w-[220px]">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="event-search">
                        Search
                    </label>
                    <input
                        id="event-search"
                        class="w-full px-4 py-2.5 rounded-lg border border-blue-200 dark:border-blue-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                        type="search"
                        placeholder="Search by event title or salle name"
                        autocomplete="off">
                </div>
                
                <!-- Type filter -->
                <div class="flex-1 min-w-[180px]">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2" for="event-type-filter">
                        Filter by type
                    </label>
                    <select 
                        id="event-type-filter" 
                        class="w-full px-4 py-2.5 rounded-lg border border-blue-200 dark:border-blue-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 cursor-pointer">
                        <option value="">All types</option>
                        {% for type in event_types %}
                            <option value="{{ type }}">{{ type }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes color-shift {
        0%, 100% {
            color: #1e293b; /* Noir/Slate-800 */
        }
        50% {
            color: #2563eb; /* Bleu-600 */
        }
    }
    
    @keyframes color-shift-dark {
        0%, 100% {
            color: #ffffff; /* Blanc */
        }
        50% {
            color: #60a5fa; /* Bleu-400 */
        }
    }
    
    .animate-color-shift {
        animation: color-shift 4s ease-in-out infinite;
    }
    
    .dark .animate-color-shift {
        animation: color-shift-dark 4s ease-in-out infinite;
    }
</style>

       {% for type in event_types %}
            {% set hasType = false %}
            {% for event in events %}
                {% if event.eventType == type %}
                    {% set hasType = true %}
                {% endif %}
            {% endfor %}

            {% if hasType %}
            <section class="mb-10" data-type-section="{{ type }}">
               <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold mb-8 text-center bg-gradient-to-r from-blue-500 via-blue-600 to-cyan-500 bg-clip-text text-transparent animate-gradient bg-[length:200%_auto]">
                    {{ type }}
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {% for event in events %}
                        {% if event.eventType == type %}
                        <article class="group bg-white dark:bg-navy-800 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col" data-event-type="{{ event.eventType }}">
                            {# Image header #}
                            {% if event.image %}
                            <div class="relative w-full h-48 overflow-hidden bg-navy-100 dark:bg-navy-700">
                                {% if event.image matches '/\.(mp4|webm|ogg)$/i' %}
                                    <video class="w-full h-full object-cover" controls src="{{ event.image }}"></video>
                                {% else %}
                                    <img
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                        src="{{ event.image }}"
                                        alt="{{ event.title }}"
                                        loading="lazy">
                                {% endif %}
                            </div>
                            {% endif %}

                            {# Card content #}
                            <div class="p-5 flex flex-col flex-grow">
                                {# Title #}
                                <h3 class="text-heading-md font-display font-bold text-navy-900 dark:text-white mb-2 line-clamp-2">
                                    {{ event.title }}
                                </h3>

                                {# Description #}
                                {% if event.description %}
                                <p class="text-body-sm text-navy-600 dark:text-navy-300 mb-4 line-clamp-2">
                                    {{ event.description }}
                                </p>
                                {% endif %}

                                {# Location - Lieu #}
                                {% set salle = salle_map[event.salleId]|default(null) %}
                                <div class="mb-3">
                                    <p class="text-body-sm font-semibold text-red-500 mb-1">
                                        <i data-lucide="map-pin" class="w-4 h-4 inline-block mr-1"></i>
                                        Lieu : {{ salle ? salle.location : 'National' }}
                                    </p>
                                </div>

                                {# Date #}
                                <div class="mb-3">
                                    <p class="text-body-sm text-navy-600 dark:text-navy-400">
                                        <i data-lucide="calendar" class="w-4 h-4 inline-block mr-1"></i>
                                        <span class="font-medium">Date :</span> {{ event.startDate|date('Y-m-d') }}
                                    </p>
                                </div>

                                {# Price #}
                                <div class="mb-3">
                                    <p class="text-body-sm text-navy-600 dark:text-navy-400">
                                        <i data-lucide="tag" class="w-4 h-4 inline-block mr-1"></i>
                                        <span class="font-medium">Prix :</span> 
                                        {% if event.priceType == 'gratuit' %}
                                            <span class="text-green-600 font-semibold">Gratuit</span>
                                        {% elseif event.priceType == 'payant' %}
                                            <span class="font-semibold">Payant</span>
                                        {% else %}
                                            <span class="font-semibold">{{ event.priceType|default('N/A') }}</span>
                                        {% endif %}
                                    </p>
                                </div>

                                {# Max participants #}
                                {% if salle and salle.maxParticipants %}
                                <div class="mb-4">
                                    <p class="text-body-sm text-navy-600 dark:text-navy-400">
                                        <i data-lucide="users" class="w-4 h-4 inline-block mr-1"></i>
                                        <span class="font-medium">Participants max :</span> {{ salle.maxParticipants }}
                                    </p>
                                </div>
                                {% endif %}

                                {# Spacer #}
                                <div class="flex-grow"></div>

                                {# Footer with salle link #}
                                <div class="border-t border-navy-100 dark:border-navy-700 pt-4 mt-4">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="text-body-xs text-navy-500 dark:text-navy-400 truncate">
                                            <span class="font-medium">Salle:</span> {{ salle ? salle.name : 'Unassigned' }}
                                        </div>
                                        <a
                                            href="{{ salle ? path('salles_show', {id: salle.id}) : path('salles_index') }}"
                                            class="btn-primary btn-sm whitespace-nowrap"
                                        >
                                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                        {% endif %}
                    {% endfor %}
                </div>
            </section>
            {% endif %}
        {% endfor %}

        {% if events is empty %}
        <div class="card p-8 text-center">
            <div class="empty-state-icon mx-auto">
                <i data-lucide="calendar" class="w-full h-full"></i>
            </div>
            <p class="text-navy-500 mt-4">No events available yet.</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}


{% block javascripts %}
<script>
    (function() {
        const filter = document.getElementById('event-type-filter');
        const search = document.getElementById('event-search');
        if (!filter || !search) {
            return;
        }

        const sections = Array.from(document.querySelectorAll('[data-type-section]'));
        const cards = Array.from(document.querySelectorAll('[data-event-type]'));

        const normalize = (value) => (value || '').toLowerCase().trim();

        const applyFilter = () => {
            const typeValue = filter.value;
            const searchValue = normalize(search.value);

            cards.forEach((card) => {
                const type = card.getAttribute('data-event-type') || '';
                const title = normalize(card.getAttribute('data-event-title'));
                const salleName = normalize(card.getAttribute('data-salle-name'));
                const matchesType = !typeValue || type === typeValue;
                const matchesSearch = !searchValue || title.includes(searchValue) || salleName.includes(searchValue);
                card.classList.toggle('hidden', !(matchesType && matchesSearch));
            });

            sections.forEach((section) => {
                const type = section.getAttribute('data-type-section');
                const hasVisible = section.querySelectorAll('[data-event-type]:not(.hidden)').length > 0;
                const show = (!typeValue || type === typeValue) && hasVisible;
                section.classList.toggle('hidden', !show);
            });
        };

        filter.addEventListener('change', applyFilter);
        search.addEventListener('input', applyFilter);
        applyFilter();
    })();
</script>
{% endblock %}