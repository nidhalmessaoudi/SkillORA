{% extends 'layouts/base.html.twig' %}

{% block title %}{{ lesson.title }} - {{ course.title }} | SkillORA{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="min-h-screen bg-white dark:bg-navy-950">
    {# Fixed Top Header #}
    <header class="fixed top-0 left-0 right-0 bg-white dark:bg-navy-900 border-b border-navy-100 dark:border-navy-800 z-50 h-16">
        <div class="h-full flex items-center justify-between px-4 lg:px-6">
            {# Left: Back & Logo #}
            <div class="flex items-center gap-4">
                <a href="{{ path('learn_index') }}" class="flex items-center gap-2.5 text-navy-600 hover:text-navy-900 dark:text-navy-300 dark:hover:text-white transition-colors">
                    <div class="w-9 h-9 rounded-xl bg-navy-100 dark:bg-navy-800 flex items-center justify-center">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    </div>
                    <span class="hidden sm:inline text-sm font-medium">Back</span>
                </a>

                <div class="hidden md:block w-px h-8 bg-navy-200 dark:bg-navy-700"></div>

                <a href="{{ path('app_home') }}" class="hidden md:flex items-center gap-3 group">
                    <div class="w-10 h-10 bg-gradient-to-br from-harbor-600 to-harbor-500 rounded-2xl flex items-center justify-center shadow-soft group-hover:shadow-medium transition-shadow">
                        <i data-lucide="anchor" class="w-5 h-5 text-white"></i>
                    </div>
                    <span class="font-display font-bold text-lg text-navy-900 dark:text-white">SkillORA</span>
                </a>
            </div>

            {# Center: Course Info & Progress (Desktop) #}
            <div class="hidden lg:flex items-center gap-6 flex-1 justify-center px-8">
                <div class="flex items-center gap-4 bg-navy-50 dark:bg-navy-800/50 rounded-2xl px-5 py-2.5">
                    <div class="text-left">
                        <p class="text-xs text-navy-500 dark:text-navy-400">Now Learning</p>
                        <p class="text-sm font-semibold text-navy-900 dark:text-white truncate max-w-[200px]">{{ course.title }}</p>
                    </div>
                    <div class="w-px h-8 bg-navy-200 dark:bg-navy-700"></div>
                    <div class="flex items-center gap-3">
                        <div class="w-24 h-2 bg-navy-200 dark:bg-navy-700 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-success-500 to-success-400 rounded-full" style="width: {{ progress }}%"></div>
                        </div>
                        <span class="text-sm font-bold text-success-600 dark:text-success-400">{{ progress }}%</span>
                    </div>
                </div>
            </div>

            {# Right: Actions #}
            <div class="flex items-center gap-1.5">
                <button onclick="toggleTheme()" class="w-10 h-10 rounded-xl hover:bg-navy-100 dark:hover:bg-navy-800 flex items-center justify-center transition-colors" title="Toggle Theme">
                    <i data-lucide="sun" id="theme-sun" class="w-5 h-5 text-navy-500 dark:hidden"></i>
                    <i data-lucide="moon" id="theme-moon" class="w-5 h-5 text-navy-400 hidden dark:block"></i>
                </button>
                <button class="w-10 h-10 rounded-xl hover:bg-navy-100 dark:hover:bg-navy-800 flex items-center justify-center transition-colors" title="Notes">
                    <i data-lucide="file-text" class="w-5 h-5 text-navy-500 dark:text-navy-400"></i>
                </button>
                <button class="w-10 h-10 rounded-xl hover:bg-navy-100 dark:hover:bg-navy-800 flex items-center justify-center transition-colors" title="Bookmark">
                    <i data-lucide="bookmark" class="w-5 h-5 text-navy-500 dark:text-navy-400"></i>
                </button>
                <button id="toggleSidebar" class="xl:hidden w-10 h-10 rounded-xl bg-harbor-500 hover:bg-harbor-600 flex items-center justify-center transition-colors">
                    <i data-lucide="menu" class="w-5 h-5 text-white"></i>
                </button>
            </div>
        </div>
    </header>

    {# Main Layout with padding for fixed header #}
    <div class="pt-16 flex min-h-screen">
        {# Main Content Area #}
        <main class="flex-1 min-w-0 xl:mr-[400px]">
            {# Video Player Container #}
            <div class="bg-navy-950">
                <div class="relative w-full" style="padding-bottom: 56.25%;">
                    {# Video Background #}
                    <div class="absolute inset-0">
                        <img src="{{ course.thumbnail }}" alt="{{ lesson.title }}" class="w-full h-full object-cover opacity-30 blur-md scale-105">
                        <div class="absolute inset-0 bg-gradient-to-b from-navy-950/60 via-navy-950/80 to-navy-950"></div>
                    </div>

                    {# Video Player Placeholder #}
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="text-center px-4">
                            {# Play Button #}
                            <button class="group relative w-28 h-28 rounded-full bg-white/10 backdrop-blur-xl border-2 border-white/20 flex items-center justify-center mx-auto transition-all duration-500 hover:bg-white/20 hover:scale-110 hover:border-white/40 hover:shadow-2xl hover:shadow-white/10">
                                <i data-lucide="play" class="w-12 h-12 text-white ml-1.5 group-hover:scale-110 transition-transform"></i>
                                <div class="absolute inset-0 rounded-full border-2 border-white/20 animate-ping"></div>
                            </button>

                            <h3 class="mt-8 text-xl font-display font-semibold text-white">{{ lesson.title }}</h3>
                            <p class="mt-2 text-navy-300 flex items-center justify-center gap-2">
                                <i data-lucide="clock" class="w-4 h-4"></i>
                                {{ lesson.duration }}
                            </p>
                        </div>
                    </div>

                    {# Video Controls Bar #}
                    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black via-black/80 to-transparent p-6 pt-20">
                        {# Progress Bar #}
                        <div class="flex items-center gap-4 mb-4">
                            <span class="text-sm font-mono text-white/70 w-14">0:00</span>
                            <div class="flex-1 h-1.5 bg-white/20 rounded-full cursor-pointer group relative">
                                <div class="absolute inset-y-0 left-0 w-0 bg-harbor-500 rounded-full">
                                    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-4 h-4 bg-white rounded-full shadow-lg opacity-0 group-hover:opacity-100 transition-opacity -mr-2"></div>
                                </div>
                            </div>
                            <span class="text-sm font-mono text-white/70 w-14 text-right">{{ lesson.duration }}</span>
                        </div>

                        {# Control Buttons #}
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <button class="w-12 h-12 rounded-xl bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors">
                                    <i data-lucide="play" class="w-5 h-5 text-white"></i>
                                </button>
                                <button class="w-10 h-10 rounded-lg hover:bg-white/10 flex items-center justify-center transition-colors">
                                    <i data-lucide="skip-back" class="w-4 h-4 text-white/70"></i>
                                </button>
                                <button class="w-10 h-10 rounded-lg hover:bg-white/10 flex items-center justify-center transition-colors">
                                    <i data-lucide="skip-forward" class="w-4 h-4 text-white/70"></i>
                                </button>
                                <div class="flex items-center gap-2 ml-2 pl-2 border-l border-white/20">
                                    <button class="w-10 h-10 rounded-lg hover:bg-white/10 flex items-center justify-center transition-colors">
                                        <i data-lucide="volume-2" class="w-4 h-4 text-white/70"></i>
                                    </button>
                                    <div class="w-20 h-1 bg-white/20 rounded-full hidden sm:block">
                                        <div class="h-full w-3/4 bg-white/60 rounded-full"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button class="h-9 px-4 rounded-lg bg-white/10 hover:bg-white/20 text-sm font-medium text-white transition-colors">1x</button>
                                <button class="w-10 h-10 rounded-lg hover:bg-white/10 flex items-center justify-center transition-colors hidden sm:flex">
                                    <i data-lucide="subtitles" class="w-4 h-4 text-white/70"></i>
                                </button>
                                <button class="w-10 h-10 rounded-lg hover:bg-white/10 flex items-center justify-center transition-colors">
                                    <i data-lucide="maximize" class="w-4 h-4 text-white/70"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Lesson Content #}
            <div class="bg-white dark:bg-navy-900">
                {# Mobile Progress #}
                <div class="lg:hidden p-4 bg-navy-50 dark:bg-navy-800/50 border-b border-navy-100 dark:border-navy-800">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm text-navy-600 dark:text-navy-400">{{ completed_lessons }} of {{ total_lessons }} lessons completed</span>
                        <span class="text-sm font-bold text-success-600 dark:text-success-400">{{ progress }}%</span>
                    </div>
                    <div class="w-full h-2 bg-navy-200 dark:bg-navy-700 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-success-500 to-success-400 rounded-full" style="width: {{ progress }}%"></div>
                    </div>
                </div>

                {# Tabs #}
                <div class="border-b border-navy-100 dark:border-navy-800">
                    <div class="container-wide">
                        <div class="flex gap-1 overflow-x-auto scrollbar-hide">
                            <button class="px-6 py-4 text-sm font-semibold text-harbor-600 dark:text-harbor-400 border-b-2 border-harbor-500 whitespace-nowrap">Overview</button>
                            <button class="px-6 py-4 text-sm font-medium text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-white border-b-2 border-transparent transition-colors whitespace-nowrap">Notes</button>
                            <button class="px-6 py-4 text-sm font-medium text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-white border-b-2 border-transparent transition-colors whitespace-nowrap flex items-center gap-2">
                                Q&A
                                <span class="px-2 py-0.5 text-xs font-medium bg-harbor-100 dark:bg-harbor-900/30 text-harbor-600 dark:text-harbor-400 rounded-full">12</span>
                            </button>
                            <button class="px-6 py-4 text-sm font-medium text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-white border-b-2 border-transparent transition-colors whitespace-nowrap">Resources</button>
                        </div>
                    </div>
                </div>

                {# Tab Content #}
                <div class="container-wide py-10">
                    {# Lesson Header #}
                    <div class="mb-10">
                        <h1 class="font-display font-bold text-3xl lg:text-4xl text-navy-900 dark:text-white mb-4">
                            {{ lesson.title }}
                        </h1>
                        <p class="text-lg text-navy-600 dark:text-navy-300 leading-relaxed max-w-3xl mb-6">
                            {{ lesson.description }}
                        </p>

                        {# Instructor & Meta #}
                        <div class="flex flex-wrap items-center gap-6">
                            <a href="{{ path('instructor_show', {id: course.instructor.id}) }}" class="flex items-center gap-3 group">
                                <img src="{{ course.instructor.avatar }}" alt="{{ course.instructor.name }}" class="w-12 h-12 rounded-xl object-cover ring-2 ring-navy-100 dark:ring-navy-700 group-hover:ring-harbor-500 transition-all">
                                <div>
                                    <p class="font-semibold text-navy-900 dark:text-white group-hover:text-harbor-600 dark:group-hover:text-harbor-400 transition-colors">{{ course.instructor.name }}</p>
                                    <p class="text-sm text-navy-500 dark:text-navy-400">Instructor</p>
                                </div>
                            </a>

                            <div class="flex items-center gap-6 text-sm text-navy-500 dark:text-navy-400">
                                <span class="flex items-center gap-2">
                                    <i data-lucide="clock" class="w-4 h-4"></i>
                                    {{ lesson.duration }}
                                </span>
                                <span class="flex items-center gap-2">
                                    <i data-lucide="calendar" class="w-4 h-4"></i>
                                    Updated Jan 2024
                                </span>
                            </div>
                        </div>
                    </div>

                    {# What You'll Learn #}
                    <div class="p-8 mb-10 rounded-2xl border border-navy-200 bg-navy-50 dark:border-navy-700 dark:bg-navy-800">
                        <h2 class="font-display font-bold text-xl text-navy-900 dark:text-white mb-6 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-harbor-500/10 dark:bg-harbor-500/20 flex items-center justify-center">
                                <i data-lucide="target" class="w-5 h-5 text-harbor-600 dark:text-harbor-400"></i>
                            </div>
                            What you'll learn in this lesson
                        </h2>
                        <div class="grid sm:grid-cols-2 gap-4">
                            <div class="flex items-start gap-4 p-4 rounded-xl border border-navy-200 bg-white dark:border-navy-600 dark:bg-navy-700">
                                <div class="w-8 h-8 rounded-lg bg-success-500/10 dark:bg-success-500/20 flex items-center justify-center shrink-0">
                                    <i data-lucide="check" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                                </div>
                                <span class="text-navy-700 dark:text-white">Understand the core concepts and fundamentals</span>
                            </div>
                            <div class="flex items-start gap-4 p-4 rounded-xl border border-navy-200 bg-white dark:border-navy-600 dark:bg-navy-700">
                                <div class="w-8 h-8 rounded-lg bg-success-500/10 dark:bg-success-500/20 flex items-center justify-center shrink-0">
                                    <i data-lucide="check" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                                </div>
                                <span class="text-navy-700 dark:text-white">Apply practical techniques in real scenarios</span>
                            </div>
                            <div class="flex items-start gap-4 p-4 rounded-xl border border-navy-200 bg-white dark:border-navy-600 dark:bg-navy-700">
                                <div class="w-8 h-8 rounded-lg bg-success-500/10 dark:bg-success-500/20 flex items-center justify-center shrink-0">
                                    <i data-lucide="check" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                                </div>
                                <span class="text-navy-700 dark:text-white">Build a foundation for advanced topics</span>
                            </div>
                            <div class="flex items-start gap-4 p-4 rounded-xl border border-navy-200 bg-white dark:border-navy-600 dark:bg-navy-700">
                                <div class="w-8 h-8 rounded-lg bg-success-500/10 dark:bg-success-500/20 flex items-center justify-center shrink-0">
                                    <i data-lucide="check" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                                </div>
                                <span class="text-navy-700 dark:text-white">Complete the hands-on coding exercise</span>
                            </div>
                        </div>
                    </div>

                    {# Lesson Navigation #}
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-6 p-6 rounded-2xl border border-navy-200 bg-navy-50 dark:border-navy-700 dark:bg-navy-800">
                        <a href="#" class="flex items-center gap-4 group">
                            <div class="w-12 h-12 rounded-xl border border-navy-200 bg-white dark:border-navy-600 dark:bg-navy-700 flex items-center justify-center group-hover:border-harbor-500 group-hover:bg-harbor-50 dark:group-hover:bg-harbor-600 transition-all">
                                <i data-lucide="chevron-left" class="w-5 h-5 text-navy-500 dark:text-white group-hover:text-harbor-600 dark:group-hover:text-white"></i>
                            </div>
                            <div>
                                <p class="text-xs text-navy-500 dark:text-navy-400 mb-0.5">Previous</p>
                                <p class="font-semibold text-navy-900 dark:text-white group-hover:text-harbor-600 dark:group-hover:text-harbor-400 transition-colors">Introduction</p>
                            </div>
                        </a>

                        <button class="btn-primary px-8 py-3 text-base order-first sm:order-none">
                            <i data-lucide="check-circle" class="w-5 h-5 mr-2"></i>
                            Mark Complete
                        </button>

                        <a href="#" class="flex items-center gap-4 group justify-end">
                            <div class="text-right">
                                <p class="text-xs text-navy-500 dark:text-navy-400 mb-0.5">Next</p>
                                <p class="font-semibold text-navy-900 dark:text-white group-hover:text-harbor-600 dark:group-hover:text-harbor-400 transition-colors">Working with State</p>
                            </div>
                            <div class="w-12 h-12 rounded-xl border border-navy-200 bg-white dark:border-navy-600 dark:bg-navy-700 flex items-center justify-center group-hover:border-harbor-500 group-hover:bg-harbor-50 dark:group-hover:bg-harbor-600 transition-all">
                                <i data-lucide="chevron-right" class="w-5 h-5 text-navy-500 dark:text-white group-hover:text-harbor-600 dark:group-hover:text-white"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </main>

        {# Fixed Sidebar (Desktop) #}
        <aside class="hidden xl:block fixed top-16 right-0 bottom-0 w-[400px] bg-white dark:bg-navy-900 border-l border-navy-100 dark:border-navy-800 overflow-hidden flex flex-col">
            {# Sidebar Header #}
            <div class="p-6 border-b border-navy-100 dark:border-navy-800">
                <h3 class="font-display font-bold text-lg text-navy-900 dark:text-white mb-1">Course Content</h3>
                <p class="text-sm text-navy-500 dark:text-navy-400">{{ sections|length }} sections • {{ total_lessons }} lessons</p>
            </div>

            {# Progress #}
            <div class="p-6 border-b border-navy-100 dark:border-navy-800 bg-navy-50 dark:bg-navy-800/30">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-medium text-navy-700 dark:text-navy-300">Your Progress</span>
                    <span class="text-sm font-bold text-success-600 dark:text-success-400">{{ completed_lessons }}/{{ total_lessons }} complete</span>
                </div>
                <div class="w-full bg-navy-200 dark:bg-navy-700 rounded-full h-2.5 overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-success-500 to-success-400 rounded-full transition-all duration-500" style="width: {{ progress }}%"></div>
                </div>
            </div>

            {# Sections List #}
            <div class="flex-1 overflow-y-auto">
                {% for section in sections %}
                <div class="border-b border-navy-100 dark:border-navy-800">
                    {# Section Header #}
                    <button class="w-full px-6 py-4 flex items-center justify-between hover:bg-navy-50 dark:hover:bg-navy-800/30 transition-colors text-left group" onclick="toggleSection({{ loop.index }})">
                        <div class="flex items-center gap-3 min-w-0">
                            <i data-lucide="chevron-down" class="w-4 h-4 text-navy-400 shrink-0 section-chevron-{{ loop.index }} transition-transform"></i>
                            <div class="min-w-0">
                                <p class="font-semibold text-navy-900 dark:text-white truncate group-hover:text-harbor-600 dark:group-hover:text-harbor-400 transition-colors">{{ section.title }}</p>
                                <p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">{{ section.lessons|length }} lessons • {{ section.duration }}</p>
                            </div>
                        </div>
                        <span class="text-xs font-bold px-3 py-1.5 rounded-lg shrink-0 ml-3 {{ section.completed == section.lessons|length ? 'bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-400' : 'bg-navy-100 dark:bg-navy-800 text-navy-600 dark:text-navy-400' }}">
                            {{ section.completed|default(0) }}/{{ section.lessons|length }}
                        </span>
                    </button>

                    {# Section Lessons #}
                    <div id="section-{{ loop.index }}" class="bg-navy-50/50 dark:bg-navy-800/20">
                        {% for sectionLesson in section.lessons %}
                        <a href="{{ path('learn_player', {courseId: course.id, lessonId: sectionLesson.id}) }}"
                           class="flex items-center gap-4 px-6 py-4 transition-colors relative border-t border-navy-100 dark:border-navy-800 {{ sectionLesson.id == lesson.id ? 'bg-harbor-50 dark:bg-harbor-900/20' : 'hover:bg-navy-100 dark:hover:bg-navy-800/50' }}">

                            {# Active Indicator #}
                            {% if sectionLesson.id == lesson.id %}
                            <div class="absolute left-0 top-0 bottom-0 w-1 bg-harbor-500"></div>
                            {% endif %}

                            {# Status Icon #}
                            {% if sectionLesson.is_completed|default(false) %}
                            <div class="w-8 h-8 rounded-lg bg-success-100 dark:bg-success-900/30 flex items-center justify-center shrink-0">
                                <i data-lucide="check" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                            </div>
                            {% elseif sectionLesson.id == lesson.id %}
                            <div class="w-8 h-8 rounded-lg bg-harbor-500 flex items-center justify-center shrink-0 shadow-lg shadow-harbor-500/30">
                                <i data-lucide="play" class="w-4 h-4 text-white"></i>
                            </div>
                            {% else %}
                            <div class="w-8 h-8 rounded-lg border-2 border-navy-200 dark:border-navy-700 flex items-center justify-center shrink-0">
                                <span class="text-xs font-bold text-navy-400 dark:text-navy-500">{{ loop.index }}</span>
                            </div>
                            {% endif %}

                            {# Lesson Info #}
                            <div class="flex-1 min-w-0">
                                <p class="font-medium truncate {{ sectionLesson.id == lesson.id ? 'text-harbor-700 dark:text-harbor-400' : 'text-navy-900 dark:text-white' }}">{{ sectionLesson.title }}</p>
                                <div class="flex items-center gap-2 mt-1">
                                    <i data-lucide="{{ sectionLesson.type == 'video' ? 'play-circle' : (sectionLesson.type == 'quiz' ? 'help-circle' : 'file-text') }}" class="w-3.5 h-3.5 text-navy-400"></i>
                                    <span class="text-xs text-navy-500 dark:text-navy-400">{{ sectionLesson.duration }}</span>
                                </div>
                            </div>

                            {% if sectionLesson.is_preview|default(false) %}
                            <span class="text-xs font-semibold text-harbor-600 dark:text-harbor-400 bg-harbor-100 dark:bg-harbor-900/30 px-2.5 py-1 rounded-lg">Preview</span>
                            {% endif %}
                        </a>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </aside>
    </div>
</div>

{# Mobile Sidebar Overlay #}
<div id="sidebarOverlay" class="fixed inset-0 bg-navy-950/60 backdrop-blur-sm z-40 hidden xl:hidden" onclick="closeSidebar()"></div>

{# Mobile Sidebar #}
<aside id="mobileSidebar" class="fixed top-0 right-0 bottom-0 w-[320px] bg-white dark:bg-navy-900 z-50 transform translate-x-full transition-transform duration-300 xl:hidden overflow-hidden flex flex-col shadow-2xl">
    <div class="p-5 border-b border-navy-100 dark:border-navy-800 flex items-center justify-between bg-navy-50 dark:bg-navy-800/30">
        <div>
            <h3 class="font-display font-bold text-navy-900 dark:text-white">Course Content</h3>
            <p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">{{ sections|length }} sections • {{ total_lessons }} lessons</p>
        </div>
        <button onclick="closeSidebar()" class="w-10 h-10 rounded-xl bg-white dark:bg-navy-800 border border-navy-200 dark:border-navy-700 flex items-center justify-center hover:border-danger-500 hover:bg-danger-50 dark:hover:bg-danger-900/20 transition-all">
            <i data-lucide="x" class="w-5 h-5 text-navy-500 dark:text-navy-400"></i>
        </button>
    </div>

    {# Progress #}
    <div class="p-5 border-b border-navy-100 dark:border-navy-800">
        <div class="flex items-center justify-between mb-2">
            <span class="text-sm text-navy-600 dark:text-navy-400">Progress</span>
            <span class="text-sm font-bold text-success-600 dark:text-success-400">{{ progress }}%</span>
        </div>
        <div class="w-full bg-navy-200 dark:bg-navy-700 rounded-full h-2 overflow-hidden">
            <div class="h-full bg-success-500 rounded-full" style="width: {{ progress }}%"></div>
        </div>
    </div>

    {# Mobile Sections #}
    <div class="flex-1 overflow-y-auto">
        {% for section in sections %}
        <div class="border-b border-navy-100 dark:border-navy-800">
            <div class="px-5 py-4 bg-navy-50 dark:bg-navy-800/30">
                <p class="font-semibold text-navy-900 dark:text-white">{{ section.title }}</p>
                <p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">{{ section.lessons|length }} lessons</p>
            </div>
            {% for sectionLesson in section.lessons %}
            <a href="{{ path('learn_player', {courseId: course.id, lessonId: sectionLesson.id}) }}"
               class="flex items-center gap-4 px-5 py-3 border-t border-navy-100 dark:border-navy-800 {{ sectionLesson.id == lesson.id ? 'bg-harbor-50 dark:bg-harbor-900/20 border-l-2 border-l-harbor-500' : 'hover:bg-navy-50 dark:hover:bg-navy-800/30' }}">
                {% if sectionLesson.is_completed|default(false) %}
                <i data-lucide="check-circle" class="w-5 h-5 text-success-500 shrink-0"></i>
                {% elseif sectionLesson.id == lesson.id %}
                <i data-lucide="play-circle" class="w-5 h-5 text-harbor-500 shrink-0"></i>
                {% else %}
                <i data-lucide="circle" class="w-5 h-5 text-navy-300 dark:text-navy-600 shrink-0"></i>
                {% endif %}
                <div class="min-w-0">
                    <p class="text-sm font-medium truncate {{ sectionLesson.id == lesson.id ? 'text-harbor-700 dark:text-harbor-400' : 'text-navy-900 dark:text-white' }}">{{ sectionLesson.title }}</p>
                    <p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">{{ sectionLesson.duration }}</p>
                </div>
            </a>
            {% endfor %}
        </div>
        {% endfor %}
    </div>
</aside>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    function toggleSection(index) {
        const section = document.getElementById('section-' + index);
        const chevron = document.querySelector('.section-chevron-' + index);

        if (section.style.display === 'none') {
            section.style.display = 'block';
            chevron.style.transform = 'rotate(0deg)';
        } else {
            section.style.display = 'none';
            chevron.style.transform = 'rotate(-90deg)';
        }
    }

    document.getElementById('toggleSidebar')?.addEventListener('click', function() {
        document.getElementById('mobileSidebar').classList.remove('translate-x-full');
        document.getElementById('sidebarOverlay').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    });

    function closeSidebar() {
        document.getElementById('mobileSidebar').classList.add('translate-x-full');
        document.getElementById('sidebarOverlay').classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeSidebar();
    });
</script>
{% endblock %}
