{% extends 'layouts/base.html.twig' %}

{% block title %}Reservation - SkillHarbor{% endblock %}

{% block body %}
<div class="bg-navy-50 dark:bg-navy-900/30 min-h-screen">
    <div class="container-wide py-10 max-w-3xl">
        <div class="mb-8">
            <h1 class="font-display font-bold text-display-md text-navy-900 dark:text-white mb-2">Reservation</h1>
            <p class="text-body-md text-navy-600 dark:text-navy-400">Reserve your seat for an event.</p>
        </div>

        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

        <form method="post" class="card p-6 space-y-4">
            <input type="hidden" name="max_participants" value="{{ form_data.max_participants|default('') }}">
            <input type="hidden" name="seat_locked" value="{{ form_data.seat_locked ? '1' : '' }}">
            <input type="hidden" name="seats" value="{{ form_data.seats|default('') }}">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="input-label" for="event_id">Event</label>
                    {% if errors.event_id is defined %}
                        <p class="text-red-600 text-sm mt-1">{{ errors.event_id }}</p>
                    {% endif %}
                    {% if form_data.event_id %}
                        {% set selected_event = null %}
                        {% for event in events %}
                            {% if event.id == form_data.event_id %}
                                {% set selected_event = event %}
                            {% endif %}
                        {% endfor %}
                        <input type="hidden" id="event_id" name="event_id" value="{{ form_data.event_id }}">
                        <input type="text" class="input" value="{{ selected_event ? selected_event.title : 'Selected event' }}" readonly>
                    {% else %}
                        <select id="event_id" name="event_id" class="select">
                            <option value="">Select an event...</option>
                            {% for event in events %}
                                <option value="{{ event.id }}" {{ form_data.event_id == event.id ? 'selected' : '' }}>{{ event.title }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>
                <div>
                    <label class="input-label" for="salle_id">Salle</label>
                    {% if errors.salle_id is defined %}
                        <p class="text-red-600 text-sm mt-1">{{ errors.salle_id }}</p>
                    {% endif %}
                    {% if form_data.salle_id %}
                        {% set selected_salle = null %}
                        {% for salle in salles %}
                            {% if salle.id == form_data.salle_id %}
                                {% set selected_salle = salle %}
                            {% endif %}
                        {% endfor %}
                        <input type="hidden" id="salle_id" name="salle_id" value="{{ form_data.salle_id }}">
                        <input type="text" class="input" value="{{ selected_salle ? selected_salle.name : 'Selected salle' }}" readonly>
                    {% else %}
                        <select id="salle_id" name="salle_id" class="select">
                            <option value="">Select a salle...</option>
                            {% for salle in salles %}
                                <option value="{{ salle.id }}" {{ form_data.salle_id == salle.id ? 'selected' : '' }}>{{ salle.name }}</option>
                            {% endfor %}
                        </select>
                    {% endif %}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="input-label" for="prenom">First Name</label>
                    {% if errors.prenom is defined %}
                        <p class="text-red-600 text-sm mt-1">{{ errors.prenom }}</p>
                    {% endif %}
                    <input id="prenom" name="prenom" type="text" class="input" value="{{ form_data.prenom|default('') }}">
                </div>
                <div>
                    <label class="input-label" for="nom">Last Name</label>
                    {% if errors.nom is defined %}
                        <p class="text-red-600 text-sm mt-1">{{ errors.nom }}</p>
                    {% endif %}
                    <input id="nom" name="nom" type="text" class="input" value="{{ form_data.nom|default('') }}">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="input-label" for="telephone">Phone</label>
                    {% if errors.telephone is defined %}
                        <p class="text-red-600 text-sm mt-1">{{ errors.telephone }}</p>
                    {% endif %}
                    <input id="telephone" name="telephone" type="text" class="input" value="{{ form_data.telephone|default('') }}">
                </div>
                <div>
                    {% if form_data.seats %}
                        <label class="input-label" for="seats_display">Seats</label>
                        <input id="seats_display" name="seats_display" type="text" class="input" value="{{ form_data.seats|default('') }}" readonly>
                    {% else %}
                        <label class="input-label" for="nombre_places">Seat</label>
                        {% if errors.nombre_places is defined %}
                            <p class="text-red-600 text-sm mt-1">{{ errors.nombre_places }}</p>
                        {% endif %}
                        <input id="nombre_places" name="nombre_places" type="number" min="1" class="input" value="{{ form_data.nombre_places|default('') }}" {{ form_data.seat_locked ? 'readonly' : '' }}>
                    {% endif %}
                    {% if form_data.max_participants %}
                        <p class="text-caption text-navy-500 dark:text-navy-400 mt-1">Max seats: {{ form_data.max_participants }}</p>
                    {% endif %}
                </div>
            </div>

            {% set address_locked = form_data.salle_id and form_data.adresse %}
            <div>
                <label class="input-label" for="adresse">Address</label>
                <input id="adresse" name="adresse" type="text" class="input {{ address_locked ? 'bg-navy-50 dark:bg-navy-800 cursor-not-allowed' : '' }}" value="{{ form_data.adresse|default('') }}" {{ address_locked ? 'readonly data-locked=true' : '' }}>
                <div id="adresse-suggestions" class="mt-2 space-y-1"></div>
                <div id="adresse-map" class="mt-3 h-64 w-full rounded-xl border border-navy-200 dark:border-navy-700 overflow-hidden"></div>
                <p class="input-hint">{{ address_locked ? 'Address is locked to the salle location.' : 'Type an address or click on the map to set it.' }}</p>
            </div>

            <div>
                <label class="input-label" for="date_reservation">Reservation Date</label>
                <input id="date_reservation" name="date_reservation" type="datetime-local" class="input" value="{{ form_data.date_reservation|default('') }}" readonly>
                <p class="text-caption text-navy-500 dark:text-navy-400 mt-1">Set automatically to the current time.</p>
            </div>

            <div class="flex items-center gap-3">
                <button type="submit" class="btn-primary">Submit Reservation</button>
                <a href="{{ path('events_index') }}" class="btn-ghost btn-sm">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    (function() {
        const input = document.getElementById('adresse');
        const suggestions = document.getElementById('adresse-suggestions');
        const mapEl = document.getElementById('adresse-map');
        const locked = input.dataset.locked === 'true';

        if (!input || !suggestions || !mapEl || typeof L === 'undefined') {
            return;
        }

        const map = L.map(mapEl).setView([36.8065, 10.1815], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let marker = null;

        const setMarker = (lat, lng) => {
            if (marker) {
                marker.setLatLng([lat, lng]);
            } else {
                marker = L.marker([lat, lng]).addTo(map);
            }
            map.setView([lat, lng], 14);
        };

        const clearSuggestions = () => {
            suggestions.innerHTML = '';
        };

        const renderSuggestions = (items) => {
            clearSuggestions();
            items.forEach((item) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'w-full text-left px-3 py-2 rounded bg-navy-50 dark:bg-navy-800 text-sm hover:bg-navy-100 dark:hover:bg-navy-700';
                btn.textContent = item.display_name;
                btn.addEventListener('click', () => {
                    input.value = item.display_name;
                    setMarker(item.lat, item.lon);
                    clearSuggestions();
                });
                suggestions.appendChild(btn);
            });
        };

        if (!locked) {
            let debounceId = null;
            input.addEventListener('input', () => {
                const query = input.value.trim();
                clearTimeout(debounceId);
                if (query.length < 3) {
                    clearSuggestions();
                    return;
                }
                debounceId = setTimeout(() => {
                    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5`)
                        .then((res) => res.json())
                        .then((data) => {
                            renderSuggestions(data);
                        })
                        .catch(() => {
                            clearSuggestions();
                        });
                }, 250);
            });

            map.on('click', (event) => {
                const { lat, lng } = event.latlng;
                setMarker(lat.toFixed(6), lng.toFixed(6));
                fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
                    .then((res) => res.json())
                    .then((data) => {
                        if (data && data.display_name) {
                            input.value = data.display_name;
                        }
                    })
                    .catch(() => {});
            });
        }

        if (input.value.trim().length >= 3) {
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(input.value.trim())}&limit=1`)
                .then((res) => res.json())
                .then((data) => {
                    if (data && data[0]) {
                        setMarker(data[0].lat, data[0].lon);
                    }
                })
                .catch(() => {});
        }
    })();
</script>
{% endblock %}
