{% extends 'layouts/admin.html.twig' %}

{% block title %}User Management - Admin - SkillHarbor{% endblock %}

{% block head %}
<style>
    .user-card {
        transition: all 0.3s ease;
        border: 1px solid;
    }
    
    .user-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    }
    
    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animate-slide-in {
        animation: slideIn 0.4s ease-out forwards;
    }
    
    .filter-badge {
        transition: all 0.2s ease;
    }
    
    .filter-badge.active {
        background: #268bff !important;
        color: white !important;
    }
</style>
{% endblock %}

{% block admin_content %}
{# Calculate Statistics #}
{% set totalUsers = users|length %}
{% set adminCount = 0 %}
{% set professorCount = 0 %}
{% set studentCount = 0 %}
{% set bannedCount = 0 %}
{% set activeCount = 0 %}
{% for user in users %}
    {% if user.isAdmin %}{% set adminCount = adminCount + 1 %}
    {% elseif user.isProfessor %}{% set professorCount = professorCount + 1 %}
    {% else %}{% set studentCount = studentCount + 1 %}
    {% endif %}
    {% if user.isBanned %}{% set bannedCount = bannedCount + 1 %}
    {% else %}{% set activeCount = activeCount + 1 %}
    {% endif %}
{% endfor %}

{# Header with Stats and Create Button #}
<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-4xl font-display font-bold text-navy-900 dark:text-white mb-2 flex items-center gap-3">
                <i data-lucide="users" class="w-9 h-9 text-harbor-500"></i>
                User Management
            </h1>
            <p class="text-lg text-navy-600 dark:text-navy-400">
                Manage users, assign roles, and monitor platform activity
            </p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="showCreateUserModal()" class="px-4 py-2.5 bg-harbor-600 hover:bg-harbor-700 text-white rounded-xl text-sm font-medium transition-colors flex items-center gap-2 shadow-lg shadow-harbor-500/30">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                Create User
            </button>
        </div>
    </div>

    {# Statistics Cards #}
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
        <div class="bg-gradient-to-br from-harbor-500 to-harbor-600 rounded-2xl p-4 text-white shadow-lg">
            <div class="flex items-center justify-between mb-2">
                <span class="text-white/80 text-xs font-medium">Total Users</span>
                <i data-lucide="users" class="w-4 h-4 text-white/60"></i>
            </div>
            <div class="text-2xl font-bold">{{ totalUsers }}</div>
        </div>
        <div class="bg-gradient-to-br from-violet-500 to-violet-600 rounded-2xl p-4 text-white shadow-lg">
            <div class="flex items-center justify-between mb-2">
                <span class="text-white/80 text-xs font-medium">Admins</span>
                <i data-lucide="shield" class="w-4 h-4 text-white/60"></i>
            </div>
            <div class="text-2xl font-bold">{{ adminCount }}</div>
        </div>
        <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl p-4 text-white shadow-lg">
            <div class="flex items-center justify-between mb-2">
                <span class="text-white/80 text-xs font-medium">Professors</span>
                <i data-lucide="briefcase" class="w-4 h-4 text-white/60"></i>
            </div>
            <div class="text-2xl font-bold">{{ professorCount }}</div>
        </div>
        <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl p-4 text-white shadow-lg">
            <div class="flex items-center justify-between mb-2">
                <span class="text-white/80 text-xs font-medium">Students</span>
                <i data-lucide="graduation-cap" class="w-4 h-4 text-white/60"></i>
            </div>
            <div class="text-2xl font-bold">{{ studentCount }}</div>
        </div>
        <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-2xl p-4 text-white shadow-lg">
            <div class="flex items-center justify-between mb-2">
                <span class="text-white/80 text-xs font-medium">Banned</span>
                <i data-lucide="ban" class="w-4 h-4 text-white/60"></i>
            </div>
            <div class="text-2xl font-bold">{{ bannedCount }}</div>
        </div>
    </div>

    {# Search and Filter Bar #}
    <div class="bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-2xl p-6 shadow-lg">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {# Search Box #}
            <div class="md:col-span-2">
                <div class="relative">
                    <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-navy-400"></i>
                    <input 
                        type="text" 
                        id="searchInput"
                        placeholder="Search by name, email..." 
                        class="w-full pl-12 pr-4 py-3 bg-navy-50 dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-xl text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-harbor-500 transition-all"
                    >
                </div>
            </div>
            
            {# Role Filter #}
            <div>
                <select id="roleFilter" class="w-full px-4 py-3 bg-navy-50 dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-xl text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-harbor-500">
                    <option value="all">All Roles</option>
                    <option value="admin">Admins Only</option>
                    <option value="professor">Professors Only</option>
                    <option value="student">Students Only</option>
                </select>
            </div>
        </div>
        
        {# Filter Badges #}
        <div class="flex flex-wrap items-center gap-3 mt-4">
            <span class="text-sm font-medium text-navy-600 dark:text-navy-400">Quick Filters:</span>
            <button onclick="filterUsers('all')" class="filter-badge active px-4 py-2 bg-navy-100 dark:bg-navy-800 text-navy-700 dark:text-navy-300 rounded-lg text-sm font-medium hover:bg-harbor-500 hover:text-white">
                All Users
            </button>
            <button onclick="filterUsers('active')" class="filter-badge px-4 py-2 bg-navy-100 dark:bg-navy-800 text-navy-700 dark:text-navy-300 rounded-lg text-sm font-medium hover:bg-emerald-500 hover:text-white">
                Active
            </button>
            <button onclick="filterUsers('banned')" class="filter-badge px-4 py-2 bg-navy-100 dark:bg-navy-800 text-navy-700 dark:text-navy-300 rounded-lg text-sm font-medium hover:bg-red-500 hover:text-white">
                Banned
            </button>
            <button onclick="filterUsers('recent')" class="filter-badge px-4 py-2 bg-navy-100 dark:bg-navy-800 text-navy-700 dark:text-navy-300 rounded-lg text-sm font-medium hover:bg-violet-500 hover:text-white">
                Recent
            </button>
        </div>
    </div>
</div>

{# Users Grid #}
<div id="usersGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for user in users %}
    <div class="user-card bg-white dark:bg-navy-900 border-navy-200 dark:border-navy-800 rounded-2xl overflow-hidden shadow-lg animate-slide-in" 
         style="animation-delay: {{ loop.index0 * 0.05 }}s"
         data-role="{{ user.role ?? 'student' }}"
         data-status="{{ user.isBanned ? 'banned' : 'active' }}"
         data-name="{{ user.fullName|lower }}"
         data-email="{{ user.email|lower }}">
        
        {# Card Header with Gradient #}
        <div class="h-24 bg-gradient-to-r {% if user.isAdmin %}from-harbor-500 to-violet-500{% elseif user.isProfessor %}from-violet-500 to-purple-500{% else %}from-emerald-500 to-teal-500{% endif %} relative">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-10"></div>
        </div>
        
        {# User Avatar #}
        <div class="px-6 -mt-12 mb-4">
            <div class="relative inline-block">
                {% if user.avatar %}
                    <img src="/uploads/avatars/{{ user.avatar }}" alt="{{ user.fullName }}" class="w-20 h-20 rounded-2xl border-4 border-white dark:border-navy-900 shadow-xl object-cover">
                {% else %}
                    <div class="w-20 h-20 rounded-2xl border-4 border-white dark:border-navy-900 shadow-xl bg-gradient-to-br {% if user.isAdmin %}from-harbor-500 to-violet-500{% elseif user.isProfessor %}from-violet-500 to-purple-500{% else %}from-emerald-500 to-teal-500{% endif %} flex items-center justify-center text-white text-2xl font-bold">
                        {{ user.fullName[:1]|upper }}
                    </div>
                {% endif %}
                {# Status Indicator #}
                <div class="absolute -bottom-1 -right-1 w-6 h-6 {% if user.isBanned %}bg-red-500{% else %}bg-emerald-500{% endif %} border-2 border-white dark:border-navy-900 rounded-full"></div>
            </div>
        </div>
        
        {# User Info #}
        <div class="px-6 pb-6">
            {# Name and ID #}
            <div class="mb-3">
                <h3 class="text-lg font-bold text-navy-900 dark:text-white mb-1 flex items-center gap-2">
                    {{ user.fullName }}
                    {% if user.isAdmin %}
                        <i data-lucide="shield-check" class="w-4 h-4 text-harbor-500"></i>
                    {% elseif user.isProfessor %}
                        <i data-lucide="graduation-cap" class="w-4 h-4 text-violet-500"></i>
                    {% endif %}
                </h3>
                <p class="text-sm text-navy-500 dark:text-navy-400">{{ user.email }}</p>
                <p class="text-xs text-navy-400 dark:text-navy-500 mt-1">ID: #{{ user.id }}</p>
            </div>
            
            {# Role and Status Badges #}
            <div class="flex flex-wrap items-center gap-2 mb-4">
                {# Role Badge #}
                {% if user.isAdmin %}
                    <span class="px-3 py-1 bg-harbor-100 dark:bg-harbor-900/30 text-harbor-700 dark:text-harbor-400 rounded-lg text-xs font-semibold flex items-center gap-1.5">
                        <i data-lucide="shield" class="w-3 h-3"></i>
                        Admin
                    </span>
                {% elseif user.isProfessor %}
                    <span class="px-3 py-1 bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400 rounded-lg text-xs font-semibold flex items-center gap-1.5">
                        <i data-lucide="briefcase" class="w-3 h-3"></i>
                        Professor
                    </span>
                {% else %}
                    <span class="px-3 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 rounded-lg text-xs font-semibold flex items-center gap-1.5">
                        <i data-lucide="user" class="w-3 h-3"></i>
                        Student
                    </span>
                {% endif %}
                
                {# Status Badge #}
                {% if user.isBanned %}
                    <span class="px-3 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 rounded-lg text-xs font-semibold flex items-center gap-1.5">
                        <i data-lucide="ban" class="w-3 h-3"></i>
                        Banned
                    </span>
                {% else %}
                    <span class="px-3 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 rounded-lg text-xs font-semibold flex items-center gap-1.5">
                        <i data-lucide="check-circle" class="w-3 h-3"></i>
                        Active
                    </span>
                {% endif %}
            </div>
            
            {# Stats #}
            <div class="grid grid-cols-2 gap-3 mb-4 p-3 bg-navy-50 dark:bg-navy-800 rounded-xl">
                <div>
                    <div class="text-xs text-navy-500 dark:text-navy-400 mb-1">Joined</div>
                    <div class="text-sm font-semibold text-navy-900 dark:text-white">{{ user.createdAt|date('M d, Y') }}</div>
                </div>
                <div>
                    <div class="text-xs text-navy-500 dark:text-navy-400 mb-1">Last Login</div>
                    <div class="text-sm font-semibold text-navy-900 dark:text-white">
                        {% if user.lastLoginAt %}
                            {{ user.lastLoginAt|date('M d') }}
                        {% else %}
                            Never
                        {% endif %}
                    </div>
                </div>
            </div>
            
            {# Actions #}
            <div class="space-y-2">
                {% if not user.isAdmin %}
                    {# Role Upgrade Dropdown #}
                    <div class="relative" data-dropdown>
                        <button onclick="toggleDropdown('role-{{ user.id }}')" class="w-full px-4 py-2 bg-harbor-600 hover:bg-harbor-700 text-white rounded-lg text-sm font-medium transition-colors flex items-center justify-between">
                            <span class="flex items-center gap-2">
                                <i data-lucide="user-cog" class="w-4 h-4"></i>
                                Change Role
                            </span>
                            <i data-lucide="chevron-down" class="w-4 h-4"></i>
                        </button>
                        <div id="role-{{ user.id }}" class="hidden absolute bottom-full mb-2 left-0 right-0 bg-white dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-xl shadow-lg z-10">
                            <form method="post" action="{{ path('admin_user_promote', {id: user.id, role: 'admin'}) }}" class="block">
                                <button type="submit" onclick="return confirm('Promote {{ user.fullName }} to Admin?')" class="w-full px-4 py-2 text-left text-sm text-navy-700 dark:text-navy-300 hover:bg-harbor-50 dark:hover:bg-navy-700 transition-colors flex items-center gap-2 rounded-t-xl">
                                    <i data-lucide="shield" class="w-4 h-4 text-harbor-500"></i>
                                    Promote to Admin
                                </button>
                            </form>
                            <form method="post" action="{{ path('admin_user_promote', {id: user.id, role: 'professor'}) }}" class="block">
                                <button type="submit" onclick="return confirm('Set {{ user.fullName }} as Professor?')" class="w-full px-4 py-2 text-left text-sm text-navy-700 dark:text-navy-300 hover:bg-violet-50 dark:hover:bg-navy-700 transition-colors flex items-center gap-2">
                                    <i data-lucide="briefcase" class="w-4 h-4 text-violet-500"></i>
                                    Set as Professor
                                </button>
                            </form>
                            <form method="post" action="{{ path('admin_user_promote', {id: user.id, role: 'student'}) }}" class="block">
                                <button type="submit" onclick="return confirm('Set {{ user.fullName }} as Student?')" class="w-full px-4 py-2 text-left text-sm text-navy-700 dark:text-navy-300 hover:bg-emerald-50 dark:hover:bg-navy-700 transition-colors flex items-center gap-2 rounded-b-xl">
                                    <i data-lucide="user" class="w-4 h-4 text-emerald-500"></i>
                                    Set as Student
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    {# Ban/Unban and Delete #}
                    <div class="flex gap-2">
                        {% if user.isBanned %}
                            <form method="post" action="{{ path('admin_user_unban', {id: user.id}) }}" class="flex-1">
                                <button type="submit" class="w-full px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2">
                                    <i data-lucide="user-check" class="w-4 h-4"></i>
                                    Unban
                                </button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('admin_user_ban', {id: user.id}) }}" class="flex-1" onsubmit="return confirm('Ban {{ user.fullName }}?')">
                                <button type="submit" class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2">
                                    <i data-lucide="ban" class="w-4 h-4"></i>
                                    Ban
                                </button>
                            </form>
                        {% endif %}
                        
                        <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Delete {{ user.fullName }} permanently? This cannot be undone!')">
                            <button type="submit" class="px-4 py-2 bg-navy-100 dark:bg-navy-800 text-red-600 hover:bg-red-100 dark:hover:bg-red-900/30 rounded-lg transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    </div>
                {% else %}
                    <div class="px-4 py-3 bg-harbor-100 dark:bg-harbor-900/30 text-harbor-700 dark:text-harbor-400 rounded-lg text-center text-sm font-medium flex items-center justify-center gap-2">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                        Protected Admin
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-span-3">
        <div class="bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-2xl p-12 text-center">
            <div class="w-16 h-16 bg-navy-100 dark:bg-navy-800 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="users" class="w-8 h-8 text-navy-400"></i>
            </div>
            <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-2">No users found</h3>
            <p class="text-navy-500">There are no users in the system yet.</p>
        </div>
    </div>
    {% endfor %}
</div>

{# No Results Message #}
<div id="noResults" class="hidden">
    <div class="bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-2xl p-12 text-center">
        <div class="w-16 h-16 bg-navy-100 dark:bg-navy-800 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="search-x" class="w-8 h-8 text-navy-400"></i>
        </div>
        <h3 class="text-xl font-bold text-navy-900 dark:text-white mb-2">No users match your search</h3>
        <p class="text-navy-500">Try adjusting your filters or search terms.</p>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    lucide.createIcons();
    
    // Dropdown toggle
    function toggleDropdown(id) {
        const dropdown = document.getElementById(id);
        if (dropdown) {
            // Close all other dropdowns
            document.querySelectorAll('[id^="role-"]').forEach(d => {
                if (d.id !== id) d.classList.add('hidden');
            });
            dropdown.classList.toggle('hidden');
        }
    }
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('[data-dropdown]')) {
            document.querySelectorAll('[id^="role-"]').forEach(d => d.classList.add('hidden'));
        }
    });
    
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    const roleFilter = document.getElementById('roleFilter');
    const userCards = document.querySelectorAll('.user-card');
    const noResults = document.getElementById('noResults');
    const usersGrid = document.getElementById('usersGrid');
    
    function performSearch() {
        const searchTerm = searchInput.value.toLowerCase();
        const selectedRole = roleFilter.value;
        let visibleCount = 0;
        
        userCards.forEach(card => {
            const name = card.dataset.name;
            const email = card.dataset.email;
            const role = card.dataset.role;
            
            const matchesSearch = name.includes(searchTerm) || email.includes(searchTerm);
            const matchesRole = selectedRole === 'all' || role === selectedRole;
            
            if (matchesSearch && matchesRole) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
        
        // Show/hide no results message
        if (visibleCount === 0) {
            usersGrid.style.display = 'none';
            noResults.classList.remove('hidden');
        } else {
            usersGrid.style.display = 'grid';
            noResults.classList.add('hidden');
        }
    }
    
    searchInput.addEventListener('input', performSearch);
    roleFilter.addEventListener('change', performSearch);
    
    // Quick filters
    function filterUsers(type) {
        // Update active badge
        document.querySelectorAll('.filter-badge').forEach(badge => {
            badge.classList.remove('active');
        });
        event.target.classList.add('active');
        
        const userCards = document.querySelectorAll('.user-card');
        let visibleCount = 0;
        
        userCards.forEach(card => {
            let show = false;
            
            if (type === 'all') {
                show = true;
            } else if (type === 'active') {
                show = card.dataset.status === 'active';
            } else if (type === 'banned') {
                show = card.dataset.status === 'banned';
            } else if (type === 'recent') {
                // Show recently joined (implement based on your needs)
                show = true;
            }
            
            if (show) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
        
        if (visibleCount === 0) {
            usersGrid.style.display = 'none';
            noResults.classList.remove('hidden');
        } else {
            usersGrid.style.display = 'grid';
            noResults.classList.add('hidden');
        }
    }
    // Create User Modal
    function showCreateUserModal() {
        alert('Create User functionality coming soon! This would open a modal to create a new user manually.');
    }
</script>
{% endblock %}
