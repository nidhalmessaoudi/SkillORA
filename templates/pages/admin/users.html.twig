{% extends 'layouts/admin.html.twig' %}

{% block title %}User Management - Admin - SkillHarbor{% endblock %}

{% block admin_content %}
{# Header #}
<div class="mb-8">
    <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
        User Management
    </h1>
    <p class="text-body-md text-navy-600 dark:text-navy-400">
        Manage all users, ban or unban accounts, and monitor user activity.
    </p>
</div>

{# Users Table #}
<div class="card">
    <div class="p-6 border-b border-navy-100 dark:border-navy-800">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
                    All Users ({{ users|length }})
                </h2>
                <p class="text-body-sm text-navy-500 mt-1">
                    Complete list of all platform users
                </p>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-navy-50 dark:bg-navy-900/50">
                <tr>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        ID
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        User
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Email
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Role
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Status
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Joined
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Last Login
                    </th>
                    <th class="px-6 py-3 text-right text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-navy-100 dark:divide-navy-800">
                {% for user in users %}
                <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        #{{ user.id }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <div class="avatar avatar-md {% if user.isAdmin %}bg-harbor-600 text-white{% else %}bg-harbor-100 dark:bg-harbor-900/30 text-harbor-600 dark:text-harbor-400{% endif %}">
                                {{ user.fullName|slice(0, 1)|upper }}
                            </div>
                            <div class="font-medium text-navy-900 dark:text-white">
                                {{ user.fullName }}
                                {% if user.isAdmin %}
                                    <i data-lucide="shield-check" class="w-4 h-4 inline text-harbor-600 dark:text-harbor-400 ml-1"></i>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {{ user.email }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {% if user.isAdmin %}
                            <span class="badge-primary">
                                <i data-lucide="shield" class="w-3 h-3"></i>
                                Admin
                            </span>
                        {% else %}
                            <span class="badge-secondary">
                                <i data-lucide="user" class="w-3 h-3"></i>
                                User
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {% if user.isBanned %}
                            <span class="badge-danger">
                                <i data-lucide="ban" class="w-3 h-3"></i>
                                Banned
                            </span>
                        {% else %}
                            <span class="badge-success">
                                <i data-lucide="check-circle" class="w-3 h-3"></i>
                                Active
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-500 dark:text-navy-400">
                        {{ user.createdAt|date('M d, Y') }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-500 dark:text-navy-400">
                        {% if user.lastLoginAt %}
                            {{ user.lastLoginAt|date('M d, Y') }}
                        {% else %}
                            <span class="text-navy-400">Never</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right">
                        <div class="flex items-center justify-end gap-2">
                            {% if not user.isAdmin %}
                                {% if user.isBanned %}
                                    {# Unban Button #}
                                    <form method="post" action="{{ path('admin_user_unban', {id: user.id}) }}" class="inline">
                                        <button type="submit" class="btn-sm bg-success-500 text-white hover:bg-success-600" title="Unban User">
                                            <i data-lucide="user-check" class="w-4 h-4"></i>
                                            Unban
                                        </button>
                                    </form>
                                {% else %}
                                    {# Ban Button #}
                                    <form method="post" action="{{ path('admin_user_ban', {id: user.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to ban this user?');">
                                        <button type="submit" class="btn-sm bg-danger-500 text-white hover:bg-danger-600" title="Ban User">
                                            <i data-lucide="ban" class="w-4 h-4"></i>
                                            Ban
                                        </button>
                                    </form>
                                {% endif %}

                                {# Delete Button #}
                                <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" class="inline" onsubmit="return confirmDelete('Are you sure you want to delete this user? This action cannot be undone.');">
                                    <button type="submit" class="btn-icon btn-sm bg-danger-100 text-danger-600 hover:bg-danger-200 dark:bg-danger-900/30 dark:text-danger-400" title="Delete User">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            {% else %}
                                <span class="text-caption text-navy-400 italic">Protected</span>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" class="px-6 py-12 text-center">
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i data-lucide="users" class="w-full h-full"></i>
                            </div>
                            <p class="text-navy-500">No users found</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
