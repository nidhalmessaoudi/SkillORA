{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit Reservation - Admin - SkillHarbor{% endblock %}

{% block admin_content %}
<div class="mb-8">
    <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">Edit Reservation</h1>
    <p class="text-body-md text-navy-600 dark:text-navy-400">Update reservation details.</p>
</div>

<form method="post" class="space-y-6">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_reservation_edit') }}">
    <div class="card p-6 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="input-label" for="event_id">Event</label>
                {% if errors.event_id is defined %}
                    <p class="text-red-600 text-sm mt-1">{{ errors.event_id }}</p>
                {% endif %}
                <select id="event_id" name="event_id" class="select">
                    <option value="">Select an event...</option>
                    {% for event in events %}
                        <option value="{{ event.id }}" {{ form_data.event_id == event.id ? 'selected' : '' }}>{{ event.title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label class="input-label" for="salle_id">Salle</label>
                {% if errors.salle_id is defined %}
                    <p class="text-red-600 text-sm mt-1">{{ errors.salle_id }}</p>
                {% endif %}
                <select id="salle_id" name="salle_id" class="select">
                    <option value="">Select a salle...</option>
                    {% for salle in salles %}
                        <option value="{{ salle.id }}" {{ form_data.salle_id == salle.id ? 'selected' : '' }}>{{ salle.name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="input-label" for="prenom">First Name</label>
                {% if errors.prenom is defined %}
                    <p class="text-red-600 text-sm mt-1">{{ errors.prenom }}</p>
                {% endif %}
                <input id="prenom" name="prenom" type="text" class="input" value="{{ form_data.prenom|default('') }}">
            </div>
            <div>
                <label class="input-label" for="nom">Last Name</label>
                {% if errors.nom is defined %}
                    <p class="text-red-600 text-sm mt-1">{{ errors.nom }}</p>
                {% endif %}
                <input id="nom" name="nom" type="text" class="input" value="{{ form_data.nom|default('') }}">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="input-label" for="telephone">Phone</label>
                {% if errors.telephone is defined %}
                    <p class="text-red-600 text-sm mt-1">{{ errors.telephone }}</p>
                {% endif %}
                <input id="telephone" name="telephone" type="text" class="input" value="{{ form_data.telephone|default('') }}">
            </div>
            <div>
                <label class="input-label" for="nombre_places">Places</label>
                {% if errors.nombre_places is defined %}
                    <p class="text-red-600 text-sm mt-1">{{ errors.nombre_places }}</p>
                {% endif %}
                <input id="nombre_places" name="nombre_places" type="text" class="input" value="{{ form_data.nombre_places|default('') }}">
                <p class="text-caption text-navy-500 dark:text-navy-400 mt-1">Example: 18,19,20</p>
            </div>
        </div>

        <div>
            <label class="input-label" for="adresse">Address</label>
            <input id="adresse" name="adresse" type="text" class="input" value="{{ form_data.adresse|default('') }}">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="input-label" for="date_reservation">Reservation Date</label>
                {% if errors.date_reservation is defined %}
                    <p class="text-red-600 text-sm mt-1">{{ errors.date_reservation }}</p>
                {% endif %}
                <input id="date_reservation" name="date_reservation" type="datetime-local" class="input" value="{{ form_data.date_reservation|default('') }}">
            </div>
            <div>
                <label class="input-label" for="user_id">User ID (optional)</label>
                <input id="user_id" name="user_id" type="number" min="1" class="input" value="{{ form_data.user_id|default('') }}">
            </div>
        </div>
    </div>

    <div class="flex items-center gap-3">
        <button type="submit" class="btn-primary">Save Changes</button>
        <a href="{{ path('admin_reservations_show', {id: reservation.id}) }}" class="btn-ghost btn-sm">Cancel</a>
    </div>
</form>
{% endblock %}
