{% extends 'layouts/admin.html.twig' %}

{% block title %}Reservations - Admin - SkillHarbor{% endblock %}

{% block admin_content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">Reservations</h1>
        <p class="text-body-md text-navy-600 dark:text-navy-400">Manage event reservations.</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="{{ path('admin_reservations_export') }}" class="btn-secondary btn-sm">
            <i data-lucide="download" class="w-4 h-4"></i>
            Export TXT
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="card">
        <div class="p-6 border-b border-navy-100 dark:border-navy-800">
            <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">Total Places</h2>
            <p class="text-body-sm text-navy-500 mt-1">Global seats reserved across all events.</p>
        </div>
        <div class="p-6">
            <div class="text-4xl font-display font-bold text-navy-900 dark:text-white">{{ total_places }}</div>
            <div class="text-caption text-navy-500 mt-2">From {{ reservation_total }} reservations</div>
        </div>
    </div>

    <div class="card lg:col-span-2">
        <div class="p-6 border-b border-navy-100 dark:border-navy-800">
            <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">Places by Event</h2>
            <p class="text-body-sm text-navy-500 mt-1">Top events by reserved places.</p>
        </div>
        <div class="p-6">
            {% if event_place_stats is not empty %}
                <div class="flex items-end gap-3 h-56">
                    {% for stat in event_place_stats %}
                        {% set barHeight = max_places_by_event > 0 ? (stat.places / max_places_by_event * 100) : 0 %}
                        <div class="flex-1 flex flex-col items-center gap-2 group min-w-[48px]">
                            <div class="relative w-full rounded-t-xl bg-gradient-to-t from-blue-500 via-cyan-400 to-cyan-300" style="height: {{ barHeight|number_format(0) }}%; min-height: 8px;">
                                <div class="absolute -top-8 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <div class="bg-navy-900 dark:bg-white text-white dark:text-navy-900 text-caption px-2 py-1 rounded shadow-medium whitespace-nowrap">
                                        {{ stat.places }} places
                                    </div>
                                </div>
                            </div>
                            <span class="text-caption text-navy-500 dark:text-navy-400 text-center line-clamp-2">
                                {{ stat.title }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-body-sm text-navy-500">No reservation data yet.</p>
            {% endif %}
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="card">
        <div class="p-6 border-b border-navy-100 dark:border-navy-800">
            <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white text-center">Share by Event</h2>
            <p class="text-body-sm text-navy-500 mt-1 text-center">Visual split of reserved places.</p>
        </div>
        <div class="p-6">
            {% if pie_slices is not empty %}
                <div class="flex flex-col md:flex-row items-center justify-center gap-8">
                    <div class="relative animate-fade-in">
                        <div class="w-48 h-48 rounded-full shadow-lg hover:shadow-2xl transform hover:scale-110 transition-all duration-500 animate-spin-slow"
                             style="background: {{ pie_gradient }};">
                        </div>
                    </div>
                    <div class="space-y-3 animate-slide-in">
                        {% for slice in pie_slices %}
                            <div class="flex items-center gap-3 transform hover:translate-x-2 transition-transform duration-300 animate-fade-in-up" style="animation-delay: {{ loop.index0 * 0.1 }}s;">
                                <span class="w-4 h-4 rounded-full shadow-md animate-pulse-slow" style="background: {{ slice.color }};"></span>
                                <div class="text-body-sm text-navy-700 dark:text-navy-300">
                                    <span class="font-semibold">{{ slice.title }}</span>
                                    <span class="text-navy-500">({{ slice.places }} places, {{ slice.percent|number_format(1) }}%)</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <p class="text-body-sm text-navy-500 text-center animate-fade-in">No reservation data yet.</p>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="p-6 border-b border-navy-100 dark:border-navy-800">
            <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">Totals</h2>
            <p class="text-body-sm text-navy-500 mt-1">Quick view of overall volume.</p>
        </div>
        <div class="p-6 space-y-4">
            <div class="flex items-center justify-between">
                <span class="text-body-sm font-medium text-navy-700 dark:text-navy-300">Reservations</span>
                <span class="text-heading-md font-semibold text-navy-900 dark:text-white">{{ reservation_total }}</span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-body-sm font-medium text-navy-700 dark:text-navy-300">Total Places</span>
                <span class="text-heading-md font-semibold text-navy-900 dark:text-white">{{ total_places }}</span>
            </div>
            <div class="text-caption text-navy-500">Updated live from reservations list.</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="p-6 border-b border-navy-100 dark:border-navy-800">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">All Reservations ({{ reservation_total }})</h2>
                <p class="text-body-sm text-navy-500">Search by name and sort by places.</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="min-w-[220px]">
                    <label class="block text-caption text-navy-500 mb-1" for="reservation-search">Search</label>
                    <input
                        id="reservation-search"
                        type="search"
                        placeholder="Search by first or last name"
                        autocomplete="off"
                        class="w-full px-3 py-2 rounded-lg border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-navy-900 dark:text-white text-body-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="min-w-[180px]">
                    <label class="block text-caption text-navy-500 mb-1" for="reservation-sort">Sort by</label>
                    <select
                        id="reservation-sort"
                        class="w-full px-3 py-2 rounded-lg border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-navy-900 dark:text-white text-body-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="places-desc" selected>Places (High to Low)</option>
                        <option value="places-asc">Places (Low to High)</option>
                        <option value="date-desc">Date (Newest)</option>
                        <option value="date-asc">Date (Oldest)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-navy-50 dark:bg-navy-900/50">
                <tr>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Event</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Salle</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Places</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Date</th>
                    <th class="px-6 py-3 text-right text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-navy-100 dark:divide-navy-800" data-reservation-rows>
                {% for reservation in reservations %}
                <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors"
                    data-reservation-row
                    data-name="{{ (reservation.prenom ~ ' ' ~ reservation.nom)|lower }}"
                    data-places="{{ reservation.nombrePlaces }}"
                    data-date="{{ reservation.dateReservation|date('Y-m-d H:i') }}">
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-900 dark:text-white">
                        {% set event = event_map[reservation.eventId]|default(null) %}
                        {{ event ? event.title : 'Unknown' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {% set salle = salle_map[reservation.salleId]|default(null) %}
                        {{ salle ? salle.name : 'Unknown' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {{ reservation.prenom }} {{ reservation.nom }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">{{ reservation.nombrePlaces }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">{{ reservation.dateReservation|date('M d, Y H:i') }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_reservations_show', {id: reservation.id}) }}" class="btn-sm bg-navy-100 text-navy-700 hover:bg-navy-200">View</a>
                            <a href="{{ path('admin_reservations_edit', {id: reservation.id}) }}" class="btn-sm bg-harbor-100 text-harbor-700 hover:bg-harbor-200">Edit</a>
                            <form method="post" action="{{ path('admin_reservations_delete', {id: reservation.id}) }}" onsubmit="return confirmDelete('Delete this reservation?');">
                                <button type="submit" class="btn-sm bg-danger-100 text-danger-600 hover:bg-danger-200">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center">
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i data-lucide="ticket" class="w-full h-full"></i>
                            </div>
                            <p class="text-navy-500">No reservations found</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Empty search state -->
    <div id="reservation-empty" class="hidden px-6 py-10 text-center text-navy-500">No matching reservations.</div>

    <!-- ══════════════════════════════════════════
         PAGINATION
         ══════════════════════════════════════════ -->
    <div class="px-6 py-4 border-t border-navy-100 dark:border-navy-800 flex flex-col sm:flex-row items-center justify-between gap-3">
        <!-- Info text -->
        <p class="text-caption text-navy-500 dark:text-navy-400 select-none">
            Showing <span id="pg-from" class="font-semibold text-navy-700 dark:text-navy-300">1</span>–<span id="pg-to" class="font-semibold text-navy-700 dark:text-navy-300">10</span>
            of <span id="pg-total" class="font-semibold text-navy-700 dark:text-navy-300">0</span> reservations
        </p>
        <!-- Nav buttons -->
        <nav class="flex items-center gap-1" id="pagination-nav" aria-label="Reservations pagination"></nav>
    </div>
</div>

<style>
/* ── Pagination buttons ────────────────────── */
.pg-btn {
    position: relative;
    min-width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 500;
    border: none;
    cursor: pointer;
    padding: 0 8px;
    color: #64748b;
    background: transparent;
    transition: background 0.15s, color 0.15s;
    user-select: none;
}
.pg-btn:hover:not(:disabled):not(.pg-active) {
    background: #f1f5f9;
    color: #1e293b;
}
.dark .pg-btn:hover:not(:disabled):not(.pg-active) {
    background: rgba(255,255,255,0.07);
    color: #e2e8f0;
}
/* Active page */
.pg-btn.pg-active {
    background: #f1f5f9;
    color: #0f172a;
    font-weight: 700;
}
.dark .pg-btn.pg-active {
    background: rgba(255,255,255,0.10);
    color: #fff;
}
/* Underline on active page — matches the image */
.pg-btn.pg-active::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 55%;
    height: 2px;
    border-radius: 2px;
    background: #0f172a;
}
.dark .pg-btn.pg-active::after {
    background: #fff;
}
/* Disabled arrow */
.pg-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}
/* Ellipsis separator */
.pg-sep {
    color: #94a3b8;
    font-size: 0.84rem;
    padding: 0 4px;
    line-height: 36px;
    user-select: none;
}
</style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        /* ── Elements ─────────────────────────────── */
        const searchInput = document.getElementById('reservation-search');
        const sortSelect  = document.getElementById('reservation-sort');
        const tbody       = document.querySelector('[data-reservation-rows]');
        const emptyMsg    = document.getElementById('reservation-empty');
        const pgNav       = document.getElementById('pagination-nav');
        const pgFrom      = document.getElementById('pg-from');
        const pgTo        = document.getElementById('pg-to');
        const pgTotal     = document.getElementById('pg-total');

        if (!searchInput || !sortSelect || !tbody) return;

        /* ── Config ────────────────────────────────── */
        const PER_PAGE = 4;

        /* ── State ─────────────────────────────────── */
        const allRows = Array.from(tbody.querySelectorAll('[data-reservation-row]'));
        let visibleRows = [];   // rows that pass the current filter+sort
        let currentPage = 1;

        /* ── Helpers ───────────────────────────────── */
        const normalize   = (v) => (v || '').toLowerCase().trim();
        const parsePlaces = (v) => {
            const raw = (v || '').trim();
            if (!raw) return 0;
            if (/^\d+$/.test(raw)) return parseInt(raw, 10);
            return raw.split(',').filter(p => /^\d+$/.test(p.trim())).length;
        };
        const totalPages  = () => Math.max(1, Math.ceil(visibleRows.length / PER_PAGE));

        /* ── Filter + Sort ─────────────────────────── */
        function applyFilterSort() {
            const query    = normalize(searchInput.value);
            const sortMode = sortSelect.value;

            // 1. Filter
            visibleRows = allRows.filter(row => {
                const name = normalize(row.getAttribute('data-name'));
                return !query || name.includes(query);
            });

            // 2. Sort
            visibleRows.sort((a, b) => {
                if (sortMode.startsWith('places')) {
                    const av = parsePlaces(a.getAttribute('data-places'));
                    const bv = parsePlaces(b.getAttribute('data-places'));
                    return sortMode === 'places-asc' ? av - bv : bv - av;
                }
                const ad = new Date(a.getAttribute('data-date'));
                const bd = new Date(b.getAttribute('data-date'));
                return sortMode === 'date-asc' ? ad - bd : bd - ad;
            });

            // Reset to page 1 on every new filter/sort
            currentPage = 1;
            render();
        }

        /* ── Render page ───────────────────────────── */
        function render() {
            const tp    = totalPages();
            currentPage = Math.min(Math.max(1, currentPage), tp);

            const start = (currentPage - 1) * PER_PAGE;  // 0-based
            const end   = start + PER_PAGE;

            // Hide all rows first, then show the current page slice
            allRows.forEach(r => r.classList.add('hidden'));
            visibleRows.forEach((row, idx) => {
                tbody.appendChild(row); // maintain sorted order in DOM
                row.classList.toggle('hidden', idx < start || idx >= end);
            });

            // Empty message
            if (emptyMsg) emptyMsg.classList.toggle('hidden', visibleRows.length > 0);

            // Info text
            const showing = Math.min(visibleRows.length, end) - start;
            if (pgFrom)  pgFrom.textContent  = visibleRows.length ? start + 1 : 0;
            if (pgTo)    pgTo.textContent    = visibleRows.length ? start + showing : 0;
            if (pgTotal) pgTotal.textContent = visibleRows.length;

            renderNav(tp);
        }

        /* ── Build pagination nav ──────────────────── */
        function renderNav(tp) {
            if (!pgNav) return;
            pgNav.innerHTML = '';

            if (tp <= 1) return; // no nav needed for a single page

            // Prev arrow
            pgNav.appendChild(makeArrow('prev', currentPage <= 1));

            // Page numbers with ellipsis logic
            const pages = pageNumbers(currentPage, tp);
            let lastNum = null;
            pages.forEach(p => {
                if (p === '…') {
                    const sep = document.createElement('span');
                    sep.className   = 'pg-sep';
                    sep.textContent = '…';
                    pgNav.appendChild(sep);
                } else {
                    pgNav.appendChild(makePageBtn(p));
                }
                lastNum = p;
            });

            // Next arrow
            pgNav.appendChild(makeArrow('next', currentPage >= tp));
        }

        /* Return array like [1, 2, '…', 7, 8] */
        function pageNumbers(cur, tp) {
            if (tp <= 7) return Array.from({ length: tp }, (_, i) => i + 1);
            const pages = new Set([1, tp, cur, cur - 1, cur + 1].filter(p => p >= 1 && p <= tp));
            const sorted = Array.from(pages).sort((a, b) => a - b);
            const result = [];
            sorted.forEach((p, i) => {
                if (i > 0 && p - sorted[i - 1] > 1) result.push('…');
                result.push(p);
            });
            return result;
        }

        function makePageBtn(page) {
            const btn = document.createElement('button');
            btn.type      = 'button';
            btn.className = 'pg-btn' + (page === currentPage ? ' pg-active' : '');
            btn.textContent = page;
            btn.setAttribute('aria-label', `Page ${page}`);
            if (page === currentPage) btn.setAttribute('aria-current', 'page');
            btn.addEventListener('click', () => { currentPage = page; render(); });
            return btn;
        }

        function makeArrow(dir, disabled) {
            const btn = document.createElement('button');
            btn.type      = 'button';
            btn.className = 'pg-btn';
            btn.disabled  = disabled;
            btn.setAttribute('aria-label', dir === 'prev' ? 'Previous page' : 'Next page');
            btn.innerHTML = dir === 'prev'
                ? `<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>`
                : `<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>`;
            btn.addEventListener('click', () => {
                currentPage += dir === 'prev' ? -1 : 1;
                render();
            });
            return btn;
        }

        /* ── Bind events ───────────────────────────── */
        searchInput.addEventListener('input',  applyFilterSort);
        sortSelect.addEventListener('change',  applyFilterSort);

        // Initial render
        applyFilterSort();
    })();
    </script>
{% endblock %}
