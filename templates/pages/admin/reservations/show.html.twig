{% extends 'layouts/admin.html.twig' %}

{% block title %}Reservation Details - Admin - SkillORA{% endblock %}

{% block admin_content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">Reservation #{{ reservation.id }}</h1>
        <p class="text-body-md text-navy-600 dark:text-navy-400">Reservation details and linked event.</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="{{ path('admin_reservations_edit', {id: reservation.id}) }}" class="btn-secondary btn-sm">Edit</a>
        <form method="post" action="{{ path('admin_reservations_delete', {id: reservation.id}) }}" onsubmit="return confirmDelete('Delete this reservation?');">
            <button type="submit" class="btn-danger btn-sm">Delete</button>
        </form>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card p-6 space-y-3">
        <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">Reservation Details</h2>
        <div class="text-body-sm text-navy-600 dark:text-navy-300">
            <p><strong>Name:</strong> {{ reservation.prenom }} {{ reservation.nom }}</p>
            <p><strong>Phone:</strong> {{ reservation.telephone }}</p>
            {% if reservation.adresse %}
                <p><strong>Address:</strong> {{ reservation.adresse }}</p>
            {% endif %}
            <p><strong>Places:</strong> {{ reservation.nombrePlaces }}</p>
            <p><strong>Date:</strong> {{ reservation.dateReservation|date('M d, Y H:i') }}</p>
            {% if reservation.userId %}
                <p><strong>User ID:</strong> {{ reservation.userId }}</p>
            {% endif %}
        </div>
    </div>

    <div class="card p-6 space-y-3">
        <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">Linked Event</h2>
        <div class="text-body-sm text-navy-600 dark:text-navy-300">
            {% if event %}
                <p><strong>Event:</strong> {{ event.title }}</p>
                <p><strong>Type:</strong> {{ event.eventType }}</p>
                <p><strong>Start:</strong> {{ event.startDate|date('M d, Y H:i') }}</p>
            {% else %}
                <p>Event not found.</p>
            {% endif %}

            {% if salle %}
                <p class="mt-3"><strong>Salle:</strong> {{ salle.name }}</p>
                <p><strong>Location:</strong> {{ salle.location }}</p>
            {% endif %}
        </div>
    </div>
</div>

<div class="mt-6">
    <a href="{{ path('admin_reservations_index') }}" class="btn-ghost btn-sm">Back to Reservations</a>
</div>
{% endblock %}
