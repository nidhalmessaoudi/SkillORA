{% extends 'layouts/admin.html.twig' %}

{% block title %}Evaluations - Admin - SkillHarbor{% endblock %}

{% block admin_content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
            Evaluations
        </h1>
        <p class="text-body-md text-navy-600 dark:text-navy-400">
            Manage all platform evaluations (quizzes & exams).
        </p>
    </div>

    <a href="{{ path('evaluation_new') }}" class="btn-primary btn-sm">
        <i data-lucide="plus" class="w-4 h-4"></i>
        New Evaluation
    </a>
</div>

<div class="card">
    <div class="p-6 border-b border-navy-100 dark:border-navy-800">
        <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
            All Evaluations ({{ evaluations|length }})
        </h2>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-navy-50 dark:bg-navy-900/50">
                <tr>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        ID
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Title
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Type
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Duration
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Total Score
                    </th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Created At
                    </th>
                    <th class="px-6 py-3 text-right text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody class="divide-y divide-navy-100 dark:divide-navy-800">
                {% for evaluation in evaluations %}
                <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        #{{ evaluation.id }}
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex flex-col">
                            <span class="text-body-sm font-medium text-navy-900 dark:text-white">
                                {{ evaluation.title }}
                            </span>
                            {% if evaluation.description %}
                                <span class="text-caption text-navy-500 truncate max-w-xs">
                                    {{ evaluation.description }}
                                </span>
                            {% endif %}
                        </div>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-body-sm">
                        <span class="badge 
                            {{ evaluation.type == 'EXAM' 
                                ? 'bg-danger-100 text-danger-700' 
                                : 'bg-harbor-100 text-harbor-700' }}">
                            {{ evaluation.type }}
                        </span>
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {{ evaluation.duration }} min
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {{ evaluation.totalScore }}
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {{ evaluation.createdAt|date('M d, Y H:i') }}
                    </td>

                    <td class="px-6 py-4 whitespace-nowrap text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('evaluation_show', {id: evaluation.id}) }}"
                               class="btn-sm bg-navy-100 text-navy-700 hover:bg-navy-200">
                                View
                            </a>

                            <a href="{{ path('evaluation_edit', {id: evaluation.id}) }}"
                               class="btn-sm bg-harbor-100 text-harbor-700 hover:bg-harbor-200">
                                Edit
                            </a>

                            <form method="post"
                                  action="{{ path('evaluation_delete', {id: evaluation.id}) }}"
                                  onsubmit="return confirm('Delete this evaluation?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evaluation.id) }}">
                                <button type="submit"
                                        class="btn-sm bg-danger-100 text-danger-600 hover:bg-danger-200">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="px-6 py-12 text-center">
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i data-lucide="clipboard-list" class="w-full h-full"></i>
                            </div>
                            <p class="text-navy-500">No evaluations found</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
