{% extends 'layouts/admin.html.twig' %}

{% block title %}Events - Admin - SkillHarbor{% endblock %}

{% block admin_content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">Events</h1>
        <p class="text-body-md text-navy-600 dark:text-navy-400">Manage all platform events and their salles.</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="{{ path('admin_events_export') }}" class="btn-secondary btn-sm">
            <i data-lucide="download" class="w-4 h-4"></i>
            Export Excel
        </a>
        <a href="{{ path('admin_events_new') }}" class="btn-primary btn-sm">
            <i data-lucide="plus" class="w-4 h-4"></i>
            New Event
        </a>
    </div>
</div>

<div class="card">
    <div class="p-6 border-b border-navy-100 dark:border-navy-800">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div>
                <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
                    All Events ({{ events|length }})
                </h2>
                <p class="text-body-sm text-navy-500">Search by title and sort by price type.</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="min-w-[220px]">
                    <label class="block text-caption text-navy-500 mb-1" for="event-search">Search</label>
                    <input
                        id="event-search"
                        type="search"
                        placeholder="Search by event title"
                        autocomplete="off"
                        class="w-full px-3 py-2 rounded-lg border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-navy-900 dark:text-white text-body-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div class="min-w-[180px]">
                    <label class="block text-caption text-navy-500 mb-1" for="event-sort">Sort by</label>
                    <select
                        id="event-sort"
                        class="w-full px-3 py-2 rounded-lg border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-navy-900 dark:text-white text-body-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="price-asc" selected>Price Type (A-Z)</option>
                        <option value="price-desc">Price Type (Z-A)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-navy-50 dark:bg-navy-900/50">
                <tr>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Title</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Dates</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Type</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Price</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Salle</th>
                    <th class="px-6 py-3 text-right text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-navy-100 dark:divide-navy-800" data-event-rows>
                {% for event in events %}
                <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors" data-event-row data-title="{{ event.title|lower }}" data-price="{{ event.priceType|lower }}">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            {% if event.image %}
                                {% if event.image matches '/\.(mp4|webm|ogg)$/i' %}
                                    <video class="w-[100px] h-12 rounded-lg border border-navy-200 object-cover" src="{{ event.image }}"></video>
                                {% else %}
                                    <img class="w-[100px] h-12 rounded-lg border border-navy-200 object-cover" src="{{ event.image }}" alt="{{ event.title }}">
                                {% endif %}
                            {% endif %}
                            <span class="text-body-sm text-navy-900 dark:text-white">{{ event.title }}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {{ event.startDate|date('M d, Y H:i') }}<br>
                        <span class="text-navy-400">to {{ event.endDate|date('M d, Y H:i') }}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">{{ event.eventType }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">{{ event.priceType }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
                        {% set salle = salle_map[event.salleId]|default(null) %}
                        {{ salle ? salle.name : 'Unassigned' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_events_show', {id: event.id}) }}" class="btn-sm bg-navy-100 text-navy-700 hover:bg-navy-200">View</a>
                            <a href="{{ path('admin_events_edit', {id: event.id}) }}" class="btn-sm bg-harbor-100 text-harbor-700 hover:bg-harbor-200">Edit</a>
                            <form method="post" action="{{ path('admin_events_delete', {id: event.id}) }}" onsubmit="return confirmDelete('Delete this event?');">
                                <button type="submit" class="btn-sm bg-danger-100 text-danger-600 hover:bg-danger-200">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="px-6 py-12 text-center">
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i data-lucide="calendar" class="w-full h-full"></i>
                            </div>
                            <p class="text-navy-500">No events found</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div id="event-empty" class="hidden px-6 py-10 text-center text-navy-500">No matching events.</div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function() {
            const searchInput = document.getElementById('event-search');
            const sortSelect = document.getElementById('event-sort');
            const tbody = document.querySelector('[data-event-rows]');
            const emptyState = document.getElementById('event-empty');

            if (!searchInput || !sortSelect || !tbody) {
                return;
            }

            const rows = Array.from(tbody.querySelectorAll('[data-event-row]'));

            const normalize = (value) => (value || '').toLowerCase().trim();

            const applyFilterSort = () => {
                const query = normalize(searchInput.value);

                rows.forEach((row) => {
                    const title = normalize(row.getAttribute('data-title'));
                    const matches = !query || title.includes(query);
                    row.classList.toggle('hidden', !matches);
                });

                const visibleRows = rows.filter((row) => !row.classList.contains('hidden'));
                const sortMode = sortSelect.value;

                visibleRows.sort((a, b) => {
                    const aPrice = normalize(a.getAttribute('data-price'));
                    const bPrice = normalize(b.getAttribute('data-price'));
                    return sortMode === 'price-desc'
                        ? bPrice.localeCompare(aPrice)
                        : aPrice.localeCompare(bPrice);
                });

                visibleRows.forEach((row) => tbody.appendChild(row));
                if (emptyState) {
                    emptyState.classList.toggle('hidden', visibleRows.length > 0);
                }
            };

            searchInput.addEventListener('input', applyFilterSort);
            sortSelect.addEventListener('change', applyFilterSort);
            applyFilterSort();
        })();
    </script>
{% endblock %}
