{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit Course - Admin{% endblock %}

{% block admin_content %}
<div class="mb-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
        Edit Course
      </h1>
      <p class="text-body-md text-navy-600 dark:text-navy-400">
        {{ course.title }}
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a href="{{ path('admin_courses_show', {courseId: course.id}) }}" class="btn-secondary btn-sm">
        Manage sections
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </a>
      <a href="{{ path('admin_courses_index') }}" class="btn-secondary btn-sm">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Back
      </a>
    </div>
  </div>
</div>

<div class="card">
  <div class="p-6 border-b border-navy-100 dark:border-navy-800">
    <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
      Course details
    </h2>
    <p class="text-body-sm text-navy-500 mt-1">Update metadata for the catalog.</p>
  </div>

  <div class="p-6">
    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

      {% if not form.vars.valid %}
        <div class="mb-6 rounded-2xl border border-red-200 dark:border-red-900/40 bg-red-50 dark:bg-red-900/10 p-4">
          <div class="flex items-center gap-3">
            <div class="mt-0.5 w-9 h-9 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
              <i data-lucide="alert-triangle" class="w-5 h-5 text-red-600 dark:text-red-300"></i>
            </div>
            <div class="min-w-0">
              <p class="font-medium text-red-700 dark:text-red-300">Please fix the errors below.</p>
            </div>
          </div>
        </div>
      {% endif %}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          {{ form_row(form.title) }}
        </div>
        <div>
          {{ form_row(form.category) }}
        </div>
        <div>
          {{ form_row(form.status) }}
        </div>
        <div class="md:col-span-2">
          {{ form_row(form.thumbnail) }}
        </div>
        <div class="md:col-span-2">
          {{ form_row(form.description) }}
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3">
        <a href="{{ path('admin_courses_index') }}" class="btn-secondary btn-sm">Cancel</a>
        <button class="btn-primary btn-sm">
          <i data-lucide="save" class="w-4 h-4"></i>
          Update
        </button>
      </div>
    {{ form_end(form) }}
  </div>
</div>

<div class="card mt-6 border border-red-200 dark:border-red-900/40">
  <div class="p-6 border-b border-red-200 dark:border-red-900/40">
    <h2 class="text-heading-lg font-display font-semibold text-red-700 dark:text-red-300">
      Danger zone
    </h2>
    <p class="text-body-sm text-navy-500 mt-1">
      Deleting this course will remove its sections and lessons too.
    </p>
  </div>

  <div class="p-6 flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="font-medium text-navy-900 dark:text-white">Delete course</p>
      <p class="text-body-sm text-navy-500">This action can’t be undone.</p>
    </div>

    <form method="post"
          action="{{ path('admin_courses_delete', {courseId: course.id}) }}"
          onsubmit="return confirm('Delete this course? This will remove sections and lessons too.');">
      <input type="hidden" name="_token" value="{{ csrf_token('delete_course_' ~ course.id) }}">
      <button class="btn-danger btn-sm">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
        Delete
      </button>
    </form>
  </div>
</div>
{% endblock %}
