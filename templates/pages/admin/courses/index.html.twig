{% extends 'layouts/admin.html.twig' %}

{% block title %}Courses - Admin{% endblock %}

{% block admin_content %}
<div class="mb-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
        Courses
      </h1>
      <p class="text-body-md text-navy-600 dark:text-navy-400">
        Create and manage courses (basic info only for now).
      </p>
    </div>

    <a href="{{ path('admin_courses_new') }}" class="btn-primary btn-sm">
      <i data-lucide="plus" class="w-4 h-4"></i>
      Add course
    </a>
  </div>
</div>

<div class="card">
  <div class="p-6 border-b border-navy-100 dark:border-navy-800">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
          All Courses
        </h2>
        <p class="text-body-sm text-navy-500 mt-1">
          Click a course to manage its sections and lessons.
        </p>
      </div>
    </div>
  </div>

  <div class="overflow-x-hidden">
    <table class="w-full table-fixed">
      <colgroup>
        <col class="w-auto">
        <col class="w-48">
        <col class="w-40">
        <col class="w-44">
        <col class="w-56">
      </colgroup>

      <thead class="bg-navy-50 dark:bg-navy-900/50">
        <tr>
          <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Course
          </th>
          <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Category
          </th>
          <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Status
          </th>
          <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Created
          </th>
          <th class="px-6 py-3 text-right text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Actions
          </th>
        </tr>
      </thead>

      <tbody class="divide-y divide-navy-100 dark:divide-navy-800">
        {% for course in courses %}
          <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors align-top">
            <td class="px-6 py-4">
              <div class="flex items-start gap-3">
                <div class="avatar avatar-md bg-harbor-100 dark:bg-harbor-900/30 text-harbor-600 dark:text-harbor-400 flex-shrink-0">
                  {{ course.title|slice(0, 1)|upper }}
                </div>

                <div class="min-w-0">
                  <a href="{{ path('admin_courses_show', {courseId: course.id}) }}"
                     class="font-medium text-navy-900 dark:text-white hover:underline break-words">
                    {{ course.title }}
                  </a>

                </div>
              </div>
            </td>

            <td class="px-6 py-4 text-body-sm text-navy-600 dark:text-navy-300 break-words">
              {{ course.category }}
            </td>

            <td class="px-6 py-4">
              {% set s = course.status|default('draft') %}
              {% if s == 'published' %}
                <span class="badge-success">
                  <i data-lucide="check-circle" class="w-3 h-3"></i>
                  Published
                </span>
              {% elseif s == 'archived' %}
                <span class="badge-danger">
                  <i data-lucide="archive" class="w-3 h-3"></i>
                  Archived
                </span>
              {% else %}
                <span class="badge-secondary">
                  <i data-lucide="edit-3" class="w-3 h-3"></i>
                  Draft
                </span>
              {% endif %}
            </td>

            <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-500 dark:text-navy-400">
              {{ course.createdAt ? course.createdAt|date('M d, Y') : '-' }}
            </td>

            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center justify-end gap-2">
                <a href="{{ path('admin_courses_show', {courseId: course.id}) }}" class="btn-secondary btn-sm">
                  Manage
                  <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>

                <a href="{{ path('admin_courses_edit', {courseId: course.id}) }}"
                   class="btn-secondary btn-sm">
                  <i data-lucide="pencil" class="w-4 h-4"></i>
                </a>

                <form method="post"
                      action="{{ path('admin_courses_delete', {courseId: course.id}) }}"
                      class="inline-flex"
                      onsubmit="return confirm('Delete this course? This will remove sections and lessons too.');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_course_' ~ course.id) }}">
                  <button type="submit"
                          class="btn-secondary btn-sm hover:bg-danger-50 hover:text-danger-600 dark:hover:bg-danger-900/20 dark:hover:text-danger-400">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="px-6 py-12 text-center">
              <div class="empty-state-icon mx-auto">
                <i data-lucide="book-open" class="w-full h-full"></i>
              </div>
              <p class="text-navy-500">No courses found</p>
              <div class="mt-4">
                <a href="{{ path('admin_courses_new') }}" class="btn-primary btn-sm">
                  <i data-lucide="plus" class="w-4 h-4"></i>
                  Create your first course
                </a>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
