{% extends 'layouts/admin.html.twig' %}

{% block title %}Add Course - Admin{% endblock %}

{% block admin_content %}
<div class="mb-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
        Add Course
      </h1>
      <p class="text-body-md text-navy-600 dark:text-navy-400">
        Create a new course. You can add sections and lessons after.
      </p>
    </div>

    <a href="{{ path('admin_courses_index') }}" class="btn-secondary btn-sm">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      Back
    </a>
  </div>
</div>

<div class="card">
  <div class="p-6 border-b border-navy-100 dark:border-navy-800">
    <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
      Course details
    </h2>
    <p class="text-body-sm text-navy-500 mt-1">Basic metadata for the catalog.</p>
  </div>

  <div class="p-6">
    {{ form_start(form) }}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          {{ form_row(form.title) }}
        </div>
        <div>
          {{ form_row(form.category) }}
        </div>
        <div>
          {{ form_row(form.status) }}
        </div>
        <div class="md:col-span-2">
          {{ form_row(form.thumbnail) }}
        </div>
        <div class="md:col-span-2">
          {{ form_row(form.description) }}
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3">
        <a href="{{ path('admin_courses_index') }}" class="btn-secondary btn-sm">Cancel</a>
        <button class="btn-primary btn-sm">
          <i data-lucide="save" class="w-4 h-4"></i>
          Save
        </button>
      </div>
    {{ form_end(form) }}
  </div>
</div>
{% endblock %}
