{% extends 'layouts/admin.html.twig' %}

{% block title %}Manage Exam{% endblock %}

{% block admin_content %}
<div class="space-y-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white">Manage Exam</h1>
      <p class="text-body-sm text-navy-500 dark:text-navy-400 mt-1">Evaluation: <span class="font-semibold text-navy-800 dark:text-navy-200">{{ evaluation.title }}</span></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <a href="{{ path('admin_exam_submissions_by_exam', { evaluationId: evaluation.id }) }}" class="btn-secondary btn-sm">Submissions</a>
      <a href="{{ path('admin_plagiarism_dashboard', { id: evaluation.id }) }}" class="btn-secondary btn-sm">Plagiarism</a>
      <a href="{{ path('evaluation_index', { type: evaluation.type }) }}" class="btn-secondary btn-sm">Back to evaluations</a>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="card p-4">
      <p class="text-caption uppercase tracking-wide text-navy-500">Question Count</p>
      <p class="mt-2 text-2xl font-display font-bold text-navy-900 dark:text-white">{{ questions|length }}</p>
    </div>
    <div class="card p-4">
      <p class="text-caption uppercase tracking-wide text-navy-500">PDF Status</p>
      <p class="mt-2 text-sm font-semibold {{ evaluation.pdfPath ? 'text-success-600' : 'text-navy-500' }}">{{ evaluation.pdfPath ? 'Available' : 'Missing' }}</p>
    </div>
    <div class="card p-4">
      <p class="text-caption uppercase tracking-wide text-navy-500">Word Status</p>
      <p class="mt-2 text-sm font-semibold {{ evaluation.docxPath ? 'text-success-600' : 'text-navy-500' }}">{{ evaluation.docxPath ? 'Available' : 'Missing' }}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <section class="card p-5 lg:p-6 space-y-5">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-display font-semibold text-navy-900 dark:text-white">Document Workspace</h2>
        <div class="flex items-center gap-2">
          {% if evaluation.docxPath %}
            <form
              method="post"
              action="{{ path('admin_exam_delete_docx', { id: evaluation.id }) }}"
              onsubmit="return confirm('Delete Word file?');"
            >
              <input type="hidden" name="_token" value="{{ csrf_token('delete_exam_docx_' ~ evaluation.id) }}">
              <button type="submit" class="btn-sm text-danger-600 hover:text-danger-700">Delete Word</button>
            </form>
          {% endif %}

          {% if evaluation.pdfPath %}
            <form
              method="post"
              action="{{ path('admin_exam_delete_pdf', { id: evaluation.id }) }}"
              onsubmit="return confirm('Delete PDF file?');"
            >
              <input type="hidden" name="_token" value="{{ csrf_token('delete_exam_pdf_' ~ evaluation.id) }}">
              <button type="submit" class="btn-sm text-danger-600 hover:text-danger-700">Delete PDF</button>
            </form>
          {% endif %}
        </div>
      </div>

      <form
        method="post"
        action="{{ path('admin_exam_import_docx', { id: evaluation.id }) }}"
        enctype="multipart/form-data"
        class="rounded-xl border border-dashed border-navy-300 dark:border-navy-700 p-4 bg-navy-50/40 dark:bg-navy-900/40"
      >
        <input type="hidden" name="_token" value="{{ csrf_token('import_exam_docx_' ~ evaluation.id) }}">
        <label class="block text-sm font-medium text-navy-700 dark:text-navy-200 mb-3">Import Word document (.docx)</label>
        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
          <input type="file" name="docx" accept=".docx" class="block w-full text-sm" required>
          <button class="btn-primary btn-sm whitespace-nowrap" type="submit">Import and Convert</button>
        </div>
      </form>

      <div class="rounded-xl border border-navy-200 dark:border-navy-800 overflow-hidden bg-white dark:bg-navy-900">
        {% if evaluation.pdfPath %}
          <div class="h-[65vh] min-h-[420px]">
            <iframe src="{{ asset(evaluation.pdfPath) ~ '?v=' ~ date().timestamp }}" class="w-full h-full" title="Exam PDF preview"></iframe>
          </div>
        {% else %}
          <div class="p-8 text-center text-sm text-navy-500">No PDF generated yet. Import a Word file to generate the latest preview.</div>
        {% endif %}
      </div>

      <div class="space-y-1 text-xs text-navy-500 dark:text-navy-400">
        <p>PDF: {{ evaluation.pdfPath ?: 'Not available' }}</p>
        <p>Word: {{ evaluation.docxPath ?: 'Not available' }}</p>
      </div>
    </section>

    <section class="card p-5 lg:p-6 space-y-4">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-display font-semibold text-navy-900 dark:text-white">Exam Questions <span class="text-sm text-navy-500">({{ questions|length }})</span></h2>

        <a
          href="{{ path('admin_question_new', {
            evaluationId: evaluation.id,
            back: path('admin_exam_manage', { id: evaluation.id })
          }) }}"
          class="btn-primary btn-sm"
        >
          Add Question
        </a>
      </div>

      <div class="space-y-3 max-h-[78vh] overflow-y-auto pr-1">
        {% for q in questions %}
          <article class="rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-900/50 p-4">
            <div class="flex items-start justify-between gap-4">
              <p class="text-sm text-navy-800 dark:text-navy-100 whitespace-pre-line">{{ q.content }}</p>
              <span class="badge badge-primary whitespace-nowrap">{{ q.score }} pts</span>
            </div>

            <div class="mt-2 text-xs text-navy-500">Type: {{ q.type }}</div>

            <div class="mt-3 flex items-center justify-end gap-2">
              <a
                class="btn-secondary btn-sm"
                href="{{ path('admin_question_edit', {
                  id: q.id,
                  evaluationId: evaluation.id,
                  back: path('admin_exam_manage', { id: evaluation.id })
                }) }}"
              >
                Edit
              </a>

              <form
                method="post"
                action="{{ path('admin_question_delete', {
                  id: q.id,
                  back: path('admin_exam_manage', { id: evaluation.id })
                }) }}"
                onsubmit="return confirm('Delete this question?');"
              >
                <input type="hidden" name="_token" value="{{ csrf_token('delete_question_' ~ q.id) }}">
                <button class="btn-sm text-danger-600 hover:text-danger-700" type="submit">Delete</button>
              </form>
            </div>
          </article>
        {% else %}
          <div class="rounded-xl border border-dashed border-navy-300 dark:border-navy-700 p-8 text-center text-sm text-navy-500">
            No questions yet for this exam.
          </div>
        {% endfor %}
      </div>
    </section>
  </div>
</div>
{% endblock %}
