{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Edit Exam Question' : 'New Exam Question' }}{% endblock %}

{% block admin_content %}
<h1 class="text-2xl font-bold mb-6 text-black">
    {{ mode == 'edit' ? 'Edit Exam Question' : 'Add Exam Question' }}
</h1>

<div class="card p-6 max-w-3xl">
    {{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.content) }}
    {{ form_row(form.score) }}

    <div class="mt-6 flex gap-3">
        <button class="btn-primary">{{ mode == 'edit' ? 'Update' : 'Save' }}</button>
        <a href="{{ path('admin_exam_manage', { id: exam.evaluation.id }) }}" class="btn-secondary">Cancel</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
