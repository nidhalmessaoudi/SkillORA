{% extends 'layouts/admin.html.twig' %}

{% block admin_content %}
<h1 class="text-2xl font-bold mb-2">Copie EXAM</h1>

<p><b>Examen :</b> {{ evaluation.title }}</p>
<p><b>Étudiant :</b> {{ ue.user.email }}</p>
<p><b>Soumis le :</b> {{ ue.submittedAt ? ue.submittedAt|date('d/m/Y H:i') : '-' }}</p>

{% if evaluation.pdfPath %}
  <div class="my-4 border rounded overflow-hidden" style="height: 70vh;">
    <iframe src="{{ asset(evaluation.pdfPath) ~ '?v=' ~ date().timestamp }}"
            class="w-full h-full"></iframe>
  </div>
{% else %}
  <div class="text-gray-500">Aucun PDF.</div>
{% endif %}

<div class="border rounded p-4 mt-4">
  <h2 class="font-semibold mb-2">Réponse de l’étudiant</h2>
  <textarea class="w-full border p-3" rows="12" readonly>{{ examAnswer ? examAnswer.content : '' }}</textarea>
</div>

<div class="border rounded p-4 mt-4">
  <h2 class="font-semibold mb-2">Correction</h2>

  {% if ue.isCorrected %}
    <p><b>Note :</b> {{ ue.score }} / {{ evaluation.totalScore }}</p>

    {% if ue.aiFeedback %}
      <div class="mt-2 text-sm whitespace-pre-line">
        <b>Feedback IA :</b><br>
        {{ ue.aiFeedback }}
      </div>
    {% endif %}
  {% else %}
    <form method="post" action="{{ path('admin_exam_ai_correct', {id: ue.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('ai_correct_' ~ ue.id) }}">
      <button class="px-4 py-2 rounded bg-black text-white">
        Corriger IA (Mistral)
      </button>
    </form>
  {% endif %}
</div>

<a href="{{ path('admin_exam_submissions') }}" class="inline-block mt-4 px-4 py-2 rounded bg-gray-200">
  Retour
</a>
{% endblock %}