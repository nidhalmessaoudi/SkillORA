<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkillHarbor Statistics Report</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 3px solid #268bff;
        }
        
        .header h1 {
            color: #268bff;
            font-size: 32px;
            margin-bottom: 10px;
        }
        
        .header .subtitle {
            color: #666;
            font-size: 16px;
        }
        
        .meta-info {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .meta-info .date {
            font-weight: 600;
            color: #268bff;
        }
        
        .section {
            margin-bottom: 40px;
        }
        
        .section-title {
            font-size: 24px;
            color: #1a2332;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #e5e7eb;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: linear-gradient(135deg, #268bff 0%, #0070f3 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(38, 139, 255, 0.2);
        }
        
        .stat-card.success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        
        .stat-card.warning {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }
        
        .stat-card.danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        }
        
        .stat-card .value {
            font-size: 36px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .stat-card .label {
            font-size: 14px;
            opacity: 0.9;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: white;
        }
        
        table thead {
            background: #268bff;
            color: white;
        }
        
        table th,
        table td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }
        
        table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
        }
        
        table tbody tr:hover {
            background: #f8f9fa;
        }
        
        table tbody tr:nth-child(even) {
            background: #f9fafb;
        }
        
        .badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }
        
        .badge-success {
            background: #d1fae5;
            color: #065f46;
        }
        
        .badge-danger {
            background: #fee2e2;
            color: #991b1b;
        }
        
        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 2px solid #e5e7eb;
            text-align: center;
            color: #666;
            font-size: 14px;
        }
        
        .chart-placeholder {
            background: #f8f9fa;
            border: 2px dashed #cbd5e1;
            border-radius: 8px;
            padding: 40px;
            text-align: center;
            color: #64748b;
            margin: 20px 0;
        }
        
        .growth-table {
            max-height: 400px;
            overflow-y: auto;
        }
        
        @media print {
            body {
                padding: 20px;
            }
            
            .section {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    {# Header #}
    <div class="header">
        <h1>📊 SkillHarbor Platform Statistics</h1>
        <p class="subtitle">Comprehensive Analytics & User Insights Report</p>
    </div>

    {# Meta Information #}
    <div class="meta-info">
        <div>
            <strong>Report Type:</strong> Platform Statistics
        </div>
        <div class="date">
            Generated: {{ generated_at|date('F d, Y \\a\\t H:i:s') }}
        </div>
    </div>

    {# Overall Statistics #}
    <div class="section">
        <h2 class="section-title">📈 Overall Statistics</h2>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="value">{{ stats.total|number_format }}</div>
                <div class="label">Total Users</div>
            </div>
            <div class="stat-card success">
                <div class="value">{{ stats.active|number_format }}</div>
                <div class="label">Active Users</div>
            </div>
            <div class="stat-card warning">
                <div class="value">{{ stats.new_this_week|number_format }}</div>
                <div class="label">New This Week</div>
            </div>
            <div class="stat-card danger">
                <div class="value">{{ stats.banned|number_format }}</div>
                <div class="label">Banned Users</div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Key Metric</th>
                    <th>Value</th>
                    <th>Percentage</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Activity Rate</td>
                    <td>{{ stats.active|number_format }} / {{ stats.total|number_format }}</td>
                    <td><strong>{{ ((stats.active / stats.total) * 100)|number_format(2) }}%</strong></td>
                </tr>
                <tr>
                    <td>Ban Rate</td>
                    <td>{{ stats.banned|number_format }} / {{ stats.total|number_format }}</td>
                    <td><strong>{{ ((stats.banned / stats.total) * 100)|number_format(2) }}%</strong></td>
                </tr>
                <tr>
                    <td>Weekly Growth</td>
                    <td>{{ stats.new_this_week|number_format }} new users</td>
                    <td><strong>{{ ((stats.new_this_week / stats.total) * 100)|number_format(2) }}%</strong></td>
                </tr>
            </tbody>
        </table>
    </div>

    {# User Growth #}
    <div class="section">
        <h2 class="section-title">📊 User Growth - Last 30 Days</h2>
        <div class="growth-table">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>New Users</th>
                        <th>Cumulative</th>
                    </tr>
                </thead>
                <tbody>
                    {% set cumulative = 0 %}
                    {% for day in user_growth %}
                        {% set cumulative = cumulative + day.count %}
                        <tr>
                            <td>{{ day.formatted_date }}</td>
                            <td><strong>{{ day.count }}</strong></td>
                            <td>{{ cumulative }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p style="margin-top: 15px; color: #666; font-size: 14px;">
            <strong>Total new users in last 30 days:</strong> {{ cumulative }}
        </p>
    </div>

    {# User List Summary #}
    <div class="section">
        <h2 class="section-title">👥 User List Summary (Latest 20 Users)</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined Date</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users|slice(0, 20) %}
                <tr>
                    <td>#{{ user.id }}</td>
                    <td>{{ user.fullName }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% if user.role == 'admin' %}
                            <strong style="color: #268bff;">Admin</strong>
                        {% elseif user.role == 'professor' %}
                            <strong style="color: #8b5cf6;">Professor</strong>
                        {% else %}
                            Student
                        {% endif %}
                    </td>
                    <td>
                        {% if user.isBanned %}
                            <span class="badge badge-danger">Banned</span>
                        {% else %}
                            <span class="badge badge-success">Active</span>
                        {% endif %}
                    </td>
                    <td>{{ user.createdAt|date('M d, Y') }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <p style="margin-top: 15px; color: #666; font-size: 14px;">
            <em>Note: Showing latest 20 users. Full user list available in CSV export.</em>
        </p>
    </div>

    {# Footer #}
    <div class="footer">
        <p><strong>SkillHarbor</strong> - Premium Online Learning Platform</p>
        <p>This report is confidential and intended for internal use only.</p>
        <p style="margin-top: 10px; font-size: 12px; color: #999;">
            Report generated automatically by SkillHarbor Admin Panel
        </p>
    </div>

    {# Print Button #}
    <div style="text-align: center; margin-top: 30px; page-break-after: avoid;">
        <button onclick="window.print()" style="background: #268bff; color: white; border: none; padding: 12px 30px; border-radius: 8px; font-size: 16px; cursor: pointer; font-weight: 600;">
            🖨️ Print Report
        </button>
        <button onclick="window.close()" style="background: #6b7280; color: white; border: none; padding: 12px 30px; border-radius: 8px; font-size: 16px; cursor: pointer; font-weight: 600; margin-left: 10px;">
            Close
        </button>
    </div>
</body>
</html>
