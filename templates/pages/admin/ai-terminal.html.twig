{% extends 'layouts/admin.html.twig' %}

{% block title %}AI Terminal - Admin Dashboard{% endblock %}

{% block head %}
<style>
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
    
    @keyframes shimmer {
        0% { background-position: -1000px 0; }
        100% { background-position: 1000px 0; }
    }
    
    .chat-message {
        animation: slideUp 0.3s ease-out;
    }
    
    .modal-backdrop {
        animation: fadeIn 0.3s ease-out;
    }
    
    .modal-content {
        animation: slideUp 0.4s ease-out;
    }
    
    .typing-dot {
        animation: pulse 1.4s ease-in-out infinite;
    }
    
    .typing-dot:nth-child(2) {
        animation-delay: 0.2s;
    }
    
    .typing-dot:nth-child(3) {
        animation-delay: 0.4s;
    }
    
    .gradient-border {
        position: relative;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 2px;
        border-radius: 16px;
    }
    
    .gradient-border-inner {
        background: white;
        border-radius: 14px;
    }
    
    .message-user {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    
    .message-ai {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
    }
    
    .shimmer-bg {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 1000px 100%;
        animation: shimmer 2s infinite;
    }
    
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(103, 126, 234, 0.3);
        border-radius: 10px;
    }
    
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(103, 126, 234, 0.5);
    }
</style>
{% endblock %}

{% block admin_content %}
<div class="min-h-screen bg-gradient-to-br from-navy-50 via-purple-50 to-pink-50 dark:from-navy-950 dark:via-purple-950 dark:to-pink-950 p-6">
    <div class="max-w-7xl mx-auto">
        {# Header #}
        <div class="mb-8">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-4xl font-display font-bold bg-gradient-to-r from-purple-600 via-pink-600 to-purple-600 bg-clip-text text-transparent mb-2">
                        Admin Assistant
                    </h1>
                    <p class="text-navy-600 dark:text-navy-400 flex items-center gap-2">
                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                        Powered by Advanced Intelligence
                    </p>
                </div>
                <button id="open-chat-btn" class="group px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white rounded-2xl font-semibold shadow-lg hover:shadow-xl transition-all flex items-center gap-2">
                    <i data-lucide="message-circle" class="w-5 h-5 group-hover:scale-110 transition-transform"></i>
                    Start Conversation
                </button>
            </div>
        </div>

        {# Feature Cards #}
        <div class="grid md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all border border-navy-100 dark:border-navy-800">
                <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mb-4">
                    <i data-lucide="users" class="w-6 h-6 text-white"></i>
                </div>
                <h3 class="font-semibold text-lg text-navy-900 dark:text-white mb-2">User Management</h3>
                <p class="text-navy-600 dark:text-navy-400 text-sm">Create, update, delete, ban or unban users with simple commands</p>
            </div>
            
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all border border-navy-100 dark:border-navy-800">
                <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center mb-4">
                    <i data-lucide="bar-chart-3" class="w-6 h-6 text-white"></i>
                </div>
                <h3 class="font-semibold text-lg text-navy-900 dark:text-white mb-2">Analytics</h3>
                <p class="text-navy-600 dark:text-navy-400 text-sm">Get instant platform statistics and user insights</p>
            </div>
            
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all border border-navy-100 dark:border-navy-800">
                <div class="w-12 h-12 bg-gradient-to-br from-pink-500 to-pink-600 rounded-xl flex items-center justify-center mb-4">
                    <i data-lucide="zap" class="w-6 h-6 text-white"></i>
                </div>
                <h3 class="font-semibold text-lg text-navy-900 dark:text-white mb-2">Quick Actions</h3>
                <p class="text-navy-600 dark:text-navy-400 text-sm">Execute commands instantly using natural language</p>
            </div>
        </div>

        {# Example Commands #}
        <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 shadow-lg border border-navy-100 dark:border-navy-800">
            <h3 class="font-semibold text-lg text-navy-900 dark:text-white mb-4 flex items-center gap-2">
                <i data-lucide="lightbulb" class="w-5 h-5 text-purple-600"></i>
                Example Commands
            </h3>
            <div class="grid md:grid-cols-2 gap-3">
                <div class="flex items-start gap-3 p-3 bg-purple-50 dark:bg-purple-950/30 rounded-xl">
                    <i data-lucide="check-circle" class="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-navy-900 dark:text-white text-sm">"List all users"</p>
                        <p class="text-navy-600 dark:text-navy-400 text-xs mt-1">View recent users in the system</p>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3 bg-pink-50 dark:bg-pink-950/30 rounded-xl">
                    <i data-lucide="check-circle" class="w-5 h-5 text-pink-600 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-navy-900 dark:text-white text-sm">"Create a user named John"</p>
                        <p class="text-navy-600 dark:text-navy-400 text-xs mt-1">Add new users quickly</p>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3 bg-blue-50 dark:bg-blue-950/30 rounded-xl">
                    <i data-lucide="check-circle" class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-navy-900 dark:text-white text-sm">"Show platform statistics"</p>
                        <p class="text-navy-600 dark:text-navy-400 text-xs mt-1">Get real-time analytics</p>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3 bg-purple-50 dark:bg-purple-950/30 rounded-xl">
                    <i data-lucide="check-circle" class="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-navy-900 dark:text-white text-sm">"Ban user test@example.com"</p>
                        <p class="text-navy-600 dark:text-navy-400 text-xs mt-1">Manage user access</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Chat Modal #}
<div id="chat-modal" class="modal-backdrop hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="modal-content bg-white dark:bg-navy-900 rounded-3xl shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col overflow-hidden border border-navy-100 dark:border-navy-800">
        {# Modal Header #}
        <div class="flex items-center justify-between p-6 border-b border-navy-100 dark:border-navy-800 bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-950/30 dark:to-pink-950/30">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gradient-to-br from-purple-600 to-pink-600 rounded-2xl flex items-center justify-center shadow-lg">
                    <i data-lucide="bot" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-lg text-navy-900 dark:text-white">Admin Assistant</h3>
                    <p class="text-sm text-navy-600 dark:text-navy-400 flex items-center gap-1">
                        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                        Online
                    </p>
                </div>
            </div>
            <button id="close-chat-btn" class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors text-navy-600 dark:text-navy-400">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        {# Chat Messages #}
        <div id="chat-messages" class="flex-1 overflow-y-auto p-6 space-y-4 custom-scrollbar">
            {# Welcome Message #}
            <div class="chat-message flex items-start gap-3">
                <div class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
                    <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
                </div>
                <div class="flex-1">
                    <div class="message-ai rounded-2xl rounded-tl-sm p-4 shadow-lg max-w-md">
                        <p class="text-sm font-medium mb-2">👋 Welcome to Admin Assistant!</p>
                        <p class="text-sm opacity-90">I can help you manage users, get statistics, and perform various admin tasks. Just type what you need in natural language!</p>
                    </div>
                    <p class="text-xs text-navy-400 mt-2 ml-1">Just now</p>
                </div>
            </div>
        </div>

        {# Chat Input #}
        <div class="p-6 border-t border-navy-100 dark:border-navy-800 bg-navy-50 dark:bg-navy-950/50">
            <form id="chat-form" class="flex gap-3">
                <div class="flex-1 relative">
                    <input 
                        type="text" 
                        id="chat-input" 
                        placeholder="Type your message here..." 
                        class="w-full px-6 py-4 bg-white dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-2xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all text-navy-900 dark:text-white placeholder-navy-400"
                        style="color: #000000 !important;"
                        autocomplete="off"
                    >
                    <div id="typing-indicator" class="absolute right-4 top-1/2 -translate-y-1/2 hidden flex gap-1">
                        <div class="typing-dot w-2 h-2 bg-purple-600 rounded-full"></div>
                        <div class="typing-dot w-2 h-2 bg-purple-600 rounded-full"></div>
                        <div class="typing-dot w-2 h-2 bg-purple-600 rounded-full"></div>
                    </div>
                </div>
                <button 
                    type="submit" 
                    id="send-btn"
                    class="px-6 py-4 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white rounded-2xl transition-all flex items-center gap-2 font-semibold shadow-lg hover:shadow-xl disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    <i data-lucide="send" class="w-5 h-5"></i>
                    <span class="hidden sm:inline">Send</span>
                </button>
            </form>
            
            {# Quick Suggestions #}
            <div class="mt-4 flex flex-wrap gap-2">
                <button class="quick-suggestion px-4 py-2 text-xs bg-white dark:bg-navy-800 hover:bg-purple-50 dark:hover:bg-navy-700 text-navy-700 dark:text-navy-300 rounded-xl transition-all border border-navy-200 dark:border-navy-700 font-medium">
                    📊 Show statistics
                </button>
                <button class="quick-suggestion px-4 py-2 text-xs bg-white dark:bg-navy-800 hover:bg-purple-50 dark:hover:bg-navy-700 text-navy-700 dark:text-navy-300 rounded-xl transition-all border border-navy-200 dark:border-navy-700 font-medium">
                    👥 List all users
                </button>
                <button class="quick-suggestion px-4 py-2 text-xs bg-white dark:bg-navy-800 hover:bg-purple-50 dark:hover:bg-navy-700 text-navy-700 dark:text-navy-300 rounded-xl transition-all border border-navy-200 dark:border-navy-700 font-medium">
                    ➕ Create new user
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }

    const chatModal = document.getElementById('chat-modal');
    const openChatBtn = document.getElementById('open-chat-btn');
    const closeChatBtn = document.getElementById('close-chat-btn');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');
    const sendBtn = document.getElementById('send-btn');
    const typingIndicator = document.getElementById('typing-indicator');
    const quickSuggestions = document.querySelectorAll('.quick-suggestion');

    // Open modal
    openChatBtn.addEventListener('click', function() {
        chatModal.classList.remove('hidden');
        chatInput.focus();
    });

    // Close modal
    closeChatBtn.addEventListener('click', function() {
        chatModal.classList.add('hidden');
    });

    // Close on backdrop click
    chatModal.addEventListener('click', function(e) {
        if (e.target === chatModal) {
            chatModal.classList.add('hidden');
        }
    });

    // Quick suggestions
    quickSuggestions.forEach(btn => {
        btn.addEventListener('click', function() {
            const text = this.textContent.trim().replace(/^[^\s]+\s/, ''); // Remove emoji
            chatInput.value = text;
            chatInput.focus();
        });
    });

    // Handle form submission
    chatForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const message = chatInput.value.trim();
        if (!message) return;

        // Clear input
        chatInput.value = '';

        // Add user message
        addMessage(message, 'user');

        // Show typing indicator
        typingIndicator.classList.remove('hidden');
        sendBtn.disabled = true;

        try {
            // Send to backend
            const response = await fetch('/admin/ai-terminal/query', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ message: message })
            });

            const data = await response.json();

            // Hide typing indicator
            typingIndicator.classList.add('hidden');
            sendBtn.disabled = false;

            if (data.success) {
                addMessage(data.response, 'ai');
            } else {
                addMessage('❌ Error: ' + (data.error || 'Something went wrong'), 'ai');
            }
        } catch (error) {
            console.error('Error:', error);
            typingIndicator.classList.add('hidden');
            sendBtn.disabled = false;
            addMessage('❌ Connection error. Please try again.', 'ai');
        }
    });

    function addMessage(text, type) {
        const messageDiv = document.createElement('div');
        messageDiv.className = 'chat-message flex items-start gap-3 ' + (type === 'user' ? 'flex-row-reverse' : '');
        
        const now = new Date();
        const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
        
        if (type === 'user') {
            messageDiv.innerHTML = `
                <div class="w-10 h-10 bg-gradient-to-br from-navy-700 to-navy-900 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
                    <i data-lucide="user" class="w-5 h-5 text-white"></i>
                </div>
                <div class="flex-1 flex flex-col items-end">
                    <div class="message-user rounded-2xl rounded-tr-sm p-4 shadow-lg max-w-md">
                        <p class="text-sm">${escapeHtml(text)}</p>
                    </div>
                    <p class="text-xs text-navy-400 mt-2 mr-1">${timeStr}</p>
                </div>
            `;
        } else {
            messageDiv.innerHTML = `
                <div class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
                    <i data-lucide="bot" class="w-5 h-5 text-white"></i>
                </div>
                <div class="flex-1">
                    <div class="message-ai rounded-2xl rounded-tl-sm p-4 shadow-lg max-w-md">
                        <div class="text-sm prose prose-sm max-w-none prose-invert">${formatMessage(text)}</div>
                    </div>
                    <p class="text-xs text-navy-400 mt-2 ml-1">${timeStr}</p>
                </div>
            `;
        }
        
        chatMessages.appendChild(messageDiv);
        
        // Re-initialize icons
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
        
        // Scroll to bottom
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatMessage(text) {
        // Convert markdown-style formatting
        text = escapeHtml(text);
        
        // Bold
        text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        
        // Line breaks
        text = text.replace(/\n/g, '<br>');
        
        // Lists
        text = text.replace(/^- (.+)$/gm, '• $1');
        
        return text;
    }
});
</script>
{% endblock %}
