{% extends 'layouts/base.html.twig' %}

{% block title %}Manage Posts - Admin | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {# Header #}
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-3xl font-display font-bold text-slate-900 dark:text-white mb-2">Community Posts Management</h1>
                <p class="text-slate-600 dark:text-slate-400">View and manage all community posts</p>
            </div>
            <a href="{{ path('admin_reports_index') }}" class="btn-primary">
                <i data-lucide="flag" class="w-4 h-4"></i>
                View Reports
                {% if reportCounts|length > 0 %}
                    <span class="badge bg-coral-400 text-white ml-2">{{ reportCounts|reduce((sum, count) => sum + count, 0) }}</span>
                {% endif %}
            </a>
        </div>

        {# Stats Cards #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="card p-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/30 rounded-xl flex items-center justify-center">
                        <i data-lucide="file-text" class="w-6 h-6 text-emerald-600 dark:text-emerald-400"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ totalPosts }}</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Total Posts</p>
                    </div>
                </div>
            </div>
            
            <div class="card p-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-coral-100 dark:bg-coral-900/30 rounded-xl flex items-center justify-center">
                        <i data-lucide="flag" class="w-6 h-6 text-coral-500"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ reportCounts|reduce((sum, count) => sum + count, 0) }}</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Pending Reports</p>
                    </div>
                </div>
            </div>

            <div class="card p-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center">
                        <i data-lucide="users" class="w-6 h-6 text-blue-600 dark:text-blue-400"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ currentPage }}</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">of {{ totalPages }} pages</p>
                    </div>
                </div>
            </div>
        </div>

        {# Posts Table #}
        <div class="card overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Post</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Author</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Date</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Replies</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Reports</th>
                            <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-navy-800">
                        {% for post in posts %}
                        <tr class="hover:bg-slate-50 dark:hover:bg-navy-900/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-start gap-3">
                                    <div class="flex-1 min-w-0">
                                        <button onclick="viewPost({{ post.id }})" class="font-semibold text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors text-left line-clamp-2">
                                            {{ post.title }}
                                        </button>
                                        <div class="flex items-center gap-2 mt-1">
                                            {% set badgeClass = post.type == 'discussion' ? 'badge-primary' : (post.type == 'article' ? 'badge-success' : 'badge-secondary') %}
                                            <span class="badge {{ badgeClass }} text-xs">{{ post.type|capitalize }}</span>
                                            {% if post.topic %}
                                                <span class="text-xs text-slate-500">{{ post.topic }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xs font-medium">
                                        {{ post.author.fullName|slice(0,1)|upper }}
                                    </div>
                                    <span class="text-sm text-slate-900 dark:text-white">{{ post.author.fullName }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-slate-600 dark:text-slate-400">{{ post.createdAt|date('M j, Y') }}</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-slate-600 dark:text-slate-400">{{ post.replies|length }}</span>
                            </td>
                            <td class="px-6 py-4">
                                {% if reportCounts[post.id] > 0 %}
                                    <span class="badge badge-danger">{{ reportCounts[post.id] }}</span>
                                {% else %}
                                    <span class="text-sm text-slate-400">-</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <button onclick="viewPost({{ post.id }})" class="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors" title="View details">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </button>
                                    <button onclick="deletePost({{ post.id }})" class="p-2 rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" title="Delete post">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">
                                No posts found
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            {% if totalPages > 1 %}
            <div class="flex items-center justify-between px-6 py-4 border-t border-slate-200 dark:border-navy-800">
                <div class="text-sm text-slate-600 dark:text-slate-400">
                    Page {{ currentPage }} of {{ totalPages }}
                </div>
                <div class="flex gap-2">
                    {% if currentPage > 1 %}
                        <a href="{{ path('admin_posts_index', {'page': currentPage - 1}) }}" class="btn-outline btn-sm">Previous</a>
                    {% endif %}
                    {% if currentPage < totalPages %}
                        <a href="{{ path('admin_posts_index', {'page': currentPage + 1}) }}" class="btn-primary btn-sm">Next</a>
                    {% endif %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

{# Post Detail Modal #}
<div id="post-modal" class="hidden fixed inset-0 z-50 bg-navy-950/50 backdrop-blur-sm flex items-center justify-center p-4" onclick="closePostModal()">
    <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-strong w-full max-w-4xl max-h-[90vh] overflow-auto" onclick="event.stopPropagation()">
        <div id="post-modal-content" class="p-8">
            {# Content loaded via AJAX #}
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-emerald-600"></div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    function viewPost(postId) {
        const modal = document.getElementById('post-modal');
        const content = document.getElementById('post-modal-content');
        
        modal.classList.remove('hidden');
        
        fetch(`/admin/posts/${postId}`)
            .then(res => res.text())
            .then(html => {
                content.innerHTML = html;
                lucide.createIcons();
            })
            .catch(err => {
                console.error('Error loading post:', err);
                content.innerHTML = '<p class="text-red-500">Error loading post details</p>';
            });
    }

    function closePostModal() {
        document.getElementById('post-modal').classList.add('hidden');
    }

    function deletePost(postId) {
        if (!confirm('Are you sure you want to delete this post? This action cannot be undone.')) {
            return;
        }

        fetch(`/admin/posts/${postId}/delete`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                alert('Post deleted successfully');
                location.reload();
            } else {
                alert('Error: ' + (data.error || 'Failed to delete post'));
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Failed to delete post');
        });
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closePostModal();
        }
    });
</script>
{% endblock %}