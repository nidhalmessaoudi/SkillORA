{% extends 'layouts/admin.html.twig' %}

{% block title %}Reports Management - Admin | SkillHarbor{% endblock %}

{% block admin_content %}
<div class="space-y-6">
    {# Header Section #}
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-display font-bold text-navy-900 dark:text-white">Content Reports</h1>
            <p class="text-navy-600 dark:text-navy-400 mt-1">Review and moderate reported community posts</p>
        </div>
        <a href="{{ path('admin_posts_index') }}" class="btn-outline btn-sm">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Posts
        </a>
    </div>

    {# Status Filters #}
    <div class="card p-2">
        <div class="flex items-center gap-2 overflow-x-auto">
            <a href="{{ path('admin_reports_index', {'status': 'pending'}) }}" 
               class="flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm transition-all {{ currentStatus == 'pending' ? 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 shadow-sm' : 'text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800' }}">
                <i data-lucide="clock" class="w-4 h-4"></i>
                <span>Pending</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold {{ currentStatus == 'pending' ? 'bg-amber-200 dark:bg-amber-800 text-amber-900 dark:text-amber-200' : 'bg-navy-200 dark:bg-navy-700 text-navy-700 dark:text-navy-300' }}">
                    {{ statusCounts['pending'] }}
                </span>
            </a>
            
            <a href="{{ path('admin_reports_index', {'status': 'reviewed'}) }}" 
               class="flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm transition-all {{ currentStatus == 'reviewed' ? 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 shadow-sm' : 'text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800' }}">
                <i data-lucide="check-circle" class="w-4 h-4"></i>
                <span>Reviewed</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold {{ currentStatus == 'reviewed' ? 'bg-emerald-200 dark:bg-emerald-800 text-emerald-900 dark:text-emerald-200' : 'bg-navy-200 dark:bg-navy-700 text-navy-700 dark:text-navy-300' }}">
                    {{ statusCounts['reviewed'] }}
                </span>
            </a>
            
            <a href="{{ path('admin_reports_index', {'status': 'dismissed'}) }}" 
               class="flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm transition-all {{ currentStatus == 'dismissed' ? 'bg-navy-200 dark:bg-navy-700 text-navy-800 dark:text-navy-200 shadow-sm' : 'text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800' }}">
                <i data-lucide="x-circle" class="w-4 h-4"></i>
                <span>Dismissed</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold {{ currentStatus == 'dismissed' ? 'bg-navy-300 dark:bg-navy-600 text-navy-900 dark:text-navy-100' : 'bg-navy-200 dark:bg-navy-700 text-navy-700 dark:text-navy-300' }}">
                    {{ statusCounts['dismissed'] }}
                </span>
            </a>
            
            <a href="{{ path('admin_reports_index', {'status': 'all'}) }}" 
               class="flex items-center gap-2 px-4 py-2.5 rounded-xl font-medium text-sm transition-all {{ currentStatus == 'all' ? 'bg-harbor-100 dark:bg-harbor-900/30 text-harbor-700 dark:text-harbor-400 shadow-sm' : 'text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800' }}">
                <i data-lucide="list" class="w-4 h-4"></i>
                <span>All Reports</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold {{ currentStatus == 'all' ? 'bg-harbor-200 dark:bg-harbor-800 text-harbor-900 dark:text-harbor-200' : 'bg-navy-200 dark:bg-navy-700 text-navy-700 dark:text-navy-300' }}">
                    {{ statusCounts['all'] }}
                </span>
            </a>
        </div>
    </div>

    {# Reports List #}
    <div class="space-y-4">
        {% for report in reports %}
        <div class="card overflow-hidden hover:shadow-xl transition-all duration-300">
            <div class="p-6">
                <div class="flex items-start gap-4">
                    {# Reporter Avatar #}
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-red-400 to-red-600 flex items-center justify-center text-white font-bold text-lg shrink-0 shadow-lg">
                        {{ report.reporter.username|default('U')|slice(0,1)|upper }}
                    </div>
                    
                    <div class="flex-1 min-w-0">
                        {# Report Header #}
                        <div class="flex items-start justify-between gap-4 mb-3">
                            <div class="flex-1">
                                <div class="flex items-center gap-2 flex-wrap mb-1">
                                    <span class="font-semibold text-navy-900 dark:text-white">{{ report.reporter.username }}</span>
                                    <span class="text-navy-500 dark:text-navy-400">reported</span>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-700">
                                        <i data-lucide="flag" class="w-3 h-3 text-red-700 dark:text-red-400"></i>
                                        <span class="text-sm font-semibold text-red-700 dark:text-red-400">{{ report.reasonLabel }}</span>
                                    </span>
                                </div>
                                <p class="text-sm text-navy-500 dark:text-navy-400">
                                    <i data-lucide="clock" class="w-3 h-3 inline"></i>
                                    {{ report.createdAt|date('M j, Y \\a\\t H:i') }}
                                </p>
                            </div>

                            {# Status Badge #}
                            {% if report.status == 'pending' %}
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-100 dark:bg-amber-900/30 border border-amber-300 dark:border-amber-700 shadow-sm">
                                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                                    <span class="text-sm font-semibold text-amber-700 dark:text-amber-400">Pending Review</span>
                                </span>
                            {% elseif report.status == 'reviewed' %}
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-900/30 border border-emerald-300 dark:border-emerald-700">
                                    <i data-lucide="check" class="w-3 h-3 text-emerald-700 dark:text-emerald-400"></i>
                                    <span class="text-sm font-semibold text-emerald-700 dark:text-emerald-400">Reviewed</span>
                                </span>
                            {% elseif report.status == 'dismissed' %}
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-navy-200 dark:bg-navy-700 border border-navy-300 dark:border-navy-600">
                                    <i data-lucide="x" class="w-3 h-3 text-navy-700 dark:text-navy-300"></i>
                                    <span class="text-sm font-semibold text-navy-700 dark:text-navy-300">Dismissed</span>
                                </span>
                            {% endif %}
                        </div>
                        
                        {# Report Description #}
                        {% if report.description %}
                        <div class="mb-4 p-4 rounded-xl bg-navy-50 dark:bg-navy-900/50 border border-navy-200 dark:border-navy-800">
                            <p class="text-sm text-navy-700 dark:text-navy-300 leading-relaxed">{{ report.description }}</p>
                        </div>
                        {% endif %}

                        {# Reported Post Preview #}
                        <div class="p-4 rounded-xl bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-900/10 dark:to-orange-900/10 border-l-4 border-red-500">
                            <div class="flex items-center gap-2 mb-3">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-harbor-400 to-harbor-600 flex items-center justify-center text-white text-xs font-semibold">
                                    {{ report.post.author.username|default('U')|slice(0,1)|upper }}
                                </div>
                                <div class="flex items-center gap-2 text-sm flex-wrap">
                                    <span class="font-medium text-navy-900 dark:text-white">{{ report.post.author.username }}</span>
                                    <span class="text-navy-400">•</span>
                                    <span class="text-navy-500 dark:text-navy-400">{{ report.post.createdAt|date('M j, Y') }}</span>
                                </div>
                            </div>
                            <h4 class="font-semibold text-navy-900 dark:text-white mb-2 line-clamp-1">{{ report.post.title }}</h4>
                            <p class="text-sm text-navy-600 dark:text-navy-400 line-clamp-2">{{ report.post.content }}</p>
                        </div>
                    </div>
                </div>

                {# Actions - Redesigned Buttons #}
                {% if report.isPending %}
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-4 mt-4 border-t border-navy-200 dark:border-navy-800">
                    <button onclick="viewReportedPost({{ report.post.id }})" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-navy-700 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors">
                        <i data-lucide="eye" class="w-4 h-4"></i>
                        <span>View Full Post</span>
                    </button>
                    <div class="flex items-center gap-2">
                        <button onclick="resolveReport({{ report.id }}, 'dismiss')" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-navy-700 dark:text-navy-300 bg-navy-100 dark:bg-navy-800 hover:bg-navy-200 dark:hover:bg-navy-700 transition-colors">
                            <i data-lucide="x-circle" class="w-4 h-4"></i>
                            <span>Dismiss Report</span>
                        </button>
                        <button onclick="resolveReport({{ report.id }}, 'delete_post')" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-600 hover:bg-red-700 dark:bg-red-600 dark:hover:bg-red-700 transition-colors">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                            <span>Delete Post</span>
                        </button>
                    </div>
                </div>
                {% else %}
                <div class="pt-4 mt-4 border-t border-navy-200 dark:border-navy-800">
                    <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800">
                        <i data-lucide="user-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                        <span class="text-sm text-emerald-700 dark:text-emerald-400">
                            Reviewed by <strong>{{ report.reviewedBy.username }}</strong> on {{ report.reviewedAt|date('M j, Y \\a\\t H:i') }}
                        </span>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
        {% else %}
        {# Empty State #}
        <div class="card p-16 text-center">
            <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-gradient-to-br from-emerald-100 to-emerald-200 dark:from-emerald-900/30 dark:to-emerald-800/30 flex items-center justify-center">
                <i data-lucide="shield-check" class="w-10 h-10 text-emerald-600 dark:text-emerald-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-navy-900 dark:text-white mb-2">
                {% if currentStatus == 'pending' %}
                    All Clear!
                {% else %}
                    No Reports Found
                {% endif %}
            </h3>
            <p class="text-navy-600 dark:text-navy-400 max-w-md mx-auto">
                {% if currentStatus == 'pending' %}
                    Great job! There are no pending reports to review. The community is safe and well-moderated.
                {% else %}
                    No reports match the selected status filter.
                {% endif %}
            </p>
        </div>
        {% endfor %}
    </div>
</div>

{# Post Detail Modal - Limited to 70% viewport height #}
<div id="post-modal" class="hidden fixed inset-0 z-50 bg-navy-950/50 backdrop-blur-sm flex items-center justify-center p-4" onclick="closePostModal()">
    <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-strong w-full max-w-4xl max-h-[70vh] overflow-auto" onclick="event.stopPropagation()">
        <div id="post-modal-content" class="p-8">
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-harbor-600"></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    function viewReportedPost(postId) {
        const modal = document.getElementById('post-modal');
        const content = document.getElementById('post-modal-content');
        
        modal.classList.remove('hidden');
        
        // Show loading state
        content.innerHTML = `
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-harbor-600"></div>
            </div>
        `;
        
        fetch(`/admin/posts/${postId}`)
            .then(res => res.text())
            .then(html => {
                content.innerHTML = html;
                lucide.createIcons();
            })
            .catch(err => {
                console.error('Error loading post:', err);
                content.innerHTML = `
                    <div class="text-center py-12">
                        <i data-lucide="alert-circle" class="w-16 h-16 text-red-500 dark:text-red-400 mx-auto mb-4"></i>
                        <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-2">Failed to load post</h3>
                        <p class="text-navy-500 dark:text-navy-400 mb-4">Please try again later.</p>
                        <button onclick="closePostModal()" class="px-4 py-2 rounded-lg bg-navy-100 dark:bg-navy-800 text-navy-700 dark:text-navy-300 hover:bg-navy-200 dark:hover:bg-navy-700 transition-colors">Close</button>
                    </div>
                `;
                lucide.createIcons();
            });
    }

    function closePostModal() {
        document.getElementById('post-modal').classList.add('hidden');
    }

    function resolveReport(reportId, action) {
        const messages = {
            'delete_post': 'Are you sure you want to DELETE this post?\n\n⚠️ This will permanently remove:\n• The post and all its content\n• All replies to this post\n• All reactions\n\nThis action CANNOT be undone!',
            'dismiss': 'Are you sure you want to dismiss this report?\n\nThe post will remain visible and this report will be marked as reviewed.'
        };

        if (!confirm(messages[action])) {
            return;
        }

        const button = event.target.closest('button');
        const originalContent = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<div class="flex items-center gap-2"><i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Processing...</span></div>';
        lucide.createIcons();

        fetch(`/admin/posts/reports/${reportId}/resolve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ action: action })
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                // Show success message
                button.innerHTML = '<div class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4"></i><span>Success!</span></div>';
                lucide.createIcons();
                
                setTimeout(() => location.reload(), 1000);
            } else {
                alert('Error: ' + (data.error || 'Failed to resolve report'));
                button.disabled = false;
                button.innerHTML = originalContent;
                lucide.createIcons();
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Failed to resolve report. Please try again.');
            button.disabled = false;
            button.innerHTML = originalContent;
            lucide.createIcons();
        });
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closePostModal();
        }
    });
</script>
{% endblock %}