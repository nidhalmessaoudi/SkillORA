{% extends 'layouts/base.html.twig' %}

{% block title %}Reports Management - Admin | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {# Header #}
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-3xl font-display font-bold text-slate-900 dark:text-white mb-2">Reports Management</h1>
                <p class="text-slate-600 dark:text-slate-400">Review and manage reported posts</p>
            </div>
            <a href="{{ path('admin_posts_index') }}" class="btn-outline">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to Posts
            </a>
        </div>

        {# Status Tabs #}
        <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
            <a href="{{ path('admin_reports_index', {'status': 'pending'}) }}" 
               class="chip {{ currentStatus == 'pending' ? 'chip-active' : '' }}">
                <i data-lucide="clock" class="w-4 h-4"></i>
                Pending ({{ statusCounts['pending'] }})
            </a>
            <a href="{{ path('admin_reports_index', {'status': 'reviewed'}) }}" 
               class="chip {{ currentStatus == 'reviewed' ? 'chip-active' : '' }}">
                <i data-lucide="check-circle" class="w-4 h-4"></i>
                Reviewed ({{ statusCounts['reviewed'] }})
            </a>
            <a href="{{ path('admin_reports_index', {'status': 'dismissed'}) }}" 
               class="chip {{ currentStatus == 'dismissed' ? 'chip-active' : '' }}">
                <i data-lucide="x-circle" class="w-4 h-4"></i>
                Dismissed ({{ statusCounts['dismissed'] }})
            </a>
            <a href="{{ path('admin_reports_index', {'status': 'all'}) }}" 
               class="chip {{ currentStatus == 'all' ? 'chip-active' : '' }}">
                <i data-lucide="list" class="w-4 h-4"></i>
                All ({{ statusCounts['all'] }})
            </a>
        </div>

        {# Reports List #}
        <div class="space-y-4">
            {% for report in reports %}
            <div class="card p-6 hover:shadow-lg transition-all">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-start gap-4 flex-1">
                        {# Reporter Info #}
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-coral-400 to-red-500 flex items-center justify-center text-white font-semibold shrink-0">
                            {{ report.reporter.fullName|slice(0,1)|upper }}
                        </div>
                        
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <p class="font-semibold text-slate-900 dark:text-white">{{ report.reporter.fullName }}</p>
                                <span class="text-sm text-slate-500">reported</span>
                                <span class="badge badge-coral">{{ report.reasonLabel }}</span>
                            </div>
                            <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
                                {{ report.createdAt|date('M j, Y, H:i') }}
                            </p>
                            
                            {# Report Description #}
                            {% if report.description %}
                            <div class="p-3 bg-slate-50 dark:bg-navy-900/50 rounded-lg mb-3">
                                <p class="text-sm text-slate-700 dark:text-slate-300">{{ report.description }}</p>
                            </div>
                            {% endif %}

                            {# Reported Post Preview #}
                            <div class="p-4 border-l-4 border-coral-400 bg-slate-50 dark:bg-navy-900/50 rounded-r-lg">
                                <div class="flex items-center gap-2 mb-2">
                                    <div class="w-6 h-6 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xs font-medium">
                                        {{ report.post.author.fullName|slice(0,1)|upper }}
                                    </div>
                                    <span class="text-sm font-medium text-slate-900 dark:text-white">{{ report.post.author.fullName }}</span>
                                    <span class="text-sm text-slate-400">•</span>
                                    <span class="text-sm text-slate-500">{{ report.post.createdAt|date('M j, Y') }}</span>
                                </div>
                                <h4 class="font-semibold text-slate-900 dark:text-white mb-2">{{ report.post.title }}</h4>
                                <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">{{ report.post.content }}</p>
                            </div>
                        </div>
                    </div>

                    {# Status Badge #}
                    <div>
                        {% if report.status == 'pending' %}
                            <span class="badge badge-warning">Pending</span>
                        {% elseif report.status == 'reviewed' %}
                            <span class="badge badge-success">Reviewed</span>
                        {% elseif report.status == 'dismissed' %}
                            <span class="badge badge-secondary">Dismissed</span>
                        {% else %}
                            <span class="badge">{{ report.status|capitalize }}</span>
                        {% endif %}
                    </div>
                </div>

                {# Actions #}
                {% if report.isPending %}
                <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-navy-800">
                    <a href="{{ path('community_post', {'id': report.post.id}) }}" target="_blank" class="text-sm text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300 flex items-center gap-1">
                        <i data-lucide="external-link" class="w-4 h-4"></i>
                        View Post
                    </a>
                    <div class="flex items-center gap-2">
                        <button onclick="resolveReport({{ report.id }}, 'dismiss')" class="btn-outline btn-sm">
                            <i data-lucide="x" class="w-4 h-4"></i>
                            Dismiss Report
                        </button>
                        <button onclick="resolveReport({{ report.id }}, 'delete_post')" class="btn-danger btn-sm">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                            Delete Post
                        </button>
                    </div>
                </div>
                {% else %}
                    <div class="pt-4 border-t border-slate-200 dark:border-navy-800">
                        <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            <span>Reviewed by {{ report.reviewedBy.fullName }} on {{ report.reviewedAt|date('M j, Y, H:i') }}</span>
                        </div>
                    </div>
                {% endif %}
            </div>
            {% else %}
            <div class="card p-12 text-center">
                <i data-lucide="inbox" class="w-16 h-16 text-slate-300 dark:text-slate-600 mx-auto mb-4"></i>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">No reports found</h3>
                <p class="text-slate-600 dark:text-slate-400">
                    {% if currentStatus == 'pending' %}
                        Great! There are no pending reports to review.
                    {% else %}
                        No reports with this status.
                    {% endif %}
                </p>
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    function resolveReport(reportId, action) {
        let message = action === 'delete_post' 
            ? 'Are you sure you want to delete this post? This action cannot be undone.'
            : 'Are you sure you want to dismiss this report?';

        if (!confirm(message)) {
            return;
        }

        fetch(`/admin/posts/reports/${reportId}/resolve`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ action: action })
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                alert(data.message);
                location.reload();
            } else {
                alert('Error: ' + (data.error || 'Failed to resolve report'));
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Failed to resolve report');
        });
    }
</script>
{% endblock %}