                    <div class="py-2">
                        <a href="{{ path('admin_stats_export', {format: 'csv'}) }}" class="flex items-center gap-3 px-4 py-2 text-sm text-navy-700 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-700 transition-colors">
