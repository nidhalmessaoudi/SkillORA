                <button onclick="toggleDropdown('export-dropdown')" class="px-4 py-2.5 bg-harbor-600 hover:bg-harbor-700 text-white rounded-xl text-sm font-medium transition-colors flex items-center gap-2">
                    <i data-lucide="download" class="w-4 h-4"></i>
