{% extends 'layouts/admin.html.twig' %}

{% block title %}Answers - Admin{% endblock %}

{% block admin_content %}
{% set backUrl = back ?? app.request.query.get('back') %}

<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold">Answers</h1>

    {% if selectedEvaluation %}
      <p class="text-gray-500">
        Evaluation #{{ selectedEvaluation.title }}
      </p>
    {% else %}
      <p class="text-gray-500">All answers (no evaluation filter)</p>
    {% endif %}
  </div>

  <a href="{{ backUrl ?: path('evaluation_index') }}" class="btn-secondary btn-sm">
    ← Back
  </a>
</div>

{% if selectedEvaluation %}
  <div class="mb-6 flex gap-2">
    <span class="px-3 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full">
      Correct: {{ correct }}
    </span>
    <span class="px-3 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full">
      Incorrect: {{ incorrect }}
    </span>
  </div>

  {% if groupedByQuestion is empty %}
    <div class="card p-6 text-gray-500">No answers found for this evaluation.</div>
  {% else %}
    {% for qid, block in groupedByQuestion %}
      <div class="card mb-6 overflow-hidden rounded-xl">

        <div class="p-5 border-b bg-gray-50">
          <div class="font-semibold text-gray-900">
            Question
          </div>
          <div class="text-sm text-gray-700 whitespace-pre-wrap mt-2">
            {{ block.question.content }}
          </div>
        </div>

        <div class="p-5">
          <ul class="space-y-2">
            {% set letters = ['A','B','C','D','E','F','G','H','I','J','K','L'] %}
            {% for a in block.answers %}
              <li class="p-3 rounded-lg border flex items-start gap-3
                {{ a.isCorrect ? 'bg-green-50 border-green-200' : 'bg-white border-gray-200' }}">
                <div class="font-bold w-8">
                  {{ letters[loop.index0] ~ '.' }}
                </div>

                <div class="flex-1">
                  <div class="text-gray-900 whitespace-pre-wrap">{{ a.content }}</div>
                </div>

                {% if a.isCorrect %}
                  <span class="text-green-700 font-semibold">✔ Correct</span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>

      </div>
    {% endfor %}
  {% endif %}

{% else %}
  {# fallback view if no evaluationId: show grouped evaluations quickly #}
  {% if fallbackGrouped %}
    {% for evalId, block in fallbackGrouped %}
      <div class="card mb-6 p-5">
        <div class="font-semibold">
          Evaluation #{{ evalId }} — {{ block.evaluation.title }}
        </div>
        <div class="text-gray-500 text-sm mt-1">
          {{ block.answers|length }} answer(s)
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="card p-6 text-gray-500">No answers found.</div>
  {% endif %}
{% endif %}

{% endblock %}
