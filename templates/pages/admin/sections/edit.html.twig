{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit Section - Admin{% endblock %}

{% block admin_content %}
<div class="mb-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
        Edit Section
      </h1>
      <p class="text-body-md text-navy-600 dark:text-navy-400">
        Course: <span class="font-medium text-navy-900 dark:text-white">{{ course.title }}</span>
      </p>
    </div>

    <a href="{{ path('admin_courses_show', {courseId: course.id}) }}" class="btn-secondary btn-sm">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      Back
    </a>
  </div>
</div>

<div class="card">
  <div class="p-6 border-b border-navy-100 dark:border-navy-800">
    <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
      Section details
    </h2>
    <p class="text-body-sm text-navy-500 mt-1">Update title or ordering.</p>
  </div>

  <div class="p-6">
    {{ form_start(form) }}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          {{ form_row(form.title) }}
        </div>
        <div>
          {{ form_row(form.position) }}
        </div>
      </div>

      <div class="mt-6 flex items-center justify-end gap-3">
        <a href="{{ path('admin_courses_show', {courseId: course.id}) }}" class="btn-secondary btn-sm">Cancel</a>
        <button class="btn-primary btn-sm">
          <i data-lucide="save" class="w-4 h-4"></i>
          Update
        </button>
      </div>
    {{ form_end(form) }}
  </div>
</div>

<div class="card mt-6 border border-red-200 dark:border-red-900/40">
  <div class="p-6 border-b border-red-200 dark:border-red-900/40">
    <h2 class="text-heading-lg font-display font-semibold text-red-700 dark:text-red-300">
      Danger zone
    </h2>
    <p class="text-body-sm text-navy-500 mt-1">
      Deleting this section will remove its lessons too.
    </p>
  </div>

  <div class="p-6 flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="font-medium text-navy-900 dark:text-white">Delete section</p>
      <p class="text-body-sm text-navy-500">This action can’t be undone.</p>
    </div>

    <form method="post"
          action="{{ path('admin_sections_delete', {courseId: course.id, sectionId: section.id}) }}"
          onsubmit="return confirm('Delete this section?');">
      <input type="hidden" name="_token" value="{{ csrf_token('delete_section_' ~ section.id) }}">
      <button class="btn-danger btn-sm">
        <i data-lucide="trash-2" class="w-4 h-4"></i>
        Delete
      </button>
    </form>
  </div>
</div>
{% endblock %}
