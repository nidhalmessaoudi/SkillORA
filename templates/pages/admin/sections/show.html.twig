{% extends 'layouts/admin.html.twig' %}

{% block title %}Section - Admin{% endblock %}

{% block admin_content %}
<div class="mb-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
        {{ section.title }}
      </h1>
      <p class="text-body-md text-navy-600 dark:text-navy-400">
        Course: <span class="font-medium text-navy-900 dark:text-white">{{ course.title }}</span>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a href="{{ path('admin_sections_edit', {courseId: course.id, sectionId: section.id}) }}" class="btn-secondary btn-sm">
        <i data-lucide="pencil" class="w-4 h-4"></i>
        Edit section
      </a>
      <a href="{{ path('admin_courses_show', {courseId: course.id}) }}" class="btn-secondary btn-sm">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        Back
      </a>
    </div>
  </div>
</div>

<div class="card">
  <div class="p-6 border-b border-navy-100 dark:border-navy-800">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
          Lessons
        </h2>
        <p class="text-body-sm text-navy-500 mt-1">Basic list (title + type + position).</p>
      </div>

      <a href="{{ path('admin_lessons_new', {courseId: course.id, sectionId: section.id}) }}" class="btn-primary btn-sm">
        <i data-lucide="plus" class="w-4 h-4"></i>
        Add lesson
      </a>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-navy-50 dark:bg-navy-900/50">
        <tr>
          <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Lesson
          </th>
          <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Type
          </th>
          <th class="px-6 py-3 text-left text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Position
          </th>
          <th class="px-6 py-3 text-right text-caption font-semibold text-navy-600 dark:text-navy-400 uppercase tracking-wider">
            Actions
          </th>
        </tr>
      </thead>

      <tbody class="divide-y divide-navy-100 dark:divide-navy-800">
        {% set lessons = section.lessons|default([]) %}
        {% for lesson in lessons|sort((a,b) => a.position <=> b.position) %}
          {% set t = lesson.type|default('text') %}

          <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-harbor-100 dark:bg-harbor-900/30 flex items-center justify-center">
                  {% if t == 'video' %}
                    <i data-lucide="play-circle" class="w-5 h-5 text-harbor-600 dark:text-harbor-400"></i>
                  {% elseif t == 'pdf' %}
                    <i data-lucide="file-text" class="w-5 h-5 text-harbor-600 dark:text-harbor-400"></i>
                  {% else %}
                    <i data-lucide="align-left" class="w-5 h-5 text-harbor-600 dark:text-harbor-400"></i>
                  {% endif %}
                </div>
                <div class="min-w-0">
                  <a href="{{ path('admin_lessons_show', {courseId: course.id, sectionId: section.id, lessonId: lesson.id}) }}"
                     class="font-medium text-navy-900 dark:text-white hover:underline truncate block">
                    {{ lesson.title }}
                  </a>
                </div>
              </div>
            </td>

            <td class="px-6 py-4 whitespace-nowrap">
              {% if t == 'video' %}
                <span class="badge-primary"><i data-lucide="play-circle" class="w-3 h-3"></i> Video</span>
              {% elseif t == 'pdf' %}
                <span class="badge-secondary"><i data-lucide="file-text" class="w-3 h-3"></i> PDF</span>
              {% else %}
                <span class="badge-success"><i data-lucide="align-left" class="w-3 h-3"></i> Text</span>
              {% endif %}
            </td>

            <td class="px-6 py-4 whitespace-nowrap text-body-sm text-navy-600 dark:text-navy-300">
              {{ lesson.position }}
            </td>

            <td class="px-6 py-4 whitespace-nowrap text-right">
              <div class="inline-flex items-center gap-2">
                <a href="{{ path('admin_lessons_edit', {courseId: course.id, sectionId: section.id, lessonId: lesson.id}) }}"
                   class="btn-secondary btn-sm">
                  <i data-lucide="pencil" class="w-4 h-4"></i>
                </a>

                <form method="post"
                      action="{{ path('admin_lessons_delete', {courseId: course.id, sectionId: section.id, lessonId: lesson.id}) }}"
                      onsubmit="return confirm('Delete this lesson?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete_lesson_' ~ lesson.id) }}">
                  <button type="submit"
                          class="btn-secondary btn-sm hover:!bg-danger-50 hover:!text-danger-600 dark:hover:!bg-danger-900/20 dark:hover:!text-danger-400"
                          title="Delete">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="4" class="px-6 py-12 text-center">
              <div class="empty-state-icon mx-auto">
                <i data-lucide="file-text" class="w-full h-full"></i>
              </div>
              <p class="text-navy-500">No lessons yet</p>
              <div class="mt-4">
                <a href="{{ path('admin_lessons_new', {courseId: course.id, sectionId: section.id}) }}" class="btn-primary btn-sm">
                  <i data-lucide="plus" class="w-4 h-4"></i>
                  Add your first lesson
                </a>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
