{% extends 'layouts/base.html.twig' %}

{% block title %}SkillHarbor - Learn deeply. Grow visibly.{% endblock %}

{% block body %}
{# Hero Section #}
<section class="relative overflow-hidden bg-hero-pattern dark:bg-hero-pattern-dark">
    <div class="container-wide py-20 lg:py-28">
        <div class="max-w-3xl mx-auto text-center">
            {# Badge #}
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-harbor-100 dark:bg-harbor-900/30 text-harbor-700 dark:text-harbor-400 text-body-sm font-medium mb-6">
                <i data-lucide="sparkles" class="w-4 h-4"></i>
                <span>Over 185,000 students trust SkillHarbor</span>
            </div>

            {# Headline #}
            <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-navy-900 dark:text-white mb-6 leading-tight">
                Learn deeply.
                <span class="text-gradient">Grow visibly.</span>
            </h1>

            {# Subtitle #}
            <p class="text-body-lg text-navy-600 dark:text-navy-300 mb-10 max-w-2xl mx-auto">
                Master in-demand skills with courses crafted by industry experts.
                Join millions of learners transforming their careers.
            </p>

            {# Search Bar #}
            <div class="relative max-w-xl mx-auto">
                <i data-lucide="search" class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-navy-400"></i>
                <input
                    type="search"
                    placeholder="What do you want to learn?"
                    class="w-full pl-14 pr-36 py-4 rounded-2xl bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-700 text-navy-900 dark:text-white shadow-soft focus:shadow-medium focus:border-harbor-500 dark:focus:border-harbor-500 transition-all text-body-md"
                >
                <button class="absolute right-2 top-1/2 -translate-y-1/2 btn-primary">
                    Explore
                </button>
            </div>

            {# Quick stats #}
            <div class="flex flex-wrap items-center justify-center gap-8 mt-12">
                <div class="text-center">
                    <div class="font-display font-bold text-2xl text-navy-900 dark:text-white">10K+</div>
                    <div class="text-body-sm text-navy-500">Courses</div>
                </div>
                <div class="w-px h-10 bg-navy-200 dark:bg-navy-700 hidden sm:block"></div>
                <div class="text-center">
                    <div class="font-display font-bold text-2xl text-navy-900 dark:text-white">500K+</div>
                    <div class="text-body-sm text-navy-500">Students</div>
                </div>
                <div class="w-px h-10 bg-navy-200 dark:bg-navy-700 hidden sm:block"></div>
                <div class="text-center">
                    <div class="font-display font-bold text-2xl text-navy-900 dark:text-white">2K+</div>
                    <div class="text-body-sm text-navy-500">Instructors</div>
                </div>
                <div class="w-px h-10 bg-navy-200 dark:bg-navy-700 hidden sm:block"></div>
                <div class="text-center">
                    <div class="font-display font-bold text-2xl text-navy-900 dark:text-white">4.8</div>
                    <div class="text-body-sm text-navy-500">Avg. Rating</div>
                </div>
            </div>
        </div>
    </div>
</section>

{# Featured Categories #}
<section class="py-16 lg:py-20 bg-navy-50 dark:bg-navy-900/50">
    <div class="container-wide">
        <div class="flex items-end justify-between mb-10">
            <div>
                <h2 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-2">
                    Browse by category
                </h2>
                <p class="text-body-md text-navy-600 dark:text-navy-400">
                    Explore our most popular learning paths
                </p>
            </div>
            <a href="{{ path('courses_index') }}" class="hidden sm:flex items-center gap-2 text-harbor-600 dark:text-harbor-400 font-medium hover:gap-3 transition-all">
                View all <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {% for category in categories|slice(0, 8) %}
            <a href="{{ path('courses_index', {category: category.slug}) }}" class="card-interactive p-6 text-center group">
                <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-harbor-100 dark:bg-harbor-900/30 flex items-center justify-center group-hover:bg-harbor-600 group-hover:text-white transition-colors">
                    {% if category.icon == 'code' %}
                        <i data-lucide="code-2" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% elseif category.icon == 'briefcase' %}
                        <i data-lucide="briefcase" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% elseif category.icon == 'chart' %}
                        <i data-lucide="bar-chart-3" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% elseif category.icon == 'palette' %}
                        <i data-lucide="palette" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% elseif category.icon == 'megaphone' %}
                        <i data-lucide="megaphone" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% elseif category.icon == 'user' %}
                        <i data-lucide="user" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% elseif category.icon == 'server' %}
                        <i data-lucide="server" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% else %}
                        <i data-lucide="camera" class="w-6 h-6 text-harbor-600 dark:text-harbor-400 group-hover:text-white"></i>
                    {% endif %}
                </div>
                <h3 class="font-display font-semibold text-navy-900 dark:text-white mb-1">{{ category.name }}</h3>
                <p class="text-body-sm text-navy-500">{{ category.count|number_format }} courses</p>
            </a>
            {% endfor %}
        </div>
    </div>
</section>

{# Featured Courses #}
<section class="py-16 lg:py-20">
    <div class="container-wide">
        <div class="flex items-end justify-between mb-10">
            <div>
                <span class="badge-coral mb-3">Featured</span>
                <h2 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-2">
                    Expand your career opportunities
                </h2>
                <p class="text-body-md text-navy-600 dark:text-navy-400">
                    Hand-picked courses to help you level up
                </p>
            </div>
            <a href="{{ path('courses_index') }}" class="hidden sm:flex items-center gap-2 text-harbor-600 dark:text-harbor-400 font-medium hover:gap-3 transition-all">
                View all <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% for course in featured_courses %}
                {% include 'components/course-card.html.twig' with {course: course} %}
            {% endfor %}
        </div>
    </div>
</section>

{# Bestsellers #}
<section class="py-16 lg:py-20 bg-navy-50 dark:bg-navy-900/50">
    <div class="container-wide">
        <div class="flex items-end justify-between mb-10">
            <div>
                <span class="badge-success mb-3">Bestsellers</span>
                <h2 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-2">
                    Most popular with learners
                </h2>
                <p class="text-body-md text-navy-600 dark:text-navy-400">
                    Courses loved by thousands of students
                </p>
            </div>
            <a href="{{ path('courses_index') }}" class="hidden sm:flex items-center gap-2 text-harbor-600 dark:text-harbor-400 font-medium hover:gap-3 transition-all">
                View all <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% for course in bestsellers %}
                {% include 'components/course-card.html.twig' with {course: course} %}
            {% endfor %}
        </div>
    </div>
</section>

{# Top Instructors #}
<section class="py-16 lg:py-20">
    <div class="container-wide">
        <div class="text-center mb-12">
            <h2 class="font-display font-bold text-display-sm text-navy-900 dark:text-white mb-3">
                Learn from industry leaders
            </h2>
            <p class="text-body-md text-navy-600 dark:text-navy-400 max-w-2xl mx-auto">
                Our instructors are practitioners with real-world experience at top companies
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {% for instructor in instructors %}
            <a href="{{ path('instructor_show', {id: instructor.id}) }}" class="card-interactive p-6 text-center">
                <img
                    src="{{ instructor.avatar }}"
                    alt="{{ instructor.name }}"
                    class="w-20 h-20 rounded-full mx-auto mb-4 object-cover ring-4 ring-white dark:ring-navy-800 shadow-soft"
                >
                <div class="flex items-center justify-center gap-1 mb-2">
                    <h3 class="font-display font-semibold text-navy-900 dark:text-white">{{ instructor.name }}</h3>
                    {% if instructor.verified %}
                    <i data-lucide="badge-check" class="w-5 h-5 text-harbor-600"></i>
                    {% endif %}
                </div>
                <p class="text-body-sm text-navy-500 mb-3">{{ instructor.title }}</p>
                <div class="flex items-center justify-center gap-4 text-body-sm">
                    <span class="flex items-center gap-1 text-warning-500">
                        <i data-lucide="star" class="w-4 h-4 fill-current"></i>
                        {{ instructor.rating }}
                    </span>
                    <span class="text-navy-400">{{ (instructor.students_count / 1000)|number_format(0) }}K students</span>
                </div>
            </a>
            {% endfor %}
        </div>

        <div class="text-center mt-10">
            <a href="{{ path('instructors_index') }}" class="btn-secondary">
                View all instructors
            </a>
        </div>
    </div>
</section>

{# Testimonials #}
<section class="py-16 lg:py-20 bg-navy-950">
    <div class="container-wide">
        <div class="text-center mb-12">
            <h2 class="font-display font-bold text-display-sm text-white mb-3">
                Success stories from our community
            </h2>
            <p class="text-body-md text-navy-400 max-w-2xl mx-auto">
                See how SkillHarbor has helped learners achieve their goals
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {% for testimonial in testimonials %}
            <div class="bg-navy-900 rounded-3xl p-8">
                <div class="flex items-center gap-1 mb-4">
                    {% for i in 1..5 %}
                    <i data-lucide="star" class="w-5 h-5 text-warning-400 fill-warning-400"></i>
                    {% endfor %}
                </div>
                <p class="text-body-md text-navy-300 mb-6">
                    "{{ testimonial.content }}"
                </p>
                <div class="flex items-center gap-4">
                    <img
                        src="{{ testimonial.avatar }}"
                        alt="{{ testimonial.name }}"
                        class="w-12 h-12 rounded-full object-cover"
                    >
                    <div>
                        <div class="font-display font-semibold text-white">{{ testimonial.name }}</div>
                        <div class="text-body-sm text-navy-400">{{ testimonial.role }}</div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# CTA Section #}
<section class="py-20 lg:py-28">
    <div class="container-wide">
        <div class="relative overflow-hidden rounded-4xl bg-gradient-to-br from-harbor-600 to-harbor-700 p-12 lg:p-16 text-center">
            {# Background pattern #}
            <div class="absolute inset-0 opacity-10">
                <div class="absolute top-0 left-0 w-72 h-72 bg-white rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
                <div class="absolute bottom-0 right-0 w-96 h-96 bg-coral-400 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
            </div>

            <div class="relative z-10 max-w-2xl mx-auto">
                <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">
                    Start learning today
                </h2>
                <p class="text-lg text-harbor-100 mb-8">
                    Join over 500,000 learners who are advancing their careers with SkillHarbor.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="{{ path('courses_index') }}" class="btn bg-white text-harbor-700 hover:bg-harbor-50 shadow-medium btn-lg">
                        Browse courses
                    </a>
                    <a href="#" class="btn bg-harbor-500/20 text-white hover:bg-harbor-500/30 btn-lg border border-white/20">
                        Start free trial
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
