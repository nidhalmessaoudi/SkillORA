{% extends 'layouts/base.html.twig' %}

{% block title %}{{ quiz.title }} - SkillORA{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Breadcrumb #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <nav class="flex items-center gap-2 text-sm">
                <a href="{{ path('learn_index') }}" class="text-slate-500 dark:text-slate-400 hover:text-harbor-600 dark:hover:text-harbor-400 transition-colors">My Learning</a>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                <a href="{{ path('quiz_index') }}" class="text-slate-500 dark:text-slate-400 hover:text-harbor-600 dark:hover:text-harbor-400 transition-colors">Quizzes</a>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                <span class="text-slate-900 dark:text-white font-medium">{{ quiz.title }}</span>
            </nav>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {# Quiz Header Card #}
        <div class="card p-8 mb-8">
            <div class="flex flex-col lg:flex-row lg:items-start gap-6">
                {# Icon #}
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-br {{ quiz.color|default('from-violet-500 to-purple-600') }} flex items-center justify-center flex-shrink-0">
                    <i data-lucide="{{ quiz.icon|default('brain') }}" class="w-10 h-10 text-white"></i>
                </div>

                <div class="flex-1">
                    {# Category & Difficulty #}
                    <div class="flex flex-wrap items-center gap-3 mb-3">
                        <span class="badge-primary">{{ quiz.course }}</span>
                        <div class="flex items-center gap-1">
                            {% for i in 1..3 %}
                            <div class="w-2 h-2 rounded-full {{ i <= quiz.difficulty|default(2) ? 'bg-amber-400' : 'bg-slate-200 dark:bg-navy-700' }}"></div>
                            {% endfor %}
                            <span class="text-xs text-slate-500 dark:text-slate-400 ml-1">
                                {{ quiz.difficulty == 1 ? 'Easy' : (quiz.difficulty == 2 ? 'Medium' : 'Hard') }}
                            </span>
                        </div>
                    </div>

                    <h1 class="text-3xl font-display font-bold text-slate-900 dark:text-white mb-3">
                        {{ quiz.title }}
                    </h1>
                    <p class="text-slate-600 dark:text-slate-400 mb-6">
                        {{ quiz.description }}
                    </p>

                    {# Quiz Stats #}
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        <div class="text-center p-4 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <i data-lucide="help-circle" class="w-5 h-5 text-harbor-500 mx-auto mb-2"></i>
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ quiz.questions }}</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Questions</p>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <i data-lucide="clock" class="w-5 h-5 text-emerald-500 mx-auto mb-2"></i>
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ quiz.duration }}</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Minutes</p>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <i data-lucide="target" class="w-5 h-5 text-coral-500 mx-auto mb-2"></i>
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ quiz.passingScore|default(70) }}%</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">To Pass</p>
                        </div>
                        <div class="text-center p-4 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <i data-lucide="zap" class="w-5 h-5 text-amber-500 mx-auto mb-2"></i>
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ quiz.xp }}</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">XP Reward</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
            {# Main Content #}
            <div class="lg:col-span-2 space-y-6">
                {# What to Expect #}
                <div class="card p-6">
                    <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="info" class="w-5 h-5 text-harbor-500"></i>
                        What to Expect
                    </h2>
                    <div class="space-y-4 text-slate-600 dark:text-slate-400">
                        <p>This quiz will test your knowledge on the key concepts covered in <strong class="text-slate-900 dark:text-white">{{ quiz.course }}</strong>. You'll encounter a mix of question types designed to assess both your theoretical understanding and practical application skills.</p>

                        <div class="grid sm:grid-cols-2 gap-3">
                            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                                <div class="w-8 h-8 rounded-lg bg-harbor-100 dark:bg-harbor-900/30 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="check-square" class="w-4 h-4 text-harbor-600 dark:text-harbor-400"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-slate-900 dark:text-white text-sm">Multiple Choice</p>
                                    <p class="text-xs text-slate-500">Select the best answer</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                                <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="toggle-left" class="w-4 h-4 text-emerald-600 dark:text-emerald-400"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-slate-900 dark:text-white text-sm">True/False</p>
                                    <p class="text-xs text-slate-500">Evaluate statements</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                                <div class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="code" class="w-4 h-4 text-amber-600 dark:text-amber-400"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-slate-900 dark:text-white text-sm">Code Analysis</p>
                                    <p class="text-xs text-slate-500">Review code snippets</p>
                                </div>
                            </div>
                            <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                                <div class="w-8 h-8 rounded-lg bg-violet-100 dark:bg-violet-900/30 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="list-ordered" class="w-4 h-4 text-violet-600 dark:text-violet-400"></i>
                                </div>
                                <div>
                                    <p class="font-medium text-slate-900 dark:text-white text-sm">Fill in Blanks</p>
                                    <p class="text-xs text-slate-500">Complete the sentence</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Topics Covered #}
                <div class="card p-6">
                    <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="book-open" class="w-5 h-5 text-harbor-500"></i>
                        Topics Covered
                    </h2>
                    <div class="space-y-3">
                        {% set topics = ['Core fundamentals and basic concepts', 'Advanced techniques and best practices', 'Real-world application scenarios', 'Common pitfalls and how to avoid them', 'Performance optimization strategies'] %}
                        {% for topic in topics %}
                        <div class="flex items-center gap-3">
                            <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
                                <i data-lucide="check" class="w-3 h-3 text-emerald-600 dark:text-emerald-400"></i>
                            </div>
                            <span class="text-slate-700 dark:text-slate-300">{{ topic }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                {# Quiz Rules #}
                <div class="card p-6">
                    <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="shield-check" class="w-5 h-5 text-harbor-500"></i>
                        Quiz Rules
                    </h2>
                    <ul class="space-y-3 text-slate-600 dark:text-slate-400">
                        <li class="flex items-start gap-3">
                            <i data-lucide="timer" class="w-5 h-5 text-slate-400 flex-shrink-0 mt-0.5"></i>
                            <span>You have <strong class="text-slate-900 dark:text-white">{{ quiz.duration }} minutes</strong> to complete all questions. Timer starts when you begin.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i data-lucide="arrow-left-right" class="w-5 h-5 text-slate-400 flex-shrink-0 mt-0.5"></i>
                            <span>You can navigate between questions and change your answers before submitting.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i data-lucide="check-circle" class="w-5 h-5 text-slate-400 flex-shrink-0 mt-0.5"></i>
                            <span>Score at least <strong class="text-slate-900 dark:text-white">{{ quiz.passingScore|default(70) }}%</strong> to pass and earn XP rewards.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i data-lucide="rotate-ccw" class="w-5 h-5 text-slate-400 flex-shrink-0 mt-0.5"></i>
                            <span>You can retake the quiz to improve your score. Best score is recorded.</span>
                        </li>
                    </ul>
                </div>
            </div>

            {# Sidebar #}
            <div class="space-y-6">
                {# Start Quiz Card #}
                <div class="card p-6 sticky top-24">
                    <div class="text-center mb-6">
                        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-harbor-500 to-harbor-600 flex items-center justify-center mx-auto mb-4">
                            <i data-lucide="play" class="w-8 h-8 text-white"></i>
                        </div>
                        <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-1">Ready to Start?</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Make sure you're prepared before beginning</p>
                    </div>

                    <a href="{{ path('quiz_attempt', {id: quiz.id}) }}" class="btn-primary w-full justify-center py-4 text-lg mb-4">
                        <i data-lucide="play" class="w-5 h-5 mr-2"></i>
                        Start Quiz
                    </a>

                    <div class="flex items-center justify-center gap-4 text-sm text-slate-500 dark:text-slate-400">
                        <span class="flex items-center gap-1">
                            <i data-lucide="clock" class="w-4 h-4"></i>
                            {{ quiz.duration }} min
                        </span>
                        <span class="text-slate-300 dark:text-slate-600">•</span>
                        <span class="flex items-center gap-1">
                            <i data-lucide="help-circle" class="w-4 h-4"></i>
                            {{ quiz.questions }} questions
                        </span>
                    </div>
                </div>

                {# Your Previous Attempts #}
                {% if attempts|default([])|length > 0 %}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Previous Attempts</h3>
                    <div class="space-y-3">
                        {% for attempt in attempts|slice(0, 3) %}
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <div>
                                <p class="font-medium text-slate-900 dark:text-white">{{ attempt.score }}%</p>
                                <p class="text-xs text-slate-500">{{ attempt.date }}</p>
                            </div>
                            <span class="badge {{ attempt.passed ? 'badge-success' : 'badge-danger' }}">
                                {{ attempt.passed ? 'Passed' : 'Failed' }}
                            </span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# Related Quizzes #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Related Quizzes</h3>
                    <div class="space-y-3">
                        {% for related in relatedQuizzes|default([])|slice(0, 3) %}
                        <a href="{{ path('quiz_show', {id: related.id}) }}" class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 dark:hover:bg-navy-800/50 transition-colors">
                            <div class="w-10 h-10 rounded-lg bg-gradient-to-br {{ related.color|default('from-harbor-500 to-harbor-600') }} flex items-center justify-center flex-shrink-0">
                                <i data-lucide="{{ related.icon|default('help-circle') }}" class="w-5 h-5 text-white"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-medium text-slate-900 dark:text-white text-sm truncate">{{ related.title }}</p>
                                <p class="text-xs text-slate-500">{{ related.questions }} questions</p>
                            </div>
                        </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();
</script>
{% endblock %}
