{% extends 'layouts/base.html.twig' %}

{% block title %}Quizzes - SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Hero Section #}
    <div class="bg-gradient-to-br from-violet-600 via-purple-600 to-indigo-700 relative overflow-hidden">
        <div class="absolute inset-0">
            <div class="absolute top-20 left-10 w-72 h-72 bg-white/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 right-20 w-96 h-96 bg-pink-500/10 rounded-full blur-3xl"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
            <div class="text-center max-w-3xl mx-auto">
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
                    <i data-lucide="brain" class="w-4 h-4 text-amber-300"></i>
                    <span class="text-sm font-medium text-white">Test Your Knowledge</span>
                </div>
                <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-4">
                    Quizzes & Assessments
                </h1>
                <p class="text-lg text-purple-100 mb-8">
                    Challenge yourself with interactive quizzes, earn XP, and track your mastery across all topics.
                </p>

                {# Quick Stats #}
                <div class="flex flex-wrap justify-center gap-6">
                    <div class="bg-white/10 backdrop-blur-sm rounded-2xl px-6 py-4 border border-white/10">
                        <p class="text-2xl font-bold text-white">{{ quizzes|length }}</p>
                        <p class="text-sm text-purple-200">Available Quizzes</p>
                    </div>
                    <div class="bg-white/10 backdrop-blur-sm rounded-2xl px-6 py-4 border border-white/10">
                        <p class="text-2xl font-bold text-white">{{ user.quizzesPassed|default(15) }}</p>
                        <p class="text-sm text-purple-200">Quizzes Passed</p>
                    </div>
                    <div class="bg-white/10 backdrop-blur-sm rounded-2xl px-6 py-4 border border-white/10">
                        <p class="text-2xl font-bold text-white">{{ user.avgScore|default(85) }}%</p>
                        <p class="text-sm text-purple-200">Average Score</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {# Filter Tabs #}
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0">
                <button class="tab-pill active">All Quizzes</button>
                <button class="tab-pill">Not Started</button>
                <button class="tab-pill">In Progress</button>
                <button class="tab-pill">Completed</button>
            </div>

            <div class="flex items-center gap-3">
                <div class="relative">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input type="text" placeholder="Search quizzes..." class="input pl-10 py-2.5 w-64">
                </div>
                <select class="input py-2.5 w-auto">
                    <option>All Categories</option>
                    <option>Web Development</option>
                    <option>Data Science</option>
                    <option>Design</option>
                    <option>Business</option>
                </select>
            </div>
        </div>

        {# Daily Challenge Banner #}
        <div class="card bg-gradient-to-r from-amber-500 to-orange-500 p-6 mb-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2"></div>
            <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center">
                        <i data-lucide="zap" class="w-8 h-8 text-white"></i>
                    </div>
                    <div>
                        <p class="text-amber-100 text-sm font-medium mb-1">Daily Challenge</p>
                        <h3 class="text-xl font-display font-bold">JavaScript Advanced Concepts</h3>
                        <p class="text-amber-100 text-sm mt-1">Complete today's quiz for 2x XP bonus!</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-center">
                        <p class="text-3xl font-bold">500</p>
                        <p class="text-amber-100 text-sm">XP Reward</p>
                    </div>
                    <a href="{{ path('quiz_attempt', {id: 1}) }}" class="btn bg-white text-amber-600 hover:bg-amber-50 px-6 py-3 font-semibold">
                        Start Challenge
                        <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
                    </a>
                </div>
            </div>
        </div>

        {# Quiz Grid #}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for quiz in quizzes %}
            <div class="card p-6 hover:shadow-xl transition-all duration-300 group">
                {# Quiz Header #}
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br {{ quiz.color|default('from-harbor-500 to-harbor-600') }} flex items-center justify-center">
                        <i data-lucide="{{ quiz.icon|default('help-circle') }}" class="w-6 h-6 text-white"></i>
                    </div>
                    {% if quiz.status == 'completed' %}
                    <span class="badge-success">Completed</span>
                    {% elseif quiz.status == 'in_progress' %}
                    <span class="badge-warning">In Progress</span>
                    {% else %}
                    <span class="badge-secondary">Not Started</span>
                    {% endif %}
                </div>

                {# Quiz Info #}
                <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-2 group-hover:text-harbor-600 dark:group-hover:text-harbor-400 transition-colors">
                    {{ quiz.title }}
                </h3>
                <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 line-clamp-2">
                    {{ quiz.description }}
                </p>

                {# Quiz Meta #}
                <div class="flex flex-wrap gap-3 mb-4 text-sm">
                    <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                        <i data-lucide="help-circle" class="w-4 h-4"></i>
                        <span>{{ quiz.questions }} questions</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                        <i data-lucide="clock" class="w-4 h-4"></i>
                        <span>{{ quiz.duration }} min</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-amber-500">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        <span>{{ quiz.xp }} XP</span>
                    </div>
                </div>

                {# Difficulty & Course #}
                <div class="flex items-center justify-between mb-4">
                    <span class="text-xs text-slate-500 dark:text-slate-400">{{ quiz.course }}</span>
                    <div class="flex items-center gap-1">
                        {% for i in 1..3 %}
                        <div class="w-2 h-2 rounded-full {{ i <= quiz.difficulty|default(2) ? 'bg-amber-400' : 'bg-slate-200 dark:bg-navy-700' }}"></div>
                        {% endfor %}
                        <span class="text-xs text-slate-500 dark:text-slate-400 ml-1">
                            {{ quiz.difficulty == 1 ? 'Easy' : (quiz.difficulty == 2 ? 'Medium' : 'Hard') }}
                        </span>
                    </div>
                </div>

                {# Progress or Score #}
                {% if quiz.status == 'completed' %}
                <div class="flex items-center justify-between p-3 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 mb-4">
                    <div class="flex items-center gap-2">
                        <i data-lucide="trophy" class="w-5 h-5 text-emerald-500"></i>
                        <span class="font-semibold text-emerald-700 dark:text-emerald-400">{{ quiz.score }}%</span>
                    </div>
                    <span class="text-sm text-emerald-600 dark:text-emerald-400">Best Score</span>
                </div>
                {% elseif quiz.status == 'in_progress' %}
                <div class="mb-4">
                    <div class="flex items-center justify-between text-sm mb-2">
                        <span class="text-slate-500 dark:text-slate-400">Progress</span>
                        <span class="font-medium text-slate-700 dark:text-slate-300">{{ quiz.progress }}%</span>
                    </div>
                    <div class="w-full bg-slate-200 dark:bg-navy-800 rounded-full h-2">
                        <div class="h-full bg-harbor-500 rounded-full" style="width: {{ quiz.progress }}%"></div>
                    </div>
                </div>
                {% endif %}

                {# Action Button #}
                <a href="{{ path('quiz_show', {id: quiz.id}) }}" class="btn-primary w-full justify-center group/btn">
                    {% if quiz.status == 'completed' %}
                    <i data-lucide="rotate-ccw" class="w-4 h-4 mr-2"></i>
                    Retake Quiz
                    {% elseif quiz.status == 'in_progress' %}
                    <i data-lucide="play" class="w-4 h-4 mr-2"></i>
                    Continue
                    {% else %}
                    <i data-lucide="play" class="w-4 h-4 mr-2 group-hover/btn:scale-110 transition-transform"></i>
                    Start Quiz
                    {% endif %}
                </a>
            </div>
            {% endfor %}
        </div>

        {# Load More #}
        <div class="text-center mt-10">
            <button class="btn-outline px-8">
                Load More Quizzes
                <i data-lucide="chevron-down" class="w-4 h-4 ml-2"></i>
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Tab switching
    document.querySelectorAll('.tab-pill').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.tab-pill').forEach(t => t.classList.remove('active'));
            this.classList.add('active');
        });
    });
</script>
{% endblock %}
