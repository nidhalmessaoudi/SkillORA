{% extends 'layouts/base.html.twig' %}

{% block title %}Quiz Results - {{ quiz.title }} | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Results Hero #}
    <div class="relative overflow-hidden {{ result.passed ? 'bg-gradient-to-br from-emerald-500 via-emerald-600 to-teal-600' : 'bg-gradient-to-br from-coral-500 via-red-500 to-rose-600' }}">
        {# Confetti Animation (for passed) #}
        {% if result.passed %}
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="confetti-container">
                {% for i in 1..50 %}
                <div class="confetti" style="--delay: {{ random(0, 3) }}s; --x: {{ random(0, 100) }}vw; --color: {{ ['#FFD700', '#FF6B6B', '#4ECDC4', '#A78BFA', '#F472B6', '#FBBF24'][random(0, 5)] }};"></div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
            <div class="text-center">
                {# Result Icon #}
                <div class="w-24 h-24 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto mb-6 animate-bounce-slow">
                    {% if result.passed %}
                    <i data-lucide="trophy" class="w-12 h-12 text-white"></i>
                    {% else %}
                    <i data-lucide="refresh-ccw" class="w-12 h-12 text-white"></i>
                    {% endif %}
                </div>

                {# Result Message #}
                {% if result.passed %}
                <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-3">
                    Congratulations!
                </h1>
                <p class="text-xl text-white/90 mb-8">
                    You passed the quiz with flying colors!
                </p>
                {% else %}
                <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-3">
                    Keep Going!
                </h1>
                <p class="text-xl text-white/90 mb-8">
                    You didn't pass this time, but don't give up!
                </p>
                {% endif %}

                {# Score Display #}
                <div class="inline-flex items-center gap-8 bg-white/10 backdrop-blur-sm rounded-3xl px-10 py-6 border border-white/20">
                    <div class="text-center">
                        <p class="text-6xl font-display font-bold text-white">{{ result.score }}%</p>
                        <p class="text-white/70 mt-1">Your Score</p>
                    </div>
                    <div class="w-px h-16 bg-white/20"></div>
                    <div class="text-center">
                        <p class="text-4xl font-display font-bold text-white">{{ result.correct }}/{{ result.total }}</p>
                        <p class="text-white/70 mt-1">Correct Answers</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {# XP & Rewards Card #}
        <div class="card p-6 -mt-8 relative z-10 mb-8">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
                {# XP Earned #}
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center">
                        <i data-lucide="zap" class="w-7 h-7 text-white"></i>
                    </div>
                    <div>
                        <p class="text-3xl font-display font-bold text-slate-900 dark:text-white">+{{ result.xpEarned }}</p>
                        <p class="text-slate-500 dark:text-slate-400">XP Earned</p>
                    </div>
                </div>

                {# Time Taken #}
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-harbor-400 to-harbor-600 flex items-center justify-center">
                        <i data-lucide="clock" class="w-7 h-7 text-white"></i>
                    </div>
                    <div>
                        <p class="text-3xl font-display font-bold text-slate-900 dark:text-white">{{ result.timeTaken }}</p>
                        <p class="text-slate-500 dark:text-slate-400">Time Taken</p>
                    </div>
                </div>

                {# Badges Earned #}
                {% if result.badges|default([])|length > 0 %}
                <div class="flex items-center gap-4">
                    <div class="flex -space-x-2">
                        {% for badge in result.badges|slice(0, 3) %}
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br {{ badge.color }} flex items-center justify-center ring-4 ring-white dark:ring-navy-900">
                            <i data-lucide="{{ badge.icon }}" class="w-7 h-7 text-white"></i>
                        </div>
                        {% endfor %}
                    </div>
                    <div>
                        <p class="text-lg font-display font-bold text-slate-900 dark:text-white">New Badge!</p>
                        <p class="text-slate-500 dark:text-slate-400">{{ result.badges[0].name }}</p>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# Performance Breakdown #}
        <div class="grid lg:grid-cols-3 gap-6 mb-8">
            {# Score by Category #}
            <div class="lg:col-span-2 card p-6">
                <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-6">Performance by Topic</h2>

                <div class="space-y-4">
                    {% set categories = [
                        {name: 'Core Concepts', correct: 8, total: 10, color: 'harbor'},
                        {name: 'Syntax & Structure', correct: 6, total: 8, color: 'emerald'},
                        {name: 'Best Practices', correct: 4, total: 5, color: 'amber'},
                        {name: 'Advanced Patterns', correct: 2, total: 7, color: 'violet'}
                    ] %}

                    {% for cat in categories %}
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-medium text-slate-900 dark:text-white">{{ cat.name }}</span>
                            <span class="text-sm text-slate-500 dark:text-slate-400">{{ cat.correct }}/{{ cat.total }} correct</span>
                        </div>
                        <div class="w-full bg-slate-200 dark:bg-navy-800 rounded-full h-3 overflow-hidden">
                            <div class="h-full bg-{{ cat.color }}-500 rounded-full transition-all duration-500" style="width: {{ (cat.correct / cat.total * 100)|round }}%"></div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# Quick Stats #}
            <div class="card p-6">
                <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-6">Quiz Stats</h2>

                <div class="space-y-4">
                    <div class="flex items-center justify-between p-3 rounded-xl bg-emerald-50 dark:bg-emerald-900/20">
                        <div class="flex items-center gap-3">
                            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-500"></i>
                            <span class="text-slate-700 dark:text-slate-300">Correct</span>
                        </div>
                        <span class="font-bold text-emerald-600 dark:text-emerald-400">{{ result.correct }}</span>
                    </div>

                    <div class="flex items-center justify-between p-3 rounded-xl bg-red-50 dark:bg-red-900/20">
                        <div class="flex items-center gap-3">
                            <i data-lucide="x-circle" class="w-5 h-5 text-red-500"></i>
                            <span class="text-slate-700 dark:text-slate-300">Incorrect</span>
                        </div>
                        <span class="font-bold text-red-600 dark:text-red-400">{{ result.total - result.correct }}</span>
                    </div>

                    <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                        <div class="flex items-center gap-3">
                            <i data-lucide="skip-forward" class="w-5 h-5 text-slate-400"></i>
                            <span class="text-slate-700 dark:text-slate-300">Skipped</span>
                        </div>
                        <span class="font-bold text-slate-600 dark:text-slate-400">{{ result.skipped|default(0) }}</span>
                    </div>

                    <div class="flex items-center justify-between p-3 rounded-xl bg-harbor-50 dark:bg-harbor-900/20">
                        <div class="flex items-center gap-3">
                            <i data-lucide="target" class="w-5 h-5 text-harbor-500"></i>
                            <span class="text-slate-700 dark:text-slate-300">Accuracy</span>
                        </div>
                        <span class="font-bold text-harbor-600 dark:text-harbor-400">{{ result.score }}%</span>
                    </div>
                </div>
            </div>
        </div>

        {# Answer Review #}
        <div class="card p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white">Review Answers</h2>
                <div class="flex items-center gap-2">
                    <button class="tab-pill active text-sm" onclick="filterAnswers('all')">All</button>
                    <button class="tab-pill text-sm" onclick="filterAnswers('correct')">Correct</button>
                    <button class="tab-pill text-sm" onclick="filterAnswers('incorrect')">Incorrect</button>
                </div>
            </div>

            <div class="space-y-4" id="answersList">
                {% for i in 1..5 %}
                {% set isCorrect = i in [1, 2, 4] %}
                <div class="answer-item {{ isCorrect ? 'correct' : 'incorrect' }} p-4 rounded-2xl border-2 {{ isCorrect ? 'border-emerald-200 dark:border-emerald-900/50 bg-emerald-50/50 dark:bg-emerald-900/10' : 'border-red-200 dark:border-red-900/50 bg-red-50/50 dark:bg-red-900/10' }}">
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 rounded-xl {{ isCorrect ? 'bg-emerald-100 dark:bg-emerald-900/30' : 'bg-red-100 dark:bg-red-900/30' }} flex items-center justify-center flex-shrink-0">
                            <i data-lucide="{{ isCorrect ? 'check' : 'x' }}" class="w-5 h-5 {{ isCorrect ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400' }}"></i>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Question {{ i }}</span>
                                <span class="badge {{ isCorrect ? 'badge-success' : 'badge-danger' }} text-xs">{{ isCorrect ? 'Correct' : 'Incorrect' }}</span>
                            </div>
                            <p class="font-medium text-slate-900 dark:text-white mb-3">
                                {{ ['What is the purpose of useEffect in React?', 'Which method is used to update state?', 'What does JSX stand for?', 'How do you pass data to child components?', 'What is the virtual DOM?'][i-1] }}
                            </p>

                            <div class="grid sm:grid-cols-2 gap-2 text-sm">
                                <div class="p-2 rounded-lg {{ isCorrect ? 'bg-emerald-100 dark:bg-emerald-900/30' : 'bg-red-100 dark:bg-red-900/30' }}">
                                    <span class="text-slate-500 dark:text-slate-400">Your answer:</span>
                                    <p class="{{ isCorrect ? 'text-emerald-700 dark:text-emerald-400' : 'text-red-700 dark:text-red-400' }} font-medium">Option {{ ['A', 'B', 'C', 'D'][random(0,3)] }}</p>
                                </div>
                                {% if not isCorrect %}
                                <div class="p-2 rounded-lg bg-emerald-100 dark:bg-emerald-900/30">
                                    <span class="text-slate-500 dark:text-slate-400">Correct answer:</span>
                                    <p class="text-emerald-700 dark:text-emerald-400 font-medium">Option A</p>
                                </div>
                                {% endif %}
                            </div>

                            {% if not isCorrect %}
                            <div class="mt-3 p-3 rounded-lg bg-slate-100 dark:bg-navy-800">
                                <p class="text-sm text-slate-600 dark:text-slate-400">
                                    <i data-lucide="lightbulb" class="w-4 h-4 inline text-amber-500 mr-1"></i>
                                    <strong>Explanation:</strong> This is the correct explanation for why Option A is the right answer...
                                </p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {# Action Buttons #}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            {% if not result.passed %}
            <a href="{{ path('quiz_attempt', {id: quiz.id}) }}" class="btn-primary px-8 py-3 w-full sm:w-auto justify-center">
                <i data-lucide="rotate-ccw" class="w-5 h-5 mr-2"></i>
                Retake Quiz
            </a>
            {% endif %}
            <a href="{{ path('quiz_index') }}" class="btn-outline px-8 py-3 w-full sm:w-auto justify-center">
                <i data-lucide="layout-grid" class="w-5 h-5 mr-2"></i>
                Back to Quizzes
            </a>
            <a href="{{ path('learn_index') }}" class="btn-ghost px-8 py-3 w-full sm:w-auto justify-center">
                <i data-lucide="book-open" class="w-5 h-5 mr-2"></i>
                Continue Learning
            </a>
        </div>
    </div>
</div>

<style>
    @keyframes bounce-slow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .animate-bounce-slow {
        animation: bounce-slow 2s ease-in-out infinite;
    }

    @keyframes confetti-fall {
        0% {
            transform: translateY(-100vh) rotate(0deg);
            opacity: 1;
        }
        100% {
            transform: translateY(100vh) rotate(720deg);
            opacity: 0;
        }
    }

    .confetti {
        position: absolute;
        width: 10px;
        height: 10px;
        background-color: var(--color);
        left: var(--x);
        animation: confetti-fall 3s ease-in-out var(--delay) infinite;
    }

    .confetti:nth-child(odd) {
        border-radius: 50%;
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Filter answers
    function filterAnswers(type) {
        const items = document.querySelectorAll('.answer-item');
        const tabs = document.querySelectorAll('.tab-pill');

        tabs.forEach(t => t.classList.remove('active'));
        event.target.classList.add('active');

        items.forEach(item => {
            if (type === 'all') {
                item.style.display = 'block';
            } else if (type === 'correct') {
                item.style.display = item.classList.contains('correct') ? 'block' : 'none';
            } else if (type === 'incorrect') {
                item.style.display = item.classList.contains('incorrect') ? 'block' : 'none';
            }
        });
    }
</script>
{% endblock %}
