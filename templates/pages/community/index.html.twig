{% extends 'layouts/base.html.twig' %}

{% block title %}Community - SkillHarbor{% endblock %}

{% set emojiMap = {
    'like': '👍',
    'love': '❤️',
    'haha': '😂',
    'wow': '😮',
    'sad': '😢',
    'angry': '😡'
} %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Hero Section #}
    <div class="bg-gradient-to-br from-emerald-600 via-teal-600 to-cyan-700 relative overflow-hidden">
        <div class="absolute inset-0">
            <div class="absolute top-10 right-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 left-10 w-96 h-96 bg-emerald-400/10 rounded-full blur-3xl"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
            <div class="text-center max-w-3xl mx-auto">
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
                    <i data-lucide="users" class="w-4 h-4 text-emerald-200"></i>
                    <span class="text-sm font-medium text-white">Learning Community</span>
                </div>
                <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-4">
                    Connect & Learn Together
                </h1>
                <p class="text-lg text-emerald-100 mb-8">
                    Ask questions, share knowledge, and grow with fellow learners
                </p>

                {# Search Bar #}
                <div class="max-w-2xl mx-auto mb-6">
                    <form method="get" action="{{ path('community_index') }}" class="relative">
                        <input type="hidden" name="tab" value="{{ current_tab|default('hot') }}">
                        {% if current_topic %}
                            <input type="hidden" name="topic" value="{{ current_topic }}">
                        {% endif %}
                        
                        <i data-lucide="search" class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 z-10"></i>
                        <input 
                            type="text" 
                            name="q" 
                            value="{{ searchQuery|default('') }}" 
                            placeholder="Search posts, tags, or users..."
                            class="w-full pl-12 pr-24 py-4 rounded-full bg-white dark:bg-navy-900 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white/50 shadow-lg"
                        >
                        {% if searchQuery %}
                            <a href="{{ path('community_index', {'tab': current_tab, 'topic': current_topic}) }}" 
                               class="absolute right-16 top-1/2 -translate-y-1/2 p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </a>
                        {% endif %}
                        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-full font-medium transition-colors">
                            Search
                        </button>
                    </form>
                </div>

                <div class="flex flex-wrap justify-center gap-4">
                    {% if app.user %}
                        <button onclick="openCreatePostModal()" class="btn bg-white text-emerald-700 hover:bg-emerald-50 px-6 py-3 font-semibold shadow-lg">
                            <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                            New Post
                        </button>
                    {% else %}
                        <a href="{{ path('auth_login') }}" class="btn bg-white text-emerald-700 hover:bg-emerald-50 px-6 py-3 font-semibold">
                            <i data-lucide="log-in" class="w-5 h-5 mr-2"></i>
                            Login to Post
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-8">
            {# Main Feed #}
            <div class="flex-1">
                {# Search Results Info #}
                {% if searchQuery %}
                    <div class="mb-6 p-4 bg-white dark:bg-navy-900 rounded-xl border border-slate-200 dark:border-navy-800">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <i data-lucide="search" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                                <div>
                                    <p class="text-sm font-medium text-slate-900 dark:text-white">
                                        {% if resultCount > 0 %}
                                            Found {{ resultCount }} {{ resultCount == 1 ? 'result' : 'results' }}
                                        {% else %}
                                            No results found
                                        {% endif %}
                                        for "<span class="text-emerald-600 dark:text-emerald-400">{{ searchQuery }}</span>"
                                    </p>
                                </div>
                            </div>
                            <a href="{{ path('community_index', {'tab': current_tab, 'topic': current_topic}) }}" 
                               class="text-sm text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-1">
                                <i data-lucide="x" class="w-4 h-4"></i>
                                Clear
                            </a>
                        </div>
                    </div>
                {% endif %}

                {# Filters & Sort #}
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0">
                        {% set baseParams = {'topic': current_topic|default(null), 'q': searchQuery|default(null)} %}
                        <a href="{{ path('community_index', baseParams|merge({'tab':'hot'}) ) }}" class="tab-pill {{ current_tab == 'hot' ? 'active' : '' }}">
                            <i data-lucide="flame" class="w-4 h-4 mr-1"></i> Hot
                        </a>

                        <a href="{{ path('community_index', baseParams|merge({'tab':'new'}) ) }}" class="tab-pill {{ current_tab == 'new' ? 'active' : '' }}">
                            <i data-lucide="sparkles" class="w-4 h-4 mr-1"></i> New
                        </a>

                        <a href="{{ path('community_index', baseParams|merge({'tab':'top'}) ) }}" class="tab-pill {{ current_tab == 'top' ? 'active' : '' }}">
                            <i data-lucide="trending-up" class="w-4 h-4 mr-1"></i> Top
                        </a>

                        <a href="{{ path('community_index', baseParams|merge({'tab':'unanswered'}) ) }}" class="tab-pill {{ current_tab == 'unanswered' ? 'active' : '' }}">
                            <i data-lucide="help-circle" class="w-4 h-4 mr-1"></i> Unanswered
                        </a>
                    </div>

                    {# Topic selector #}
                    <div class="mt-2 sm:mt-0">
                        <form method="get" action="{{ path('community_index') }}" class="inline-flex items-center gap-3">
                            <input type="hidden" name="tab" value="{{ current_tab|default('hot') }}">
                            {% if searchQuery %}
                                <input type="hidden" name="q" value="{{ searchQuery }}">
                            {% endif %}

                            <select name="topic" onchange="this.form.submit()" class="input rounded-full px-4 py-2 text-sm">
                                <option value="">All Topics</option>
                                {% for t in topics|default([]) %}
                                    <option value="{{ t }}" {{ current_topic is defined and current_topic == t ? 'selected' : '' }}>{{ t }}</option>
                                {% endfor %}
                            </select>

                            {% if current_topic %}
                                <a href="{{ path('community_index', {'tab': current_tab|default('hot'), 'q': searchQuery}) }}" class="text-sm text-slate-500 hover:text-emerald-600">Clear</a>
                            {% endif %}
                        </form>
                    </div>
                </div>

                {# Posts List #}
                <div class="space-y-4">
                    {% for post in posts %}
                        {% set postData = reactionData[post.id]|default({'userReaction': null, 'counts': {}, 'total': 0}) %}
                    <article class="card p-6 hover:shadow-lg transition-all duration-300 cursor-pointer" onclick="openPostModal({{ post.id }})">
                        <div class="flex gap-4">
                            {# Post Content #}
                            <div class="flex-1 min-w-0">
                                {# Post Meta #}
                                <div class="flex items-center gap-2 mb-2 text-sm">
                                    {% set badgeLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                                    {% set badgeClass = post.type == 'discussion'
                                        ? 'badge-primary'
                                        : (post.type == 'article' ? 'badge-success' : 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400') %}
                                    <span class="badge {{ badgeClass }}">{{ badgeLabel }}</span>
                                </div>

                                {# Title #}
                                <div class="block mb-2">
                                    <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                                        {{ post.title }}
                                    </h2>
                                </div>

                                {# Preview Text #}
                                <p class="text-slate-600 dark:text-slate-400 text-sm line-clamp-3 mb-4">
                                    {{ post.content|striptags|slice(0, 250) }}{% if post.content|length > 250 %}...{% endif %}
                                </p>

                                {# Post Footer #}
                                <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
                                    <div class="flex items-center gap-2">
                                        {% if post.author.avatar %}
                                            <img src="{{ post.author.avatar }}" alt="{{ post.author.fullName }}" class="w-6 h-6 rounded-full object-cover">
                                        {% else %}
                                            <div class="w-6 h-6 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xs font-medium">
                                                {{ post.author.fullName|slice(0,1)|upper }}
                                            </div>
                                        {% endif %}
                                        <span>{{ post.author.fullName }}</span>
                                    </div>
                                    <span class="text-slate-300 dark:text-slate-600">•</span>
                                    <span>{{ post.createdAt ? post.createdAt|date('M j, Y') : '' }}</span>
                                    <span class="text-slate-300 dark:text-slate-600">•</span>
                                    <div class="flex items-center gap-1">
                                        <i data-lucide="message-square" class="w-4 h-4"></i>
                                        {{ post.replies|length }} {{ post.replies|length == 1 ? 'reply' : 'replies' }}
                                    </div>

                                    {# Reactions Summary #}
                                    {% if postData.total > 0 %}
                                        <span class="text-slate-300 dark:text-slate-600">•</span>
                                        <div class="flex items-center gap-1">
                                            <span>{{ emojiMap[postData.userReaction] ?? '👍' }}</span>
                                            <span>{{ postData.total }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </article>
                    {% else %}
                    <div class="card p-6 text-center text-slate-500 dark:text-slate-400">
                        {% if searchQuery %}
                            <i data-lucide="search-x" class="w-12 h-12 text-slate-300 dark:text-slate-600 mx-auto mb-3"></i>
                            <p class="font-medium mb-2">No posts found</p>
                            <a href="{{ path('community_index') }}" class="text-emerald-600 hover:text-emerald-700 text-sm">View all posts</a>
                        {% else %}
                            No posts yet. Be the first!
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# Sidebar #}
            <aside class="lg:w-80 space-y-6">
                {# Create Post CTA #}
                <div class="card p-6 bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20 border-emerald-200 dark:border-emerald-800/50">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-2">Have a question?</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Join the conversation!</p>
                    {% if app.user %}
                        <button onclick="openCreatePostModal()" class="btn-primary w-full justify-center">
                            <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                            Create Post
                        </button>
                    {% else %}
                        <a href="{{ path('auth_login') }}" class="btn-primary w-full justify-center">
                            <i data-lucide="log-in" class="w-4 h-4 mr-2"></i>
                            Login to Post
                        </a>
                    {% endif %}
                </div>

                {# Popular Topics #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="trending-up" class="w-5 h-5 text-emerald-500"></i>
                        Popular Topics
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        {% set commonTopics = ['JavaScript', 'React', 'Python', 'CSS', 'PHP', 'Database', 'Career'] %}
                        {% for topic in commonTopics %}
                        <a href="{{ path('community_index', {'tab': current_tab|default('hot'), 'topic': topic}) }}" class="badge bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                            {{ topic }}
                        </a>
                        {% endfor %}
                    </div>
                </div>

                {# Community Stats #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Community Stats</h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="text-center p-3 rounded-xl bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ posts|length }}</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Posts</p>
                        </div>
                        <div class="text-center p-3 rounded-xl bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">12.5K</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Members</p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

{# POST DETAIL MODAL #}
<div id="post-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm overflow-y-auto" onclick="closePostModal(event)">
    <div class="min-h-screen px-4 py-8 flex items-start justify-center">
        <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-2xl w-full max-w-4xl relative animate-fade-in" onclick="event.stopPropagation()">
            {# Close Button #}
            <button onclick="closePostModal()" class="absolute top-4 right-4 p-2 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors z-10">
                <i data-lucide="x" class="w-6 h-6 text-slate-600 dark:text-slate-400"></i>
            </button>

            {# Modal Content - Loaded Dynamically #}
            <div id="post-modal-content" class="p-8">
                <div class="flex items-center justify-center py-12">
                    <div class="animate-spin rounded-full h-12 w-12 border-4 border-emerald-500 border-t-transparent"></div>
                </div>
            </div>
        </div>
    </div>
</div>

{# CREATE POST MODAL #}
<div id="create-post-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm overflow-y-auto" onclick="closeCreatePostModal(event)">
    <div class="min-h-screen px-4 py-8 flex items-start justify-center">
        <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-2xl w-full max-w-2xl relative animate-fade-in" onclick="event.stopPropagation()">
            {# Header #}
            <div class="flex items-center justify-between p-6 border-b border-slate-200 dark:border-navy-800">
                <h2 class="text-2xl font-display font-bold text-slate-900 dark:text-white">Create Post</h2>
                <button onclick="closeCreatePostModal()" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors">
                    <i data-lucide="x" class="w-6 h-6 text-slate-600 dark:text-slate-400"></i>
                </button>
            </div>

            {# Create Form #}
            <form action="{{ path('community_create') }}" method="post" class="p-6 space-y-6">
                {# Post Type #}
                <div>
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">Post Type</label>
                    <div class="grid grid-cols-3 gap-3">
                        <label>
                            <input type="radio" name="type" value="question" checked class="peer sr-only">
                            <div class="peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-900/20 peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400 border-2 border-slate-200 dark:border-navy-800 rounded-xl p-4 text-center cursor-pointer hover:border-slate-300 dark:hover:border-navy-700 transition-all">
                                <i data-lucide="help-circle" class="w-6 h-6 mx-auto mb-2"></i>
                                <span class="font-medium text-sm">Question</span>
                            </div>
                        </label>
                        <label>
                            <input type="radio" name="type" value="discussion" class="peer sr-only">
                            <div class="peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-900/20 peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400 border-2 border-slate-200 dark:border-navy-800 rounded-xl p-4 text-center cursor-pointer hover:border-slate-300 dark:hover:border-navy-700 transition-all">
                                <i data-lucide="message-circle" class="w-6 h-6 mx-auto mb-2"></i>
                                <span class="font-medium text-sm">Discussion</span>
                            </div>
                        </label>
                        <label>
                            <input type="radio" name="type" value="article" class="peer sr-only">
                            <div class="peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-900/20 peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400 border-2 border-slate-200 dark:border-navy-800 rounded-xl p-4 text-center cursor-pointer hover:border-slate-300 dark:hover:border-navy-700 transition-all">
                                <i data-lucide="file-text" class="w-6 h-6 mx-auto mb-2"></i>
                                <span class="font-medium text-sm">Article</span>
                            </div>
                        </label>
                    </div>
                </div>

                {# Title #}
                <div>
                    <label for="title" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Title *</label>
                    <input type="text" id="title" name="title" required maxlength="255" placeholder="What's your question or topic?" class="input">
                </div>

                {# Topic #}
                <div>
                    <label for="topic" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Topic</label>
                    <select name="topic" id="topic" class="input">
                        <option value="">Select a topic (optional)...</option>
                        <option value="JavaScript">JavaScript</option>
                        <option value="Python">Python</option>
                        <option value="React">React</option>
                        <option value="PHP">PHP</option>
                        <option value="CSS">CSS</option>
                        <option value="Database">Database</option>
                    </select>
                </div>

                {# Content #}
                <div>
                    <label for="content" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Content *</label>
                    <textarea id="content" name="content" rows="6" required placeholder="Describe your question in detail..." class="input resize-none"></textarea>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Markdown formatting is supported</p>
                </div>

                {# Tags #}
                <div>
                    <label for="tags" class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Tags</label>
                    <input type="text" id="tags" name="tags" placeholder="javascript, react, debugging" class="input">
                </div>

                {# Buttons #}
                <div class="flex gap-3 pt-4">
                    <button type="button" onclick="closeCreatePostModal()" class="btn-outline flex-1">Cancel</button>
                    <button type="submit" class="btn-primary flex-1">
                        <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                        Publish
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Open create post modal
    function openCreatePostModal() {
        document.getElementById('create-post-modal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        lucide.createIcons();
    }

    // Close create post modal
    function closeCreatePostModal(event) {
        if (event && event.target !== event.currentTarget) return;
        document.getElementById('create-post-modal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    // Open post modal
    async function openPostModal(postId) {
        const modal = document.getElementById('post-modal');
        const content = document.getElementById('post-modal-content');
        
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        try {
            const response = await fetch(`/community/${postId}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const html = await response.text();
            content.innerHTML = html;
            lucide.createIcons();
        } catch (error) {
            console.error('Error loading post:', error);
            content.innerHTML = '<div class="p-8 text-center text-red-600">Failed to load post</div>';
        }
    }

    // Close post modal
    function closePostModal(event) {
        if (event && event.target !== event.currentTarget && !event.target.closest('[data-close-modal]')) return;
        document.getElementById('post-modal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    // Reaction emoji mapping
    const reactionEmojis = {
        'like': '👍',
        'love': '❤️',
        'haha': '😂',
        'wow': '😮',
        'sad': '😢',
        'angry': '😡'
    };

    // ESC key to close modals
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closePostModal();
            closeCreatePostModal();
        }
    });
</script>

<style>
@keyframes fade-in {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in {
    animation: fade-in 0.3s ease-out;
}
</style>
{% endblock %}