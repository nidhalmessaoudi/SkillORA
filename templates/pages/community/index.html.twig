{% extends 'layouts/base.html.twig' %}

{% block title %}Community - SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Hero Section #}
    <div class="bg-gradient-to-br from-emerald-600 via-teal-600 to-cyan-700 relative overflow-hidden">
        <div class="absolute inset-0">
            <div class="absolute top-10 right-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 left-10 w-96 h-96 bg-emerald-400/10 rounded-full blur-3xl"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
            <div class="text-center max-w-3xl mx-auto">
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
                    <i data-lucide="users" class="w-4 h-4 text-emerald-200"></i>
                    <span class="text-sm font-medium text-white">Learning Community</span>
                </div>
                <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-4">
                    Connect & Learn Together
                </h1>
                <p class="text-lg text-emerald-100 mb-8">
                    Ask questions, share knowledge, and grow with fellow learners. Your learning journey is better together!
                </p>

                <div class="flex flex-wrap justify-center gap-4">
                    <a href="{{ path('community_create') }}" class="btn bg-white text-emerald-700 hover:bg-emerald-50 px-6 py-3 font-semibold">
                        <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                        New Post
                    </a>
                    <button class="btn bg-white/10 text-white hover:bg-white/20 border border-white/20 px-6 py-3">
                        <i data-lucide="search" class="w-5 h-5 mr-2"></i>
                        Search Topics
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-8">
            {# Main Feed #}
            <div class="flex-1">
                {# Filters & Sort #}
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0">
                        <button class="tab-pill active">
                            <i data-lucide="sparkles" class="w-4 h-4 mr-1"></i>
                            Hot
                        </button>
                        <button class="tab-pill">
                            <i data-lucide="clock" class="w-4 h-4 mr-1"></i>
                            New
                        </button>
                        <button class="tab-pill">
                            <i data-lucide="trending-up" class="w-4 h-4 mr-1"></i>
                            Top
                        </button>
                        <button class="tab-pill">
                            <i data-lucide="help-circle" class="w-4 h-4 mr-1"></i>
                            Unanswered
                        </button>
                    </div>

                    <select class="input py-2.5 w-auto text-sm">
                        <option>All Topics</option>
                        <option>Web Development</option>
                        <option>Data Science</option>
                        <option>Design</option>
                        <option>Career</option>
                    </select>
                </div>

                {# Posts List #}
                <div class="space-y-4">
                    {% for post in posts %}
                    <article class="card p-6 hover:shadow-lg transition-all duration-300">
                        <div class="flex gap-4">
                            {# Vote Column #}
                            <div class="flex flex-col items-center gap-1">
                                <button class="p-1.5 rounded-lg hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-colors group">
                                    <i data-lucide="chevron-up" class="w-5 h-5 text-slate-400 group-hover:text-emerald-600"></i>
                                </button>
                                <span class="font-semibold text-slate-900 dark:text-white">{{ post.upvotes }}</span>
                                <button class="p-1.5 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors group">
                                    <i data-lucide="chevron-down" class="w-5 h-5 text-slate-400 group-hover:text-red-600"></i>
                                </button>
                            </div>

                            {# Post Content #}
                            <div class="flex-1 min-w-0">
                                {# Post Meta #}
                                <div class="flex items-center gap-2 mb-2 text-sm">
                                    <span class="badge {{ post.tag == 'Discussion' ? 'badge-primary' : (post.tag == 'Success Story' ? 'badge-success' : 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400') }}">
                                        {{ post.tag }}
                                    </span>
                                    {% if post.solved|default(false) %}
                                    <span class="badge badge-success">
                                        <i data-lucide="check" class="w-3 h-3 mr-1"></i>
                                        Solved
                                    </span>
                                    {% endif %}
                                </div>

                                {# Title #}
                                <a href="{{ path('community_post', {id: post.id}) }}" class="block mb-2 group">
                                    <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                                        {{ post.title }}
                                    </h2>
                                </a>

                                {# Preview Text #}
                                <p class="text-slate-600 dark:text-slate-400 text-sm line-clamp-2 mb-4">
                                    {{ post.content|slice(0, 200) }}...
                                </p>

                                {# Post Footer #}
                                <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
                                    <div class="flex items-center gap-2">
                                        <div class="w-6 h-6 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xs font-medium">
                                            {{ post.author|slice(0, 1) }}
                                        </div>
                                        <span>{{ post.author }}</span>
                                    </div>
                                    <span class="text-slate-300 dark:text-slate-600">•</span>
                                    <span>{{ post.created_at }}</span>
                                    <span class="text-slate-300 dark:text-slate-600">•</span>
                                    <a href="{{ path('community_post', {id: post.id}) }}" class="flex items-center gap-1 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                                        <i data-lucide="message-square" class="w-4 h-4"></i>
                                        {{ post.comments_count }} {{ post.comments_count == 1 ? 'reply' : 'replies' }}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                    {% endfor %}
                </div>

                {# Load More #}
                <div class="text-center mt-8">
                    <button class="btn-outline px-8">
                        Load More Posts
                        <i data-lucide="chevron-down" class="w-4 h-4 ml-2"></i>
                    </button>
                </div>
            </div>

            {# Sidebar #}
            <aside class="lg:w-80 space-y-6">
                {# Create Post CTA #}
                <div class="card p-6 bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20 border-emerald-200 dark:border-emerald-800/50">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-2">Have a question?</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Join the conversation and get help from the community.</p>
                    <a href="{{ path('community_create') }}" class="btn-primary w-full justify-center">
                        <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                        Create Post
                    </a>
                </div>

                {# Popular Topics #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Popular Topics</h3>
                    <div class="flex flex-wrap gap-2">
                        {% set topics = ['JavaScript', 'React', 'Python', 'Machine Learning', 'CSS', 'TypeScript', 'Node.js', 'Career Advice', 'Algorithms', 'System Design'] %}
                        {% for topic in topics %}
                        <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                            {{ topic }}
                        </a>
                        {% endfor %}
                    </div>
                </div>

                {# Top Contributors #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Top Contributors</h3>
                    <div class="space-y-4">
                        {% set contributors = [
                            {name: 'Emma Rodriguez', avatar: 'photo-1438761681033-6461ffad8d80', points: 2450, badge: 'gold'},
                            {name: 'Marcus Chen', avatar: 'photo-1507003211169-0a1dd7228f2d', points: 1820, badge: 'gold'},
                            {name: 'Sophie Williams', avatar: 'photo-1494790108377-be9c29b29330', points: 1340, badge: 'silver'},
                            {name: 'David Kim', avatar: 'photo-1506794778202-cad84cf45f1d', points: 980, badge: 'silver'},
                            {name: 'Olivia Brown', avatar: 'photo-1534528741775-53994a69daeb', points: 720, badge: 'bronze'}
                        ] %}

                        {% for contributor in contributors %}
                        <div class="flex items-center gap-3">
                            <span class="w-6 text-center font-medium text-slate-500 dark:text-slate-400">{{ loop.index }}</span>
                            <img src="https://images.unsplash.com/{{ contributor.avatar }}?w=100" alt="{{ contributor.name }}" class="w-10 h-10 rounded-full object-cover">
                            <div class="flex-1 min-w-0">
                                <p class="font-medium text-slate-900 dark:text-white text-sm truncate">{{ contributor.name }}</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">{{ contributor.points }} points</p>
                            </div>
                            <div class="w-6 h-6 rounded-full {{ contributor.badge == 'gold' ? 'bg-amber-400' : (contributor.badge == 'silver' ? 'bg-slate-400' : 'bg-amber-700') }} flex items-center justify-center">
                                <i data-lucide="award" class="w-3 h-3 text-white"></i>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>

                {# Community Guidelines #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="book-open" class="w-5 h-5 text-emerald-500"></i>
                        Community Guidelines
                    </h3>
                    <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5"></i>
                            <span>Be respectful and helpful to others</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5"></i>
                            <span>Search before posting duplicates</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5"></i>
                            <span>Use code formatting for code snippets</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5"></i>
                            <span>Mark answers as solved when resolved</span>
                        </li>
                    </ul>
                </div>

                {# Community Stats #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Community Stats</h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="text-center p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">12.5K</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Members</p>
                        </div>
                        <div class="text-center p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">45.2K</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Posts</p>
                        </div>
                        <div class="text-center p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">89%</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Solved Rate</p>
                        </div>
                        <div class="text-center p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">2.4K</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Online Now</p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Tab filtering
    document.querySelectorAll('.tab-pill').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.tab-pill').forEach(t => t.classList.remove('active'));
            this.classList.add('active');
        });
    });
</script>
{% endblock %}
