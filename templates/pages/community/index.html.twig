{% extends 'layouts/base.html.twig' %}

{% block title %}Community - SkillHarbor{% endblock %}

{% set emojiMap = {
    'like': '👍',
    'love': '❤️',
    'haha': '😂',
    'wow': '😮',
    'sad': '😢',
    'angry': '😡'
} %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Hero Section #}
    <div class="bg-gradient-to-br from-emerald-600 via-teal-600 to-cyan-700 relative overflow-hidden">
        <div class="absolute inset-0">
            <div class="absolute top-10 right-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 left-10 w-96 h-96 bg-emerald-400/10 rounded-full blur-3xl"></div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative">
            <div class="text-center max-w-3xl mx-auto">
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-2 mb-6">
                    <i data-lucide="users" class="w-4 h-4 text-emerald-200"></i>
                    <span class="text-sm font-medium text-white">Learning Community</span>
                </div>
                <h1 class="text-4xl lg:text-5xl font-display font-bold text-white mb-4">
                    Connect & Learn Together
                </h1>
                <p class="text-lg text-emerald-100 mb-8">
                    Ask questions, share knowledge, and grow with fellow learners
                </p>

                {# Search Bar #}
                <div class="max-w-2xl mx-auto mb-6">
                    <form method="get" action="{{ path('community_index') }}" class="relative">
                        <input type="hidden" name="tab" value="{{ current_tab|default('hot') }}">
                        {% if current_topic %}
                            <input type="hidden" name="topic" value="{{ current_topic }}">
                        {% endif %}
                        
                        <i data-lucide="search" class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 z-10"></i>
                        <input 
                            type="text" 
                            name="q" 
                            value="{{ searchQuery|default('') }}" 
                            placeholder="Search posts, tags, or users..."
                            class="w-full pl-12 pr-24 py-4 rounded-full bg-white dark:bg-navy-900 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white/50 shadow-lg"
                        >
                        {% if searchQuery %}
                            <a href="{{ path('community_index', {'tab': current_tab, 'topic': current_topic}) }}" 
                               class="absolute right-16 top-1/2 -translate-y-1/2 p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </a>
                        {% endif %}
                        <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-full font-medium transition-colors">
                            Search
                        </button>
                    </form>
                </div>

                <div class="flex flex-wrap justify-center gap-4">
                    {% if app.user %}
                        <a href="{{ path('community_create') }}" class="btn bg-white text-emerald-700 hover:bg-emerald-50 px-6 py-3 font-semibold">
                            <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                            New Post
                        </a>
                    {% else %}
                        <a href="{{ path('auth_login') }}" class="btn bg-white text-emerald-700 hover:bg-emerald-50 px-6 py-3 font-semibold">
                            <i data-lucide="log-in" class="w-5 h-5 mr-2"></i>
                            Login to Post
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col lg:flex-row gap-8">
            {# Main Feed #}
            <div class="flex-1">
                {# Search Results Info #}
                {% if searchQuery %}
                    <div class="mb-6 p-4 bg-white dark:bg-navy-900 rounded-xl border border-slate-200 dark:border-navy-800">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <i data-lucide="search" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                                <div>
                                    <p class="text-sm font-medium text-slate-900 dark:text-white">
                                        {% if resultCount > 0 %}
                                            Found {{ resultCount }} {{ resultCount == 1 ? 'result' : 'results' }}
                                        {% else %}
                                            No results found
                                        {% endif %}
                                        for "<span class="text-emerald-600 dark:text-emerald-400">{{ searchQuery }}</span>"
                                    </p>
                                </div>
                            </div>
                            <a href="{{ path('community_index', {'tab': current_tab, 'topic': current_topic}) }}" 
                               class="text-sm text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-1">
                                <i data-lucide="x" class="w-4 h-4"></i>
                                Clear
                            </a>
                        </div>
                    </div>
                {% endif %}

                {# Filters & Sort #}
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0">
                        {% set baseParams = {'topic': current_topic|default(null), 'q': searchQuery|default(null)} %}
                        <a href="{{ path('community_index', baseParams|merge({'tab':'hot'}) ) }}" class="tab-pill {{ current_tab == 'hot' ? 'active' : '' }}">
                            <i data-lucide="flame" class="w-4 h-4 mr-1"></i> Hot
                        </a>

                        <a href="{{ path('community_index', baseParams|merge({'tab':'new'}) ) }}" class="tab-pill {{ current_tab == 'new' ? 'active' : '' }}">
                            <i data-lucide="sparkles" class="w-4 h-4 mr-1"></i> New
                        </a>

                        <a href="{{ path('community_index', baseParams|merge({'tab':'top'}) ) }}" class="tab-pill {{ current_tab == 'top' ? 'active' : '' }}">
                            <i data-lucide="trending-up" class="w-4 h-4 mr-1"></i> Top
                        </a>

                        <a href="{{ path('community_index', baseParams|merge({'tab':'unanswered'}) ) }}" class="tab-pill {{ current_tab == 'unanswered' ? 'active' : '' }}">
                            <i data-lucide="help-circle" class="w-4 h-4 mr-1"></i> Unanswered
                        </a>
                    </div>

                    {# Topic selector #}
                    <div class="mt-2 sm:mt-0">
                        <form method="get" action="{{ path('community_index') }}" class="inline-flex items-center gap-3">
                            <input type="hidden" name="tab" value="{{ current_tab|default('hot') }}">
                            {% if searchQuery %}
                                <input type="hidden" name="q" value="{{ searchQuery }}">
                            {% endif %}

                            <select name="topic" onchange="this.form.submit()" class="input rounded-full px-4 py-2 text-sm">
                                <option value="">All Topics</option>
                                {% for t in topics|default([]) %}
                                    <option value="{{ t }}" {{ current_topic is defined and current_topic == t ? 'selected' : '' }}>{{ t }}</option>
                                {% endfor %}
                            </select>

                            {% if current_topic %}
                                <a href="{{ path('community_index', {'tab': current_tab|default('hot'), 'q': searchQuery}) }}" class="text-sm text-slate-500 hover:text-emerald-600">Clear</a>
                            {% endif %}
                        </form>
                    </div>
                </div>

                {# Posts List #}
                <div class="space-y-4">
                    {% for post in pagination %}
                        {% set postData = reactionData[post.id]|default({'userReaction': null, 'counts': {}, 'total': 0}) %}
                    <article class="card p-6 hover:shadow-lg transition-all duration-300">
                        <div class="flex gap-4">
                            {# Post Content #}
                            <div class="flex-1 min-w-0">
                                {# Post Meta #}
                                <div class="flex items-center gap-2 mb-2 text-sm">
                                    {% set badgeLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                                    {% set badgeClass = post.type == 'discussion'
                                        ? 'badge-primary'
                                        : (post.type == 'article' ? 'badge-success' : 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400') %}
                                    <span class="badge {{ badgeClass }}">{{ badgeLabel }}</span>
                                </div>

                                {# Title #}
                                <a href="{{ path('community_post', {id: post.id}) }}" class="block mb-2 group">
                                    <h2 class="text-lg font-display font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                                        {{ post.title }}
                                    </h2>
                                </a>

                                {# Extract first image from content if exists #}
                                {% set firstImage = post.content|extract_first_image %}
                                
                                <div class="flex gap-4 mb-4">
                                    <div class="flex-1">
                                        {# Preview Text - Strip markdown #}
                                        <p class="text-slate-600 dark:text-slate-400 text-sm line-clamp-3">
                                            {{ post.content|striptags|slice(0, 200) }}{% if post.content|length > 200 %}...{% endif %}
                                        </p>
                                    </div>
                                    
                                    {# Thumbnail if image exists #}
                                    {% if firstImage %}
                                        <a href="{{ path('community_post', {id: post.id}) }}" class="flex-shrink-0">
                                            <img src="{{ firstImage|imagine_filter('community_thumb') }}" 
                                                 alt="Post thumbnail"
                                                 class="w-32 h-24 rounded-xl object-cover border-2 border-slate-200 dark:border-navy-700 hover:border-emerald-500 dark:hover:border-emerald-500 transition-colors"
                                                 loading="lazy">
                                        </a>
                                    {% endif %}
                                </div>

                                {# Post Footer #}
                                <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
                                    <div class="flex items-center gap-2">
                                        {% if post.author.avatar %}
                                            <img src="{{ post.author.avatar }}" alt="{{ post.author.fullName }}" class="w-6 h-6 rounded-full object-cover">
                                        {% else %}
                                            <div class="w-6 h-6 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xs font-medium">
                                                {{ post.author.fullName|slice(0,1)|upper }}
                                            </div>
                                        {% endif %}
                                        <span>{{ post.author.fullName }}</span>
                                    </div>
                                    <span class="text-slate-300 dark:text-slate-600">•</span>
                                    <span>{{ post.createdAt ? post.createdAt|ago : '' }}</span>
                                    <span class="text-slate-300 dark:text-slate-600">•</span>
                                    <a href="{{ path('community_post', {id: post.id}) }}">
                                        <twig:ReplyCount postId="{{ post.id }}" />
                                    </a>

                                    {# Live Reaction Component #}
                                    <div class="ml-auto">
                                        <twig:PostReaction postId="{{ post.id }}" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                    {% else %}
                    <div class="card p-6 text-center text-slate-500 dark:text-slate-400">
                        {% if searchQuery %}
                            <i data-lucide="search-x" class="w-12 h-12 text-slate-300 dark:text-slate-600 mx-auto mb-3"></i>
                            <p class="font-medium mb-2">No posts found</p>
                            <a href="{{ path('community_index') }}" class="text-emerald-600 hover:text-emerald-700 text-sm">View all posts</a>
                        {% else %}
                            No posts yet. Be the first!
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>

                {# Pagination #}
                {% if pagination.pageCount > 1 %}
                    <div class="mt-8 flex justify-center">
                        <nav class="flex items-center gap-2">
                            {# Previous Button #}
                            {% if pagination.currentPageNumber > 1 %}
                                <a href="{{ path('community_index', {'page': pagination.currentPageNumber - 1, 'tab': current_tab, 'topic': current_topic, 'q': searchQuery}) }}" 
                                   class="px-4 py-2 rounded-lg border-2 border-slate-200 dark:border-navy-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors font-medium">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                </a>
                            {% else %}
                                <span class="px-4 py-2 rounded-lg border-2 border-slate-200 dark:border-navy-800 text-slate-400 dark:text-slate-600 cursor-not-allowed">
                                    <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                </span>
                            {% endif %}

                            {# Page Numbers #}
                            {% set startPage = max(1, pagination.currentPageNumber - 2) %}
                            {% set endPage = min(pagination.pageCount, pagination.currentPageNumber + 2) %}

                            {% if startPage > 1 %}
                                <a href="{{ path('community_index', {'page': 1, 'tab': current_tab, 'topic': current_topic, 'q': searchQuery}) }}" 
                                   class="px-4 py-2 rounded-lg border-2 border-slate-200 dark:border-navy-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors font-medium">
                                    1
                                </a>
                                {% if startPage > 2 %}
                                    <span class="px-2 text-slate-400">...</span>
                                {% endif %}
                            {% endif %}

                            {% for page in startPage..endPage %}
                                {% if page == pagination.currentPageNumber %}
                                    <span class="px-4 py-2 rounded-lg bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold shadow-md">
                                        {{ page }}
                                    </span>
                                {% else %}
                                    <a href="{{ path('community_index', {'page': page, 'tab': current_tab, 'topic': current_topic, 'q': searchQuery}) }}" 
                                       class="px-4 py-2 rounded-lg border-2 border-slate-200 dark:border-navy-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors font-medium">
                                        {{ page }}
                                    </a>
                                {% endif %}
                            {% endfor %}

                            {% if endPage < pagination.pageCount %}
                                {% if endPage < pagination.pageCount - 1 %}
                                    <span class="px-2 text-slate-400">...</span>
                                {% endif %}
                                <a href="{{ path('community_index', {'page': pagination.pageCount, 'tab': current_tab, 'topic': current_topic, 'q': searchQuery}) }}" 
                                   class="px-4 py-2 rounded-lg border-2 border-slate-200 dark:border-navy-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors font-medium">
                                    {{ pagination.pageCount }}
                                </a>
                            {% endif %}

                            {# Next Button #}
                            {% if pagination.currentPageNumber < pagination.pageCount %}
                                <a href="{{ path('community_index', {'page': pagination.currentPageNumber + 1, 'tab': current_tab, 'topic': current_topic, 'q': searchQuery}) }}" 
                                   class="px-4 py-2 rounded-lg border-2 border-slate-200 dark:border-navy-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors font-medium">
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </a>
                            {% else %}
                                <span class="px-4 py-2 rounded-lg border-2 border-slate-200 dark:border-navy-800 text-slate-400 dark:text-slate-600 cursor-not-allowed">
                                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                </span>
                            {% endif %}
                        </nav>
                    </div>

                    {# Page Info #}
                    <div class="mt-4 text-center text-sm text-slate-600 dark:text-slate-400">
                        Showing {{ ((pagination.currentPageNumber - 1) * pagination.itemNumberPerPage) + 1 }} 
                        to {{ min(pagination.currentPageNumber * pagination.itemNumberPerPage, pagination.totalItemCount) }} 
                        of {{ pagination.totalItemCount }} posts
                    </div>
                {% endif %}
            </div>

            {# Sidebar #}
            <aside class="lg:w-80 space-y-6">
                {# Create Post CTA #}
                <div class="card p-6 bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20 border-emerald-200 dark:border-emerald-800/50">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-2">Have a question?</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-4">Join the conversation!</p>
                    {% if app.user %}
                        <a href="{{ path('community_create') }}" class="btn-primary w-full justify-center">
                            <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                            Create Post
                        </a>
                    {% else %}
                        <a href="{{ path('auth_login') }}" class="btn-primary w-full justify-center">
                            <i data-lucide="log-in" class="w-4 h-4 mr-2"></i>
                            Login to Post
                        </a>
                    {% endif %}
                </div>

                {# Popular Topics #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="trending-up" class="w-5 h-5 text-emerald-500"></i>
                        Popular Topics
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        {% set commonTopics = ['JavaScript', 'React', 'Python', 'CSS', 'PHP', 'Database', 'Career'] %}
                        {% for topic in commonTopics %}
                        <a href="{{ path('community_index', {'tab': current_tab|default('hot'), 'topic': topic}) }}" class="badge bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                            {{ topic }}
                        </a>
                        {% endfor %}
                    </div>
                </div>

                {# Community Stats #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4">Community Stats</h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="text-center p-3 rounded-xl bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ resultCount }}</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Posts</p>
                        </div>
                        <div class="text-center p-3 rounded-xl bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20">
                            <p class="text-2xl font-bold text-slate-900 dark:text-white">12.5K</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Members</p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Reaction emoji mapping
    const reactionEmojis = {
        'like': '👍',
        'love': '❤️',
        'haha': '😂',
        'wow': '😮',
        'sad': '😢',
        'angry': '😡'
    };

    // Show/hide reaction picker
    document.querySelectorAll('.reaction-trigger').forEach(trigger => {
        const picker = trigger.querySelector('.reaction-picker');
        const currentBtn = trigger.querySelector('.reaction-current-btn');
        
        if (!picker || !currentBtn) return;
        
        let hideTimeout;

        const showPicker = () => {
            clearTimeout(hideTimeout);
            picker.classList.remove('hidden');
        };

        const hidePicker = () => {
            hideTimeout = setTimeout(() => {
                picker.classList.add('hidden');
            }, 200);
        };

        trigger.addEventListener('mouseenter', showPicker);
        trigger.addEventListener('mouseleave', hidePicker);
        
        currentBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (picker.classList.contains('hidden')) {
                showPicker();
            } else {
                hidePicker();
            }
        });
    });

    // Handle reaction clicks
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.reaction-btn');
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        const url = btn.dataset.url;
        const type = btn.dataset.type;
        const postId = btn.dataset.postId;

        btn.disabled = true;

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ type: type })
        })
        .then(res => res.json())
        .then(data => {
            if (!data || !data.ok) {
                console.error('Reaction failed');
                return;
            }

            const trigger = document.querySelector(`.reaction-trigger[data-post-id="${postId}"]`);
            if (!trigger) return;

            const currentBtn = trigger.querySelector('.reaction-current-btn');
            const emojiSpan = currentBtn.querySelector('.reaction-emoji');
            let countSpan = currentBtn.querySelector('.reaction-count');
            const picker = trigger.querySelector('.reaction-picker');

            if (data.userReaction) {
                emojiSpan.textContent = reactionEmojis[data.userReaction];
                
                if (!countSpan) {
                    countSpan = document.createElement('span');
                    countSpan.className = 'reaction-count';
                    currentBtn.appendChild(countSpan);
                }
                countSpan.textContent = data.total;

                currentBtn.className = 'reaction-current-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-200 dark:hover:bg-emerald-900/50 transition-colors text-sm font-medium';
            } else {
                emojiSpan.textContent = '👍';
                
                if (countSpan) {
                    if (data.total > 0) {
                        countSpan.textContent = data.total;
                    } else {
                        countSpan.remove();
                    }
                }

                currentBtn.className = 'reaction-current-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors text-sm font-medium';
            }

            picker.classList.add('hidden');
        })
        .catch(err => {
            console.error('Reaction error', err);
        })
        .finally(() => {
            btn.disabled = false;
        });
    });

    // Close picker on outside click
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.reaction-trigger')) {
            document.querySelectorAll('.reaction-picker').forEach(picker => {
                picker.classList.add('hidden');
            });
        }
    });
</script>
{% endblock %}