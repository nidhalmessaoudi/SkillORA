                            <option value="spam">Spam</option>
                            <option value="harassment">Harassment</option>
                            <option value="inappropriate">Inappropriate</option>
                            <option value="misinformation">Misinformation</option>
                            <option value="off_topic">Off-topic</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-black text-slate-900 dark:text-white mb-2">Details</label>
                        <textarea name="description" rows="4" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-navy-700/50 bg-white dark:bg-navy-900 focus:border-red-500 dark:focus:border-red-600 focus:ring-2 focus:ring-red-200 dark:focus:ring-red-900/50 transition-all text-slate-900 dark:text-white placeholder:text-slate-500 dark:placeholder:text-slate-400" placeholder="Additional context..."></textarea>
                    </div>
                    <div class="flex gap-3 pt-2">
                        <button type="button" onclick="closeReportModal()" class="flex-1 px-5 py-3 rounded-xl border-2 border-slate-200 dark:border-navy-700/50 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 font-black transition-all hover:scale-105">Cancel</button>
                        <button type="submit" class="flex-1 px-5 py-3 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:from-red-700 hover:to-red-600 text-white font-black shadow-lg hover:shadow-xl transition-all hover:scale-105">
                            <i data-lucide="flag" class="w-4 h-4 inline mr-2"></i>
                            Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/core.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/javascript.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/python.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/php.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github-dark.min.css">

<script>
    lucide.createIcons();
    marked.setOptions({
        highlight: (code, lang) => lang && hljs.getLanguage(lang) ? hljs.highlight(code, { language: lang }).value : hljs.highlightAuto(code).value,
        breaks: true,
        gfm: true
    });

    let originalPostContent = {{ post.content|json_encode|raw }};
    let originalReplyContents = { {% for reply in post.replies %}{{ reply.id }}: {{ reply.content|json_encode|raw }}{{ loop.last ? '' : ',' }}{% endfor %} };

    document.getElementById('post-content').innerHTML = marked.parse(originalPostContent);
    
    Object.keys(originalReplyContents).forEach(id => {
        const el = document.querySelector(`[data-reply-id="${id}"]`);
        if (el) el.innerHTML = marked.parse(originalReplyContents[id]);
    });

    lucide.createIcons();

    // Toggle translate menu
    let translatePanelOpen = false;
    
    function toggleTranslateMenu(e) {
        if (e) e.stopPropagation();
        const panel = document.getElementById('translate-panel');
        translatePanelOpen = !translatePanelOpen;
        
        if (translatePanelOpen) {
            panel.classList.remove('hidden');
            // Focus on select after animation
            setTimeout(() => {
                document.getElementById('translate-lang').focus();
                lucide.createIcons();
            }, 100);
        } else {
            panel.classList.add('hidden');
        }
    }

    // Close translate panel when clicking outside - with delay to prevent immediate closure
    document.addEventListener('click', (e) => {
        if (!translatePanelOpen) return;
        
        const panel = document.getElementById('translate-panel');
        const translateBtn = e.target.closest('button[onclick*="toggleTranslateMenu"]');
        
        // Don't close if clicking the button or inside the panel
        if (translateBtn || panel.contains(e.target)) {
            return;
        }
        
        // Close the panel
        translatePanelOpen = false;
        panel.classList.add('hidden');
    });

    // Translation functions
    async function translatePost() {
        const langSelect = document.getElementById('translate-lang');
        const targetLang = langSelect.value;

        if (!targetLang) {
            showNotification('Please select a language first', 'error');
            return;
        }

        const translateBtn = document.getElementById('translate-btn');
        const originalBtn = document.getElementById('original-btn');
        const postContentDiv = document.getElementById('post-content');
        
        translateBtn.disabled = true;
        translateBtn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 mr-2 animate-spin"></i> Translating...';
        lucide.createIcons();

        try {
            const response = await fetch('/community/translate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    type: 'post',
                    id: {{ post.id }},
                    lang: targetLang,
                    source: 'auto'
                })
            });

            const data = await response.json();

            if (data.ok && data.translated) {
                postContentDiv.innerHTML = marked.parse(data.translated);
                originalBtn.classList.remove('hidden');
                translateBtn.classList.add('hidden');
                showNotification(`Translated successfully!`, 'success');
                lucide.createIcons();
            } else {
                throw new Error(data.error || 'Translation failed');
            }
        } catch (error) {
            console.error('Translation error:', error);
            showNotification('Translation failed', 'error');
        } finally {
            translateBtn.disabled = false;
            translateBtn.innerHTML = '<i data-lucide="languages" class="w-4 h-4 mr-2"></i> Translate';
            lucide.createIcons();
        }
    }

    function showOriginalPost() {
        document.getElementById('post-content').innerHTML = marked.parse(originalPostContent);
        document.getElementById('original-btn').classList.add('hidden');
        document.getElementById('translate-btn').classList.remove('hidden');
        document.getElementById('translate-lang').value = '';
        showNotification('Showing original content', 'success');
        lucide.createIcons();
    }

    async function translateReply(replyId) {
        const langSelect = document.getElementById('translate-lang');
        const targetLang = langSelect.value;

        if (!targetLang) {
            showNotification('Please select a language first', 'error');
            return;
        }

        const contentDiv = document.querySelector(`[data-reply-id="${replyId}"]`);
        const originalContent = originalReplyContents[replyId];

        if (!contentDiv || !originalContent) {
            showNotification('Reply content not found', 'error');
            return;
        }

        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'text-sm text-blue-600 dark:text-blue-400 flex items-center gap-2 my-2 font-semibold';
        loadingDiv.innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Translating...';
        contentDiv.parentElement.insertBefore(loadingDiv, contentDiv);
        lucide.createIcons();

        try {
            const response = await fetch('/community/translate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    type: 'reply',
                    id: replyId,
                    lang: targetLang,
                    source: 'auto'
                })
            });

            const data = await response.json();

            if (data.ok && data.translated) {
                contentDiv.innerHTML = marked.parse(data.translated);
                showNotification('Reply translated!', 'success');
                lucide.createIcons();
            } else {
                throw new Error(data.error || 'Translation failed');
            }
        } catch (error) {
            console.error('Translation error:', error);
            showNotification('Translation failed', 'error');
        } finally {
            loadingDiv.remove();
        }
    }

    function showNotification(message, type = 'success') {
        const notification = document.createElement('div');
        const bgColor = type === 'success' ? 'bg-gradient-to-r from-emerald-500 to-teal-500' : 'bg-gradient-to-r from-red-500 to-red-600';
        const icon = type === 'success' ? 'check-circle' : 'alert-circle';
        
        notification.className = `fixed top-6 right-6 ${bgColor} text-white px-6 py-4 rounded-2xl shadow-2xl z-[100] flex items-center gap-3 animate-slide-in border-2 border-white/20`;
        notification.innerHTML = `
            <div class="p-1 rounded-lg bg-white/20">
                <i data-lucide="${icon}" class="w-5 h-5"></i>
            </div>
            <span class="font-black">${message}</span>
        `;
        document.body.appendChild(notification);
        lucide.createIcons();
        
        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transform = 'translateY(-10px)';
            notification.style.transition = 'all 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }

    // Reactions
    const reactionEmojis = {'like':'👍','love':'❤️','haha':'😂','wow':'😮','sad':'😢','angry':'😡'};

    document.querySelectorAll('.reaction-trigger, .reaction-trigger-reply').forEach(trigger => {
        const picker = trigger.querySelector('.reaction-picker, .reaction-picker-reply');
        const btn = trigger.querySelector('.reaction-current-btn, .reaction-btn-reply');
        if (!picker || !btn) return;

        let timeout;
        trigger.addEventListener('mouseenter', () => { clearTimeout(timeout); picker.classList.remove('hidden'); });
        trigger.addEventListener('mouseleave', () => { timeout = setTimeout(() => picker.classList.add('hidden'), 200); });
        btn.addEventListener('click', (e) => { e.stopPropagation(); picker.classList.toggle('hidden'); });
    });

    document.addEventListener('click', (e) => {
        const btn = e.target.closest('.reaction-btn, .reaction-option');
        if (!btn) return;

        e.preventDefault();
        btn.disabled = true;

        fetch(btn.dataset.url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: new URLSearchParams({ type: btn.dataset.type })
        })
        .then(res => res.json())
        .then(data => {
            if (!data.ok) return;
            location.reload();
        })
        .finally(() => btn.disabled = false);
    });

    // Reply functions
    function expandReplyBox() {
        document.getElementById('quick-reply-collapsed').classList.add('hidden');
        document.getElementById('quick-reply-expanded').classList.remove('hidden');
        document.getElementById('quick-reply-textarea').focus();
        lucide.createIcons();
    }

    function collapseReplyBox() {
        document.getElementById('quick-reply-collapsed').classList.remove('hidden');
        document.getElementById('quick-reply-expanded').classList.add('hidden');
        document.getElementById('quick-reply-textarea').value = '';
    }

    function toggleReplyForm(replyId) {
        const form = document.getElementById(`reply-form-${replyId}`);
        form.classList.toggle('hidden');
        if (!form.classList.contains('hidden')) {
            document.getElementById(`nested-reply-textarea-${replyId}`).focus();
        }
        lucide.createIcons();
    }

    function toggleNestedReplies(replyId) {
        const content = document.getElementById(`nested-replies-content-${replyId}`);
        const viewBtn = document.getElementById(`view-replies-btn-${replyId}`);
        
        content.classList.toggle('hidden');
        viewBtn.classList.toggle('hidden');
        lucide.createIcons();
    }

    function collapseAllReplies() {
        document.querySelectorAll('[id^="nested-replies-content-"]').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('[id^="view-replies-btn-"]').forEach(b => b.classList.remove('hidden'));
        lucide.createIcons();
    }

    function editReply(id, content) {
        document.getElementById(`reply-content-wrapper-${id}`).style.display = 'none';
        document.getElementById(`reply-edit-form-${id}`).classList.remove('hidden');
        document.getElementById(`edit-textarea-${id}`).value = content;
    }

    function cancelReplyEdit(id) {
        document.getElementById(`reply-content-wrapper-${id}`).style.display = 'block';
        document.getElementById(`reply-edit-form-${id}`).classList.add('hidden');
    }

    async function saveReplyEdit(id) {
        const content = document.getElementById(`edit-textarea-${id}`).value.trim();
        if (!content) return alert('Reply cannot be empty');

        const res = await fetch(`/community/reply/${id}/edit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: new URLSearchParams({ content })
        });

        const data = await res.json();
        if (data.ok) location.reload();
        else alert(data.error || 'Failed');
    }

    async function deleteReply(id) {
        if (!confirm('Delete this reply?')) return;
        const res = await fetch(`/community/reply/${id}/delete`, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        if (data.ok) location.reload();
        else alert('Failed');
    }

    async function submitNestedReply(parentId) {
        const content = document.getElementById(`nested-reply-textarea-${parentId}`).value.trim();
        if (!content) return alert('Reply cannot be empty');

        const res = await fetch(`/community/reply/${parentId}/reply`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: new URLSearchParams({ content })
        });

        const data = await res.json();
        if (data.ok) location.reload();
        else alert(data.error || 'Failed');
    }

    async function generateReply(postId) {
        const textarea = document.querySelector('#quick-reply-textarea');
        const btn = event.target;
        const originalText = btn.innerHTML;
        
        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 mr-2 animate-spin"></i> Generating...';
        lucide.createIcons();

        try {
            const res = await fetch('/community/ai-generate-reply', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' },
                body: JSON.stringify({ postId })
            });

            const data = await res.json();
            if (data.success) textarea.value = data.reply;
            else alert('AI generation failed');
        } catch (e) {
            alert('Error generating reply');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
            lucide.createIcons();
        }
    }

    function sortReplies(sortBy) {
        console.log('Sort by:', sortBy);
    }

    function openReportModal() {
        document.getElementById('report-modal').classList.remove('hidden');
        lucide.createIcons();
    }

    function closeReportModal() {
        document.getElementById('report-modal').classList.add('hidden');
    }

    async function submitReport(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const res = await fetch('{{ path("community_report_post", {"id": post.id}) }}', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        });

        const data = await res.json();
        showNotification(data.message || data.error || 'Report submitted', data.ok ? 'success' : 'error');
        if (data.ok) closeReportModal();
    }

    document.addEventListener('keydown', e => { 
        if (e.key === 'Escape') { 
            closeReportModal();
            if (translatePanelOpen) {
                translatePanelOpen = false;
                document.getElementById('translate-panel').classList.add('hidden');
            }
        } 
    });

    document.addEventListener("DOMContentLoaded", () => {

    const btn = document.getElementById("generate-summary-btn");
    const textarea = document.getElementById("post-summary");
    const status = document.getElementById("summary-status");

    if (!btn) return;

    btn.addEventListener("click", async () => {

        btn.disabled = true;
        btn.innerText = "Generating...";
        status.textContent = "";

        try {
            const res = await fetch("/community/ai-summarize", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: JSON.stringify({
                    postId: btn.dataset.postId
                })
            });

            const data = await res.json();

            if (!data.ok) {
                throw new Error(data.error || "Failed");
            }

            textarea.value = data.summary;
            status.textContent = "Summary generated successfully.";

        } catch (e) {
            status.textContent = "AI Summary failed: " + e.message;
        }

        btn.disabled = false;
        btn.innerText = "Generate";
    });

});
</script>

