{% extends 'layouts/base.html.twig' %}

{% block title %}{{ post.title }} - Community | SkillORA{% endblock %}

{% block body %}
{# Define reaction emoji mapping #}
{% set emojiMap = {
    'like': '👍',
    'love': '❤️',
    'haha': '😂',
    'wow': '😮',
    'sad': '😢',
    'angry': '😡'
} %}

<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Breadcrumb #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <nav class="flex items-center gap-2 text-sm">
                <a href="{{ path('community_index') }}" class="text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Community</a>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>

                {% set crumbLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                <span class="text-slate-500 dark:text-slate-400">{{ crumbLabel }}</span>

                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                <span class="text-slate-900 dark:text-white font-medium truncate max-w-xs">{{ post.title }}</span>
            </nav>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg {{ label == 'success' ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800' : 'bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Main Post #}
        <article class="card p-8 mb-6">
            <div class="flex gap-6">
                {# Post Content #}
                <div class="flex-1 min-w-0">
                    {# Post Header #}
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            {% set headerLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                            {% set headerClass = post.type == 'discussion'
                                ? 'badge-primary'
                                : (post.type == 'article' ? 'badge-success' : 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400') %}
                            <span class="badge {{ headerClass }}">{{ headerLabel }}</span>
                        </div>

                        {# Post Actions (Edit/Delete) - Only show to post author #}
                        {% if app.user and app.user.id == post.author.id %}
                            <div class="flex items-center gap-2">
                                <a href="{{ path('community_edit_post', {id: post.id}) }}" class="text-sm text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 flex items-center gap-1">
                                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                                    Edit
                                </a>
                                <form method="post" action="{{ path('community_delete_post', {id: post.id}) }}" onsubmit="return confirm('Are you sure you want to delete this post? This cannot be undone.');" class="inline">
                                    <button type="submit" class="text-sm text-slate-600 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 flex items-center gap-1">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>

                    {# Title #}
                    <h1 class="text-2xl lg:text-3xl font-display font-bold text-slate-900 dark:text-white mb-6">
                        {{ post.title }}
                    </h1>

                    {# Author Info #}
                    <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-200 dark:border-navy-800">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xl font-bold">
                            {{ post.author.username|default('U')|slice(0,1)|upper }}
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-slate-900 dark:text-white">{{ post.author.username|default('Unknown User') }}</span>
                                <span class="badge bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs">
                                    Level 5
                                </span>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400">
                                {{ post.createdAt ? post.createdAt|date('M j, Y') : '' }}
                                • {{ post.replies|length }} {{ post.replies|length == 1 ? 'reply' : 'replies' }}
                            </p>
                        </div>
                    </div>

                    {# Post Body #}
                    <div class="prose dark:prose-invert max-w-none mb-6">
                        {{ post.content is not empty ? post.content|e|nl2br : '' }}
                    </div>

                    {# Tags #}
                    <div class="flex flex-wrap gap-2 mb-6">
                        {% if post.tags|length %}
                            {% for tag in post.tags %}
                                <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                                    #{{ tag.name }}
                                </a>
                            {% endfor %}
                        {% else %}
                            <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400">#general</a>
                        {% endif %}
                    </div>

                    {# Actions & Reactions #}
<div class="pt-4 border-t border-slate-200 dark:border-navy-800">
    {# Reaction Button - Prominent and centered #}
    <div class="flex items-center justify-between mb-4">
        <div class="reaction-trigger relative" data-post-id="{{ post.id }}">
            {% set totalReactions = 0 %}
            {% for count in postReactionCounts|default({}) %}
                {% set totalReactions = totalReactions + count %}
            {% endfor %}
            
            {% if userPostReaction %}
                <button class="reaction-current-btn flex items-center gap-2 px-6 py-2.5 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all border-2 border-emerald-200 dark:border-emerald-800 font-semibold">
                    <span class="reaction-emoji text-2xl">{{ emojiMap[userPostReaction] }}</span>
                    <span class="text-base">{{ userPostReaction|capitalize }}</span>
                    {% if totalReactions > 1 %}
                        <span class="reaction-count text-sm opacity-75">+{{ totalReactions - 1 }}</span>
                    {% endif %}
                </button>
            {% else %}
                <button class="reaction-current-btn flex items-center gap-2 px-6 py-2.5 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all border-2 border-slate-200 dark:border-navy-700 font-semibold">
                    <span class="reaction-emoji text-2xl">👍</span>
                    <span class="text-base">React</span>
                    {% if totalReactions > 0 %}
                        <span class="reaction-count text-sm opacity-75">{{ totalReactions }}</span>
                    {% endif %}
                </button>
            {% endif %}

            {# Reaction Picker - Improved positioning #}
            <div class="reaction-picker hidden absolute top-full left-0 mt-2 bg-white dark:bg-navy-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-navy-700 p-3 flex items-center gap-2 z-20">
                {% for reactionType, emoji in emojiMap %}
                    <button 
                        class="reaction-btn group relative hover:scale-110 transition-all duration-200 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-700"
                        data-url="{{ path('community_react_post', {'id': post.id}) }}"
                        data-type="{{ reactionType }}"
                        data-target="post"
                        data-id="{{ post.id }}"
                        title="{{ reactionType|capitalize }}"
                    >
                        <span class="text-3xl">{{ emoji }}</span>
                        {# Tooltip #}
                        <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                            {{ reactionType|capitalize }}
                        </span>
                    </button>
                {% endfor %}
            </div>
        </div>

        {# Actions on the right #}
        <div class="flex items-center gap-2">
            <button class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-slate-700 dark:hover:text-slate-300 transition-colors" title="Save post">
                <i data-lucide="bookmark" class="w-5 h-5"></i>
            </button>
            <button class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-red-600 dark:hover:text-red-400 transition-colors" title="Report post">
                <i data-lucide="flag" class="w-5 h-5"></i>
            </button>
            <button class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-slate-700 dark:hover:text-slate-300 transition-colors" title="More options">
                <i data-lucide="more-horizontal" class="w-5 h-5"></i>
            </button>
        </div>
    </div>

    {# Show reaction breakdown if there are reactions - Improved design #}
    {% if postReactionCounts|default({})|length > 0 %}
        <div class="flex items-center flex-wrap gap-2 pt-3 border-t border-slate-200 dark:border-navy-800">
            <span class="text-sm font-medium text-slate-600 dark:text-slate-400 mr-1">{{ totalReactions }} {{ totalReactions == 1 ? 'reaction' : 'reactions' }}</span>
            {% for type, count in postReactionCounts %}
                <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-navy-800 hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors cursor-default">
                    <span class="text-lg">{{ emojiMap[type] }}</span>
                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">{{ count }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
                </div>
            </div>
        </article>

        {# Answers Section #}
        <div class="mb-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white">
                    {{ post.replies|length }} {{ post.replies|length == 1 ? 'Answer' : 'Answers' }}
                </h2>
                <select class="input py-2 w-auto text-sm">
                    <option>Sort by: Best</option>
                    <option>Sort by: Newest</option>
                    <option>Sort by: Oldest</option>
                </select>
            </div>

            <div class="space-y-4">
                {% for reply in post.replies %}
                    {% set replyData = replyReactionData[reply.id]|default({'userReaction': null, 'counts': {}}) %}
                    {% set totalReplyReactions = 0 %}
                    {% for count in replyData.counts %}
                        {% set totalReplyReactions = totalReplyReactions + count %}
                    {% endfor %}                    
                <article class="card p-6" id="reply-{{ reply.id }}">
                    <div class="flex gap-4">
                        <div class="flex-1 min-w-0">
                            {# Author Info with Edit/Delete buttons #}
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-sm font-medium">
                                        {{ reply.author.username ? reply.author.username|slice(0,1)|upper : 'U' }}
                                    </div>
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-slate-900 dark:text-white">{{ reply.author.username ?? 'Guest' }}</span>
                                            <span class="text-xs text-slate-500 dark:text-slate-400">{{ reply.createdAt ? reply.createdAt|date('M j, Y, H:i') : '' }}</span>
                                            {% if reply.updatedAt %}
                                                <span class="text-xs text-slate-400 dark:text-slate-500">(edited)</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {# Edit/Delete buttons for reply owner #}
                                {% if app.user and app.user.id == reply.author.id %}
                                    <div class="flex items-center gap-2">
                                        <button onclick="editReplyForm({{ reply.id}}, `{{ reply.content|e('js') }}`)" class="text-sm text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 flex items-center gap-1">
                                            <i data-lucide="edit-2" class="w-3 h-3"></i>
                                            Edit
                                        </button>
                                        <button onclick="deleteReply({{ reply.id }})" class="text-sm text-slate-600 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 flex items-center gap-1">
                                            <i data-lucide="trash-2" class="w-3 h-3"></i>
                                            Delete
                                        </button>
                                    </div>
                                {% endif %}
                            </div>

                            {# Reply Content #}
                            <div class="reply-content-{{ reply.id }} prose dark:prose-invert max-w-none mb-4">
                                <p class="text-slate-700 dark:text-slate-300 whitespace-pre-line">{{ reply.content|e }}</p>
                            </div>

                            {# Edit Form (hidden by default) #}
                            <div class="reply-edit-form-{{ reply.id }} hidden mb-4">
                                <textarea class="input min-h-[120px] mb-2" id="edit-textarea-{{ reply.id }}"></textarea>
                                <div class="flex gap-2">
                                    <button onclick="saveReplyEdit({{ reply.id }})" class="btn-primary text-sm px-4 py-2">
                                        Save Changes
                                    </button>
                                    <button onclick="cancelReplyEdit({{ reply.id }})" class="btn-outline text-sm px-4 py-2">
                                        Cancel
                                    </button>
                                </div>
                            </div>

                            {# Reply Actions & Reactions #}
<div class="flex items-center justify-between pt-3 border-t border-slate-200 dark:border-navy-800">
    {# Reaction Button for Reply #}
    <div class="reaction-trigger relative" data-reply-id="{{ reply.id }}">
        {% if replyData.userReaction %}
            <button class="reaction-current-btn flex items-center gap-1.5 px-4 py-2 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all border border-emerald-200 dark:border-emerald-800 text-sm font-medium">
                <span class="reaction-emoji text-lg">{{ emojiMap[replyData.userReaction] }}</span>
                <span class="reaction-count font-semibold">{{ totalReplyReactions }}</span>
            </button>
        {% else %}
            <button class="reaction-current-btn flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all border border-slate-200 dark:border-navy-700 text-sm font-medium">
                <span class="reaction-emoji text-lg">👍</span>
                {% if totalReplyReactions > 0 %}
                    <span class="reaction-count font-semibold">{{ totalReplyReactions }}</span>
                {% else %}
                    <span>React</span>
                {% endif %}
            </button>
        {% endif %}

        {# Reaction Picker for Reply #}
        <div class="reaction-picker hidden absolute top-full left-0 mt-2 bg-white dark:bg-navy-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-navy-700 p-2.5 flex items-center gap-1.5 z-20">
            {% for reactionType, emoji in emojiMap %}
                <button 
                    class="reaction-btn group relative hover:scale-110 transition-all duration-200 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-700"
                    data-url="{{ path('community_react_reply', {'id': reply.id}) }}"
                    data-type="{{ reactionType }}"
                    data-target="reply"
                    data-id="{{ reply.id }}"
                    title="{{ reactionType|capitalize }}"
                >
                    <span class="text-2xl">{{ emoji }}</span>
                    <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                        {{ reactionType|capitalize }}
                    </span>
                </button>
            {% endfor %}
        </div>
    </div>

    {# Show reaction breakdown for replies #}
    {% if replyData.counts|length > 0 %}
        <div class="flex items-center gap-2">
            {% for type, count in replyData.counts %}
                <div class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-slate-100 dark:bg-navy-800 text-xs">
                    <span>{{ emojiMap[type] }}</span>
                    <span class="font-semibold text-slate-600 dark:text-slate-400">{{ count }}</span>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
                        </div>
                    </div>
                </article>
                {% else %}
                <div class="card p-6 text-center text-slate-500 dark:text-slate-400">
                    No answers yet. Be the first to reply.
                </div>
                {% endfor %}
            </div>
        </div>

        {# Write Answer Form #}
        {% if app.user %}
        <div class="card p-6">
            <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-4">Your Answer</h3>

            <form action="{{ path('community_reply', {id: post.id}) }}" method="post">
                <div class="mb-4">
                    <textarea name="content" class="input min-h-[200px]" placeholder="Write your answer here... Use Markdown for formatting." required>{{ app.request.get('content')|e }}</textarea>
                </div>

                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                        Markdown formatting is supported
                    </p>
                    <button type="submit" class="btn-primary">
                        <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                        Post Answer
                    </button>
                </div>
            </form>
        </div>
        {% else %}
        <div class="card p-6 text-center">
            <p class="text-slate-600 dark:text-slate-400 mb-4">
                Please sign in to post an answer
            </p>
            <a href="{{ path('app_login') }}" class="btn-primary inline-flex items-center">
                <i data-lucide="log-in" class="w-4 h-4 mr-2"></i>
                Sign In
            </a>
        </div>
        {% endif %}

        {# Related Posts #}
        <div class="mt-10">
            <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-6">Related Posts</h2>
            <div class="grid md:grid-cols-2 gap-4">
                {% for i in 1..4 %}
                <a href="#" class="card p-4 hover:shadow-lg transition-all group">
                    <h3 class="font-medium text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-2">
                        {{ ['Understanding React Lifecycle Methods', 'useCallback vs useMemo - When to use which?', 'Why is my useEffect running twice?', 'Custom Hooks Best Practices'][i-1] }}
                    </h3>
                    <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                        <span>{{ [24, 18, 32, 15][i-1] }} answers</span>
                        <span>•</span>
                        <span>{{ [1.2, 0.8, 2.1, 0.5][i-1] }}k views</span>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Reaction emoji mapping
    const reactionEmojis = {
        'like': '👍',
        'love': '❤️',
        'haha': '😂',
        'wow': '😮',
        'sad': '😢',
        'angry': '😡'
    };

    // Show/hide reaction picker on hover/click
    document.querySelectorAll('.reaction-trigger').forEach(trigger => {
        const picker = trigger.querySelector('.reaction-picker');
        const currentBtn = trigger.querySelector('.reaction-current-btn');
        
        let hideTimeout;

        const showPicker = () => {
            clearTimeout(hideTimeout);
            picker.classList.remove('hidden');
        };

        const hidePicker = () => {
            hideTimeout = setTimeout(() => {
                picker.classList.add('hidden');
            }, 200);
        };

        // Show picker on hover
        trigger.addEventListener('mouseenter', showPicker);
        trigger.addEventListener('mouseleave', hidePicker);
        
        // Also show on click for mobile
        currentBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (picker.classList.contains('hidden')) {
                showPicker();
            } else {
                hidePicker();
            }
        });
    });

    // Handle reaction button clicks
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.reaction-btn');
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        const url = btn.dataset.url;
        const type = btn.dataset.type;
        const target = btn.dataset.target; // 'post' or 'reply'
        const id = btn.dataset.id;

        // Disable button during request
        btn.disabled = true;

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ type: type })
        })
        .then(res => res.json())
        .then(data => {
            if (!data || !data.ok) {
                console.error('Reaction failed', data);
                return;
            }

            // Find the trigger container
            let trigger;
            if (target === 'post') {
                trigger = document.querySelector(`.reaction-trigger[data-post-id="${id}"]`);
            } else {
                trigger = document.querySelector(`.reaction-trigger[data-reply-id="${id}"]`);
            }

            if (!trigger) return;

            const currentBtn = trigger.querySelector('.reaction-current-btn');
            const emojiSpan = currentBtn.querySelector('.reaction-emoji');
            let countSpan = currentBtn.querySelector('.reaction-count');
            const picker = trigger.querySelector('.reaction-picker');

            // Update emoji and count
            if (data.userReaction) {
                emojiSpan.textContent = reactionEmojis[data.userReaction];
                
                if (!countSpan) {
                    // Create count span if it doesn't exist
                    countSpan = document.createElement('span');
                    countSpan.className = 'reaction-count';
                    currentBtn.appendChild(countSpan);
                }
                countSpan.textContent = data.total;

                // Update button styling (active state)
                currentBtn.className = 'reaction-current-btn flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-200 dark:hover:bg-emerald-900/50 transition-colors font-medium';
                
                // For replies, use smaller sizing
                if (target === 'reply') {
                    currentBtn.className = 'reaction-current-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-200 dark:hover:bg-emerald-900/50 transition-colors text-sm font-medium';
                }
            } else {
                // User removed their reaction
                emojiSpan.textContent = '👍';
                
                if (countSpan) {
                    if (data.total > 0) {
                        countSpan.textContent = data.total;
                    } else {
                        countSpan.remove();
                    }
                }

                // Reset button styling (inactive state)
                currentBtn.className = 'reaction-current-btn flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors font-medium';
                
                // For replies, use smaller sizing
                if (target === 'reply') {
                    currentBtn.className = 'reaction-current-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors text-sm font-medium';
                }
            }

            // Hide picker
            picker.classList.add('hidden');
        })
        .catch(err => {
            console.error('Reaction request error', err);
        })
        .finally(() => {
            btn.disabled = false;
        });
    });

    // Close picker when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.reaction-trigger')) {
            document.querySelectorAll('.reaction-picker').forEach(picker => {
                picker.classList.add('hidden');
            });
        }
    });

    // Reply Edit Functions
    function editReplyForm(replyId, currentContent) {
        // Hide content, show edit form
        document.querySelector(`.reply-content-${replyId}`).classList.add('hidden');
        document.querySelector(`.reply-edit-form-${replyId}`).classList.remove('hidden');
        document.getElementById(`edit-textarea-${replyId}`).value = currentContent;
        lucide.createIcons();
    }

    function cancelReplyEdit(replyId) {
        // Show content, hide edit form
        document.querySelector(`.reply-content-${replyId}`).classList.remove('hidden');
        document.querySelector(`.reply-edit-form-${replyId}`).classList.add('hidden');
    }

    function saveReplyEdit(replyId) {
        const content = document.getElementById(`edit-textarea-${replyId}`).value.trim();
        
        if (!content) {
            alert('Reply content cannot be empty');
            return;
        }

        fetch(`/community/reply/${replyId}/edit`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ content: content })
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                // Update the content display
                document.querySelector(`.reply-content-${replyId} p`).textContent = data.content;
                cancelReplyEdit(replyId);
                // Optionally show success message
                alert('Reply updated successfully!');
            } else {
                alert('Error: ' + (data.error || 'Failed to update reply'));
            }
        })
        .catch(err => {
            console.error('Edit error:', err);
            alert('Failed to update reply');
        });
    }

    function deleteReply(replyId) {
        if (!confirm('Are you sure you want to delete this reply? This cannot be undone.')) {
            return;
        }

        fetch(`/community/reply/${replyId}/delete`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                // Remove the reply from DOM
                document.getElementById(`reply-${replyId}`).remove();
                alert('Reply deleted successfully');
            } else {
                alert('Error: ' + (data.error || 'Failed to delete reply'));
            }
        })
        .catch(err => {
            console.error('Delete error:', err);
            alert('Failed to delete reply');
        });
    }
</script>
{% endblock %}