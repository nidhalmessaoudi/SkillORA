{% extends 'layouts/base.html.twig' %}

{% block title %}{{ post.title }} - Community | SkillHarbor{% endblock %}

{% block body %}
{# Define reaction emoji mapping #}
{% set emojiMap = {
    'like': '👍',
    'love': '❤️',
    'haha': '😂',
    'wow': '😮',
    'sad': '😢',
    'angry': '😡'
} %}

<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Breadcrumb #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <nav class="flex items-center gap-2 text-sm">
                <a href="{{ path('community_index') }}" class="text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Community</a>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>

                {% set crumbLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                <span class="text-slate-500 dark:text-slate-400">{{ crumbLabel }}</span>

                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                <span class="text-slate-900 dark:text-white font-medium truncate max-w-xs">{{ post.title }}</span>
            </nav>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg {{ label == 'success' ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800' : 'bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Main Post #}
        <article class="card p-8 mb-6">
            <div class="flex gap-6">
                {# Post Content #}
                <div class="flex-1 min-w-0">
                    {# Post Header #}
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            {% set headerLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                            {% set headerClass = post.type == 'discussion'
                                ? 'badge-primary'
                                : (post.type == 'article' ? 'badge-success' : 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400') %}
                            <span class="badge {{ headerClass }}">{{ headerLabel }}</span>
                        </div>

                        {# Post Actions (Edit/Delete) - Only show to post author #}
                        {% if app.user and app.user.id == post.author.id %}
                            <div class="flex items-center gap-2">
                                <a href="{{ path('community_edit_post', {id: post.id}) }}" class="text-sm text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 flex items-center gap-1">
                                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                                    Edit
                                </a>
                                <form method="post" action="{{ path('community_delete_post', {id: post.id}) }}" onsubmit="return confirm('Are you sure you want to delete this post? This cannot be undone.');" class="inline">
                                    <button type="submit" class="text-sm text-slate-600 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 flex items-center gap-1">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>

                    {# Title #}
                    <h1 class="text-2xl lg:text-3xl font-display font-bold text-slate-900 dark:text-white mb-6">
                        {{ post.title }}
                    </h1>

                    {# Author Info #}
                    <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-200 dark:border-navy-800">
                        {% if post.author.avatar %}
                            <img src="{{ post.author.avatar }}" alt="{{ post.author.fullName }}" class="w-12 h-12 rounded-full object-cover">
                        {% else %}
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xl font-bold">
                                {{ post.author.fullName|slice(0,1)|upper }}
                            </div>
                        {% endif %}
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-slate-900 dark:text-white">{{ post.author.fullName }}</span>
                                <span class="badge bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs">
                                    Level 5
                                </span>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400">
                                {{ post.createdAt ? post.createdAt|date('M j, Y') : '' }}
                                • {{ post.replies|length }} {{ post.replies|length == 1 ? 'reply' : 'replies' }}
                            </p>
                        </div>
                    </div>

                    {# Post Body - MARKDOWN RENDERED #}
                    <div class="prose prose-slate dark:prose-invert max-w-none mb-6" id="post-content">
                        {# Content will be rendered by JavaScript #}
                    </div>

                    {# Tags #}
                    <div class="flex flex-wrap gap-2 mb-6">
                        {% if post.tags|length %}
                            {% for tag in post.tags %}
                                <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                                    #{{ tag.name }}
                                </a>
                            {% endfor %}
                        {% else %}
                            <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400">#general</a>
                        {% endif %}
                    </div>

                    {# Actions & Reactions #}
                    <div class="pt-4 border-t border-slate-200 dark:border-navy-800">
                        {# Reaction Button - Prominent and centered #}
                        <div class="flex items-center justify-between mb-4">
                            {% if app.user %}
                            <div class="reaction-trigger relative" data-post-id="{{ post.id }}">
                                {% set totalReactions = 0 %}
                                {% for count in postReactionCounts|default({}) %}
                                    {% set totalReactions = totalReactions + count %}
                                {% endfor %}
                                
                                {% if userPostReaction %}
                                    <button class="reaction-current-btn flex items-center gap-2 px-6 py-2.5 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all border-2 border-emerald-200 dark:border-emerald-800 font-semibold">
                                        <span class="reaction-emoji text-2xl">{{ emojiMap[userPostReaction] }}</span>
                                        <span class="text-base">{{ userPostReaction|capitalize }}</span>
                                        {% if totalReactions > 1 %}
                                            <span class="reaction-count text-sm opacity-75">+{{ totalReactions - 1 }}</span>
                                        {% endif %}
                                    </button>
                                {% else %}
                                    <button class="reaction-current-btn flex items-center gap-2 px-6 py-2.5 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all border-2 border-slate-200 dark:border-navy-700 font-semibold">
                                        <span class="reaction-emoji text-2xl">👍</span>
                                        <span class="text-base">React</span>
                                        {% if totalReactions > 0 %}
                                            <span class="reaction-count text-sm opacity-75">{{ totalReactions }}</span>
                                        {% endif %}
                                    </button>
                                {% endif %}

                                {# Reaction Picker #}
                                <div class="reaction-picker hidden absolute top-full left-0 mt-2 bg-white dark:bg-navy-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-navy-700 p-3 flex items-center gap-2 z-20">
                                    {% for reactionType, emoji in emojiMap %}
                                        <button 
                                            class="reaction-btn group relative hover:scale-110 transition-all duration-200 p-2.5 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-700"
                                            data-url="{{ path('community_react_post', {'id': post.id}) }}"
                                            data-type="{{ reactionType }}"
                                            data-target="post"
                                            data-id="{{ post.id }}"
                                            title="{{ reactionType|capitalize }}"
                                        >
                                            <span class="text-3xl">{{ emoji }}</span>
                                            <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                                                {{ reactionType|capitalize }}
                                            </span>
                                        </button>
                                    {% endfor %}
                                </div>
                            </div>
                            {% else %}
                                <a href="{{ path('auth_login') }}" class="flex items-center gap-2 px-6 py-2.5 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all border-2 border-slate-200 dark:border-navy-700 font-semibold">
                                    <span class="text-2xl">👍</span>
                                    <span class="text-base">Sign in to React</span>
                                </a>
                            {% endif %}

                            {# Actions on the right #}
                            <div class="flex items-center gap-1">
                                <button class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-slate-700 dark:hover:text-slate-300 transition-colors" title="Save post">
                                    <i data-lucide="bookmark" class="w-4 h-4"></i>
                                </button>
                                
                                {% if app.user %}
                                <button onclick="openReportModal()" class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-red-600 dark:hover:text-red-400 transition-colors" title="Report post">
                                    <i data-lucide="flag" class="w-4 h-4"></i>
                                </button>
                                {% endif %}
                                
                                <button class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-slate-700 dark:hover:text-slate-300 transition-colors" title="More options">
                                    <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>

                        {# Show reaction breakdown #}
                        {% if postReactionCounts|default({})|length > 0 %}
                            {% set totalReactions = 0 %}
                            {% for count in postReactionCounts %}
                                {% set totalReactions = totalReactions + count %}
                            {% endfor %}
                            <div class="flex items-center flex-wrap gap-2 pt-3 border-t border-slate-200 dark:border-navy-800">
                                <span class="text-sm font-medium text-slate-600 dark:text-slate-400 mr-1">{{ totalReactions }} {{ totalReactions == 1 ? 'reaction' : 'reactions' }}</span>
                                {% for type, count in postReactionCounts %}
                                    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-navy-800 hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors cursor-default">
                                        <span class="text-lg">{{ emojiMap[type] }}</span>
                                        <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">{{ count }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </article>

        {# Answers Section #}
<div class="mb-6">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white">
            {{ post.replies|length }} {{ post.replies|length == 1 ? 'Answer' : 'Answers' }}
        </h2>
        <select class="input py-2 w-auto text-sm">
            <option>Sort by: Best</option>
            <option>Sort by: Newest</option>
        </select>
    </div>

    <div class="space-y-4">
        {# Only show top-level replies #}
        {% for reply in post.replies %}
            {% if reply.parent is null %}
                {{ _self.render_reply(reply, replyReactionData, emojiMap, app.user, 0) }}
            {% endif %}
        {% else %}
        <div class="card p-6 text-center text-slate-500 dark:text-slate-400">
            No answers yet. Be the first to reply.
        </div>
        {% endfor %}
    </div>
</div>

{# Recursive Reply Macro #}
{% macro render_reply(reply, replyReactionData, emojiMap, currentUser, depth) %}
    {% set replyData = replyReactionData[reply.id]|default({'userReaction': null, 'counts': {}}) %}
    {% set totalReplyReactions = 0 %}
    {% for count in replyData.counts %}
        {% set totalReplyReactions = totalReplyReactions + count %}
    {% endfor %}
    
    {# Calculate left margin based on depth (max 5 levels) #}
    {% set marginClass = depth > 0 ? 'ml-' ~ (depth > 5 ? 20 : (depth * 4)) : '' %}
    
    <article class="card p-6 {{ marginClass }}" id="reply-{{ reply.id }}" style="{% if depth > 0 %}border-left: 3px solid rgb(16 185 129);{% endif %}">
        <div class="flex gap-4">
            <div class="flex-1 min-w-0">
                {# Author Info #}
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        {% if reply.author.avatar %}
                            <img src="{{ reply.author.avatar }}" alt="{{ reply.author.fullName }}" class="w-10 h-10 rounded-full object-cover">
                        {% else %}
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-sm font-medium">
                                {{ reply.author.fullName|slice(0,1)|upper }}
                            </div>
                        {% endif %}
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-slate-900 dark:text-white">{{ reply.author.fullName }}</span>
                                <span class="text-xs text-slate-500 dark:text-slate-400">{{ reply.createdAt ? reply.createdAt|date('M j, Y, H:i') : '' }}</span>
                                {% if reply.updatedAt %}
                                    <span class="text-xs text-slate-400 dark:text-slate-500">(edited)</span>
                                {% endif %}
                                {% if depth > 0 %}
                                    <span class="text-xs badge bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400">↳ Reply</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Edit/Delete buttons #}
                    {% if currentUser and currentUser.id == reply.author.id %}
                        <div class="flex items-center gap-2">
                            <button onclick="editReplyForm({{ reply.id}}, `{{ reply.content|e('js') }}`)" class="text-sm text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 flex items-center gap-1">
                                <i data-lucide="edit-2" class="w-3 h-3"></i>
                                Edit
                            </button>
                            <button onclick="deleteReply({{ reply.id }})" class="text-sm text-slate-600 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 flex items-center gap-1">
                                <i data-lucide="trash-2" class="w-3 h-3"></i>
                                Delete
                            </button>
                        </div>
                    {% endif %}
                </div>

                {# Reply Content - MARKDOWN RENDERED #}
                <div class="reply-content-{{ reply.id }} prose prose-sm dark:prose-invert max-w-none mb-4" data-reply-id="{{ reply.id }}">
                    {# Content rendered by JS #}
                </div>

                {# Edit Form #}
                <div class="reply-edit-form-{{ reply.id }} hidden mb-4">
                    <textarea class="input min-h-[120px] mb-2" id="edit-textarea-{{ reply.id }}"></textarea>
                    <div class="flex gap-2">
                        <button onclick="saveReplyEdit({{ reply.id }})" class="btn-primary text-sm px-4 py-2">
                            Save Changes
                        </button>
                        <button onclick="cancelReplyEdit({{ reply.id }})" class="btn-outline text-sm px-4 py-2">
                            Cancel
                        </button>
                    </div>
                </div>

                {# Reply Actions & Reactions #}
                <div class="flex items-center justify-between pt-3 border-t border-slate-200 dark:border-navy-800">
                    <div class="flex items-center gap-4">
                        {# Reaction Button for Reply #}
                        {% if currentUser %}
                        <div class="reaction-trigger relative" data-reply-id="{{ reply.id }}">
                            {% if replyData.userReaction %}
                                <button class="reaction-current-btn flex items-center gap-1.5 px-4 py-2 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all border border-emerald-200 dark:border-emerald-800 text-sm font-medium">
                                    <span class="reaction-emoji text-lg">{{ emojiMap[replyData.userReaction] }}</span>
                                    <span class="reaction-count font-semibold">{{ totalReplyReactions }}</span>
                                </button>
                            {% else %}
                                <button class="reaction-current-btn flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all border border-slate-200 dark:border-navy-700 text-sm font-medium">
                                    <span class="reaction-emoji text-lg">👍</span>
                                    {% if totalReplyReactions > 0 %}
                                        <span class="reaction-count font-semibold">{{ totalReplyReactions }}</span>
                                    {% else %}
                                        <span>React</span>
                                    {% endif %}
                                </button>
                            {% endif %}

                            {# Reaction Picker #}
                            <div class="reaction-picker hidden absolute top-full left-0 mt-2 bg-white dark:bg-navy-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-navy-700 p-2.5 flex items-center gap-1.5 z-20">
                                {% for reactionType, emoji in emojiMap %}
                                    <button 
                                        class="reaction-btn group relative hover:scale-110 transition-all duration-200 p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-700"
                                        data-url="{{ path('community_react_reply', {'id': reply.id}) }}"
                                        data-type="{{ reactionType }}"
                                        data-target="reply"
                                        data-id="{{ reply.id }}"
                                        title="{{ reactionType|capitalize }}"
                                    >
                                        <span class="text-2xl">{{ emoji }}</span>
                                        <span class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                                            {{ reactionType|capitalize }}
                                        </span>
                                    </button>
                                {% endfor %}
                            </div>
                        </div>

                        {# Reply to Reply Button #}
                        {% if depth < 5 %}
                            <button onclick="showReplyForm({{ reply.id }})" class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all text-sm font-medium">
                                <i data-lucide="corner-down-right" class="w-4 h-4"></i>
                                <span>Reply</span>
                            </button>
                        {% endif %}
                        {% else %}
                            <a href="{{ path('auth_login') }}" class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all text-sm font-medium">
                                <span class="text-lg">👍</span>
                                <span>Sign in</span>
                            </a>
                        {% endif %}
                    </div>

                    {# Show reaction breakdown #}
                    {% if replyData.counts|length > 0 %}
                        <div class="flex items-center gap-2">
                            {% for type, count in replyData.counts %}
                                <div class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-slate-100 dark:bg-navy-800 text-xs">
                                    <span>{{ emojiMap[type] }}</span>
                                    <span class="font-semibold text-slate-600 dark:text-slate-400">{{ count }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {# Nested Reply Form (hidden by default) #}
                <div id="reply-form-{{ reply.id }}" class="hidden mt-4 pl-4 border-l-2 border-emerald-500">
                    <textarea 
                        id="reply-textarea-{{ reply.id }}" 
                        class="input min-h-[100px] mb-2" 
                        placeholder="Write your reply..."
                    ></textarea>
                    <div class="flex gap-2">
                        <button onclick="submitNestedReply({{ reply.id }})" class="btn-primary text-sm px-4 py-2">
                            <i data-lucide="send" class="w-4 h-4 mr-1"></i>
                            Post Reply
                        </button>
                        <button onclick="hideReplyForm({{ reply.id }})" class="btn-outline text-sm px-4 py-2">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </article>

    {# Recursively render nested replies #}
    {% if reply.replies|length > 0 %}
        <div class="space-y-4 mt-4">
            {% for nestedReply in reply.replies %}
                {{ _self.render_reply(nestedReply, replyReactionData, emojiMap, currentUser, depth + 1) }}
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

        {# Write Answer Form #}
        {% if app.user %}
        <div class="card p-6">
            <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-4">Your Answer</h3>

            <form action="{{ path('community_reply', {id: post.id}) }}" method="post">
                <div class="mb-4">
                    <textarea name="content" class="input min-h-[200px]" placeholder="Write your answer here... Use Markdown for formatting." required>{{ app.request.get('content')|e }}</textarea>
                </div>

                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                        Markdown formatting is supported
                    </p>
                    <button type="submit" class="btn-primary">
                        <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                        Post Answer
                    </button>
                </div>
            </form>
        </div>
        {% else %}
        <div class="card p-6 text-center">
            <p class="text-slate-600 dark:text-slate-400 mb-4">
                Please sign in to post an answer
            </p>
            <a href="{{ path('auth_login') }}" class="btn-primary inline-flex items-center">
                <i data-lucide="log-in" class="w-4 h-4 mr-2"></i>
                Sign In
            </a>
        </div>
        {% endif %}
    </div>
</div>

{# Report Modal #}
<div id="report-modal" class="hidden fixed inset-0 z-50 bg-navy-950/50 backdrop-blur-sm flex items-center justify-center p-4" onclick="closeReportModal()">
    <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-strong w-full max-w-md" onclick="event.stopPropagation()">
        <div class="p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-display font-bold text-slate-900 dark:text-white">Report Post</h3>
                <button onclick="closeReportModal()" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors">
                    <i data-lucide="x" class="w-5 h-5 text-slate-600 dark:text-slate-400"></i>
                </button>
            </div>

            <form id="report-form" onsubmit="submitReport(event)">
                <div class="space-y-4">
                    <div>
                        <label class="input-label">Why are you reporting this post?</label>
                        <select name="reason" required class="input">
                            <option value="">Select a reason...</option>
                            <option value="spam">Spam or advertising</option>
                            <option value="harassment">Harassment or bullying</option>
                            <option value="inappropriate">Inappropriate content</option>
                            <option value="misinformation">False or misleading information</option>
                            <option value="off_topic">Off-topic or irrelevant</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div>
                        <label class="input-label">Additional details (optional)</label>
                        <textarea name="description" rows="4" class="textarea" placeholder="Please provide more context..."></textarea>
                    </div>

                    <div class="flex items-center gap-3 pt-4">
                        <button type="button" onclick="closeReportModal()" class="btn-outline flex-1">
                            Cancel
                        </button>
                        <button type="submit" class="btn-danger flex-1">
                            <i data-lucide="flag" class="w-4 h-4"></i>
                            Submit Report
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}

{# Markdown parser and syntax highlighting #}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/core.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/javascript.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/python.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/php.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/java.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/css.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/languages/sql.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github-dark.min.css">

<script>
    lucide.createIcons();

    // Configure marked for syntax highlighting
    marked.setOptions({
        highlight: function(code, lang) {
            if (lang && hljs.getLanguage(lang)) {
                try {
                    return hljs.highlight(code, { language: lang }).value;
                } catch (err) {}
            }
            return hljs.highlightAuto(code).value;
        },
        breaks: true,
        gfm: true
    });

    // Render post content
    const postContent = {{ post.content|json_encode|raw }};
    const contentDiv = document.getElementById('post-content');
    if (contentDiv && postContent) {
        contentDiv.innerHTML = marked.parse(postContent);
        lucide.createIcons();
    }

    // Render reply content
    const replyContents = {
        {% for reply in post.replies %}
        {{ reply.id }}: {{ reply.content|json_encode|raw }}{{ loop.last ? '' : ',' }}
        {% endfor %}
    };

    Object.keys(replyContents).forEach(replyId => {
        const el = document.querySelector(`[data-reply-id="${replyId}"]`);
        if (el) {
            el.innerHTML = marked.parse(replyContents[replyId]);
        }
    });

    // Reaction emoji mapping
    const reactionEmojis = {
        'like': '👍',
        'love': '❤️',
        'haha': '😂',
        'wow': '😮',
        'sad': '😢',
        'angry': '😡'
    };

    // Show/hide reaction picker
    document.querySelectorAll('.reaction-trigger').forEach(trigger => {
        const picker = trigger.querySelector('.reaction-picker');
        const currentBtn = trigger.querySelector('.reaction-current-btn');
        
        if (!picker || !currentBtn) return;
        
        let hideTimeout;

        const showPicker = () => {
            clearTimeout(hideTimeout);
            picker.classList.remove('hidden');
        };

        const hidePicker = () => {
            hideTimeout = setTimeout(() => {
                picker.classList.add('hidden');
            }, 200);
        };

        trigger.addEventListener('mouseenter', showPicker);
        trigger.addEventListener('mouseleave', hidePicker);
        
        currentBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (picker.classList.contains('hidden')) {
                showPicker();
            } else {
                hidePicker();
            }
        });
    });

    // Handle reaction button clicks
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.reaction-btn');
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        const url = btn.dataset.url;
        const type = btn.dataset.type;
        const target = btn.dataset.target;
        const id = btn.dataset.id;

        btn.disabled = true;

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ type: type })
        })
        .then(res => res.json())
        .then(data => {
            if (!data || !data.ok) {
                console.error('Reaction failed', data);
                return;
            }

            let trigger;
            if (target === 'post') {
                trigger = document.querySelector(`.reaction-trigger[data-post-id="${id}"]`);
            } else {
                trigger = document.querySelector(`.reaction-trigger[data-reply-id="${id}"]`);
            }

            if (!trigger) return;

            const currentBtn = trigger.querySelector('.reaction-current-btn');
            const emojiSpan = currentBtn.querySelector('.reaction-emoji');
            let countSpan = currentBtn.querySelector('.reaction-count');
            const picker = trigger.querySelector('.reaction-picker');

            if (data.userReaction) {
                emojiSpan.textContent = reactionEmojis[data.userReaction];
                
                if (!countSpan) {
                    countSpan = document.createElement('span');
                    countSpan.className = 'reaction-count';
                    currentBtn.appendChild(countSpan);
                }
                countSpan.textContent = data.total;

                if (target === 'post') {
                    currentBtn.className = 'reaction-current-btn flex items-center gap-2 px-6 py-2.5 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all border-2 border-emerald-200 dark:border-emerald-800 font-semibold';
                } else {
                    currentBtn.className = 'reaction-current-btn flex items-center gap-1.5 px-4 py-2 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all border border-emerald-200 dark:border-emerald-800 text-sm font-medium';
                }
            } else {
                emojiSpan.textContent = '👍';
                
                if (countSpan) {
                    if (data.total > 0) {
                        countSpan.textContent = data.total;
                    } else {
                        countSpan.remove();
                    }
                }

                if (target === 'post') {
                    currentBtn.className = 'reaction-current-btn flex items-center gap-2 px-6 py-2.5 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all border-2 border-slate-200 dark:border-navy-700 font-semibold';
                } else {
                    currentBtn.className = 'reaction-current-btn flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all border border-slate-200 dark:border-navy-700 text-sm font-medium';
                }
            }

            picker.classList.add('hidden');
        })
        .catch(err => {
            console.error('Reaction request error', err);
        })
        .finally(() => {
            btn.disabled = false;
        });
    });

    // Close picker when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.reaction-trigger')) {
            document.querySelectorAll('.reaction-picker').forEach(picker => {
                picker.classList.add('hidden');
            });
        }
    });

    // Reply Edit Functions
    function editReplyForm(replyId, currentContent) {
        document.querySelector(`.reply-content-${replyId}`).classList.add('hidden');
        document.querySelector(`.reply-edit-form-${replyId}`).classList.remove('hidden');
        document.getElementById(`edit-textarea-${replyId}`).value = currentContent;
        lucide.createIcons();
    }

    function cancelReplyEdit(replyId) {
        document.querySelector(`.reply-content-${replyId}`).classList.remove('hidden');
        document.querySelector(`.reply-edit-form-${replyId}`).classList.add('hidden');
    }

    function saveReplyEdit(replyId) {
        const content = document.getElementById(`edit-textarea-${replyId}`).value.trim();
        
        if (!content) {
            alert('Reply content cannot be empty');
            return;
        }

        fetch(`/community/reply/${replyId}/edit`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ content: content })
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                const contentDiv = document.querySelector(`[data-reply-id="${replyId}"]`);
                contentDiv.innerHTML = marked.parse(data.content);
                cancelReplyEdit(replyId);
                alert('Reply updated successfully!');
            } else {
                alert('Error: ' + (data.error || 'Failed to update reply'));
            }
        })
        .catch(err => {
            console.error('Edit error:', err);
            alert('Failed to update reply');
        });
    }

    function deleteReply(replyId) {
        if (!confirm('Are you sure you want to delete this reply? This cannot be undone.')) {
            return;
        }

        fetch(`/community/reply/${replyId}/delete`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                document.getElementById(`reply-${replyId}`).remove();
                alert('Reply deleted successfully');
            } else {
                alert('Error: ' + (data.error || 'Failed to delete reply'));
            }
        })
        .catch(err => {
            console.error('Delete error:', err);
            alert('Failed to delete reply');
        });
    }

    // Report Modal Functions
    function openReportModal() {
        document.getElementById('report-modal').classList.remove('hidden');
        document.getElementById('report-form').reset();
        lucide.createIcons();
    }

    function closeReportModal() {
        document.getElementById('report-modal').classList.add('hidden');
    }

    function submitReport(event) {
        event.preventDefault();
        
        const form = event.target;
        const formData = new FormData(form);
        
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Submitting...';
        lucide.createIcons();
        
        fetch('{{ path("community_report_post", {"id": post.id}) }}', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.ok) {
                alert(data.message || 'Report submitted successfully.');
                closeReportModal();
            } else {
                alert(data.error || 'Failed to submit report.');
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert('Failed to submit report.');
        })
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i data-lucide="flag" class="w-4 h-4"></i> Submit Report';
            lucide.createIcons();
        });
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeReportModal();
        }
    });

    // Show reply form for nested replies
function showReplyForm(replyId) {
    const form = document.getElementById(`reply-form-${replyId}`);
    if (form) {
        form.classList.remove('hidden');
        document.getElementById(`reply-textarea-${replyId}`).focus();
        lucide.createIcons();
    }
}

// Hide reply form
function hideReplyForm(replyId) {
    const form = document.getElementById(`reply-form-${replyId}`);
    if (form) {
        form.classList.add('hidden');
        document.getElementById(`reply-textarea-${replyId}`).value = '';
    }
}

// Submit nested reply
async function submitNestedReply(parentReplyId) {
    const textarea = document.getElementById(`reply-textarea-${parentReplyId}`);
    const content = textarea.value.trim();

    if (!content) {
        alert('Reply cannot be empty');
        return;
    }

    try {
        const response = await fetch(`/community/reply/${parentReplyId}/reply`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ content: content })
        });

        const data = await response.json();

        if (data.ok) {
            alert('Reply posted! Page will reload to show nested reply.');
            location.reload(); // Reload to show new nested reply
        } else {
            alert('Error: ' + (data.error || 'Failed to post reply'));
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Failed to post reply');
    }
}
</script>

