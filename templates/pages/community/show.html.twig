                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

{# Facebook-Style Reply Macro #}
{% macro render_facebook_reply(reply, replyReactionData, emojiMap, currentUser, depth, postId) %}
    {% set replyData = replyReactionData[reply.id]|default({'userReaction': null, 'counts': {}}) %}
    {% set totalReactions = replyData.counts|reduce((sum, count) => sum + count, 0) %}
    {% set hasNested = reply.replies|length > 0 %}
    {% set replyCount = reply.replies|length %}
    
    <div class="reply-item bg-white dark:bg-navy-900 {% if depth == 0 %}rounded-2xl shadow-xl border border-slate-200/50 dark:border-navy-700/50 mb-4 p-5{% else %}mt-3{% endif %}" id="reply-{{ reply.id }}" data-depth="{{ depth }}">
        <div class="flex gap-3">
            {% if reply.author.avatar %}
                <img src="{{ reply.author.avatar }}" alt="{{ reply.author.fullName }}" class="w-10 h-10 rounded-xl flex-shrink-0 shadow-lg ring-2 ring-slate-100 dark:ring-navy-800/50">
            {% else %}
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-400 to-cyan-500 flex items-center justify-center text-white text-sm font-black flex-shrink-0 shadow-lg ring-2 ring-slate-100 dark:ring-navy-800/50">
                    {{ reply.author.fullName|slice(0,1)|upper }}
                </div>
            {% endif %}

            <div class="flex-1 min-w-0">
                <div class="reply-content-wrapper" id="reply-content-wrapper-{{ reply.id }}">
                    <div class="inline-block max-w-full">
                        <div class="bg-slate-50 dark:bg-navy-800/50 rounded-2xl px-4 py-3 border border-slate-200 dark:border-navy-700/30">
                            <div class="flex items-center gap-2 mb-1.5">
                                <span class="font-black text-sm text-slate-900 dark:text-white hover:underline cursor-pointer">{{ reply.author.fullName }}</span>
                                {% if reply.updatedAt %}
                                    <span class="text-xs text-slate-400 dark:text-slate-500">(edited)</span>
                                {% endif %}
                            </div>
                            
                            <div class="reply-content prose prose-sm dark:prose-invert max-w-none" id="reply-content-{{ reply.id }}" data-reply-id="{{ reply.id }}"></div>
                        </div>

                        <div class="reply-edit-form hidden mt-2" id="reply-edit-form-{{ reply.id }}">
                            <textarea class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-navy-700/50 bg-white dark:bg-navy-900 text-sm min-h-[100px] focus:border-emerald-500 dark:focus:border-emerald-600 focus:ring-2 focus:ring-emerald-200 dark:focus:ring-emerald-900/50 transition-all text-slate-900 dark:text-white" id="edit-textarea-{{ reply.id }}"></textarea>
                            <div class="flex gap-2 mt-2">
                                <button onclick="saveReplyEdit({{ reply.id }})" class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white text-xs font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200">Save</button>
                                <button onclick="cancelReplyEdit({{ reply.id }})" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-navy-700/50 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 text-xs font-semibold transition-all">Cancel</button>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 mt-2 text-xs font-semibold flex-wrap">
                        <span class="text-slate-500 dark:text-slate-400">{{ reply.createdAt|ago }}</span>
                        
                        {% if currentUser %}
                            <div class="reaction-trigger-reply relative inline-block" data-reply-id="{{ reply.id }}">
                                {% if replyData.userReaction %}
                                    <button class="reaction-btn-reply px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all border border-emerald-200 dark:border-emerald-700/30 font-black hover:scale-105">
                                        <span class="text-base">{{ emojiMap[replyData.userReaction] }}</span>
                                        {% if totalReactions > 1 %}<span class="ml-1">{{ totalReactions }}</span>{% endif %}
                                    </button>
                                {% else %}
                                    <button class="reaction-btn-reply px-3 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 font-black hover:scale-105">
                                        Like{% if totalReactions > 0 %} · {{ totalReactions }}{% endif %}
                                    </button>
                                {% endif %}

                                <div class="reaction-picker-reply hidden absolute bottom-full left-0 mb-2 bg-white dark:bg-navy-800 rounded-2xl shadow-2xl border-2 border-slate-200 dark:border-navy-700/50 p-2 flex gap-1 z-[60] animate-scale-in">
                                    {% for reactionType, emoji in emojiMap %}
                                        <button 
                                            class="reaction-option hover:scale-125 transition-all p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-700/50"
                                            data-url="{{ path('community_react_reply', {'id': reply.id}) }}"
                                            data-type="{{ reactionType }}"
                                            data-target="reply"
                                            data-id="{{ reply.id }}"
                                        >
                                            <span class="text-xl">{{ emoji }}</span>
                                        </button>
                                    {% endfor %}
                                </div>
                            </div>

                            {% if depth < 3 %}
                                <button onclick="toggleReplyForm({{ reply.id }})" class="px-3 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 font-black hover:scale-105">
                                    Reply
                                </button>
                            {% endif %}

                            <button onclick="translateReply({{ reply.id }})" class="px-3 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 font-black hover:scale-105">
                                Translate
                            </button>
                        {% else %}
                            <a href="{{ path('auth_login') }}" class="px-3 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all text-slate-600 dark:text-slate-400 hover:text-emerald-600 font-black">
                                Like
                            </a>
                            <a href="{{ path('auth_login') }}" class="px-3 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all text-slate-600 dark:text-slate-400 hover:text-blue-600 font-black">
                                Reply
                            </a>
                        {% endif %}

                        {% if currentUser and currentUser.id == reply.author.id %}
                            <button onclick="editReply({{ reply.id }}, `{{ reply.content|e('js') }}`)" class="px-3 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all text-slate-600 dark:text-slate-400 hover:text-blue-600 font-black">
                                Edit
                            </button>
                            <button onclick="deleteReply({{ reply.id }})" class="px-3 py-1 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all text-slate-600 dark:text-slate-400 hover:text-red-600 font-black">
                                Delete
                            </button>
                        {% endif %}
                    </div>
                </div>

                <div id="reply-form-{{ reply.id }}" class="hidden mt-3 pl-4 border-l-4 border-blue-500 space-y-2">
                    <div class="flex gap-2">
                        {% if currentUser.avatar %}
                            <img src="{{ currentUser.avatar }}" alt="{{ currentUser.fullName }}" class="w-8 h-8 rounded-xl flex-shrink-0 shadow-lg">
                        {% else %}
                            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xs font-black flex-shrink-0 shadow-lg">
                                {{ currentUser.fullName|slice(0,1)|upper }}
                            </div>
                        {% endif %}
                        <textarea 
                            id="nested-reply-textarea-{{ reply.id }}" 
                            class="flex-1 px-4 py-3 rounded-xl border border-slate-200 dark:border-navy-700/50 bg-white dark:bg-navy-900 text-sm min-h-[80px] focus:border-blue-500 dark:focus:border-blue-600 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900/50 transition-all text-slate-900 dark:text-white placeholder:text-slate-500 dark:placeholder:text-slate-400" 
                            placeholder="Write a reply..."
                        ></textarea>
                    </div>
                    <div class="flex gap-2 justify-end">
                        <button onclick="toggleReplyForm({{ reply.id }})" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-navy-700/50 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 text-xs font-semibold transition-all">
                            Cancel
                        </button>
                        <button onclick="submitNestedReply({{ reply.id }})" class="px-5 py-2 rounded-xl bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-600 hover:to-cyan-600 text-white text-xs font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200">
                            <i data-lucide="send" class="w-3 h-3 inline mr-1"></i>
                            Reply
                        </button>
                    </div>
                </div>

                {% if hasNested %}
                    <div class="nested-replies mt-3 pl-4 border-l-2 border-slate-200 dark:border-navy-700/30" id="nested-replies-{{ reply.id }}">
                        <button onclick="toggleNestedReplies({{ reply.id }})" class="flex items-center gap-2 text-xs font-black text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 mb-3 px-3 py-2 rounded-xl hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all hover:scale-105" id="view-replies-btn-{{ reply.id }}">
                            <i data-lucide="corner-down-right" class="w-3.5 h-3.5"></i>
                            View {{ replyCount }} {{ replyCount == 1 ? 'reply' : 'replies' }}
                        </button>

                        <div class="hidden space-y-3" id="nested-replies-content-{{ reply.id }}">
                            <button onclick="toggleNestedReplies({{ reply.id }})" class="flex items-center gap-2 text-xs font-black text-slate-600 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-300 mb-2 px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800/50 transition-all hover:scale-105" id="hide-replies-btn-{{ reply.id }}">
                                <i data-lucide="chevron-up" class="w-3.5 h-3.5"></i>
                                Hide replies
                            </button>
                            {% for nestedReply in reply.replies %}
                                {{ _self.render_facebook_reply(nestedReply, replyReactionData, emojiMap, currentUser, depth + 1, postId) }}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{# Report Modal #}
<div id="report-modal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-md" onclick="closeReportModal()">
    <div class="min-h-screen p-4 flex items-center justify-center">
        <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-2xl w-full max-w-md border-2 border-slate-200 dark:border-navy-700/50 animate-scale-in" onclick="event.stopPropagation()">
            <div class="p-6">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-2xl font-black text-slate-900 dark:text-white">Report Post</h3>
                    <button onclick="closeReportModal()" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800 transition-all hover:scale-110">
                        <i data-lucide="x" class="w-5 h-5"></i>
