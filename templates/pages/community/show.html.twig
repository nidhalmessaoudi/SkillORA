{% extends 'layouts/base.html.twig' %}

{% block title %}{{ post.title }} - Community | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Breadcrumb #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <nav class="flex items-center gap-2 text-sm">
                <a href="{{ path('community_index') }}" class="text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Community</a>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                <span class="text-slate-500 dark:text-slate-400">{{ post.tag }}</span>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                <span class="text-slate-900 dark:text-white font-medium truncate max-w-xs">{{ post.title }}</span>
            </nav>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Main Post #}
        <article class="card p-8 mb-6">
            <div class="flex gap-6">
                {# Vote Column #}
                <div class="flex flex-col items-center gap-1 pt-2">
                    <button class="p-2 rounded-xl hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-colors group">
                        <i data-lucide="chevron-up" class="w-6 h-6 text-slate-400 group-hover:text-emerald-600"></i>
                    </button>
                    <span class="text-xl font-bold text-slate-900 dark:text-white">{{ post.upvotes }}</span>
                    <button class="p-2 rounded-xl hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors group">
                        <i data-lucide="chevron-down" class="w-6 h-6 text-slate-400 group-hover:text-red-600"></i>
                    </button>
                </div>

                {# Post Content #}
                <div class="flex-1 min-w-0">
                    {# Post Header #}
                    <div class="flex items-center gap-2 mb-4">
                        <span class="badge {{ post.tag == 'Discussion' ? 'badge-primary' : (post.tag == 'Success Story' ? 'badge-success' : 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400') }}">
                            {{ post.tag }}
                        </span>
                        {% if post.solved|default(false) %}
                        <span class="badge badge-success">
                            <i data-lucide="check-circle" class="w-3 h-3 mr-1"></i>
                            Solved
                        </span>
                        {% endif %}
                    </div>

                    {# Title #}
                    <h1 class="text-2xl lg:text-3xl font-display font-bold text-slate-900 dark:text-white mb-6">
                        {{ post.title }}
                    </h1>

                    {# Author Info #}
                    <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-200 dark:border-navy-800">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xl font-bold">
                            {{ post.author|slice(0, 1) }}
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-slate-900 dark:text-white">{{ post.author }}</span>
                                <span class="badge bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs">
                                    Level 5
                                </span>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400">{{ post.created_at }} • {{ post.comments_count }} replies</p>
                        </div>
                    </div>

                    {# Post Body #}
                    <div class="prose dark:prose-invert max-w-none mb-6">
                        <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
                            {{ post.content }}
                        </p>

                        {# Code Block Example #}
                        <div class="my-6">
                            <div class="flex items-center justify-between bg-slate-800 rounded-t-xl px-4 py-2">
                                <span class="text-sm text-slate-400">javascript</span>
                                <button class="text-sm text-slate-400 hover:text-white transition-colors flex items-center gap-1">
                                    <i data-lucide="copy" class="w-4 h-4"></i>
                                    Copy
                                </button>
                            </div>
                            <pre class="bg-slate-900 rounded-b-xl p-4 overflow-x-auto"><code class="text-sm text-slate-300">const useEffect = (callback, deps) => {
  // How does React know when to call this?
  // I'm confused about the dependency array
  if (deps changed) {
    callback();
  }
};</code></pre>
                        </div>

                        <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
                            Any help would be greatly appreciated. I've been stuck on this for a while and would love to understand it better.
                        </p>
                    </div>

                    {# Tags #}
                    <div class="flex flex-wrap gap-2 mb-6">
                        {% for tag in post.tags|default(['react', 'hooks', 'useEffect', 'javascript']) %}
                        <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                            #{{ tag }}
                        </a>
                        {% endfor %}
                    </div>

                    {# Actions #}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <button class="btn-ghost text-sm">
                                <i data-lucide="bookmark" class="w-4 h-4 mr-1"></i>
                                Save
                            </button>
                            <button class="btn-ghost text-sm">
                                <i data-lucide="share-2" class="w-4 h-4 mr-1"></i>
                                Share
                            </button>
                            <button class="btn-ghost text-sm">
                                <i data-lucide="flag" class="w-4 h-4 mr-1"></i>
                                Report
                            </button>
                        </div>
                        <button class="btn-ghost text-sm">
                            <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </article>

        {# Answers Section #}
        <div class="mb-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white">
                    {{ post.comments_count }} {{ post.comments_count == 1 ? 'Answer' : 'Answers' }}
                </h2>
                <select class="input py-2 w-auto text-sm">
                    <option>Sort by: Best</option>
                    <option>Sort by: Newest</option>
                    <option>Sort by: Oldest</option>
                </select>
            </div>

            {# Answers List #}
            <div class="space-y-4">
                {% set answers = [
                    {
                        author: {name: 'Marcus Chen', avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100', level: 11},
                        content: 'Great question! The useEffect hook runs after React renders your component. The dependency array tells React when to re-run the effect.\n\nHere\'s a clearer explanation:\n- Empty array []: Runs only once after initial render\n- No array: Runs after every render\n- [dep1, dep2]: Runs when dep1 or dep2 changes',
                        votes: 42,
                        timeAgo: '4 hours ago',
                        isAccepted: true
                    },
                    {
                        author: {name: 'Sophie Williams', avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100', level: 8},
                        content: 'To add to Marcus\'s answer, React uses Object.is() comparison to check if dependencies changed. This is why you might see unexpected re-renders with objects or arrays - you need to ensure referential equality.',
                        votes: 18,
                        timeAgo: '3 hours ago',
                        isAccepted: false
                    },
                    {
                        author: {name: 'David Kim', avatar: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=100', level: 7},
                        content: 'I found the official React docs really helpful for this. Also, the useCallback hook can help when you need to pass functions as dependencies!',
                        votes: 8,
                        timeAgo: '2 hours ago',
                        isAccepted: false
                    }
                ] %}

                {% for answer in answers %}
                <article class="card p-6 {{ answer.isAccepted ? 'ring-2 ring-emerald-500 dark:ring-emerald-400' : '' }}">
                    {% if answer.isAccepted %}
                    <div class="flex items-center gap-2 mb-4 text-emerald-600 dark:text-emerald-400">
                        <i data-lucide="check-circle" class="w-5 h-5"></i>
                        <span class="font-semibold text-sm">Accepted Answer</span>
                    </div>
                    {% endif %}

                    <div class="flex gap-4">
                        {# Vote Column #}
                        <div class="flex flex-col items-center gap-1">
                            <button class="p-1.5 rounded-lg hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-colors group">
                                <i data-lucide="chevron-up" class="w-5 h-5 text-slate-400 group-hover:text-emerald-600"></i>
                            </button>
                            <span class="font-semibold text-slate-900 dark:text-white">{{ answer.votes }}</span>
                            <button class="p-1.5 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors group">
                                <i data-lucide="chevron-down" class="w-5 h-5 text-slate-400 group-hover:text-red-600"></i>
                            </button>
                        </div>

                        {# Answer Content #}
                        <div class="flex-1 min-w-0">
                            {# Author #}
                            <div class="flex items-center gap-3 mb-4">
                                <img src="{{ answer.author.avatar }}" alt="{{ answer.author.name }}" class="w-10 h-10 rounded-full object-cover">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-slate-900 dark:text-white">{{ answer.author.name }}</span>
                                        <span class="badge bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs">
                                            Level {{ answer.author.level }}
                                        </span>
                                    </div>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">{{ answer.timeAgo }}</p>
                                </div>
                            </div>

                            {# Content #}
                            <div class="prose dark:prose-invert max-w-none mb-4">
                                <p class="text-slate-700 dark:text-slate-300 whitespace-pre-line">{{ answer.content }}</p>
                            </div>

                            {# Actions #}
                            <div class="flex items-center gap-4 text-sm">
                                <button class="text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Reply</button>
                                <button class="text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Share</button>
                                {% if not answer.isAccepted %}
                                <button class="text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors flex items-center gap-1">
                                    <i data-lucide="check" class="w-4 h-4"></i>
                                    Accept
                                </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>

        {# Write Answer Form #}
        <div class="card p-6">
            <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-4">Your Answer</h3>

            <div class="mb-4">
                <textarea class="input min-h-[200px]" placeholder="Write your answer here... Use Markdown for formatting."></textarea>
            </div>

            <div class="flex items-center justify-between">
                <p class="text-sm text-slate-500 dark:text-slate-400">
                    <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                    Markdown formatting is supported
                </p>
                <button class="btn-primary">
                    <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                    Post Answer
                </button>
            </div>
        </div>

        {# Related Posts #}
        <div class="mt-10">
            <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-6">Related Posts</h2>
            <div class="grid md:grid-cols-2 gap-4">
                {% for i in 1..4 %}
                <a href="#" class="card p-4 hover:shadow-lg transition-all group">
                    <h3 class="font-medium text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-2">
                        {{ ['Understanding React Lifecycle Methods', 'useCallback vs useMemo - When to use which?', 'Why is my useEffect running twice?', 'Custom Hooks Best Practices'][i-1] }}
                    </h3>
                    <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                        <span>{{ [24, 18, 32, 15][i-1] }} answers</span>
                        <span>•</span>
                        <span>{{ [1.2, 0.8, 2.1, 0.5][i-1] }}k views</span>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();
</script>
{% endblock %}
