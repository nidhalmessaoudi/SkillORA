{% extends 'layouts/base.html.twig' %}

{% block title %}{{ post.title }} - Community | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Breadcrumb #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <nav class="flex items-center gap-2 text-sm">
                <a href="{{ path('community_index') }}" class="text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Community</a>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>

                {# breadcrumb label: use type or topic or fallback #}
                {% set crumbLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                <span class="text-slate-500 dark:text-slate-400">{{ crumbLabel }}</span>

                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
                <span class="text-slate-900 dark:text-white font-medium truncate max-w-xs">{{ post.title }}</span>
            </nav>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Main Post #}
        <article class="card p-8 mb-6">
            <div class="flex gap-6">
                {# Vote Column for Post #}
                {% set userPostVote = userPostVote|default(0) %}
                {% set postUp = postCounts[post.id].up|default(post.upvotes) %}
                {% set postDown = postCounts[post.id].down|default(0) %}
                <div class="flex flex-col items-center gap-1 pt-2">
                    <button
                        class="vote-btn vote-post p-2 rounded-xl hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-colors group"
                        data-url="{{ path('community_vote_post', {'id': post.id}) }}"
                        data-action="up"
                        data-id="{{ post.id }}"
                        aria-label="Upvote post">
                        <i data-lucide="chevron-up" class="w-6 h-6 {{ userPostVote == 1 ? 'text-emerald-600' : 'text-slate-400 group-hover:text-emerald-600' }}"></i>
                    </button>

                    <span class="text-xl font-bold text-slate-900 dark:text-white post-upvotes" data-id="{{ post.id }}">{{ postUp }}</span>

                    <button
                        class="vote-btn vote-post p-2 rounded-xl hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors group"
                        data-url="{{ path('community_vote_post', {'id': post.id}) }}"
                        data-action="down"
                        data-id="{{ post.id }}"
                        aria-label="Downvote post">
                        <i data-lucide="chevron-down" class="w-6 h-6 {{ userPostVote == -1 ? 'text-red-600' : 'text-slate-400 group-hover:text-red-600' }}"></i>
                    </button>

                    <span class="text-xs text-slate-400 mt-1 post-downvotes" data-id="{{ post.id }}">{{ postDown }}</span>
                </div>

                {# Post Content #}
                <div class="flex-1 min-w-0">
                    {# Post Header #}
                    <div class="flex items-center gap-2 mb-4">
                        {% set headerLabel = post.type ? post.type|capitalize : (post.topic ? post.topic : 'General') %}
                        {% set headerClass = post.type == 'discussion'
                            ? 'badge-primary'
                            : (post.type == 'article' ? 'badge-success' : 'bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-400') %}
                        <span class="badge {{ headerClass }}">{{ headerLabel }}</span>
                    </div>

                    {# Title #}
                    <h1 class="text-2xl lg:text-3xl font-display font-bold text-slate-900 dark:text-white mb-6">
                        {{ post.title }}
                    </h1>

                    {# Author Info (static user for testing) #}
                    <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-200 dark:border-navy-800">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-xl font-bold">
                            {{ user.displayName|default('U')|slice(0,1)|upper }}
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-slate-900 dark:text-white">{{ user.displayName|default('Test User') }}</span>
                                <span class="badge bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs">
                                    Level 5
                                </span>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400">
                                {{ post.createdAt ? post.createdAt|date('M j, Y') : '' }}
                                • {{ post.replies|length }} {{ post.replies|length == 1 ? 'reply' : 'replies' }}
                            </p>
                        </div>
                    </div>

                    {# Post Body: render content saved in DB #}
                    <div class="prose dark:prose-invert max-w-none mb-6">
                        {{ post.content is not empty ? post.content|e|nl2br : '' }}
                    </div>

                    {# Tags #}
                    <div class="flex flex-wrap gap-2 mb-6">
                        {% if post.tags|length %}
                            {% for tag in post.tags %}
                                <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                                    #{{ tag.name }}
                                </a>
                            {% endfor %}
                        {% else %}
                            <a href="#" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400">#general</a>
                        {% endif %}
                    </div>

                    {# Actions #}
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <button class="btn-ghost text-sm">
                                <i data-lucide="bookmark" class="w-4 h-4 mr-1"></i>
                                Save
                            </button>
                            <button class="btn-ghost text-sm">
                                <i data-lucide="share-2" class="w-4 h-4 mr-1"></i>
                                Share
                            </button>
                            <button class="btn-ghost text-sm">
                                <i data-lucide="flag" class="w-4 h-4 mr-1"></i>
                                Report
                            </button>
                        </div>
                        <button class="btn-ghost text-sm">
                            <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
        </article>

        {# Answers Section #}
        <div class="mb-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white">
                    {{ post.replies|length }} {{ post.replies|length == 1 ? 'Answer' : 'Answers' }}
                </h2>
                <select class="input py-2 w-auto text-sm">
                    <option>Sort by: Best</option>
                    <option>Sort by: Newest</option>
                    <option>Sort by: Oldest</option>
                </select>
            </div>

            <div class="space-y-4">
                {% for reply in post.replies %}
                    {% set rv = replyUserVotes[reply.id]|default(0) %}
                    {% set replyUp = replyCounts[reply.id].up|default(reply.upvotes) %}
                    {% set replyDown = replyCounts[reply.id].down|default(0) %}
                <article class="card p-6">
                    <div class="flex gap-4">
                        {# Vote column for reply #}
                        <div class="flex flex-col items-center gap-1">
                            <button
                                class="vote-btn vote-reply p-1.5 rounded-lg hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-colors group"
                                data-url="{{ path('community_vote_reply', {'id': reply.id}) }}"
                                data-action="up"
                                data-id="{{ reply.id }}"
                                aria-label="Upvote reply">
                                <i data-lucide="chevron-up" class="w-5 h-5 {{ rv == 1 ? 'text-emerald-600' : 'text-slate-400 group-hover:text-emerald-600' }}"></i>
                            </button>

                            <span class="font-semibold text-slate-900 dark:text-white reply-upvotes" data-id="{{ reply.id }}">{{ replyUp }}</span>

                            <button
                                class="vote-btn vote-reply p-1.5 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors group"
                                data-url="{{ path('community_vote_reply', {'id': reply.id}) }}"
                                data-action="down"
                                data-id="{{ reply.id }}"
                                aria-label="Downvote reply">
                                <i data-lucide="chevron-down" class="w-5 h-5 {{ rv == -1 ? 'text-red-600' : 'text-slate-400 group-hover:text-red-600' }}"></i>
                            </button>

                            <span class="text-xs text-slate-400 mt-1 reply-downvotes" data-id="{{ reply.id }}">{{ replyDown }}</span>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-sm font-medium">
                                    {{ reply.authorName ? reply.authorName|slice(0,1)|upper : 'U' }}
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-slate-900 dark:text-white">{{ reply.authorName ?? 'Guest' }}</span>
                                        <span class="text-xs text-slate-500 dark:text-slate-400">{{ reply.createdAt ? reply.createdAt|date('M j, Y, H:i') : '' }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="prose dark:prose-invert max-w-none">
                                <p class="text-slate-700 dark:text-slate-300 whitespace-pre-line">{{ reply.content|e }}</p>
                            </div>
                        </div>
                    </div>
                </article>
                {% else %}
                <div class="card p-6 text-center text-slate-500 dark:text-slate-400">
                    No answers yet. Be the first to reply.
                </div>
                {% endfor %}
            </div>
        </div>

        {# Write Answer Form #}
        <div class="card p-6">
            <h3 class="text-lg font-display font-bold text-slate-900 dark:text-white mb-4">Your Answer</h3>

            <form action="{{ path('community_reply', {id: post.id}) }}" method="post">
                <div class="mb-4">
                    <textarea name="content" class="input min-h-[200px]" placeholder="Write your answer here... Use Markdown for formatting.">{{ app.request.get('content')|e }}</textarea>
                </div>

                <div class="flex items-center justify-between">
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        <i data-lucide="info" class="w-4 h-4 inline mr-1"></i>
                        Markdown formatting is supported
                    </p>
                    <button type="submit" class="btn-primary">
                        <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                        Post Answer
                    </button>
                </div>
            </form>
        </div>

        {# Related Posts #}
        <div class="mt-10">
            <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white mb-6">Related Posts</h2>
            <div class="grid md:grid-cols-2 gap-4">
                {% for i in 1..4 %}
                <a href="#" class="card p-4 hover:shadow-lg transition-all group">
                    <h3 class="font-medium text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-2">
                        {{ ['Understanding React Lifecycle Methods', 'useCallback vs useMemo - When to use which?', 'Why is my useEffect running twice?', 'Custom Hooks Best Practices'][i-1] }}
                    </h3>
                    <div class="flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                        <span>{{ [24, 18, 32, 15][i-1] }} answers</span>
                        <span>•</span>
                        <span>{{ [1.2, 0.8, 2.1, 0.5][i-1] }}k views</span>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Voting handler (post & reply)
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.vote-btn');
        if (!btn) return;

        const url = btn.dataset.url;
        const action = btn.dataset.action;
        const id = btn.dataset.id;
        const isPost = btn.classList.contains('vote-post');
        const isReply = btn.classList.contains('vote-reply');

        // quick UI disable
        btn.disabled = true;

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ action: action })
        })
        .then(res => res.json())
        .then(data => {
            if (!data || !data.ok) {
                console.error('Vote error', data);
                return;
            }

            // if post: update up/down counts + icon states
            if (isPost) {
                const upEl = document.querySelector('.post-upvotes[data-id="' + id + '"]');
                const downEl = document.querySelector('.post-downvotes[data-id="' + id + '"]');
                if (upEl) upEl.textContent = data.upvotes;
                if (downEl) downEl.textContent = data.downvotes;

                const upBtn = document.querySelector('.vote-post[data-id="' + id + '"][data-action="up"]');
                const downBtn = document.querySelector('.vote-post[data-id="' + id + '"][data-action="down"]');

                if (upBtn) {
                    const upIcon = upBtn.querySelector('i[data-lucide="chevron-up"]');
                    if (upIcon) {
                        upIcon.classList.remove('text-emerald-600', 'text-slate-400');
                        if (data.userVote === 1) upIcon.classList.add('text-emerald-600');
                        else upIcon.classList.add('text-slate-400');
                    }
                }
                if (downBtn) {
                    const downIcon = downBtn.querySelector('i[data-lucide="chevron-down"]');
                    if (downIcon) {
                        downIcon.classList.remove('text-red-600', 'text-slate-400');
                        if (data.userVote === -1) downIcon.classList.add('text-red-600');
                        else downIcon.classList.add('text-slate-400');
                    }
                }
            }

            // if reply: update up/down counts + icons
            if (isReply) {
                const upEl = document.querySelector('.reply-upvotes[data-id="' + id + '"]');
                const downEl = document.querySelector('.reply-downvotes[data-id="' + id + '"]');
                if (upEl) upEl.textContent = data.upvotes;
                if (downEl) downEl.textContent = data.downvotes;

                const upBtn = document.querySelector('.vote-reply[data-id="' + id + '"][data-action="up"]');
                const downBtn = document.querySelector('.vote-reply[data-id="' + id + '"][data-action="down"]');

                if (upBtn) {
                    const upIcon = upBtn.querySelector('i[data-lucide="chevron-up"]');
                    if (upIcon) {
                        upIcon.classList.remove('text-emerald-600', 'text-slate-400');
                        if (data.userVote === 1) upIcon.classList.add('text-emerald-600');
                        else upIcon.classList.add('text-slate-400');
                    }
                }
                if (downBtn) {
                    const downIcon = downBtn.querySelector('i[data-lucide="chevron-down"]');
                    if (downIcon) {
                        downIcon.classList.remove('text-red-600', 'text-slate-400');
                        if (data.userVote === -1) downIcon.classList.add('text-red-600');
                        else downIcon.classList.add('text-slate-400');
                    }
                }
            }
        })
        .catch(err => {
            console.error('Vote request failed', err);
        })
        .finally(() => {
            btn.disabled = false;
        });
    });
</script>
{% endblock %}
