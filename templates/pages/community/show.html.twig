{% extends 'layouts/base.html.twig' %}

{% block title %}{{ post.title }} - Community | SkillHarbor{% endblock %}

{% block body %}
{% set emojiMap = {
    'like': '👍',
    'love': '❤️',
    'haha': '😂',
    'wow': '😮',
    'sad': '😢',
    'angry': '😡'
} %}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-blue-50/20 dark:from-navy-950 dark:via-navy-900 dark:to-navy-950">
    {# Ultra Modern Sticky Header #}
    <div class="bg-white/80 dark:bg-navy-900/60 backdrop-blur-xl border-b border-slate-200/50 dark:border-navy-800/20 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex items-center justify-between">
                <nav class="flex items-center gap-2">
                    <a href="{{ path('community_index') }}" class="group flex items-center gap-2 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-all duration-200">
                        <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
                        <span class="font-semibold text-sm">Community</span>
                    </a>
                </nav>
                
                <div class="flex items-center gap-2">
                    {# Compact Translation Toggle #}
                    <button 
                        onclick="toggleTranslateMenu(event)" 
                        class="group flex items-center gap-2 px-3 py-2 rounded-xl text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all duration-200"
                        title="Translate"
                    >
                        <i data-lucide="languages" class="w-5 h-5"></i>
                        <span class="text-sm font-semibold hidden md:inline">Translate</span>
                    </button>
                    
                    <button class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800/30 hover:scale-110 transition-all duration-200" title="Bookmark">
                        <i data-lucide="bookmark" class="w-5 h-5"></i>
                    </button>
                    <button class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800/30 hover:scale-110 transition-all duration-200" title="Share">
                        <i data-lucide="share-2" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Floating Translation Panel #}
    <div id="translate-panel" class="hidden fixed top-20 right-4 z-[100] animate-slide-in">
        <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-2xl border-2 border-slate-200 dark:border-navy-700 p-5 min-w-[320px]">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <div class="p-2 rounded-xl bg-gradient-to-br from-blue-500 to-cyan-600 shadow-md">
                        <i data-lucide="languages" class="w-5 h-5 text-white"></i>
                    </div>
                    <h3 class="font-black text-slate-900 dark:text-white text-base">Translate Post</h3>
                </div>
                <button onclick="toggleTranslateMenu(event)" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors">
                    <i data-lucide="x" class="w-5 h-5 text-slate-500 dark:text-slate-400"></i>
                </button>
            </div>
            
            <select id="translate-lang" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-800 text-sm font-semibold text-slate-900 dark:text-white focus:border-blue-500 dark:focus:border-blue-500 focus:ring-4 focus:ring-blue-200/50 dark:focus:ring-blue-500/20 transition-all mb-4">
                <option value="">Select language...</option>
                <option value="ar">🇸🇦 Arabic</option>
                <option value="zh">🇨🇳 Chinese</option>
                <option value="nl">🇳🇱 Dutch</option>
                <option value="en">🇬🇧 English</option>
                <option value="fr">🇫🇷 French</option>
                <option value="de">🇩🇪 German</option>
                <option value="it">🇮🇹 Italian</option>
                <option value="pt">🇵🇹 Portuguese</option>
                <option value="ru">🇷🇺 Russian</option>
                <option value="es">🇪🇸 Spanish</option>
            </select>

            <div class="flex gap-3">
                <button 
                    onclick="translatePost()" 
                    id="translate-btn"
                    class="flex-1 px-5 py-3 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-700 hover:to-cyan-700 text-white text-sm font-bold shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200"
                >
                    <i data-lucide="languages" class="w-4 h-4 inline mr-2"></i>
                    Translate
                </button>

                <button 
                    onclick="showOriginalPost()" 
                    id="original-btn"
                    class="hidden flex-1 px-5 py-3 rounded-xl bg-slate-600 hover:bg-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600 text-white text-sm font-bold shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200"
                >
                    <i data-lucide="rotate-ccw" class="w-4 h-4 inline mr-2"></i>
                    Original
                </button>
            </div>

            <p class="text-xs text-slate-500 dark:text-slate-400 mt-3 flex items-center gap-1.5">
                <i data-lucide="info" class="w-3.5 h-3.5"></i>
                Translates post content & replies
            </p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-2xl {{ label == 'success' ? 'bg-emerald-50/80 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-700/30' : 'bg-red-50/80 dark:bg-red-900/20 border border-red-200 dark:border-red-700/30' }} shadow-sm animate-slide-down">
                    <div class="flex items-center gap-3">
                        <div class="p-1.5 rounded-xl {{ label == 'success' ? 'bg-emerald-100 dark:bg-emerald-900/30' : 'bg-red-100 dark:bg-red-900/30' }}">
                            <i data-lucide="{{ label == 'success' ? 'check-circle' : 'alert-circle' }}" class="w-4 h-4"></i>
                        </div>
                        <p class="flex-1 font-medium text-sm {{ label == 'success' ? 'text-emerald-700 dark:text-emerald-400' : 'text-red-700 dark:text-red-400' }}">{{ message }}</p>
                        <button onclick="this.parentElement.parentElement.remove()" class="p-1.5 rounded-xl hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="grid lg:grid-cols-3 gap-6">
            {# Main Content #}
            <div class="lg:col-span-2 space-y-6">
                {# Ultra Premium Post Card #}
                <article class="group bg-white dark:bg-navy-900 rounded-3xl shadow-xl hover:shadow-2xl border border-slate-200/50 dark:border-navy-700/50 overflow-hidden transition-all duration-300">
                    <div class="p-8">
                        {# Sleek Header #}
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                {% set postTypeClass = post.type == 'article' ? 'from-blue-500 to-blue-600 text-white' : (post.type == 'discussion' ? 'from-purple-500 to-purple-600 text-white' : 'from-amber-500 to-amber-600 text-white') %}
                                <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-r {{ postTypeClass }} text-xs font-bold uppercase tracking-wider shadow-lg">
                                    <i data-lucide="{{ post.type == 'article' ? 'file-text' : (post.type == 'discussion' ? 'message-circle' : 'help-circle') }}" class="w-3.5 h-3.5"></i>
                                    {{ post.type ? post.type : 'Question' }}
                                </span>
                                {% if post.topic %}
                                    <span class="text-sm text-slate-500 dark:text-slate-400 font-medium">{{ post.topic }}</span>
                                {% endif %}
                            </div>

                            {% if app.user and app.user.id == post.author.id %}
                                <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <a href="{{ path('community_edit_post', {id: post.id}) }}" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-50 dark:bg-navy-800/50 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-700 transition-all text-sm font-medium border border-slate-200 dark:border-navy-700/30">
                                        <i data-lucide="edit-2" class="w-4 h-4"></i>
                                    </a>
                                    <form method="post" action="{{ path('community_delete_post', {id: post.id}) }}" onsubmit="return confirm('Delete this post?');">
                                        <button type="submit" class="p-2 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/30 transition-all border border-red-200 dark:border-red-700/30">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>

                        {# Premium Title #}
                        <h1 class="text-4xl lg:text-5xl font-display font-black text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 dark:from-white dark:via-slate-100 dark:to-white mb-8 leading-tight">
                            {{ post.title }}
                        </h1>

                        {# Modern Author Card #}
                        <div class="flex items-center gap-4 mb-8 p-4 rounded-2xl bg-gradient-to-r from-slate-50/50 to-blue-50/50 dark:from-navy-800/20 dark:to-blue-900/10 border border-slate-200/50 dark:border-navy-700/20">
                            {% if post.author.avatar %}
                                <img src="{{ post.author.avatar }}" alt="{{ post.author.fullName }}" class="w-16 h-16 rounded-2xl object-cover ring-4 ring-white dark:ring-navy-900/50 shadow-xl">
                            {% else %}
                                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-2xl font-black ring-4 ring-white dark:ring-navy-900/50 shadow-xl">
                                    {{ post.author.fullName|slice(0,1)|upper }}
                                </div>
                            {% endif %}
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="font-black text-slate-900 dark:text-white text-lg">{{ post.author.fullName }}</span>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-gradient-to-r from-amber-400 to-yellow-400 text-slate-900 text-xs font-black shadow-md">
                                        <i data-lucide="award" class="w-3 h-3"></i>
                                        Lvl 5
                                    </span>
                                </div>
                                <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400 font-semibold">
                                    <span class="flex items-center gap-1.5">
                                        <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                                        {{ post.createdAt|ago }}
                                    </span>
                                    <span class="flex items-center gap-1.5">
                                        <i data-lucide="message-circle" class="w-3.5 h-3.5"></i>
                                        {{ post.replies|length }} replies
                                    </span>
                                </div>
                            </div>
                        </div>

                        {# Content #}
                        <div class="prose prose-slate dark:prose-invert max-w-none mb-8" id="post-content"></div>
<div class="bg-white dark:bg-navy-800 p-6 rounded-2xl shadow-sm mb-8 border border-slate-200 dark:border-navy-700">

    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-bold flex items-center gap-2">
            <div class="w-12 h-12 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center flex-shrink-0">
                            <i data-lucide="sparkles" class="w-6 h-6 text-white"></i>
                        </div>
            AI Summary
        </h3>

        <button id="generate-summary-btn"
    data-post-id="{{ post.id }}"
    class="inline-flex items-center gap-2 px-4 py-2 
           bg-gradient-to-r from-violet-600 to-purple-600
           hover:from-violet-700 hover:to-purple-700
           text-white font-semibold rounded-xl
           shadow-md transition-all duration-200">
    <i data-lucide="sparkles" class="w-4 h-4"></i>
    Generate
</button>
    </div>

    <textarea id="post-summary"
              rows="4"
              class="w-full border rounded-xl p-3 dark:bg-navy-900 dark:border-navy-700 text-sm"
              placeholder="Summary will appear here..."
              readonly></textarea>

    <p id="summary-status" class="text-sm mt-2 text-slate-500"></p>

</div>
                        {# Sleek Tags #}
                        {% if post.tags|length %}
                            <div class="flex flex-wrap gap-2 mb-8">
                                {% for tag in post.tags %}
                                    <a href="#" class="inline-flex items-center px-3 py-1.5 rounded-full bg-slate-100 dark:bg-navy-800/50 text-slate-700 dark:text-slate-300 hover:bg-emerald-500 hover:text-white dark:hover:bg-emerald-600 transition-all text-xs font-bold border border-slate-200 dark:border-navy-700/30 hover:border-emerald-500 dark:hover:border-emerald-600 hover:scale-105 shadow-sm hover:shadow-md">
                                        #{{ tag.name }}
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {# Premium Reactions #}
                        <div class="pt-8 border-t-2 border-slate-100 dark:border-navy-700/50">
                            <div class="flex items-center justify-between flex-wrap gap-4">
                                {% if app.user %}
                                    <div class="reaction-trigger relative" data-post-id="{{ post.id }}">
                                        {% set totalReactions = postReactionCounts|default({})|length > 0 ? postReactionCounts|reduce((sum, count) => sum + count, 0) : 0 %}
                                        
                                        {% if userPostReaction %}
                                            <button class="reaction-current-btn flex items-center gap-3 px-6 py-3 rounded-2xl bg-gradient-to-r from-emerald-400 to-teal-500 text-white hover:from-emerald-500 hover:to-teal-600 transition-all font-black shadow-lg hover:shadow-xl hover:scale-105 duration-200">
                                                <span class="reaction-emoji text-2xl">{{ emojiMap[userPostReaction] }}</span>
                                                <div class="flex flex-col items-start">
                                                    <span class="text-sm">{{ userPostReaction|capitalize }}</span>
                                                    {% if totalReactions > 1 %}
                                                        <span class="reaction-count text-xs opacity-90">You +{{ totalReactions - 1 }}</span>
                                                    {% endif %}
                                                </div>
                                            </button>
                                        {% else %}
                                            <button class="reaction-current-btn flex items-center gap-3 px-6 py-3 rounded-2xl bg-slate-100 dark:bg-navy-800/50 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all font-black shadow-lg hover:shadow-xl hover:scale-105 duration-200 border border-slate-200 dark:border-navy-700/30">
                                                <span class="reaction-emoji text-2xl">👍</span>
                                                <div class="flex flex-col items-start">
                                                    <span class="text-sm">React</span>
                                                    {% if totalReactions > 0 %}
                                                        <span class="reaction-count text-xs opacity-75">{{ totalReactions }}</span>
                                                    {% endif %}
                                                </div>
                                            </button>
                                        {% endif %}

                                        {# Premium Reaction Picker #}
                                        <div class="reaction-picker hidden absolute bottom-full left-0 mb-3 bg-white dark:bg-navy-800 rounded-2xl shadow-2xl border-2 border-slate-200 dark:border-navy-700/50 p-3 flex items-center gap-2 z-[60] animate-scale-in">
                                            {% for reactionType, emoji in emojiMap %}
                                                <button 
                                                    class="reaction-btn group relative hover:scale-125 transition-all duration-200 p-3 rounded-xl hover:bg-gradient-to-br hover:from-emerald-50 hover:to-teal-50 dark:hover:from-emerald-900/20 dark:hover:to-teal-900/20"
                                                    data-url="{{ path('community_react_post', {'id': post.id}) }}"
                                                    data-type="{{ reactionType }}"
                                                    data-target="post"
                                                    data-id="{{ post.id }}"
                                                >
                                                    <span class="text-3xl block">{{ emoji }}</span>
                                                    <span class="absolute -top-12 left-1/2 -translate-x-1/2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs px-3 py-2 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none font-black shadow-xl z-[70]">
                                                        {{ reactionType|capitalize }}
                                                    </span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% else %}
                                    <a href="{{ path('auth_login') }}" class="flex items-center gap-3 px-6 py-3 rounded-2xl bg-slate-100 dark:bg-navy-800/50 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-navy-700 transition-all font-black shadow-lg hover:shadow-xl hover:scale-105 duration-200 border border-slate-200 dark:border-navy-700/30">
                                        <span class="text-2xl">👍</span>
                                        <span class="text-sm">Sign in to React</span>
                                    </a>
                                {% endif %}

                                <div class="flex items-center gap-2">
                                    {% if app.user %}
                                        <button onclick="openReportModal()" class="p-3 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-red-50 dark:hover:bg-red-900/20 hover:text-red-600 hover:scale-110 transition-all duration-200" title="Report">
                                            <i data-lucide="flag" class="w-5 h-5"></i>
                                        </button>
                                    {% endif %}
                                </div>
                            </div>

                            {# Reaction Breakdown #}
                            {% if postReactionCounts|default({})|length > 0 %}
                                <div class="flex items-center flex-wrap gap-3 mt-6 pt-6 border-t border-slate-100 dark:border-navy-700/50">
                                    {% for type, count in postReactionCounts %}
                                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-navy-800/50 dark:to-navy-900/50 hover:scale-105 transition-all border border-slate-200 dark:border-navy-700/30 shadow-md cursor-pointer">
                                            <span class="text-2xl">{{ emojiMap[type] }}</span>
                                            <span class="text-sm font-black text-slate-700 dark:text-slate-300">{{ count }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </article>

                {# Modern Reply Section #}
                <div class="space-y-4">
                    {# Quick Reply #}
                    {% if app.user %}
                        <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200/50 dark:border-navy-700/50 p-5">
                            <div id="quick-reply-collapsed" class="cursor-pointer" onclick="expandReplyBox()">
                                <div class="flex items-center gap-3">
                                    {% if app.user.avatar %}
                                        <img src="{{ app.user.avatar }}" alt="{{ app.user.fullName }}" class="w-12 h-12 rounded-xl ring-2 ring-emerald-500/20 shadow-lg flex-shrink-0">
                                    {% else %}
                                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white font-black shadow-lg flex-shrink-0">
                                            {{ app.user.fullName|slice(0,1)|upper }}
                                        </div>
                                    {% endif %}
                                    <div class="flex-1 px-4 py-3 bg-slate-50 dark:bg-navy-800/50 rounded-xl border border-slate-200 dark:border-navy-700/30 hover:border-emerald-500 dark:hover:border-emerald-600 transition-all">
                                        <span class="text-slate-500 dark:text-slate-400 text-sm font-medium">Write a comment...</span>
                                    </div>
                                </div>
                            </div>

                            <div id="quick-reply-expanded" class="hidden">
                                <form action="{{ path('community_reply', {id: post.id}) }}" method="post" class="space-y-4">
                                    <div class="flex items-start gap-3">
                                        {% if app.user.avatar %}
                                            <img src="{{ app.user.avatar }}" alt="{{ app.user.fullName }}" class="w-12 h-12 rounded-xl ring-2 ring-emerald-500/20 shadow-lg flex-shrink-0">
                                        {% else %}
                                            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white font-black shadow-lg flex-shrink-0">
                                                {{ app.user.fullName|slice(0,1)|upper }}
                                            </div>
                                        {% endif %}
                                        
                                        <div class="flex-1 space-y-3">
                                            <textarea 
                                                name="content" 
                                                id="quick-reply-textarea" 
                                                class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-navy-700/50 bg-slate-50 dark:bg-navy-800/50 focus:border-emerald-500 dark:focus:border-emerald-600 focus:ring-2 focus:ring-emerald-200 dark:focus:ring-emerald-900/50 transition-all min-h-[120px] font-mono text-sm text-slate-900 dark:text-white placeholder:text-slate-500 dark:placeholder:text-slate-400" 
                                                placeholder="Share your thoughts..."
                                                required
                                            ></textarea>

                                            <div class="flex items-center justify-between gap-3 flex-wrap">
                                                <button 
                                                    type="button"
                                                    onclick="generateReply({{ post.id }})"
                                                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 text-white text-sm font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200"
                                                >
                                                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                                                    AI Generate
                                                </button>

                                                <div class="flex items-center gap-2">
                                                    <button type="button" onclick="collapseReplyBox()" class="px-4 py-2 rounded-xl border border-slate-200 dark:border-navy-700/50 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-navy-800 transition-all text-sm font-semibold">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white text-sm font-bold shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200">
                                                        <i data-lucide="send" class="w-4 h-4"></i>
                                                        Comment
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    {% else %}
                        <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200/50 dark:border-navy-700/50 p-5">
                            <a href="{{ path('auth_login') }}" class="flex items-center gap-3 group">
                                <div class="w-12 h-12 rounded-xl bg-slate-200 dark:bg-navy-800/50 flex items-center justify-center shadow-lg border border-slate-300 dark:border-navy-700/30">
                                    <i data-lucide="user" class="w-6 h-6 text-slate-500 dark:text-slate-400"></i>
                                </div>
                                <div class="flex-1 px-4 py-3 bg-slate-50 dark:bg-navy-800/50 rounded-xl border border-slate-200 dark:border-navy-700/30 group-hover:border-emerald-500 dark:group-hover:border-emerald-600 transition-all">
                                    <span class="text-slate-500 dark:text-slate-400 text-sm font-medium">Sign in to comment</span>
                                </div>
                            </a>
                        </div>
                    {% endif %}

                    {# Comments Header #}
                    <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200/50 dark:border-navy-700/50 p-5">
                        <div class="flex items-center justify-between flex-wrap gap-3">
                            <h2 class="text-xl font-black text-slate-900 dark:text-white flex items-center gap-3">
                                <div class="p-2.5 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-500 shadow-md">
                                    <i data-lucide="message-square" class="w-5 h-5 text-white"></i>
                                </div>
                                <span>{{ post.replies|length }} Comments</span>
                            </h2>
                            <div class="flex items-center gap-2">
                                <button onclick="collapseAllReplies()" class="text-xs text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition-colors px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-navy-800/50 font-semibold">
                                    <i data-lucide="minimize-2" class="w-3 h-3 inline mr-1"></i>
                                    Collapse
                                </button>
                                <select class="px-3 py-2 rounded-xl border border-slate-200 dark:border-navy-700/50 bg-white dark:bg-navy-900 text-xs font-semibold focus:border-emerald-500 dark:focus:border-emerald-600 transition-all text-slate-900 dark:text-white" onchange="sortReplies(this.value)">
                                    <option value="best">Best</option>
                                    <option value="newest">Newest</option>
                                    <option value="oldest">Oldest</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    {# Replies #}
                    <div class="space-y-0" id="replies-container">
                        {% for reply in post.replies %}
                            {% if reply.parent is null %}
                                {{ _self.render_facebook_reply(reply, replyReactionData, emojiMap, app.user, 0, post.id) }}
                            {% endif %}
                        {% else %}
                            <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200/50 dark:border-navy-700/50 p-12 text-center">
                                <div class="w-24 h-24 rounded-2xl bg-slate-100 dark:bg-navy-800/50 flex items-center justify-center mx-auto mb-4 shadow-lg border border-slate-200 dark:border-navy-700/30">
                                    <i data-lucide="message-circle-off" class="w-12 h-12 text-slate-400 dark:text-slate-500"></i>
                                </div>
                                <p class="text-xl font-black text-slate-600 dark:text-slate-400 mb-2">No comments yet</p>
                                <p class="text-sm text-slate-500 dark:text-slate-500">Be the first to share your thoughts!</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Premium Sidebar #}
            <div class="lg:col-span-1 space-y-5">
                {# Stats Card #}
                <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200/50 dark:border-navy-700/50 p-6 sticky top-[72px]">
                    <h3 class="font-black text-slate-900 dark:text-white mb-5 flex items-center gap-2">
                        <div class="p-2 rounded-xl bg-gradient-to-br from-blue-400 to-blue-500 shadow-md">
                            <i data-lucide="bar-chart-3" class="w-5 h-5 text-white"></i>
                        </div>
                        Post Stats
                    </h3>
                    <div class="space-y-3">
                        <div class="flex items-center justify-between p-3 rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-navy-800/50 dark:to-navy-900/50 border border-slate-200 dark:border-navy-700/30 hover:scale-105 transition-all cursor-pointer">
                            <span class="text-sm font-semibold text-slate-600 dark:text-slate-400">Replies</span>
                            <span class="text-2xl font-black text-slate-900 dark:text-white">{{ post.replies|length }}</span>
                        </div>
                        <div class="flex items-center justify-between p-3 rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-navy-800/50 dark:to-navy-900/50 border border-slate-200 dark:border-navy-700/30 hover:scale-105 transition-all cursor-pointer">
                            <span class="text-sm font-semibold text-slate-600 dark:text-slate-400">Reactions</span>
                            <span class="text-2xl font-black text-slate-900 dark:text-white">
                                {% set total = 0 %}
                                {% for count in postReactionCounts|default({}) %}
                                    {% set total = total + count %}
                                {% endfor %}
                                {{ total }}
                            </span>
                        </div>
                        <div class="flex items-center justify-between p-3 rounded-xl bg-gradient-to-br from-slate-50 to-slate-100 dark:from-navy-800/50 dark:to-navy-900/50 border border-slate-200 dark:border-navy-700/30 hover:scale-105 transition-all cursor-pointer">
                            <span class="text-sm font-semibold text-slate-600 dark:text-slate-400">Asked</span>
                            <span class="text-sm font-black text-slate-900 dark:text-white">{{ post.createdAt|ago }}</span>
                        </div>
                    </div>
                </div>

                {# Related Topics #}
                <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200/50 dark:border-navy-700/50 p-6">
                    <h3 class="font-black text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <div class="p-2 rounded-xl bg-gradient-to-br from-purple-400 to-purple-500 shadow-md">
                            <i data-lucide="compass" class="w-5 h-5 text-white"></i>
                        </div>
                        Related
                    </h3>
                    <div class="space-y-2">
                        {% for tag in post.tags|slice(0, 3) %}
                            <a href="#" class="block p-3 rounded-xl bg-slate-50 dark:bg-navy-800/50 hover:bg-purple-500 hover:text-white dark:hover:bg-purple-600 transition-all border border-slate-200 dark:border-navy-700/30 hover:border-purple-500 dark:hover:border-purple-600 hover:scale-105">
                                <span class="text-sm font-bold">#{{ tag.name }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>

                {# Help Card #}
                <div class="bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-2xl shadow-xl border-2 border-blue-200/50 dark:border-blue-700/30 p-6">
                    <div class="flex items-center gap-2 mb-4">
                        <div class="p-2 rounded-xl bg-blue-500 shadow-md">
                            <i data-lucide="help-circle" class="w-5 h-5 text-white"></i>
                        </div>
                        <h3 class="font-black text-slate-900 dark:text-white">How to Answer</h3>
                    </div>
                    <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
                        <li class="flex gap-2 items-start">
                            <span class="text-emerald-600 font-black text-xl flex-shrink-0">✓</span>
                            <span class="font-semibold">Be specific and clear</span>
                        </li>
                        <li class="flex gap-2 items-start">
                            <span class="text-emerald-600 font-black text-xl flex-shrink-0">✓</span>
                            <span class="font-semibold">Include code examples</span>
                        </li>
                        <li class="flex gap-2 items-start">
                            <span class="text-emerald-600 font-black text-xl flex-shrink-0">✓</span>
                            <span class="font-semibold">Cite sources</span>
                        </li>
                        <li class="flex gap-2 items-start">
                            <span class="text-emerald-600 font-black text-xl flex-shrink-0">✓</span>
