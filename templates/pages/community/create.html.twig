{% extends 'layouts/base.html.twig' %}

{% block title %}Create Post - Community | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-slate-50 via-white to-slate-50 dark:from-navy-950 dark:via-navy-900 dark:to-navy-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        {# Header #}
        <div class="mb-8">
            <a href="{{ path('community_index') }}" class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors mb-4">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to Community
            </a>
            <h1 class="text-4xl font-display font-bold text-slate-900 dark:text-white">Create New Post</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-2">Share your knowledge or ask the community</p>
        </div>

        {# ADD THIS AI GENERATE BUTTON #}
            <div class="mt-6 p-4 bg-gradient-to-r from-violet-50 to-purple-50 dark:from-violet-900/20 dark:to-purple-900/20 border-2 border-violet-200 dark:border-violet-800 rounded-2xl">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center">
                            <i data-lucide="sparkles" class="w-6 h-6 text-white"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-900 dark:text-white">AI Post Generator</h3>
                            <p class="text-sm text-slate-600 dark:text-slate-400">Let AI help you write your post</p>
                        </div>
                    </div>
                    <button type="button" onclick="openAIModal()" class="btn bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 text-white px-6 py-3 font-semibold shadow-lg">
                        <i data-lucide="wand-2" class="w-5 h-5 mr-2"></i>
                        Generate with AI
                    </button>
                </div>
            </div>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-2xl border-2 shadow-lg {% if label == 'success' %}bg-gradient-to-r from-success-50 to-emerald-50 dark:from-success-900/20 dark:to-emerald-900/20 border-success-400 dark:border-success-600{% else %}bg-gradient-to-r from-danger-50 to-red-50 dark:from-danger-900/20 dark:to-red-900/20 border-danger-400 dark:border-danger-600{% endif %}">
                    <div class="flex items-start gap-3">
                        <div class="shrink-0 w-6 h-6 flex items-center justify-center rounded-full {% if label == 'success' %}bg-success-500{% else %}bg-danger-500{% endif %}">
                            {% if label == 'success' %}
                                <i data-lucide="check" class="w-4 h-4 text-white"></i>
                            {% else %}
                                <i data-lucide="x" class="w-4 h-4 text-white"></i>
                            {% endif %}
                        </div>
                        <p class="flex-1 font-semibold {% if label == 'success' %}text-success-800 dark:text-success-300{% else %}text-danger-800 dark:text-danger-300{% endif %}">
                            {{ message }}
                        </p>
                        <button onclick="this.parentElement.parentElement.remove()" class="shrink-0 p-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors">
                            <i data-lucide="x" class="w-4 h-4 {% if label == 'success' %}text-success-600{% else %}text-danger-600{% endif %}"></i>
                        </button>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {# Create Form #}
        <form method="post" enctype="multipart/form-data" class="space-y-6">
            {# Post Type #}
            <div class="card p-6">
                <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">Post Type</label>
                <div class="grid grid-cols-3 gap-3">
                    <label class="post-type-radio">
                        <input type="radio" name="type" value="question" checked class="peer sr-only">
                        <div class="peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-900/20 peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400 border-2 border-slate-200 dark:border-navy-800 rounded-xl p-4 text-center cursor-pointer hover:border-slate-300 dark:hover:border-navy-700 transition-all">
                            <i data-lucide="help-circle" class="w-8 h-8 mx-auto mb-2"></i>
                            <span class="font-semibold text-sm">Question</span>
                        </div>
                    </label>
                    <label class="post-type-radio">
                        <input type="radio" name="type" value="discussion" class="peer sr-only">
                        <div class="peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-900/20 peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400 border-2 border-slate-200 dark:border-navy-800 rounded-xl p-4 text-center cursor-pointer hover:border-slate-300 dark:hover:border-navy-700 transition-all">
                            <i data-lucide="message-circle" class="w-8 h-8 mx-auto mb-2"></i>
                            <span class="font-semibold text-sm">Discussion</span>
                        </div>
                    </label>
                    <label class="post-type-radio">
                        <input type="radio" name="type" value="article" class="peer sr-only">
                        <div class="peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-900/20 peer-checked:text-emerald-700 dark:peer-checked:text-emerald-400 border-2 border-slate-200 dark:border-navy-800 rounded-xl p-4 text-center cursor-pointer hover:border-slate-300 dark:hover:border-navy-700 transition-all">
                            <i data-lucide="file-text" class="w-8 h-8 mx-auto mb-2"></i>
                            <span class="font-semibold text-sm">Article</span>
                        </div>
                    </label>
                </div>
            </div>

            {# Title #}
            <div class="card p-6">
                <label for="title" class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">
                    Title <span class="text-danger-500">*</span>
                </label>
                <input 
                    type="text" 
                    id="title" 
                    name="title" 
                    placeholder="What's your question or topic?"
                    maxlength="255"
                    required
                    class="w-full px-4 py-3 bg-slate-50 dark:bg-navy-900 border-2 border-slate-200 dark:border-navy-800 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all"
                >
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
                    <span id="title-count">0</span>/255 characters. Be specific and clear (minimum 5 characters).
                </p>
            </div>

            {# Topic #}
            <div class="card p-6">
                <label for="topic" class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">Topic</label>
                <select 
                    name="topic" 
                    id="topic"
                    class="w-full px-4 py-3 bg-slate-50 dark:bg-navy-900 border-2 border-slate-200 dark:border-navy-800 rounded-xl text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all"
                >
                    <option value="">Select a topic (optional)...</option>
                    <option value="JavaScript">JavaScript</option>
                    <option value="Python">Python</option>
                    <option value="React">React</option>
                    <option value="PHP">PHP</option>
                    <option value="CSS">CSS</option>
                    <option value="Node.js">Node.js</option>
                    <option value="Database">Database</option>
                    <option value="Career">Career</option>
                    <option value="DevOps">DevOps</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            {# Rich Text Content Editor #}
            <div class="card p-6">
                <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">
                    Content <span class="text-danger-500">*</span>
                </label>

                {# Formatting Toolbar #}
<div class="flex items-center gap-2 p-3 bg-slate-100 dark:bg-navy-900 rounded-t-xl border-2 border-b-0 border-slate-200 dark:border-navy-800">
    <button type="button" data-format="bold" class="toolbar-btn format-btn" title="Bold (Ctrl+B)">
        <i data-lucide="bold" class="w-4 h-4"></i>
    </button>
    <button type="button" data-format="italic" class="toolbar-btn format-btn" title="Italic (Ctrl+I)">
        <i data-lucide="italic" class="w-4 h-4"></i>
    </button>
    <button type="button" data-format="code" class="toolbar-btn format-btn" title="Inline Code">
        <i data-lucide="code" class="w-4 h-4"></i>
    </button>
    <div class="w-px h-6 bg-slate-300 dark:bg-navy-700"></div>
    <button type="button" data-format="link" class="toolbar-btn format-btn" title="Insert Link">
        <i data-lucide="link" class="w-4 h-4"></i>
    </button>
    <button type="button" id="image-btn" class="toolbar-btn" title="Upload Image">
        <i data-lucide="image" class="w-4 h-4"></i>
    </button>
    <div class="w-px h-6 bg-slate-300 dark:bg-navy-700"></div>
    <button type="button" data-format="ul" class="toolbar-btn format-btn" title="Bullet List">
        <i data-lucide="list" class="w-4 h-4"></i>
    </button>
    <button type="button" data-format="ol" class="toolbar-btn format-btn" title="Numbered List">
        <i data-lucide="list-ordered" class="w-4 h-4"></i>
    </button>
    <button type="button" data-format="quote" class="toolbar-btn format-btn" title="Quote">
        <i data-lucide="quote" class="w-4 h-4"></i>
    </button>
    <button type="button" data-format="codeblock" class="toolbar-btn format-btn" title="Code Block">
        <i data-lucide="code-2" class="w-4 h-4"></i>
    </button>
</div>

{# Hidden file input for images #}
<input type="file" id="image-upload" accept="image/*" class="hidden">

                {# Content Textarea #}
                <textarea 
                    id="content" 
                    name="content" 
                    rows="12"
                    placeholder="Describe your question or topic in detail...

You can use formatting:
- **bold** or *italic*
- `code`
- [link text](url)
- Lists, quotes, and code blocks"
                    required
                    class="w-full px-4 py-3 bg-slate-50 dark:bg-navy-900 border-2 border-t-0 border-slate-200 dark:border-navy-800 rounded-b-xl text-slate-900 dark:text-white placeholder-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all resize-none font-mono text-sm"
                ></textarea>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
                    <span id="content-count">0</span> characters. Minimum 10 characters required. Markdown formatting is supported.
                </p>

                {# Preview Panel #}
                <div id="preview-panel" class="hidden mt-4 p-4 bg-slate-50 dark:bg-navy-900 rounded-xl border-2 border-slate-200 dark:border-navy-800">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm font-semibold text-slate-900 dark:text-white">Preview</span>
                        <button type="button" onclick="togglePreview()" class="text-sm text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">Hide</button>
                    </div>
                    <div id="preview-content" class="prose dark:prose-invert max-w-none"></div>
                </div>
                <button type="button" onclick="togglePreview()" class="mt-2 text-sm font-medium text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300">
                    <i data-lucide="eye" class="w-4 h-4 inline mr-1"></i>
                    Toggle Preview
                </button>
            </div>

            {# Tags #}
            <div class="card p-6">
                <label for="tags" class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">Tags</label>
                <input 
                    type="text" 
                    id="tags" 
                    name="tags" 
                    placeholder="e.g., javascript, react, debugging (comma-separated)"
                    class="w-full px-4 py-3 bg-slate-50 dark:bg-navy-900 border-2 border-slate-200 dark:border-navy-800 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all"
                >
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Add up to 5 tags to help others find your post</p>
            </div>

            {# Submit Buttons #}
            <div class="flex items-center justify-between gap-4">
                <a href="{{ path('community_index') }}" class="btn-outline">
                    <i data-lucide="x" class="w-4 h-4"></i>
                    Cancel
                </a>
                <button type="submit" class="btn-primary">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    Publish Post
                </button>
            </div>
        </form>
    </div>
    {# AI Generation Modal #}
<div id="ai-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm overflow-y-auto" onclick="closeAIModal(event)">
    <div class="min-h-screen px-4 py-8 flex items-center justify-center">
        <div class="bg-white dark:bg-navy-900 rounded-3xl shadow-2xl w-full max-w-2xl relative" onclick="event.stopPropagation()">
            {# Header #}
            <div class="flex items-center justify-between p-6 border-b border-slate-200 dark:border-navy-800">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center">
                        <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-display font-bold text-slate-900 dark:text-white">AI Post Generator</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Describe what you want to write about</p>
                    </div>
                </div>
                <button onclick="closeAIModal()" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors">
                    <i data-lucide="x" class="w-6 h-6 text-slate-600 dark:text-slate-400"></i>
                </button>
            </div>

            {# Content #}
            <div class="p-6">
                {# Step 1: Prompt Input #}
                <div id="ai-prompt-step">
                    <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-3">
                        What do you want to write about?
                    </label>
                    <textarea 
                        id="ai-prompt" 
                        rows="4"
                        placeholder="Example: How to optimize SQL queries for large databases"
                        class="input mb-4"
                    ></textarea>
                    
                    <div class="flex gap-3">
                        <button onclick="closeAIModal()" class="btn-outline flex-1">
                            Cancel
                        </button>
                        <button onclick="generatePost()" class="btn bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 text-white flex-1">
                            <i data-lucide="wand-2" class="w-4 h-4 mr-2"></i>
                            Generate
                        </button>
                    </div>
                </div>

                {# Step 2: Loading #}
                <div id="ai-loading-step" class="hidden text-center py-12">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-violet-500 to-purple-600 rounded-2xl mb-4 animate-pulse">
                        <i data-lucide="sparkles" class="w-8 h-8 text-white"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">AI is writing your post...</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">This may take a few seconds</p>
                    <div class="mt-6 flex items-center justify-center gap-2">
                        <div class="w-3 h-3 bg-violet-500 rounded-full animate-bounce" style="animation-delay: 0ms"></div>
                        <div class="w-3 h-3 bg-purple-500 rounded-full animate-bounce" style="animation-delay: 150ms"></div>
                        <div class="w-3 h-3 bg-violet-500 rounded-full animate-bounce" style="animation-delay: 300ms"></div>
                    </div>
                </div>

                {# Step 3: Result #}
                <div id="ai-result-step" class="hidden">
                    <div class="mb-4 p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-xl">
                        <div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400">
                            <i data-lucide="check-circle" class="w-5 h-5"></i>
                            <span class="font-semibold">Post generated successfully!</span>
                        </div>
                        <p class="text-sm text-emerald-600 dark:text-emerald-500 mt-1">Review and edit the content below, then click "Use This Post"</p>
                    </div>

                    <div class="space-y-4 mb-4">
                        <div>
                            <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Generated Title</label>
                            <input type="text" id="ai-generated-title" readonly class="input bg-slate-50 dark:bg-navy-800">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Generated Content</label>
                            <textarea id="ai-generated-content" rows="8" readonly class="input bg-slate-50 dark:bg-navy-800"></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-900 dark:text-white mb-2">Suggested Tags</label>
                            <input type="text" id="ai-generated-tags" readonly class="input bg-slate-50 dark:bg-navy-800">
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button onclick="regeneratePost()" class="btn-outline flex-1">
                            <i data-lucide="refresh-cw" class="w-4 h-4 mr-2"></i>
                            Regenerate
                        </button>
                        <button onclick="useGeneratedPost()" class="btn-primary flex-1">
                            <i data-lucide="check" class="w-4 h-4 mr-2"></i>
                            Use This Post
                        </button>
                    </div>
                </div>

                {# Error Display #}
                <div id="ai-error-step" class="hidden">
                    <div class="p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl mb-4">
                        <div class="flex items-center gap-2 text-red-700 dark:text-red-400 mb-2">
                            <i data-lucide="alert-circle" class="w-5 h-5"></i>
                            <span class="font-semibold">Generation Failed</span>
                        </div>
                        <p id="ai-error-message" class="text-sm text-red-600 dark:text-red-500"></p>
                    </div>
                    <button onclick="showPromptStep()" class="btn-primary w-full">
                        <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
                        Try Again
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

<style>
.toolbar-btn {
    padding: 0.5rem;
    border-radius: 0.5rem;
    color: rgb(71 85 105);
    transition: all 0.2s;
}
.dark .toolbar-btn {
    color: rgb(148 163 184);
}
.toolbar-btn:hover {
    background-color: rgb(226 232 240);
    color: rgb(15 23 42);
}
.dark .toolbar-btn:hover {
    background-color: rgb(30 41 59);
    color: rgb(248 250 252);
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    lucide.createIcons();

    // Character counters
    const titleInput = document.getElementById('title');
    const contentTextarea = document.getElementById('content');
    const titleCount = document.getElementById('title-count');
    const contentCount = document.getElementById('content-count');

    if (titleInput && titleCount) {
        titleInput.addEventListener('input', () => {
            titleCount.textContent = titleInput.value.length;
        });
    }

    if (contentTextarea && contentCount) {
        contentTextarea.addEventListener('input', () => {
            contentCount.textContent = contentTextarea.value.length;
        });
    }

    // Text formatting functions
    function formatText(type) {
        const textarea = document.getElementById('content');
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const selectedText = textarea.value.substring(start, end);
        let replacement = '';

        switch(type) {
            case 'bold':
                replacement = `**${selectedText || 'bold text'}**`;
                break;
            case 'italic':
                replacement = `*${selectedText || 'italic text'}*`;
                break;
            case 'code':
                replacement = `\`${selectedText || 'code'}\``;
                break;
            case 'link':
                const url = prompt('Enter URL:');
                if (url) {
                    replacement = `[${selectedText || 'link text'}](${url})`;
                }
                break;
            case 'ul':
                replacement = `\n- ${selectedText || 'list item'}\n- \n- `;
                break;
            case 'ol':
                replacement = `\n1. ${selectedText || 'list item'}\n2. \n3. `;
                break;
            case 'quote':
                replacement = `\n> ${selectedText || 'quote'}`;
                break;
            case 'codeblock':
                replacement = `\n\`\`\`\n${selectedText || 'code here'}\n\`\`\`\n`;
                break;
        }

        if (replacement) {
            textarea.value = textarea.value.substring(0, start) + replacement + textarea.value.substring(end);
            textarea.focus();
            
            if (contentCount) {
                contentCount.textContent = textarea.value.length;
            }
        }
    }

    // Attach format button listeners
    document.querySelectorAll('.format-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const format = btn.getAttribute('data-format');
            formatText(format);
        });
    });

    // Image button listener
    const imageBtn = document.getElementById('image-btn');
    const imageUpload = document.getElementById('image-upload');
    
    if (imageBtn && imageUpload) {
        imageBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            imageUpload.click();
        });

        imageUpload.addEventListener('change', handleImageUpload);
    }

    // Image upload handler
    async function handleImageUpload(event) {
        const file = event.target.files[0];
        if (!file) return;

        // Validate file type
        if (!file.type.startsWith('image/')) {
            alert('Please select an image file');
            event.target.value = '';
            return;
        }

        // Validate file size (max 5MB)
        if (file.size > 5 * 1024 * 1024) {
            alert('Image size must be less than 5MB');
            event.target.value = '';
            return;
        }

        // Show loading
        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'fixed top-4 right-4 bg-blue-500 text-white px-6 py-3 rounded-xl shadow-2xl z-50 flex items-center gap-2';
        loadingDiv.innerHTML = '<div class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div><span>Uploading...</span>';
        document.body.appendChild(loadingDiv);

        const formData = new FormData();
        formData.append('image', file);

        try {
            const response = await fetch('/community/upload-image', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData,
                credentials: 'same-origin'
            });

            loadingDiv.remove();

            if (!response.ok) {
                const errorText = await response.text();
                console.error('Server response:', errorText);
                throw new Error(`Upload failed: HTTP ${response.status}`);
            }

            const data = await response.json();

            if (data.ok && data.url) {
                const textarea = document.getElementById('content');
                const cursorPos = textarea.selectionStart;
                const imageMarkdown = `\n![Image](${data.url})\n`;
                
                textarea.value = textarea.value.substring(0, cursorPos) + imageMarkdown + textarea.value.substring(cursorPos);
                textarea.focus();
                
                if (contentCount) {
                    contentCount.textContent = textarea.value.length;
                }

                // Success notification
                const successDiv = document.createElement('div');
                successDiv.className = 'fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-xl shadow-2xl z-50 flex items-center gap-2';
                successDiv.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5"></i><span>Image uploaded!</span>';
                document.body.appendChild(successDiv);
                lucide.createIcons();
                setTimeout(() => successDiv.remove(), 3000);
            } else {
                throw new Error(data.error || 'Upload failed');
            }
        } catch (error) {
            if (loadingDiv.parentNode) loadingDiv.remove();
            
            console.error('Upload error:', error);
            
            const errorDiv = document.createElement('div');
            errorDiv.className = 'fixed top-4 right-4 bg-red-500 text-white px-6 py-3 rounded-xl shadow-2xl z-50 flex items-center gap-2';
            errorDiv.innerHTML = `<i data-lucide="x-circle" class="w-5 h-5"></i><span>${error.message}</span>`;
            document.body.appendChild(errorDiv);
            lucide.createIcons();
            setTimeout(() => errorDiv.remove(), 5000);
        }

        event.target.value = '';
    }

    // Preview toggle
    function togglePreview() {
        const panel = document.getElementById('preview-panel');
        const content = document.getElementById('content').value;
        const previewContent = document.getElementById('preview-content');

        if (panel && panel.classList.contains('hidden')) {
            if (previewContent && typeof marked !== 'undefined') {
                previewContent.innerHTML = marked.parse(content);
            }
            panel.classList.remove('hidden');
            lucide.createIcons();
        } else if (panel) {
            panel.classList.add('hidden');
        }
    }

    // Keyboard shortcuts
    if (contentTextarea) {
        contentTextarea.addEventListener('keydown', (e) => {
            if (e.ctrlKey || e.metaKey) {
                switch(e.key) {
                    case 'b':
                        e.preventDefault();
                        formatText('bold');
                        break;
                    case 'i':
                        e.preventDefault();
                        formatText('italic');
                        break;
                }
            }
        });
    }

    // Keyboard shortcuts
    if (contentTextarea) {
        contentTextarea.addEventListener('keydown', (e) => {
            if (e.ctrlKey || e.metaKey) {
                switch(e.key) {
                    case 'b':
                        e.preventDefault();
                        formatText('bold');
                        break;
                    case 'i':
                        e.preventDefault();
                        formatText('italic');
                        break;
                }
            }
        });
    }

    // ========== AI GENERATION FUNCTIONS ==========

    function openAIModal() {
        document.getElementById('ai-modal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        showPromptStep();
        lucide.createIcons();
    }

    function closeAIModal(event) {
        if (event && event.target !== event.currentTarget) return;
        document.getElementById('ai-modal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    function showPromptStep() {
        document.getElementById('ai-prompt-step').classList.remove('hidden');
        document.getElementById('ai-loading-step').classList.add('hidden');
        document.getElementById('ai-result-step').classList.add('hidden');
        document.getElementById('ai-error-step').classList.add('hidden');
        document.getElementById('ai-prompt').value = '';
        lucide.createIcons();
    }

    async function generatePost() {
        const prompt = document.getElementById('ai-prompt').value.trim();
        
        if (!prompt) {
            alert('Please describe what you want to write about');
            return;
        }

        // Show loading
        document.getElementById('ai-prompt-step').classList.add('hidden');
        document.getElementById('ai-loading-step').classList.remove('hidden');
        lucide.createIcons();

        try {
            const response = await fetch('/community/ai-generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({ prompt: prompt })
            });

            const data = await response.json();

            if (data.success) {
                // Show result
                document.getElementById('ai-generated-title').value = data.title;
                document.getElementById('ai-generated-content').value = data.content;
                document.getElementById('ai-generated-tags').value = data.tags;

                document.getElementById('ai-loading-step').classList.add('hidden');
                document.getElementById('ai-result-step').classList.remove('hidden');
                lucide.createIcons();
            } else {
                // Show error
                document.getElementById('ai-error-message').textContent = data.error || 'Failed to generate post';
                document.getElementById('ai-loading-step').classList.add('hidden');
                document.getElementById('ai-error-step').classList.remove('hidden');
                lucide.createIcons();
            }
        } catch (error) {
            console.error('AI generation error:', error);
            document.getElementById('ai-error-message').textContent = 'Network error. Please try again.';
            document.getElementById('ai-loading-step').classList.add('hidden');
            document.getElementById('ai-error-step').classList.remove('hidden');
            lucide.createIcons();
        }
    }

    function regeneratePost() {
        const prompt = document.getElementById('ai-prompt').value;
        document.getElementById('ai-result-step').classList.add('hidden');
        document.getElementById('ai-loading-step').classList.remove('hidden');
        lucide.createIcons();
        
        // Call generate again with same prompt
        setTimeout(() => generatePost(), 100);
    }

    function useGeneratedPost() {
        // Fill the form with generated content
        document.getElementById('title').value = document.getElementById('ai-generated-title').value;
        document.getElementById('content').value = document.getElementById('ai-generated-content').value;
        document.getElementById('tags').value = document.getElementById('ai-generated-tags').value;

        // Update character counts
        if (titleCount) titleCount.textContent = document.getElementById('title').value.length;
        if (contentCount) contentCount.textContent = document.getElementById('content').value.length;

        // Close modal
        closeAIModal();

        // Scroll to form
        window.scrollTo({ top: 0, behavior: 'smooth' });

        // Show success notification
        const notification = document.createElement('div');
        notification.className = 'fixed top-4 right-4 bg-emerald-500 text-white px-6 py-3 rounded-xl shadow-2xl z-50 flex items-center gap-2';
        notification.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5"></i><span>AI content added! Review and publish.</span>';
        document.body.appendChild(notification);
        lucide.createIcons();
        setTimeout(() => notification.remove(), 4000);
    }

    // ESC key to close AI modal
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeAIModal();
        }
    });
</script>
{% endblock %}