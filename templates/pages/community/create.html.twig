{% extends 'layouts/base.html.twig' %}

{% block title %}Create Post - Community | SkillHarbor{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-navy-950">
    {# Header #}
    <div class="bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-display font-bold text-slate-900 dark:text-white">Create a Post</h1>
                    <p class="text-slate-500 dark:text-slate-400 mt-1">Share your question or start a discussion</p>
                </div>
                <a href="{{ path('community_index') }}" class="btn-ghost">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 p-4 rounded-lg flex items-center gap-3 {{ label == 'success' ? 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800' : 'bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800' }}">
                    <i data-lucide="{{ label == 'success' ? 'check-circle' : 'alert-circle' }}" class="w-5 h-5"></i>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="grid lg:grid-cols-3 gap-8">
            {# Main Form #}
            <div class="lg:col-span-2">
                <form id="createPostForm" action="{{ path('community_create') }}" method="post" class="space-y-6" novalidate>
                    {# Post Type #}
                    <div class="card p-6">
                        <label class="block text-sm font-medium text-slate-900 dark:text-white mb-4">
                            Post Type <span class="text-red-500">*</span>
                        </label>
                        <div class="grid grid-cols-3 gap-3">
                            <label class="relative cursor-pointer">
                                <input type="radio" name="type" value="question" class="peer sr-only" checked>
                                <div class="p-4 rounded-2xl border-2 border-slate-200 dark:border-navy-700 text-center transition-all peer-checked:border-emerald-500 peer-checked:bg-emerald-50 dark:peer-checked:bg-emerald-900/20 hover:border-emerald-300 dark:hover:border-emerald-700">
                                    <i data-lucide="help-circle" class="w-8 h-8 mx-auto mb-2 text-emerald-600 dark:text-emerald-400"></i>
                                    <p class="font-medium text-slate-900 dark:text-white">Question</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Get help from others</p>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="type" value="discussion" class="peer sr-only">
                                <div class="p-4 rounded-2xl border-2 border-slate-200 dark:border-navy-700 text-center transition-all peer-checked:border-violet-500 peer-checked:bg-violet-50 dark:peer-checked:bg-violet-900/20 hover:border-violet-300 dark:hover:border-violet-700">
                                    <i data-lucide="message-circle" class="w-8 h-8 mx-auto mb-2 text-violet-600 dark:text-violet-400"></i>
                                    <p class="font-medium text-slate-900 dark:text-white">Discussion</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Start a conversation</p>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="type" value="article" class="peer sr-only">
                                <div class="p-4 rounded-2xl border-2 border-slate-200 dark:border-navy-700 text-center transition-all peer-checked:border-harbor-500 peer-checked:bg-harbor-50 dark:peer-checked:bg-harbor-900/20 hover:border-harbor-300 dark:hover:border-harbor-700">
                                    <i data-lucide="file-text" class="w-8 h-8 mx-auto mb-2 text-harbor-600 dark:text-harbor-400"></i>
                                    <p class="font-medium text-slate-900 dark:text-white">Article</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Share knowledge</p>
                                </div>
                            </label>
                        </div>
                    </div>

                    {# Title & Topic #}
                    <div class="card p-6 space-y-6">
                        {# Title #}
                        <div>
                            <label for="title" class="block text-sm font-medium text-slate-900 dark:text-white mb-2">
                                Title <span class="text-red-500">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="title" 
                                name="title" 
                                class="input" 
                                placeholder="What's your question or topic?"
                                value="{{ app.request.get('title')|e }}"
                                required
                                minlength="10"
                                maxlength="255"
                            >
                            <div class="error-message hidden mt-2 text-sm text-red-600 dark:text-red-400 flex items-center gap-1">
                                <i data-lucide="alert-circle" class="w-4 h-4"></i>
                                <span class="error-text"></span>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
                                <span id="titleCounter">0</span>/255 characters. Be specific and clear (minimum 10 characters).
                            </p>
                        </div>

                        {# Topic #}
                        <div>
                            <label for="topic" class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Topic</label>
                            <select id="topic" name="topic" class="input">
                                <option value="">Select a topic (optional)...</option>
                                <option value="Web Development" {{ app.request.get('topic') == 'Web Development' ? 'selected' : '' }}>Web Development</option>
                                <option value="Data Science" {{ app.request.get('topic') == 'Data Science' ? 'selected' : '' }}>Data Science</option>
                                <option value="Mobile Development" {{ app.request.get('topic') == 'Mobile Development' ? 'selected' : '' }}>Mobile Development</option>
                                <option value="UI/UX Design" {{ app.request.get('topic') == 'UI/UX Design' ? 'selected' : '' }}>UI/UX Design</option>
                                <option value="DevOps" {{ app.request.get('topic') == 'DevOps' ? 'selected' : '' }}>DevOps & Cloud</option>
                                <option value="Career" {{ app.request.get('topic') == 'Career' ? 'selected' : '' }}>Career & Growth</option>
                                <option value="General" {{ app.request.get('topic') == 'General' ? 'selected' : '' }}>General Discussion</option>
                            </select>
                        </div>
                    </div>

                    {# Content #}
                    <div class="card p-6">
                        <label for="content" class="block text-sm font-medium text-slate-900 dark:text-white mb-2">
                            Content <span class="text-red-500">*</span>
                        </label>

                        {# Formatting Toolbar #}
                        <div class="flex items-center gap-1 p-2 bg-slate-50 dark:bg-navy-800 rounded-t-xl border border-b-0 border-slate-200 dark:border-navy-700">
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Bold">
                                <i data-lucide="bold" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Italic">
                                <i data-lucide="italic" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Code">
                                <i data-lucide="code" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                            <div class="w-px h-5 bg-slate-300 dark:bg-navy-600 mx-1"></div>
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Link">
                                <i data-lucide="link" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Image">
                                <i data-lucide="image" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                            <div class="w-px h-5 bg-slate-300 dark:bg-navy-600 mx-1"></div>
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Bullet List">
                                <i data-lucide="list" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Numbered List">
                                <i data-lucide="list-ordered" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                            <button type="button" class="p-2 rounded hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors" title="Quote">
                                <i data-lucide="quote" class="w-4 h-4 text-slate-600 dark:text-slate-400"></i>
                            </button>
                        </div>

                        <textarea 
                            id="content" 
                            name="content" 
                            class="input rounded-t-none min-h-[250px]" 
                            placeholder="Describe your question or topic in detail..."
                            required
                            minlength="30"
                        >{{ app.request.get('content')|e }}</textarea>

                        <div class="error-message hidden mt-2 text-sm text-red-600 dark:text-red-400 flex items-center gap-1">
                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
                            <span class="error-text"></span>
                        </div>

                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
                            <i data-lucide="info" class="w-3 h-3 inline mr-1"></i>
                            <span id="contentCounter">0</span> characters. Minimum 30 characters required. Markdown formatting is supported.
                        </p>
                    </div>

                    {# Tags #}
                    <div class="card p-6">
                        <label for="tags" class="block text-sm font-medium text-slate-900 dark:text-white mb-2">Tags</label>
                        <input 
                            type="text" 
                            id="tags" 
                            name="tags" 
                            class="input" 
                            placeholder="Add up to 5 tags (e.g., react, hooks, javascript)"
                            value="{{ app.request.get('tags')|e }}"
                            maxlength="200"
                        >
                        <div class="error-message hidden mt-2 text-sm text-red-600 dark:text-red-400 flex items-center gap-1">
                            <i data-lucide="alert-circle" class="w-4 h-4"></i>
                            <span class="error-text"></span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Separate tags with commas. Maximum 5 tags.</p>

                        {# Popular Tags #}
                        <div class="mt-4">
                            <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">Popular tags:</p>
                            <div class="flex flex-wrap gap-2">
                                {% set popularTags = ['javascript', 'react', 'python', 'css', 'typescript', 'node', 'sql'] %}
                                {% for tag in popularTags %}
                                <button type="button" data-tag="{{ tag }}" class="badge bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
                                    {{ tag }}
                                </button>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {# Submit #}
                    <div class="flex items-center justify-between">
                        <button type="button" class="btn-ghost">
                            Save as Draft
                        </button>
                        <div class="flex items-center gap-3">
                            <a href="{{ path('community_index') }}" class="btn-outline">Cancel</a>
                            <button type="submit" class="btn-primary">
                                <i data-lucide="send" class="w-4 h-4 mr-2"></i>
                                Publish Post
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            {# Sidebar Tips #}
            <div class="space-y-6">
                {# Writing Tips #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="lightbulb" class="w-5 h-5 text-amber-500"></i>
                        Writing Tips
                    </h3>
                    <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-500 mt-1">•</span>
                            <span>Make your title specific and clear</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-500 mt-1">•</span>
                            <span>Include relevant code snippets</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-500 mt-1">•</span>
                            <span>Describe what you've already tried</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-500 mt-1">•</span>
                            <span>Use appropriate tags for visibility</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-emerald-500 mt-1">•</span>
                            <span>Be respectful and patient</span>
                        </li>
                    </ul>
                </div>

                {# Code Formatting #}
                <div class="card p-6">
                    <h3 class="font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                        <i data-lucide="code" class="w-5 h-5 text-harbor-500"></i>
                        Code Formatting
                    </h3>
                    <div class="space-y-4 text-sm">
                        <div>
                            <p class="text-slate-500 dark:text-slate-400 mb-2">Inline code:</p>
                            <code class="bg-slate-100 dark:bg-navy-800 px-2 py-1 rounded text-slate-700 dark:text-slate-300">`code`</code>
                        </div>
                        <div>
                            <p class="text-slate-500 dark:text-slate-400 mb-2">Code block:</p>
                            <pre class="bg-slate-100 dark:bg-navy-800 p-3 rounded text-xs text-slate-700 dark:text-slate-300">```javascript
const x = 1;
```</pre>
                        </div>
                    </div>
                </div>

                {# XP Reward #}
                <div class="card p-6 bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 border-amber-200 dark:border-amber-800/50">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center">
                            <i data-lucide="zap" class="w-5 h-5 text-white"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-white">Earn XP!</p>
                            <p class="text-sm text-slate-600 dark:text-slate-400">+50 XP for each helpful post</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    lucide.createIcons();

    // Form validation
    const form = document.getElementById('createPostForm');
    const titleInput = document.getElementById('title');
    const contentInput = document.getElementById('content');
    const tagsInput = document.getElementById('tags');
    const titleCounter = document.getElementById('titleCounter');
    const contentCounter = document.getElementById('contentCounter');

    // Character counters
    titleInput.addEventListener('input', function() {
        titleCounter.textContent = this.value.length;
        validateField(this);
    });

    contentInput.addEventListener('input', function() {
        contentCounter.textContent = this.value.length;
        validateField(this);
    });

    // Validate individual field
    function validateField(field) {
        const errorContainer = field.parentElement.querySelector('.error-message');
        const errorText = errorContainer?.querySelector('.error-text');
        
        if (!errorContainer) return true;

        let isValid = true;
        let errorMessage = '';

        // Check if required
        if (field.hasAttribute('required') && field.value.trim() === '') {
            isValid = false;
            errorMessage = 'This field is required';
        }
        // Check minlength
        else if (field.hasAttribute('minlength')) {
            const minLength = parseInt(field.getAttribute('minlength'));
            if (field.value.trim().length < minLength) {
                isValid = false;
                errorMessage = `Minimum ${minLength} characters required (current: ${field.value.trim().length})`;
            }
        }
        // Check maxlength
        else if (field.hasAttribute('maxlength')) {
            const maxLength = parseInt(field.getAttribute('maxlength'));
            if (field.value.length > maxLength) {
                isValid = false;
                errorMessage = `Maximum ${maxLength} characters allowed`;
            }
        }

        // Special validation for tags
        if (field.id === 'tags' && field.value.trim()) {
            const tags = field.value.split(',').map(t => t.trim()).filter(Boolean);
            if (tags.length > 5) {
                isValid = false;
                errorMessage = 'Maximum 5 tags allowed';
            }
        }

        // Show/hide error
        if (isValid) {
            errorContainer.classList.add('hidden');
            field.classList.remove('border-red-500', 'dark:border-red-500');
            field.classList.add('border-slate-300', 'dark:border-navy-700');
        } else {
            errorContainer.classList.remove('hidden');
            errorText.textContent = errorMessage;
            field.classList.add('border-red-500', 'dark:border-red-500');
            field.classList.remove('border-slate-300', 'dark:border-navy-700');
            lucide.createIcons();
        }

        return isValid;
    }

    // Validate all fields on blur
    [titleInput, contentInput, tagsInput].forEach(input => {
        input.addEventListener('blur', function() {
            validateField(this);
        });
    });

    // Form submission validation
    form.addEventListener('submit', function(e) {
        let isFormValid = true;

        // Validate all required fields
        [titleInput, contentInput].forEach(field => {
            if (!validateField(field)) {
                isFormValid = false;
            }
        });

        // Validate tags if present
        if (tagsInput.value.trim()) {
            if (!validateField(tagsInput)) {
                isFormValid = false;
            }
        }

        if (!isFormValid) {
            e.preventDefault();
            
            // Scroll to first error
            const firstError = form.querySelector('.error-message:not(.hidden)');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            // Show toast notification
            showToast('Please fix the errors before submitting', 'error');
        }
    });

    // Toast notification
    function showToast(message, type = 'error') {
        const toast = document.createElement('div');
        toast.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg flex items-center gap-3 animate-slide-in ${
            type === 'error' 
                ? 'bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800' 
                : 'bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800'
        }`;
        
        toast.innerHTML = `
            <i data-lucide="${type === 'error' ? 'alert-circle' : 'check-circle'}" class="w-5 h-5"></i>
            <span>${message}</span>
        `;
        
        document.body.appendChild(toast);
        lucide.createIcons();
        
        setTimeout(() => {
            toast.remove();
        }, 4000);
    }

    // Popular tag click handler
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('button[data-tag]');
        if (!btn) return;
        
        const tag = btn.getAttribute('data-tag');
        const existing = tagsInput.value.split(',').map(s => s.trim()).filter(Boolean);
        
        if (existing.includes(tag)) {
            showToast('Tag already added', 'error');
            return;
        }
        
        if (existing.length >= 5) {
            showToast('Maximum 5 tags allowed', 'error');
            return;
        }
        
        existing.push(tag);
        tagsInput.value = existing.join(', ');
        validateField(tagsInput);
    });

    // Initialize counters
    titleCounter.textContent = titleInput.value.length;
    contentCounter.textContent = contentInput.value.length;
</script>

<style>
@keyframes slide-in {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

.animate-slide-in {
    animation: slide-in 0.3s ease-out;
}
</style>
{% endblock %}