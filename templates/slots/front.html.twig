{% extends 'layouts/base.html.twig' %}

{% block title %}Créneaux Horaires - SkillHarbor{% endblock %}

{% block body %}
<div class="bg-gradient-to-br from-slate-50 via-white to-harbor-50/30 dark:from-navy-950 dark:via-navy-900 dark:to-harbor-950/30 min-h-screen">
  {# FullCalendar CSS #}
  <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>

  <div class="w-full px-4 md:px-10 py-8 md:py-12">


        {# Modern Hero Section #}
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-harbor-600 via-harbor-500 to-cyan-500 shadow-xl mb-8 md:mb-12">
            {# Decorative Elements #}
            <div class="absolute inset-0 bg-grid-white/10 [mask-image:radial-gradient(white,transparent_85%)]"></div>
            <div class="absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
            <div class="absolute bottom-0 left-0 w-80 h-80 bg-cyan-400/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/3"></div>

            <div class="relative px-6 py-10 md:px-12 md:py-16 text-center">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/20 backdrop-blur-sm text-white/90 text-sm font-medium mb-6">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                    <span>Gestion des créneaux</span>
                </div>

                <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-white mb-4 drop-shadow-lg">
                    Créneaux Horaires
                </h1>

                <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8">
                    Gérez tous les créneaux horaires disponibles pour les rendez-vous.
                </p>

                {% if is_granted('ROLE_PROFESSOR') %}
                <button onclick="openAddSlotModal()"
                    class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-white text-harbor-600 font-semibold hover:bg-white/95 shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-200">
                    <i data-lucide="plus-circle" class="w-5 h-5"></i>
                    <span>Créer un créneau</span>
                </button>
                {% endif %}
            </div>
        </div>

        {# Flash Messages #}
        <div id="flash-container" class="mb-6 space-y-3"></div>

        {# Stats Cards #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-8">
            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 shadow-sm border border-slate-200 dark:border-navy-800 hover:shadow-md transition-shadow">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-harbor-100 dark:bg-harbor-900/30 flex items-center justify-center">
                        <i data-lucide="calendar" class="w-6 h-6 text-harbor-600 dark:text-harbor-400"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-600 dark:text-slate-400 font-medium">Total</p>
                        <p class="text-2xl font-bold text-navy-900 dark:text-white">{{ total_slots }}</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 shadow-sm border border-slate-200 dark:border-navy-800 hover:shadow-md transition-shadow">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                        <i data-lucide="check-circle" class="w-6 h-6 text-success-600 dark:text-success-400"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-600 dark:text-slate-400 font-medium">Disponibles</p>
                        <p class="text-2xl font-bold text-navy-900 dark:text-white">{{ available_slots_count }}</p>
                    </div>
                </div>
            </div>

            <div class="bg-white dark:bg-navy-900 rounded-2xl p-6 shadow-sm border border-slate-200 dark:border-navy-800 hover:shadow-md transition-shadow">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center">
                        <i data-lucide="user-check" class="w-6 h-6 text-danger-600 dark:text-danger-400"></i>
                    </div>
                    <div>
                        <p class="text-sm text-slate-600 dark:text-slate-400 font-medium">Réservés</p>
                        <p class="text-2xl font-bold text-navy-900 dark:text-white">{{ booked_slots_count }}</p>
                    </div>
                </div>
            </div>
        </div>

        {# ===== FILTER + SEARCH BAR ===== #}
        <div class="bg-white dark:bg-navy-900 rounded-2xl shadow-sm border border-slate-200 dark:border-navy-800 p-4 mb-6">
            <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
                <div class="flex items-center gap-2 text-sm font-medium text-navy-900 dark:text-white">
                    <i data-lucide="filter" class="w-5 h-5 text-slate-500"></i>
                    <span>Filtrer:</span>
                </div>

                <div class="flex items-center gap-2" id="slot-filters">
                    <button type="button" class="slot-filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                            data-filter="all">Tous</button>
                    <button type="button" class="slot-filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                            data-filter="available">Disponibles</button>
                    <button type="button" class="slot-filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors"
                            data-filter="booked">Réservés</button>
                    
                    <div class="w-px h-6 bg-slate-300 dark:bg-navy-700 mx-2"></div>
                    
                    <button type="button" id="view-toggle-list" class="view-toggle-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-harbor-100 text-harbor-700" onclick="switchView('list')">
                        <i data-lucide="list" class="w-5 h-5"></i>
                    </button>
                </div>

                <div class="flex-1"></div>

                <div class="flex items-center gap-2 w-full ">
                    <div class="relative w-full">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input id="slot-search"
                               type="text"
                               placeholder="Rechercher (date, heure...)"
                               class="w-full pl-10 pr-3 py-2.5 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all">
                    </div>

                    <button id="slot-clear"
                        type="button"
                        class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 text-sm font-semibold hover:bg-slate-200 dark:hover:bg-navy-700 transition-colors">
                        Effacer
                    </button>
                </div>
            </div>

      
        </div>

        {# Slots Cards - Modern Design (like rendez-vous) #}
        <div id="slots-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-12 lg:gap-y-14">
            {% for slot in pagination.items %}
            {{ include('components/_slot_card.html.twig', { slot: slot }) }}
            {% else %}
            <div id="empty-row" class="md:col-span-2 lg:col-span-3 bg-white dark:bg-navy-900 rounded-2xl shadow-sm border border-slate-200 dark:border-navy-800 p-12 text-center">
                <div class="flex flex-col items-center gap-4">
                    <div class="w-20 h-20 rounded-2xl bg-slate-100 dark:bg-navy-800 flex items-center justify-center">
                        <i data-lucide="calendar-x" class="w-10 h-10 text-slate-400 dark:text-slate-600"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-1">Aucun créneau</h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Créez votre premier créneau pour commencer</p>
                    </div>
                    {% if is_granted('ROLE_PROFESSOR') %}
                    <button onclick="openAddSlotModal()" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-harbor-600 to-harbor-500 text-white font-semibold hover:from-harbor-700 hover:to-harbor-600 shadow-lg hover:shadow-xl transition-all mt-2">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        Créer un créneau
                    </button>
                    {% endif %}
                </div>
            </div>

            {# Empty state for filtering/search result (JS) #}
            <div id="slots-empty" class="hidden md:col-span-2 lg:col-span-3 bg-white dark:bg-navy-900 rounded-2xl shadow-sm border border-slate-200 dark:border-navy-800 p-12 text-center">
                <div class="flex flex-col items-center gap-4">
                    <div class="w-20 h-20 rounded-2xl bg-slate-100 dark:bg-navy-800 flex items-center justify-center">
                        <i data-lucide="search-x" class="w-10 h-10 text-slate-400 dark:text-slate-600"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-navy-900 dark:text-white mb-1">Aucun résultat</h3>
                        <p class="text-sm text-slate-600 dark:text-slate-400">Essayez un autre mot-clé ou changez le filtre.</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% if pagination.total_pages > 1 %}
            <div class="mt-10 flex items-center justify-center gap-2 flex-wrap">
                {% set queryParams = app.request.query.all %}
                {% if pagination.current_page > 1 %}
                    <a href="{{ path('slots_front', queryParams|merge({page: pagination.current_page - 1})) }}"
                       class="inline-flex items-center justify-center min-w-[40px] h-10 px-4 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-700 transition-colors">
                        Prev
                    </a>
                {% else %}
                    <span class="inline-flex items-center justify-center min-w-[40px] h-10 px-4 rounded-xl border border-slate-200 dark:border-navy-800 bg-slate-100 dark:bg-navy-900 text-slate-400 dark:text-slate-500 cursor-not-allowed">
                        Prev
                    </span>
                {% endif %}

                {% for p in 1..pagination.total_pages %}
                    {% if p == pagination.current_page %}
                        <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-harbor-600 text-white font-semibold shadow-sm">
                            {{ p }}
                        </span>
                    {% else %}
                        <a href="{{ path('slots_front', queryParams|merge({page: p})) }}"
                           class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-700 transition-colors">
                            {{ p }}
                        </a>
                    {% endif %}
                {% endfor %}

                {% if pagination.current_page < pagination.total_pages %}
                    <a href="{{ path('slots_front', queryParams|merge({page: pagination.current_page + 1})) }}"
                       class="inline-flex items-center justify-center min-w-[40px] h-10 px-4 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-navy-700 transition-colors">
                        Next
                    </a>
                {% else %}
                    <span class="inline-flex items-center justify-center min-w-[40px] h-10 px-4 rounded-xl border border-slate-200 dark:border-navy-800 bg-slate-100 dark:bg-navy-900 text-slate-400 dark:text-slate-500 cursor-not-allowed">
                        Next
                    </span>
                {% endif %}
            </div>
        {% endif %}
        <script> if (window.lucide) lucide.createIcons(); </script>
    </div>
</div>  

{# ===== MODAL: Add Slot ===== #}
<div id="slotModal" class="sh-modal hidden" aria-hidden="true">
    <div class="sh-modal-overlay" data-close="modal"></div>
    <div class="sh-modal-dialog modal-panel relative bg-white dark:bg-navy-900 shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="slotModalTitle">
        <div class="sh-modal-header relative bg-gradient-to-r from-harbor-600 to-harbor-500 px-6 py-6">
            <div class="flex items-center justify-between">
                <h2 id="slotModalTitle" class="text-2xl font-display font-bold text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                    </div>
                    Ajouter un créneau
                </h2>
                <button type="button" class="sh-modal-close w-10 h-10 rounded-xl text-white/80 hover:text-white hover:bg-white/20 transition-colors flex items-center justify-center" data-close="modal" aria-label="Fermer">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        <form id="add-slot-form" method="post" action="{{ path('slots_front_new') }}" class="sh-modal-form">
            <div class="sh-modal-body">
                <div id="add-slot-form-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-500/40 dark:bg-red-500/10 dark:text-red-200">
                    <p id="add-slot-form-error-message" class="font-semibold">Veuillez corriger les erreurs.</p>
                    <ul id="add-slot-form-error-list" class="mt-2 list-disc pl-5 space-y-1"></ul>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="add_start_date">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>
                            Date de début
                        </label>
                        <input type="date" id="add_start_date" name="start_date"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>

                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="add_start_time">
                            <i data-lucide="clock" class="w-4 h-4 inline mr-1"></i>
                            Heure de début
                        </label>
                        <input type="time" id="add_start_time" name="start_time"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="add_end_date">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>
                            Date de fin
                        </label>
                        <input type="date" id="add_end_date" name="end_date"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>

                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="add_end_time">
                            <i data-lucide="clock" class="w-4 h-4 inline mr-1"></i>
                            Heure de fin
                        </label>
                        <input type="time" id="add_end_time" name="end_time"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>
                </div>

                <div class="relative">
                    <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="add_location_label">
                        <i data-lucide="map-pin" class="w-4 h-4 inline mr-1"></i>
                        Lieu (optionnel)
                    </label>
                    <input type="text" id="add_location_label" name="location_label" autocomplete="off"
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                        placeholder="Rechercher un lieu...">
                    <input type="hidden" id="add_location_lat" name="location_lat">
                    <input type="hidden" id="add_location_lng" name="location_lng">
                    <div id="add_location_suggestions" class="absolute left-0 right-0 mt-1 bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-xl shadow-lg overflow-hidden hidden z-50"></div>

                    <div class="mt-3 space-y-2">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white" for="add_selected_address">Adresse sélectionnée</label>
                        <div id="add_selected_address" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-navy-800 bg-slate-50 dark:bg-navy-950 text-navy-900 dark:text-white text-sm">
                            Aucune adresse sélectionnée
                        </div>
                        <div class="slot-map-wrap">
                            <div id="add_location_map" class="sh-map w-full rounded-xl border border-slate-200 dark:border-navy-800 overflow-hidden bg-slate-50 dark:bg-navy-950"></div>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400">Sélectionnez une suggestion pour afficher l’aperçu sur la carte.</p>
                        <p class="text-xs text-slate-600 dark:text-slate-400">Tip: cliquez sur la carte pour choisir un endroit.</p>
                    </div>
                </div>
            </div>
            <div class="sh-modal__footer mt-0 border-t border-slate-200 dark:border-navy-800 flex items-center justify-end gap-3">
                <button type="button" data-close="modal"
                    class="px-6 py-2.5 rounded-xl text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800 font-medium transition-colors">
                    Annuler
                </button>
                <button type="submit"
                    class="slot-submit px-6 py-2.5 rounded-xl bg-gradient-to-r from-harbor-600 to-harbor-500 text-white font-semibold hover:from-harbor-700 hover:to-harbor-600 shadow-lg hover:shadow-xl transition-all">
                    <i data-lucide="check" class="w-4 h-4 inline mr-1"></i>
                    Créer le créneau
                </button>
            </div>
        </form>
        </div>
    </div>
</div>

{# ===== MODAL: Edit Slot ===== #}
<div id="edit-slot-modal" class="sh-modal hidden" role="dialog" aria-modal="true" aria-labelledby="editSlotModalTitle">
    <div class="sh-modal-overlay" onclick="closeEditSlotModal()"></div>
    <div class="sh-modal-dialog modal-panel relative bg-white dark:bg-navy-900 shadow-2xl" onclick="event.stopPropagation()">
        <div class="sh-modal-header relative bg-gradient-to-r from-harbor-600 to-harbor-500 px-6 py-6">
            <div class="flex items-center justify-between">
                <h2 id="editSlotModalTitle" class="text-2xl font-display font-bold text-white flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center">
                        <i data-lucide="edit-3" class="w-5 h-5"></i>
                    </div>
                    Modifier le créneau
                </h2>
                <button type="button" onclick="closeEditSlotModal()" class="w-10 h-10 rounded-xl text-white/80 hover:text-white hover:bg-white/20 transition-colors flex items-center justify-center">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        <form id="edit-slot-form" method="post" class="sh-modal-form">
            <input type="hidden" id="edit_slot_id" name="slot_id">

            <div class="sh-modal-body">
                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="edit_start_date">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>
                            Date de début
                        </label>
                        <input type="date" id="edit_start_date" name="start_date"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>

                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="edit_start_time">
                            <i data-lucide="clock" class="w-4 h-4 inline mr-1"></i>
                            Heure de début
                        </label>
                        <input type="time" id="edit_start_time" name="start_time"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="edit_end_date">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>
                            Date de fin
                        </label>
                        <input type="date" id="edit_end_date" name="end_date"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>

                    <div class="col-span-2 md:col-span-1">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="edit_end_time">
                            <i data-lucide="clock" class="w-4 h-4 inline mr-1"></i>
                            Heure de fin
                        </label>
                        <input type="time" id="edit_end_time" name="end_time"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                            required>
                    </div>
                </div>

                <div class="relative">
                    <label class="block text-sm font-semibold text-navy-900 dark:text-white mb-2" for="edit_location_label">
                        <i data-lucide="map-pin" class="w-4 h-4 inline mr-1"></i>
                        Lieu (optionnel)
                    </label>
                    <input type="text" id="edit_location_label" name="location_label" autocomplete="off"
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-navy-900 dark:text-white focus:ring-2 focus:ring-harbor-500 focus:border-transparent transition-all"
                        placeholder="Rechercher un lieu...">
                    <input type="hidden" id="edit_location_lat" name="location_lat">
                    <input type="hidden" id="edit_location_lng" name="location_lng">
                    <div id="edit_location_suggestions" class="absolute left-0 right-0 mt-1 bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-xl shadow-lg overflow-hidden hidden z-50"></div>

                    <div class="mt-3 space-y-2">
                        <label class="block text-sm font-semibold text-navy-900 dark:text-white" for="edit_selected_address">Adresse sélectionnée</label>
                        <div id="edit_selected_address" class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-navy-800 bg-slate-50 dark:bg-navy-950 text-navy-900 dark:text-white text-sm">
                            Aucune adresse sélectionnée
                        </div>
                        <div class="slot-map-wrap">
                            <div id="edit_location_map" class="sh-map w-full rounded-xl border border-slate-200 dark:border-navy-800 overflow-hidden bg-slate-50 dark:bg-navy-950"></div>
                        </div>
                        <p class="text-xs text-slate-600 dark:text-slate-400">Sélectionnez une suggestion pour afficher l’aperçu sur la carte.</p>
                        <p class="text-xs text-slate-600 dark:text-slate-400">Tip: cliquez sur la carte pour choisir un endroit.</p>
                    </div>
                </div>
            </div>

            <div class="sh-modal__footer mt-0 border-t border-slate-200 dark:border-navy-800 flex items-center justify-end gap-3">
                <button type="button" onclick="closeEditSlotModal()"
                    class="px-6 py-2.5 rounded-xl text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800 font-medium transition-colors">
                    Annuler
                </button>
                <button type="submit"
                    class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-harbor-600 to-harbor-500 text-white font-semibold hover:from-harbor-700 hover:to-harbor-600 shadow-lg hover:shadow-xl transition-all">
                    <i data-lucide="save" class="w-4 h-4 inline mr-1"></i>
                    Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

<style>
