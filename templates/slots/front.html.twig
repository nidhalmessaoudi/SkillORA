{% block javascripts %}
<script>
(function() {
    const canManageSlots = {{ is_granted('ROLE_PROFESSOR') ? 'true' : 'false' }};

    // ===== FILTER BUTTON STYLES =====
    function setFilterActive(buttons, activeBtn) {
        buttons.forEach(b => {
            b.className = 'slot-filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-slate-100 dark:bg-navy-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-navy-700';
        });
        activeBtn.className = 'slot-filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors bg-harbor-100 dark:bg-harbor-900/30 text-harbor-700 dark:text-harbor-300 hover:bg-harbor-200 dark:hover:bg-harbor-900/50';
    }

    // ===== CLIENT SIDE FILTER/SEARCH (fallback) =====
    let currentFilter = 'all';
    let currentQuery = '';

    function applyClientFilter() {
        const cards = Array.from(document.querySelectorAll('.slot-card'));
        const emptyBox = document.getElementById('slots-empty');
        let visible = 0;

        cards.forEach(card => {
            const booked = card.dataset.booked === '1';
            const hay = (card.dataset.search || '').toLowerCase();

            const passFilter =
                currentFilter === 'all' ||
                (currentFilter === 'available' && !booked) ||
                (currentFilter === 'booked' && booked);

            const passSearch = !currentQuery || hay.includes(currentQuery);

            const show = passFilter && passSearch;
            card.classList.toggle('hidden', !show);
            if (show) visible++;
        });

        if (emptyBox) emptyBox.classList.toggle('hidden', visible !== 0);
    }

    // ===== AJAX SEARCH (optional) =====
    // If you have an endpoint returning HTML rows, put it here.
    // Example endpoint: /slots/front/search?q=...&status=...
    const ajaxEndpoint = null; // e.g. '/slots/front/search'

    let debounceTimer = null;
    function doSearchAjaxOrClient() {
        if (!ajaxEndpoint) {
            applyClientFilter();
            return;
        }

        const url = new URL(ajaxEndpoint, window.location.origin);
        url.searchParams.set('q', currentQuery);
        url.searchParams.set('status', currentFilter);

        fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.text())
            .then(html => {
                // Server should return <tr>...</tr> rows only
                const tbody = document.getElementById('slots-tbody');
                tbody.innerHTML = html;

                // Re-init icons
                if (typeof lucide !== 'undefined') lucide.createIcons();

                // After replacing rows, apply fallback empty state if needed (server can also handle)
                applyClientFilter();
            })
            .catch(() => {
                // fallback
                applyClientFilter();
            });
    }

    // ===== INIT FILTERS =====
    const filtersWrap = document.getElementById('slot-filters');
    if (filtersWrap) {
        const buttons = Array.from(filtersWrap.querySelectorAll('.slot-filter-btn'));
        const defaultBtn = buttons.find(b => b.dataset.filter === 'all') || buttons[0];

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                currentFilter = btn.dataset.filter;
                setFilterActive(buttons, btn);
                doSearchAjaxOrClient();
            });
        });

        if (defaultBtn) {
            currentFilter = defaultBtn.dataset.filter;
            setFilterActive(buttons, defaultBtn);
        }
    }

    // ===== INIT SEARCH =====
    const searchInput = document.getElementById('slot-search');
    const clearBtn = document.getElementById('slot-clear');

    if (searchInput) {
        searchInput.addEventListener('input', () => {
            currentQuery = (searchInput.value || '').trim().toLowerCase();
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(doSearchAjaxOrClient, 220);
        });
    }

    if (clearBtn) {
        clearBtn.addEventListener('click', () => {
            currentQuery = '';
            if (searchInput) searchInput.value = '';
            doSearchAjaxOrClient();
        });
    }

    // first render
    applyClientFilter();

    // ===== MODALS =====
    const slotModal = document.getElementById('slotModal');
    const slotModalDialog = slotModal ? slotModal.querySelector('.sh-modal-dialog') : null;
    const addSlotForm = document.getElementById('add-slot-form');
    const addSlotSubmitBtn = addSlotForm ? addSlotForm.querySelector('button[type="submit"]') : null;
    const addSlotErrorBox = document.getElementById('add-slot-form-error');
    const addSlotErrorMessage = document.getElementById('add-slot-form-error-message');
    const addSlotErrorList = document.getElementById('add-slot-form-error-list');

    function clearAddSlotErrors() {
        if (addSlotErrorMessage) addSlotErrorMessage.textContent = 'Veuillez corriger les erreurs.';
        if (addSlotErrorList) addSlotErrorList.innerHTML = '';
        if (addSlotErrorBox) addSlotErrorBox.classList.add('hidden');
    }

    function showAddSlotErrors(message, errors) {
        if (addSlotErrorMessage) {
            addSlotErrorMessage.textContent = message || 'Veuillez corriger les erreurs.';
        }
        if (addSlotErrorList) {
            addSlotErrorList.innerHTML = '';
            if (errors && typeof errors === 'object') {
                Object.values(errors).forEach((errorText) => {
                    if (!errorText) return;
                    const li = document.createElement('li');
                    li.textContent = String(errorText);
                    addSlotErrorList.appendChild(li);
                });
            }
        }
        if (addSlotErrorBox) addSlotErrorBox.classList.remove('hidden');
    }

    function setAddSlotSubmitting(isSubmitting) {
        if (!addSlotSubmitBtn) return;
        addSlotSubmitBtn.disabled = isSubmitting;
        addSlotSubmitBtn.classList.toggle('opacity-60', isSubmitting);
        addSlotSubmitBtn.classList.toggle('cursor-not-allowed', isSubmitting);
    }

    function openModal() {
        if (!slotModal) return;
        slotModal.classList.remove('hidden');
        slotModal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
        if (window.lucide) window.lucide.createIcons();
    }

    function closeModal() {
        if (!slotModal) return;
        slotModal.classList.add('hidden');
        slotModal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
    }

    if (slotModal) {
        slotModal.addEventListener('click', function (e) {
            if (e.target.closest('[data-close="modal"]')) {
                closeModal();
            }
        });
    }

    if (slotModalDialog) {
        slotModalDialog.addEventListener('click', function (e) {
            if (e.target.closest('[data-close="modal"]')) {
                closeModal();
                return;
            }
            e.stopPropagation();
        });
    }

    window.openAddSlotModal = function() {
        openModal();
        clearAddSlotErrors();
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('add_start_date').value = today;
        document.getElementById('add_end_date').value = today;
        const loc = document.getElementById('add_location_label');
        const lat = document.getElementById('add_location_lat');
        const lng = document.getElementById('add_location_lng');
        if (loc) loc.value = '';
        if (lat) lat.value = '';
        if (lng) lng.value = '';
        const addr = document.getElementById('add_selected_address');
        if (addr) addr.textContent = 'Aucune adresse sélectionnée';
        if (window.__slotLocationWidgets && window.__slotLocationWidgets.add && window.__slotLocationWidgets.add.invalidate) {
            setTimeout(() => window.__slotLocationWidgets.add.invalidate(), 60);
        }
    };

    window.closeAddSlotModal = function() {
        closeModal();
    };

    if (addSlotForm) {
        addSlotForm.addEventListener('submit', function(event) {
            event.preventDefault();
            clearAddSlotErrors();
            setAddSlotSubmitting(true);

            fetch(addSlotForm.action, {
                method: 'POST',
                body: new FormData(addSlotForm),
                credentials: 'same-origin',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json',
                },
            })
                .then(async (response) => {
                    const raw = await response.text();
                    let data = null;
                    try {
                        data = raw ? JSON.parse(raw) : null;
                    } catch (_) {
                        data = null;
                    }
                    return { ok: response.ok, data };
                })
                .then((payload) => {
                    if (payload.ok && payload.data && payload.data.success) {
                        closeModal();
                        window.location.reload();
                        return;
                    }

                    const message = payload.data && payload.data.message
                        ? payload.data.message
                        : 'Veuillez corriger les erreurs.';
                    const errors = payload.data && payload.data.errors ? payload.data.errors : null;
                    showAddSlotErrors(message, errors);
                })
                .catch(() => {
                    showAddSlotErrors('Erreur réseau. Réessaie.', null);
                })
                .finally(() => {
                    setAddSlotSubmitting(false);
                });
        });
    }

    window.openEditSlotModal = function(id, startDate, startTime, endDate, endTime, locationLabel, locationLat, locationLng) {
        document.getElementById('edit_slot_id').value = id;
        document.getElementById('edit_start_date').value = startDate;
        document.getElementById('edit_start_time').value = startTime;
        document.getElementById('edit_end_date').value = endDate;
        document.getElementById('edit_end_time').value = endTime;
        const loc = document.getElementById('edit_location_label');
        const lat = document.getElementById('edit_location_lat');
        const lng = document.getElementById('edit_location_lng');
        if (loc) loc.value = locationLabel || '';
        if (lat) lat.value = locationLat || '';
        if (lng) lng.value = locationLng || '';
        const addr = document.getElementById('edit_selected_address');
        if (addr) addr.textContent = (locationLabel || '').trim() !== '' ? locationLabel : 'Aucune adresse sélectionnée';
        document.getElementById('edit-slot-form').action = '/slots/front/' + id + '/edit';
        document.getElementById('edit-slot-modal').classList.remove('hidden');
        document.body.classList.add('modal-open');
        if (window.__slotLocationWidgets && window.__slotLocationWidgets.edit && window.__slotLocationWidgets.edit.sync) {
            window.__slotLocationWidgets.edit.sync();
        }
        if (window.__slotLocationWidgets && window.__slotLocationWidgets.edit && window.__slotLocationWidgets.edit.invalidate) {
            setTimeout(() => window.__slotLocationWidgets.edit.invalidate(), 60);
        }
    };

    window.closeEditSlotModal = function() {
        document.getElementById('edit-slot-modal').classList.add('hidden');
        const isAddOpen = slotModal && !slotModal.classList.contains('hidden');
        if (!isAddOpen) {
            document.body.classList.remove('modal-open');
        }
    };

    function initLocationAutocomplete(inputId, suggestionsId, latId, lngId, mapContainerId, addressBoxId) {
        const input = document.getElementById(inputId);
        const suggestions = document.getElementById(suggestionsId);
        if (!input || !suggestions) return;

        const latInput = latId ? document.getElementById(latId) : null;
        const lngInput = lngId ? document.getElementById(lngId) : null;
        const mapContainer = mapContainerId ? document.getElementById(mapContainerId) : null;
        const addressBox = addressBoxId ? document.getElementById(addressBoxId) : null;

        let debounceTimer = null;
        let activeController = null;
        let reverseTimer = null;
        let reverseController = null;

        const defaultCenter = [36.8065, 10.1815]; // Tunis
        const defaultZoom = 12;
        let map = null;
        let marker = null;
        let tiles = null;

        function ensureMap() {
            if (!mapContainer || typeof L === 'undefined') return;
            if (map) return;

            map = L.map(mapContainer, {
                zoomControl: true,
                attributionControl: true,
            }).setView(defaultCenter, defaultZoom);

            tiles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors',
            }).addTo(map);

            marker = L.marker(defaultCenter).addTo(map);

            map.on('click', (ev) => {
                if (!ev || !ev.latlng) return;
                const clickedLat = ev.latlng.lat;
                const clickedLng = ev.latlng.lng;

                if (latInput) latInput.value = String(clickedLat);
                if (lngInput) lngInput.value = String(clickedLng);

                marker.setLatLng([clickedLat, clickedLng]);
                map.setView([clickedLat, clickedLng], 15);
                map.invalidateSize();

                if (addressBox) addressBox.textContent = 'Recherche de l’adresse...';

                clearTimeout(reverseTimer);
                reverseTimer = setTimeout(() => {
                    reverseGeocode(clickedLat, clickedLng);
                }, 250);
            });
        }

        function hideSuggestions() {
            suggestions.classList.add('hidden');
            suggestions.innerHTML = '';
        }

        function setSelectedLocation(label, lat, lng) {
            const cleanedLabel = (label || '').trim();

            if (addressBox) {
                addressBox.textContent = cleanedLabel !== '' ? cleanedLabel : 'Aucune adresse sélectionnée';
            }

            ensureMap();
            if (!map || !marker) return;

            const latNum = typeof lat === 'string' ? parseFloat(lat) : lat;
            const lngNum = typeof lng === 'string' ? parseFloat(lng) : lng;
            if (!Number.isFinite(latNum) || !Number.isFinite(lngNum)) return;

            marker.setLatLng([latNum, lngNum]).addTo(map);
            map.setView([latNum, lngNum], 15);
            map.invalidateSize();
        }

        function reverseGeocode(lat, lng) {
            if (reverseController) reverseController.abort();
            reverseController = new AbortController();

            const url = new URL('https://nominatim.openstreetmap.org/reverse');
            url.searchParams.set('format', 'json');
            url.searchParams.set('lat', String(lat));
            url.searchParams.set('lon', String(lng));

            fetch(url.toString(), {
                signal: reverseController.signal,
                headers: { 'Accept': 'application/json' },
            })
                .then(r => (r.ok ? r.json() : null))
                .then(data => {
                    if (!data || !data.display_name) {
                        if (addressBox) addressBox.textContent = 'Adresse non trouvée';
                        return;
                    }

                    const label = String(data.display_name || '').trim();
                    if (label !== '') {
                        input.value = label;
                        if (addressBox) addressBox.textContent = label;
                    } else if (addressBox) {
                        addressBox.textContent = 'Adresse non trouvée';
                    }
                })
                .catch(err => {
                    if (err && err.name === 'AbortError') return;
                    if (addressBox) addressBox.textContent = 'Adresse non trouvée';
                });
        }

        function showSuggestions(items) {
            if (!Array.isArray(items) || items.length === 0) {
                hideSuggestions();
                return;
            }

            suggestions.innerHTML = items.map((item, idx) => {
                const label = String(item.display_name || '');
                const lat = item.lat ?? '';
                const lon = item.lon ?? '';

                const escAttr = (s) => String(s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
                const escHtml = (s) => String(s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');

                return (
                    '<button type="button" ' +
                    'data-idx="' + idx + '" ' +
                    'data-label="' + escAttr(label) + '" ' +
                    'data-lat="' + escAttr(lat) + '" ' +
                    'data-lng="' + escAttr(lon) + '" ' +
                    'class="w-full text-left px-4 py-2.5 hover:bg-slate-50 dark:hover:bg-navy-800 text-sm text-navy-900 dark:text-white">' +
                    escHtml(label) +
                    '</button>'
                );
            }).join('');

            suggestions.classList.remove('hidden');
        }

        function fetchSuggestions(query) {
            if (activeController) activeController.abort();
            activeController = new AbortController();

            const url = new URL('https://nominatim.openstreetmap.org/search');
            url.searchParams.set('format', 'json');
            url.searchParams.set('limit', '6');
            url.searchParams.set('q', query);

            fetch(url.toString(), {
                signal: activeController.signal,
                headers: { 'Accept': 'application/json' },
            })
                .then(r => (r.ok ? r.json() : []))
                .then(showSuggestions)
                .catch(err => {
                    if (err && err.name === 'AbortError') return;
                    hideSuggestions();
                });
        }

        input.addEventListener('input', () => {
            const q = input.value.trim();

            if (latInput) latInput.value = '';
            if (lngInput) lngInput.value = '';
            if (addressBox) addressBox.textContent = q !== '' ? q : 'Aucune adresse sélectionnée';

            if (q.length < 3) {
                hideSuggestions();
                return;
            }

            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => fetchSuggestions(q), 350);
        });

        suggestions.addEventListener('click', (e) => {
            const btn = e.target.closest('button[data-label]');
            if (!btn) return;

            input.value = btn.dataset.label || '';
            if (latInput) latInput.value = btn.dataset.lat || '';
            if (lngInput) lngInput.value = btn.dataset.lng || '';
            setSelectedLocation(btn.dataset.label || '', btn.dataset.lat || '', btn.dataset.lng || '');
            hideSuggestions();
        });

        document.addEventListener('click', (e) => {
            if (e.target === input) return;
            if (suggestions.contains(e.target)) return;
            hideSuggestions();
        });

        ensureMap();
        if (addressBox) {
            const initialLabel = (input.value || '').trim();
            addressBox.textContent = initialLabel !== '' ? initialLabel : 'Aucune adresse sélectionnée';
        }

        function syncFromInputs() {
            const label = (input.value || '').trim();
            const latVal = latInput ? latInput.value : '';
            const lngVal = lngInput ? lngInput.value : '';
            setSelectedLocation(label, latVal, lngVal);
        }
        syncFromInputs();

        if (!window.__slotLocationWidgets) window.__slotLocationWidgets = {};
        window.__slotLocationWidgets[inputId.startsWith('add_') ? 'add' : 'edit'] = {
            invalidate: () => { if (map) map.invalidateSize(); },
            sync: syncFromInputs,
        };
    }

    initLocationAutocomplete(
      'add_location_label',
      'add_location_suggestions',
      'add_location_lat',
      'add_location_lng',
      'add_location_map',
      'add_selected_address'
    );

    initLocationAutocomplete(
      'edit_location_label',
      'edit_location_suggestions',
      'edit_location_lat',
      'edit_location_lng',
      'edit_location_map',
      'edit_selected_address'
    );

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (slotModal && !slotModal.classList.contains('hidden')) {
                closeModal();
            }
            const editModal = document.getElementById('edit-slot-modal');
            if (editModal && !editModal.classList.contains('hidden')) {
                closeEditSlotModal();
            }
        }
    });

    (function () {
        const calendarUrl = '{{ path('slots_calendar') }}';
        function bindCalendarToggleRedirect() {
            const calendarToggleButton = document.getElementById('view-toggle-calendar');
            if (!calendarToggleButton || calendarToggleButton.dataset.redirectBound === '1') return;
            calendarToggleButton.dataset.redirectBound = '1';
            calendarToggleButton.addEventListener('click', function (event) {
                event.preventDefault();
                window.location.href = calendarUrl;
            });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bindCalendarToggleRedirect);
        } else {
            bindCalendarToggleRedirect();
        }
    })();

    // ===== FULLCALENDAR & VIEW TOGGLE =====
    window.switchView = function(view) {
        const listContainer = document.getElementById('slots-container');
        const calContainer = document.getElementById('calendar-container');
        const filterBar = document.getElementById('slot-filters'); // maybe hide filters in calendar mode
        const listBtn = document.getElementById('view-toggle-list');
        const calBtn = document.getElementById('view-toggle-calendar');

        if (view === 'list') {
            listContainer.classList.remove('hidden');
            calContainer.classList.add('hidden');
            
            listBtn.className = 'view-toggle-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-harbor-100 text-harbor-700';
            if (calBtn) {
                calBtn.className = 'view-toggle-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-slate-100 text-slate-500';
            }
        } else {
            listContainer.classList.add('hidden');
            calContainer.classList.remove('hidden');

            listBtn.className = 'view-toggle-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-slate-100 text-slate-500';
            if (calBtn) {
                calBtn.className = 'view-toggle-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors bg-harbor-100 text-harbor-700';
            }

            // Render calendar if not already (or resize)
            if (window.calendar) {
                window.calendar.render();
            } else {
                initCalendar();
            }
        }
    };

    function initCalendar() {
        const calendarEl = document.getElementById('calendar');
        window.calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            locale: 'fr',
            buttonText: {
                today: 'Aujourd\'hui',
                month: 'Mois',
                week: 'Semaine',
                day: 'Jour'
            },
            events: '/slots/front/api',
            eventClick: function(info) {
                if (!canManageSlots) {
                    return;
                }

                // Open edit modal if user is owner (this page is for professors)
                // We need to parse dates
                const event = info.event;
                const start = event.start;
                const end = event.end;
                
                // Format for input type="date" and "time"
                const formatDate = (d) => d.toISOString().split('T')[0];
                const formatTime = (d) => d.toTimeString().split(' ')[0].substring(0, 5);

                const id = event.id;
                
                openEditSlotModal(
                    id, 
                    formatDate(start), 
                    formatTime(start), 
                    formatDate(end), 
                    formatTime(end),
                    event.extendedProps && event.extendedProps.locationLabel ? event.extendedProps.locationLabel : '',
                    event.extendedProps && event.extendedProps.locationLat ? event.extendedProps.locationLat : '',
                    event.extendedProps && event.extendedProps.locationLng ? event.extendedProps.locationLng : ''
                );
            },
            eventDidMount: function(info) {
                // Tooltip or styling
                if (info.event.extendedProps.isBooked) {
                   // e.g. add lock icon?
                }
            }
        });
        window.calendar.render();
    }
})();
</script>
{% endblock %}
