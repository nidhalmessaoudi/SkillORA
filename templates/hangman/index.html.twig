{% extends 'layouts/user.html.twig' %}
{% block title %}Hangman Games{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-6xl space-y-6">
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-900 via-navy-800 to-harbor-700 p-6 md:p-8 text-white shadow-medium">
    <div class="absolute -top-10 -right-10 w-36 h-36 rounded-full bg-white/15 blur-2xl"></div>
    <div class="absolute -bottom-12 -left-10 w-40 h-40 rounded-full bg-harbor-300/25 blur-2xl"></div>

    <div class="relative flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold uppercase tracking-wide">Mini game</span>
        <h1 class="mt-3 text-3xl md:text-4xl font-display font-bold">Hangman</h1>
        <p class="mt-2 text-sm md:text-base text-white/85">Launch a new game by topic and difficulty, then continue your active sessions.</p>
      </div>

      <form method="post" action="{{ path('user_hangman_create') }}" class="grid w-full gap-2 sm:grid-cols-3 lg:w-auto">
        <select name="topic" class="rounded-xl border border-white/30 bg-white/95 px-3 py-2 text-sm text-navy-800 focus:outline-none focus:ring-2 focus:ring-harbor-300">
          <option value="symfony">Symfony</option>
          <option value="python">Python</option>
          <option value="programming">Programming</option>
          <option value="database">Database</option>
        </select>

        <select name="level" class="rounded-xl border border-white/30 bg-white/95 px-3 py-2 text-sm text-navy-800 focus:outline-none focus:ring-2 focus:ring-harbor-300">
          <option value="easy">Easy</option>
          <option value="medium">Medium</option>
          <option value="hard">Hard</option>
        </select>

        <button type="submit" class="btn-primary btn-sm w-full justify-center">
          New Game
        </button>
      </form>
    </div>
  </section>

  {% if games is empty %}
    <div class="card p-10 text-center">
      <h2 class="text-lg font-display font-semibold text-navy-900 dark:text-white">No game started yet</h2>
      <p class="mt-2 text-sm text-navy-500 dark:text-navy-400">Choose a topic and a level above to start your first hangman challenge.</p>
    </div>
  {% else %}
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-display font-semibold text-navy-900 dark:text-white">Your Games</h2>
        <span class="badge badge-secondary">{{ games|length }} session(s)</span>
      </div>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {% for g in games %}
          <a
            href="{{ path('user_hangman_play', { id: g.id }) }}"
            class="card p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-medium"
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-base font-display font-semibold text-navy-900 dark:text-white leading-snug">{{ g.title }}</h3>
              <i data-lucide="arrow-up-right" class="w-4 h-4 text-navy-400"></i>
            </div>

            <div class="mt-3 flex flex-wrap gap-2">
              <span class="badge badge-primary">{{ g.topic|capitalize }}</span>
              <span class="badge badge-warning">{{ g.level|capitalize }}</span>
            </div>

            <p class="mt-4 text-xs text-navy-500 dark:text-navy-400">Created on {{ g.createdAt|date('d/m/Y H:i') }}</p>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>
{% endblock %}
