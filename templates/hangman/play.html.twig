{% extends 'layouts/user.html.twig' %}
{% block title %}Hangman{% endblock %}

{% block content %}
<style>
  /* Fallback CSS si Tailwind a un souci */
  .kbd { display:grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap:8px; }
  @media (max-width: 640px){ .kbd{ grid-template-columns: repeat(7, minmax(0, 1fr)); } }
  .kbd button{ padding:10px 0; border-radius:12px; font-weight:800; background:#3b82f6; color:white; border:0; cursor:pointer; }
  .kbd button:hover{ background:#2563eb; }
  .kbd button:disabled{ opacity:.45; cursor:not-allowed; }
  .card{ background:white; border-radius:24px; padding:28px; box-shadow:0 10px 25px rgba(0,0,0,.06); }
  .muted{ color:#6b7280; }
  .bigword{ font-size:40px; font-weight:900; letter-spacing:.35em; text-align:center; }
</style>

<div class="max-w-4xl mx-auto">
  <div class="card">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold mb-2">JEU DU PENDU</h1>
        <p class="muted"><b>Phrase:</b> <span id="hint">{{ game.hint }}</span></p>
      </div>
      <a href="{{ path('user_hangman_index') }}" class="text-blue-600 font-semibold">← Retour</a>
    </div>

    <div class="mt-6 flex items-center justify-between">
      <div class="text-sm muted">
        Erreurs: <span id="mistakes">{{ attempt.mistakes }}</span> / <span id="maxMistakes">{{ game.maxMistakes }}</span>
        • Score: <span id="score">{{ attempt.score }}</span>
      </div>
      <div id="statusBadge" class="text-sm font-bold"></div>
    </div>

    {# ✅ Dessin pendu (SVG) #}
    <div class="mt-6 flex justify-center">
      <div class="w-80 h-80 border rounded-2xl flex items-center justify-center bg-gray-50">
        <svg width="260" height="260" viewBox="0 0 260 260">
          <!-- potence (toujours visible) -->
          <line x1="30" y1="230" x2="200" y2="230" stroke="#111827" stroke-width="6"/>
          <line x1="70" y1="230" x2="70" y2="30" stroke="#111827" stroke-width="6"/>
          <line x1="70" y1="30" x2="170" y2="30" stroke="#111827" stroke-width="6"/>
          <line x1="170" y1="30" x2="170" y2="60" stroke="#111827" stroke-width="6"/>

          <!-- ✅ parties “homme” (apparaissent selon erreurs) -->
          <circle id="p-head" cx="170" cy="80" r="18" stroke="#111827" stroke-width="6" fill="none" style="display:none"/>
          <line id="p-body" x1="170" y1="98" x2="170" y2="150" stroke="#111827" stroke-width="6" style="display:none"/>
          <line id="p-armL" x1="170" y1="115" x2="145" y2="135" stroke="#111827" stroke-width="6" style="display:none"/>
          <line id="p-armR" x1="170" y1="115" x2="195" y2="135" stroke="#111827" stroke-width="6" style="display:none"/>
          <line id="p-legL" x1="170" y1="150" x2="150" y2="190" stroke="#111827" stroke-width="6" style="display:none"/>
          <line id="p-legR" x1="170" y1="150" x2="190" y2="190" stroke="#111827" stroke-width="6" style="display:none"/>

          <!-- “dead face” optionnel -->
          <line id="p-dead1" x1="162" y1="74" x2="168" y2="80" stroke="#111827" stroke-width="4" style="display:none"/>
          <line id="p-dead2" x1="168" y1="74" x2="162" y2="80" stroke="#111827" stroke-width="4" style="display:none"/>
          <line id="p-dead3" x1="172" y1="74" x2="178" y2="80" stroke="#111827" stroke-width="4" style="display:none"/>
          <line id="p-dead4" x1="178" y1="74" x2="172" y2="80" stroke="#111827" stroke-width="4" style="display:none"/>
        </svg>
      </div>
    </div>

    <div class="mt-8">
      {# ✅ mot masqué avec espaces #}
      <div id="maskedWord" class="bigword">{{ masked|split('')|join(' ') }}</div>
    </div>

    {# ✅ clavier A-Z comme image 2 #}
    <div class="mt-8">
      <div class="kbd" id="keyboard">
        {% for c in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'|split('') %}
          <button type="button" class="letterBtn" data-letter="{{ c }}">{{ c }}</button>
        {% endfor %}
      </div>
    </div>

    <div id="message" class="mt-6 text-center text-2xl font-extrabold"></div>
    <div id="fabulous" class="hidden mt-6 text-center text-4xl font-extrabold text-emerald-600">✨ FABULOUS ✨</div>
  </div>
</div>

<script>
(function(){
  const maxMistakes = {{ game.maxMistakes }};
  const guessed = new Set({{ attempt.guessed|json_encode|raw }});
  let finishedWon = {{ attempt.won ? 'true' : 'false' }};
  let finishedLost = {{ attempt.lost ? 'true' : 'false' }};

  // ordre d’apparition des parties du bonhomme (1..7)
  const parts = [
    "p-head",
    "p-body",
    "p-armL",
    "p-armR",
    "p-legL",
    "p-legR",
    // si tu veux que la 7ème erreur montre “dead face”
    "p-dead1","p-dead2","p-dead3","p-dead4"
  ];

  function renderHangman(mistakes){
    // reset
    parts.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = "none";
    });

    // afficher selon erreurs
    // 1: head, 2: body, 3: armL, 4: armR, 5: legL, 6: legR, 7: dead face
    if (mistakes >= 1) document.getElementById("p-head").style.display = "";
    if (mistakes >= 2) document.getElementById("p-body").style.display = "";
    if (mistakes >= 3) document.getElementById("p-armL").style.display = "";
    if (mistakes >= 4) document.getElementById("p-armR").style.display = "";
    if (mistakes >= 5) document.getElementById("p-legL").style.display = "";
    if (mistakes >= 6) document.getElementById("p-legR").style.display = "";

    if (mistakes >= 7) {
      ["p-dead1","p-dead2","p-dead3","p-dead4"].forEach(id=>{
        const el = document.getElementById(id);
        if (el) el.style.display = "";
      });
    }
  }

  function disableGuessed(){
    document.querySelectorAll('.letterBtn').forEach(btn=>{
      const l = btn.dataset.letter;
      if (guessed.has(l) || finishedWon || finishedLost) {
        btn.disabled = true;
      }
    });
  }

  function setStatus(won, lost){
    const badge = document.getElementById('statusBadge');
    const msg = document.getElementById('message');
    const fab = document.getElementById('fabulous');

    if (won) {
      badge.textContent = "✅ WIN";
      badge.className = "text-emerald-600 text-sm font-extrabold";
      msg.textContent = "Bravo ! Tu as trouvé le mot !";
      msg.className = "mt-6 text-center text-2xl font-extrabold text-emerald-600";
      fab.classList.remove('hidden');
    } else if (lost) {
      badge.textContent = "❌ LOST";
      badge.className = "text-red-600 text-sm font-extrabold";
      msg.textContent = "Perdu… Le pendu est mort 😵";
      msg.className = "mt-6 text-center text-2xl font-extrabold text-red-600";
      fab.classList.add('hidden');
    } else {
      badge.textContent = "";
      msg.textContent = "";
      fab.classList.add('hidden');
    }
  }

  async function postJson(url, payload){
    const res = await fetch(url, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload || {})
    });
    let data = null;
    try { data = await res.json(); } catch(e){}
    return {res, data};
  }

  document.querySelectorAll('.letterBtn').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      const letter = btn.dataset.letter;

      const {res, data} = await postJson("{{ path('user_hangman_guess', {id: game.id}) }}", {letter});
      if (!res.ok || !data || data.ok !== true) return;

      guessed.add(letter);
      btn.disabled = true;

      document.getElementById('mistakes').textContent = data.mistakes;
      document.getElementById('score').textContent = data.score;

      // afficher le mot masqué avec espaces
      document.getElementById('maskedWord').textContent = (data.masked || "").split("").join(" ");

      // dessiner le bonhomme si erreur
      renderHangman(data.mistakes);

      finishedWon = data.won;
      finishedLost = data.lost;

      if (data.won || data.lost) {
        setStatus(data.won, data.lost);
        disableGuessed();
        if (data.answer) {
          document.getElementById('maskedWord').textContent = data.answer.split("").join(" ");
        }
      }
    });
  });

  // init
  renderHangman({{ attempt.mistakes }});
  disableGuessed();
  setStatus(finishedWon, finishedLost);
})();
</script>
{% endblock %}