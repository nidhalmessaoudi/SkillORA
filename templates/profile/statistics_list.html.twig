{% extends 'base.html.twig' %}

{% block title %}Profile — Statistics{% endblock %}

{% block body %}

<style>
    .example-wrapper { 
        margin: 2em auto; 
        max-width: 900px; 
        width: 95%; 
        font: 18px/1.6 sans-serif; 
    }

    .example-wrapper h1 {
        margin-bottom: 20px;
    }

    .stats-list {
        list-style: none;
        padding: 0;
    }

    .stats-item {
        background: #f9f9f9;
        padding: 12px 15px;
        margin-bottom: 10px;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stats-item a {
        text-decoration: none;
        color: white;
        background: #4CAF50;
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 14px;
    }

    .stats-item a:hover {
        background: #45a049;
    }

    .empty-message {
        background: #fff3cd;
        padding: 10px;
        border-radius: 4px;
    }
</style>

<div class="example-wrapper">
    <h1>📊 Statistics</h1>

    {% if evaluations is empty %}
        <div class="empty-message">
            No evaluations found.
        </div>
    {% else %}
        <ul class="stats-list">
            {% for evaluation in evaluations %}
                <li class="stats-item">
                    <span>
                        {{ evaluation.title|default('Evaluation #' ~ evaluation.id) }}
                    </span>
                    <a href="{{ path('profile_statistics_pdf', {'id': evaluation.id}) }}">
                        Download PDF
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>

{% endblock %}
