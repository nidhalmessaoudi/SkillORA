{% extends 'layouts/base.html.twig' %}

{% block title %}Profile Statistics - SkillHarbor{% endblock %}

{% block body %}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
        {# Header #}
        <div class="mb-8">
            <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">
                📊 Profile Statistics
            </h1>
            <p class="text-body-md text-navy-600 dark:text-navy-400">
                View your evaluation performance and results
            </p>
        </div>

        {# User's Evaluation Results #}
        <div class="card mb-6">
            <div class="p-6 border-b border-navy-100 dark:border-navy-800">
                <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
                    My Evaluation Results
                </h2>
            </div>

            {% if userEvaluations is empty %}
                <div class="p-6 text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-navy-100 dark:bg-navy-800 mb-4">
                        <i data-lucide="clipboard-list" class="w-8 h-8 text-navy-400"></i>
                    </div>
                    <p class="text-body-md text-navy-600 dark:text-navy-400 mb-4">
                        You haven't completed any evaluations yet.
                    </p>
                    <a href="{{ path('user_evaluation_index') }}" class="btn-primary btn-sm">
                        <i data-lucide="play-circle" class="w-4 h-4"></i>
                        Browse Evaluations
                    </a>
                </div>
            {% else %}
                <div class="p-6">
                    <div class="space-y-4">
                        {% for result in userEvaluations %}
                            {% set percentage = result.total_score > 0 ? (result.score / result.total_score * 100)|round(1) : 0 %}
                            {% set passed = percentage >= 60 %}
                            
                            <div class="card bg-navy-50 dark:bg-navy-800/50">
                                <div class="p-4">
                                    <div class="flex items-start justify-between">
                                        <div class="flex-1">
                                            <h3 class="font-display font-semibold text-navy-900 dark:text-white mb-1">
                                                {{ result.title }}
                                            </h3>
                                            <div class="flex items-center gap-4 text-caption text-navy-500 mb-3">
                                                <span class="flex items-center gap-1">
                                                    <i data-lucide="file-text" class="w-3 h-3"></i>
                                                    {{ result.type }}
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <i data-lucide="clock" class="w-3 h-3"></i>
                                                    {{ result.duration }} min
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <i data-lucide="calendar" class="w-3 h-3"></i>
                                                    {{ result.submitted_at|date('M d, Y') }}
                                                </span>
                                            </div>

                                            {# Score Display #}
                                            <div class="flex items-center gap-4">
                                                <div class="flex items-center gap-2">
                                                    <span class="text-body-sm text-navy-600 dark:text-navy-300">Score:</span>
                                                    <span class="font-display font-bold text-lg {{ passed ? 'text-success-600' : 'text-danger-600' }}">
                                                        {{ result.score }} / {{ result.total_score }}
                                                    </span>
                                                </div>
                                                <div class="flex items-center gap-2">
                                                    <span class="text-body-sm text-navy-600 dark:text-navy-300">Percentage:</span>
                                                    <span class="font-display font-bold text-lg {{ passed ? 'text-success-600' : 'text-danger-600' }}">
                                                        {{ percentage }}%
                                                    </span>
                                                </div>
                                                <span class="badge {{ passed ? 'badge-success' : 'badge-danger' }}">
                                                    {{ passed ? 'Passed ✓' : 'Failed ✗' }}
                                                </span>
                                            </div>
                                        </div>

                                        <div class="flex flex-col gap-2 ml-4">
                                            <a href="{{ path('profile_statistics_pdf', {'id': result.evaluation_id}) }}" 
                                               class="btn-secondary btn-sm whitespace-nowrap">
                                                <i data-lucide="download" class="w-4 h-4"></i>
                                                Download PDF
                                            </a>
                                            <a href="{{ path('user_evaluation_result', {'id': result.id}) }}" 
                                               class="btn-ghost btn-sm whitespace-nowrap">
                                                <i data-lucide="eye" class="w-4 h-4"></i>
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        {# Available Evaluations #}
        <div class="card">
            <div class="p-6 border-b border-navy-100 dark:border-navy-800">
                <h2 class="text-heading-lg font-display font-semibold text-navy-900 dark:text-white">
                    Available Evaluations
                </h2>
            </div>

            {% if evaluations is empty %}
                <div class="p-6 text-center">
                    <p class="text-body-md text-navy-600 dark:text-navy-400">
                        No evaluations available at the moment.
                    </p>
                </div>
            {% else %}
                <div class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {% for evaluation in evaluations %}
                            <div class="card bg-white dark:bg-navy-800 hover:shadow-medium transition-shadow">
                                <div class="p-4">
                                    <h3 class="font-display font-semibold text-navy-900 dark:text-white mb-2">
                                        {{ evaluation.title }}
                                    </h3>
                                    <div class="space-y-1 text-caption text-navy-500 mb-4">
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="file-text" class="w-3 h-3"></i>
                                            <span>{{ evaluation.type }}</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="clock" class="w-3 h-3"></i>
                                            <span>{{ evaluation.duration }} minutes</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="award" class="w-3 h-3"></i>
                                            <span>{{ evaluation.totalScore }} points</span>
                                        </div>
                                    </div>
                                    <a href="{{ path('user_evaluation_show', {'id': evaluation.id}) }}" 
                                       class="btn-primary btn-sm w-full">
                                        <i data-lucide="play-circle" class="w-4 h-4"></i>
                                        Take Evaluation
                                    </a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>

{% endblock %}
