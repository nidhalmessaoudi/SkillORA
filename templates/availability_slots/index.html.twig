{% extends 'layouts/admin.html.twig' %}

{% block title %}Créneaux - Admin - SkillORA{% endblock %}

{% block admin_content %}
<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">Créneaux de disponibilité</h1>
            <p class="text-body-md text-navy-600 dark:text-navy-400">Gérez tous les créneaux horaires disponibles pour les rendez-vous.</p>
        </div>
        <a href="{{ path('admin_slots_new') }}" class="btn-primary">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nouveau créneau
        </a>
    </div>
</div>

{# Stats Cards #}
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    {% set total = slots|length %}
    {% set booked = slots|filter(s => s.isBooked)|length %}
    {% set available = total - booked %}
    <div class="card p-5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-harbor-100 dark:bg-harbor-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="calendar-clock" class="w-5 h-5 text-harbor-600 dark:text-harbor-400"></i>
            </div>
            <div>
                <p class="text-caption text-navy-500">Total créneaux</p>
                <p class="text-heading-lg font-display font-bold text-navy-900 dark:text-white">{{ total }}</p>
            </div>
        </div>
    </div>
    <div class="card p-5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-success-100 dark:bg-success-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="check-circle" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
            </div>
            <div>
                <p class="text-caption text-navy-500">Disponibles</p>
                <p class="text-heading-lg font-display font-bold text-success-600 dark:text-success-400">{{ available }}</p>
            </div>
        </div>
    </div>
    <div class="card p-5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-warning-100 dark:bg-warning-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="clock" class="w-5 h-5 text-warning-600 dark:text-warning-400"></i>
            </div>
            <div>
                <p class="text-caption text-navy-500">Réservés</p>
                <p class="text-heading-lg font-display font-bold text-warning-600 dark:text-warning-400">{{ booked }}</p>
            </div>
        </div>
    </div>
</div>

{# Table #}
<div class="card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-navy-100 dark:border-navy-800 bg-navy-50 dark:bg-navy-900/50">
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Début</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Fin</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Créé le</th>
                    <th class="px-6 py-3 text-right text-caption font-semibold text-navy-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-navy-100 dark:divide-navy-800">
                {% for slot in slots %}
                <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors">
                    <td class="px-6 py-4 text-body-sm text-navy-700 dark:text-navy-300">
                        {{ slot.startAt|date('d/m/Y H:i') }}
                    </td>
                    <td class="px-6 py-4 text-body-sm text-navy-700 dark:text-navy-300">
                        {{ slot.endAt|date('d/m/Y H:i') }}
                    </td>
                    <td class="px-6 py-4">
                        {% if slot.isBooked %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-warning-100 text-warning-700 dark:bg-warning-900/30 dark:text-warning-400">
                                <i data-lucide="lock" class="w-3 h-3"></i> Réservé
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-success-100 text-success-700 dark:bg-success-900/30 dark:text-success-400">
                                <i data-lucide="unlock" class="w-3 h-3"></i> Disponible
                            </span>
                        {% endif %}
                    </td>
                    
                    <td class="px-6 py-4 text-body-sm text-navy-500">
                        {{ slot.createdAt|date('d/m/Y') }}
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_slots_show', {id: slot.id}) }}" class="p-1.5 rounded-lg text-navy-400 hover:text-harbor-600 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-colors" title="Voir">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </a>
                            <a href="{{ path('admin_slots_edit', {id: slot.id}) }}" class="p-1.5 rounded-lg text-navy-400 hover:text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors" title="Modifier">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </a>
                            <form method="post" action="{{ path('admin_slots_delete', {id: slot.id}) }}" class="inline" onsubmit="return confirmDelete('Supprimer ce créneau ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ slot.id) }}">
                                <button type="submit" class="p-1.5 rounded-lg text-navy-400 hover:text-danger-600 hover:bg-danger-50 dark:hover:bg-danger-900/20 transition-colors" title="Supprimer">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                            <i data-lucide="calendar-x" class="w-12 h-12 text-navy-300 dark:text-navy-600"></i>
                            <p class="text-body-md text-navy-500">Aucun créneau trouvé.</p>
                            <a href="{{ path('admin_slots_new') }}" class="btn-primary btn-sm">
                                <i data-lucide="plus" class="w-4 h-4"></i> Créer un créneau
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}