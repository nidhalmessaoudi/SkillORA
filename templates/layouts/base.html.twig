<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}SkillHarbor - Learn deeply. Grow visibly. Premium online learning platform.{% endblock %}">

    <title>{% block title %}SkillHarbor{% endblock %}</title>

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- DEBUG_BASE_LAYOUT -->
    {% block stylesheets %}
        {# Styles #}
        <link rel="stylesheet" href="/build/app.dev.css?v={{ random() }}">

        {# Leaflet (OpenStreetMap) #}
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    {% endblock %}
    {% if is_granted('ROLE_USER') %}
        <link rel="stylesheet" href="{{ asset('css/skillora-chat.css') }}?v=3">
    {% endif %}

    {# Icons - Lucide #}
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

    {# Theme initialization (prevent flash) #}
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>

    {% block head %}{% endblock %}
</head>
<body class="font-body bg-white dark:bg-navy-950 text-navy-900 dark:text-navy-100 antialiased">
    {# Skip to content for accessibility #}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 btn-primary z-50">
        Skip to content
    </a>

    {% block header %}
        {% include 'components/header.html.twig' %}
    {% endblock %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div
                data-flash-alert
                class="fixed top-6 right-6 z-50 px-4 py-3 rounded-xl shadow-lg transition-opacity duration-300
                    {% if label == 'success' %}
                        bg-green-500 text-white
                    {% elseif label == 'error' %}
                        bg-red-500 text-white
                    {% else %}
                        bg-blue-500 text-white
                    {% endif %}
                "
            >
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <main id="main-content" class="min-h-screen">
        {% block body %}{% endblock %}
    </main>
    {% if is_granted('ROLE_USER') %}
        {% include 'partials/_skillora_chat_widget.html.twig' %}
    {% endif %}

    {% block footer %}
        {% include 'components/footer.html.twig' %}
    {% endblock %}

    {# Toast Container #}
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-3"></div>

    {# Scripts #}
    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Theme toggle
        function toggleTheme() {
            const html = document.documentElement;
            const isDark = html.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');

            // Update icon
            const sunIcon = document.getElementById('theme-sun');
            const moonIcon = document.getElementById('theme-moon');
            if (sunIcon && moonIcon) {
                sunIcon.classList.toggle('hidden', isDark);
                moonIcon.classList.toggle('hidden', !isDark);
            }
        }

        // Mobile menu toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const overlay = document.getElementById('mobile-overlay');
            if (menu && overlay) {
                menu.classList.toggle('-translate-x-full');
                overlay.classList.toggle('hidden');
            }
        }

        // Close mobile menu
        function closeMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const overlay = document.getElementById('mobile-overlay');
            if (menu && overlay) {
                menu.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        // Dropdown toggle
        function toggleDropdown(id) {
            const dropdown = document.getElementById(id);
            if (dropdown) {
                dropdown.classList.toggle('hidden');
            }
        }

        // Close dropdowns when clicking outside or on links
        document.addEventListener('click', function(e) {
            // If clicking on a dropdown link, allow navigation and close dropdown
            if (e.target.closest('.dropdown a')) {
                document.querySelectorAll('.dropdown').forEach(d => d.classList.add('hidden'));
                return; // Allow the link to work normally
            }
            
            // Close dropdowns when clicking outside
            if (!e.target.closest('[data-dropdown]')) {
                document.querySelectorAll('.dropdown').forEach(d => d.classList.add('hidden'));
            }
        });

        // Toast notification
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast animate-slide-up';

            const iconMap = {
                success: '<i data-lucide="check-circle" class="w-5 h-5 text-success-500"></i>',
                error: '<i data-lucide="x-circle" class="w-5 h-5 text-danger-500"></i>',
                warning: '<i data-lucide="alert-triangle" class="w-5 h-5 text-warning-500"></i>',
                info: '<i data-lucide="info" class="w-5 h-5 text-harbor-500"></i>'
            };

            toast.innerHTML = `
                ${iconMap[type] || iconMap.info}
                <span class="text-body-sm text-navy-700 dark:text-navy-200">${message}</span>
                <button onclick="this.parentElement.remove()" class="ml-2 text-navy-400 hover:text-navy-600">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            `;

            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => toast.remove(), 5000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[data-flash-alert]').forEach(function(alertEl) {
                setTimeout(function() {
                    alertEl.classList.add('opacity-0');
                    setTimeout(function() {
                        alertEl.remove();
                    }, 300);
                }, 4000);
            });
        });
    </script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    {% block javascripts %}{% endblock %}
    {% if is_granted('ROLE_USER') %}
        <script src="{{ asset('js/skillora-chat.js') }}?v=3"></script>
    {% endif %}
</body>
</html>


