{% extends 'layouts/base.html.twig' %}

{% block title %}User - SkillHarbor{% endblock %}

{% block body %}
  {% set currentRoute = app.request.attributes.get('_route') %}

  <div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <section class="card p-4 sm:p-5 mb-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-xl sm:text-2xl font-display font-bold text-navy-900 dark:text-white">User Workspace</h1>
          <p class="text-body-sm text-navy-500 dark:text-navy-400 mt-1">Access assessments and games in one place.</p>
        </div>

        <nav aria-label="User navigation" class="flex flex-wrap gap-2">
          <a
            href="{{ path('user_evaluation_index') }}"
            class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold transition-colors {{ currentRoute starts with 'user_evaluation' ? 'bg-harbor-600 text-white shadow-soft' : 'bg-navy-100 text-navy-700 hover:bg-navy-200 dark:bg-navy-800 dark:text-navy-200 dark:hover:bg-navy-700' }}"
          >
            <i data-lucide="clipboard-list" class="w-4 h-4"></i>
            <span>Assessments</span>
          </a>

         

          <a
            href="{{ path('user_hangman_index') }}"
            class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold transition-colors {{ currentRoute starts with 'user_hangman' ? 'bg-harbor-600 text-white shadow-soft' : 'bg-navy-100 text-navy-700 hover:bg-navy-200 dark:bg-navy-800 dark:text-navy-200 dark:hover:bg-navy-700' }}"
          >
            <i data-lucide="brain-circuit" class="w-4 h-4"></i>
            <span>Hangman</span>
          </a>
        </nav>
      </div>
    </section>

    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 rounded-xl border px-4 py-3 text-sm font-medium shadow-soft
          {% if label == 'success' %}
            border-success-200 bg-success-50 text-success-700
          {% elseif label in ['danger', 'error'] %}
            border-danger-200 bg-danger-50 text-danger-700
          {% elseif label == 'warning' %}
            border-warning-200 bg-warning-50 text-warning-700
          {% else %}
            border-navy-200 bg-navy-50 text-navy-700 dark:border-navy-700 dark:bg-navy-900 dark:text-navy-200
          {% endif %}
        ">
          <div class="flex items-start gap-2">
            {% if label == 'success' %}
              <i data-lucide="check-circle-2" class="w-4 h-4 mt-0.5"></i>
            {% elseif label in ['danger', 'error'] %}
              <i data-lucide="x-circle" class="w-4 h-4 mt-0.5"></i>
            {% elseif label == 'warning' %}
              <i data-lucide="triangle-alert" class="w-4 h-4 mt-0.5"></i>
            {% else %}
              <i data-lucide="info" class="w-4 h-4 mt-0.5"></i>
            {% endif %}
            <span class="leading-relaxed">{{ message }}</span>
          </div>
        </div>
      {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
  </div>
{% endblock %}
