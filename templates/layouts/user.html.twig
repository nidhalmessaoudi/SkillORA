{% extends 'layouts/base.html.twig' %}

{% block title %}User — SkillHarbor{% endblock %}

{% block body %}
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    {# ============================= #}
    {# ✅ USER NAVIGATION MENU      #}
    {# ============================= #}
    <nav class="mb-8 flex flex-wrap gap-3 border-b pb-4">

      <a href="{{ path('user_evaluation_index') }}"
         class="px-4 py-2 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">
        📚 Assessments
      </a>

      <a href="{{ path('user_games_index') }}"
         class="px-4 py-2 rounded-xl bg-gray-100 text-gray-800 font-semibold hover:bg-gray-200 transition">
        🎮 Games
      </a>

      <li>
  <a href="{{ path('user_hangman_index') }}">🪓 Hangman</a>
</li>

    </nav>

    {# ============================= #}
    {# ✅ Flash messages             #}
    {# ============================= #}
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-6 p-5 rounded-lg border-l-4 shadow-md text-base font-medium
          {% if label == 'success' %}
            bg-green-50 border-green-600 text-green-800
          {% elseif label == 'danger' %}
            bg-red-50 border-red-600 text-red-800
          {% elseif label == 'warning' %}
            bg-yellow-50 border-yellow-500 text-yellow-800
          {% else %}
            bg-gray-50 border-gray-400 text-gray-800
          {% endif %}
        ">
          <div class="flex items-start gap-3">
            <div class="text-xl">⚠️</div>
            <div class="leading-relaxed">
              {{ message }}
            </div>
          </div>
        </div>
      {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}

  </div>
{% endblock %}