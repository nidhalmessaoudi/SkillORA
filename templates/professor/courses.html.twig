{% extends 'professor/layout.html.twig' %}

{% block title %}My Courses{% endblock %}
{% block page_title %}My Courses{% endblock %}
{% block page_subtitle %}Manage your courses and content{% endblock %}

{% block content %}
<div class="text-center py-20">
    <div class="w-16 h-16 bg-violet-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <i data-lucide="book-open" class="w-8 h-8 text-violet-400"></i>
    </div>
    <h2 class="text-2xl font-bold text-white mb-2">Courses Management</h2>
    <p class="text-navy-400 mb-6">Create and manage your courses here</p>
    <button class="px-6 py-3 bg-gradient-to-r from-harbor-600 to-harbor-500 hover:from-harbor-500 hover:to-harbor-600 rounded-xl text-white font-medium transition-all">
        Create Your First Course
    </button>
</div>
{% endblock %}
