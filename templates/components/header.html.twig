{# Global Navigation Header #}
<header class="sticky top-0 z-40 w-full glass border-b border-navy-200/50 dark:border-navy-800/50">
    <div class="container-wide">
        <div class="flex items-center justify-between h-16 lg:h-18">
            {# Logo & Mobile Menu Toggle #}
            <div class="flex items-center gap-4">
                {# Mobile Menu Button #}
                <button
                    onclick="toggleMobileMenu()"
                    class="lg:hidden p-2 rounded-xl text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors"
                    aria-label="Open menu"
                >
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>

                {# Logo #}
                <a href="{{ path('app_home') }}" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 bg-gradient-to-br from-harbor-600 to-harbor-500 rounded-2xl flex items-center justify-center shadow-soft group-hover:shadow-medium transition-shadow">
                        <i data-lucide="anchor" class="w-5 h-5 text-white"></i>
                    </div>
                    <div class="hidden sm:block">
                        <span class="font-display font-bold text-lg text-navy-900 dark:text-white">SkillHarbor</span>
                    </div>
                </a>
            </div>

            {# Desktop Navigation #}
            <nav class="hidden lg:flex items-center gap-1">
                <a href="{{ path('courses_index') }}" class="px-4 py-2 rounded-xl text-body-sm font-medium text-navy-600 dark:text-navy-300 hover:text-harbor-600 dark:hover:text-harbor-400 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-all">
                    Browse
                </a>
                <a href="{{ path('learn_index') }}" class="px-4 py-2 rounded-xl text-body-sm font-medium text-navy-600 dark:text-navy-300 hover:text-harbor-600 dark:hover:text-harbor-400 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-all">
                    My Learning
                </a>
                <a href="{{ path('community_index') }}" class="px-4 py-2 rounded-xl text-body-sm font-medium text-navy-600 dark:text-navy-300 hover:text-harbor-600 dark:hover:text-harbor-400 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-all">
                    Community
                </a>
                <a href="{{ path('events_index') }}" class="px-4 py-2 rounded-xl text-body-sm font-medium text-navy-600 dark:text-navy-300 hover:text-harbor-600 dark:hover:text-harbor-400 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-all">
                    Events
                </a>
                  <a href="{{ path('user_evaluation_index') }}" class="px-4 py-2 rounded-xl text-body-sm font-medium text-navy-600 dark:text-navy-300 hover:text-harbor-600 dark:hover:text-harbor-400 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-all">
                    Evaluations
                </a>
              

                {# Instructor Dropdown #}
                <div class="relative" data-dropdown>
                    <button
                        onclick="toggleDropdown('instructor-dropdown')"
                        class="flex items-center gap-1 px-4 py-2 rounded-xl text-body-sm font-medium text-navy-600 dark:text-navy-300 hover:text-harbor-600 dark:hover:text-harbor-400 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-all"
                    >
                        <span>Teach</span>
                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                    </button>
                    <div id="instructor-dropdown" class="dropdown hidden right-0">
                        <a href="{{ path('instructors_index') }}" class="dropdown-item">
                            <i data-lucide="users" class="w-4 h-4"></i>
                            <span>Browse Instructors</span>
                        </a>
                        <a href="{{ path('studio_index') }}" class="dropdown-item">
                            <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                            <span>Instructor Studio</span>
                        </a>
                        <div class="my-2 border-t border-navy-100 dark:border-navy-800"></div>
                        <a href="#" class="dropdown-item">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                            <span>Become an Instructor</span>
                        </a>
                    </div>
                </div>
            </nav>

            {# Search & Actions #}
            <div class="flex items-center gap-3">
                {# Desktop Search #}
                <div class="hidden md:block relative">
                    <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-navy-400"></i>
                    <input
                        type="search"
                        placeholder="Search courses..."
                        class="search-input w-64 lg:w-80"
                    >
                </div>

                {# Mobile Search Button #}
                <button class="md:hidden p-2 rounded-xl text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors">
                    <i data-lucide="search" class="w-5 h-5"></i>
                </button>

                {# Theme Toggle #}
                <button
                    onclick="toggleTheme()"
                    class="p-2 rounded-xl text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors"
                    aria-label="Toggle theme"
                >
                    <i id="theme-sun" data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                    <i id="theme-moon" data-lucide="moon" class="w-5 h-5 block dark:hidden"></i>
                </button>

                {# Notifications #}
                <div class="relative" data-dropdown>
                    <button
                        onclick="toggleDropdown('notifications-dropdown')"
                        class="relative p-2 rounded-xl text-navy-600 dark:text-navy-400 hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors"
                    >
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-coral-400 text-white text-[10px] font-bold rounded-full flex items-center justify-center">3</span>
                    </button>
                    <div id="notifications-dropdown" class="dropdown hidden right-0 w-80">
                        <div class="px-4 py-3 border-b border-navy-100 dark:border-navy-800">
                            <span class="font-display font-semibold text-navy-900 dark:text-white">Notifications</span>
                        </div>
                        <div class="max-h-80 overflow-y-auto custom-scrollbar">
                            <a href="#" class="flex gap-3 px-4 py-3 hover:bg-navy-50 dark:hover:bg-navy-800 transition-colors">
                                <div class="w-10 h-10 bg-success-100 dark:bg-success-900/30 rounded-xl flex items-center justify-center shrink-0">
                                    <i data-lucide="check-circle" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-body-sm text-navy-700 dark:text-navy-200 line-clamp-2">Your certificate for "UX Design" is ready</p>
                                    <p class="text-caption text-navy-500 mt-1">2 hours ago</p>
                                </div>
                            </a>
                            <a href="#" class="flex gap-3 px-4 py-3 hover:bg-navy-50 dark:hover:bg-navy-800 transition-colors">
                                <div class="w-10 h-10 bg-harbor-100 dark:bg-harbor-900/30 rounded-xl flex items-center justify-center shrink-0">
                                    <i data-lucide="message-square" class="w-5 h-5 text-harbor-600 dark:text-harbor-400"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-body-sm text-navy-700 dark:text-navy-200 line-clamp-2">Dr. Sarah Chen replied to your question</p>
                                    <p class="text-caption text-navy-500 mt-1">5 hours ago</p>
                                </div>
                            </a>
                            <a href="#" class="flex gap-3 px-4 py-3 hover:bg-navy-50 dark:hover:bg-navy-800 transition-colors">
                                <div class="w-10 h-10 bg-coral-100 dark:bg-coral-900/30 rounded-xl flex items-center justify-center shrink-0">
                                    <i data-lucide="trophy" class="w-5 h-5 text-coral-500"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-body-sm text-navy-700 dark:text-navy-200 line-clamp-2">You earned the "Week Warrior" badge!</p>
                                    <p class="text-caption text-navy-500 mt-1">1 day ago</p>
                                </div>
                            </a>
                        </div>
                        <a href="#" class="block px-4 py-3 text-center text-body-sm font-medium text-harbor-600 dark:text-harbor-400 hover:bg-navy-50 dark:hover:bg-navy-800 border-t border-navy-100 dark:border-navy-800 transition-colors">
                            View all notifications
                        </a>
                    </div>
                </div>

                {# Auth Buttons (shown when not logged in) #}
                {% if not app.user %}
                <div class="flex items-center gap-2">
                    <a href="{{ path('auth_login') }}" class="px-4 py-2 rounded-xl text-body-sm font-medium text-navy-600 dark:text-navy-300 hover:text-harbor-600 dark:hover:text-harbor-400 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-all">
                        Sign In
                    </a>
                    <a href="{{ path('auth_register') }}" class="btn-primary py-2">
                        Get Started
                    </a>
                </div>
                {% else %}
                {# User Menu (shown when logged in) #}
                <div class="relative" data-dropdown>
                    <button
                        onclick="toggleDropdown('user-dropdown')"
                        class="flex items-center gap-2 p-1.5 pr-3 rounded-full bg-navy-100 dark:bg-navy-800 hover:bg-navy-200 dark:hover:bg-navy-700 transition-colors"
                    >
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-harbor-600 to-harbor-500 flex items-center justify-center text-white font-semibold text-sm">
                            {{ app.user.firstName|slice(0, 1)|upper }}{{ app.user.lastName|slice(0, 1)|upper }}
                        </div>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-navy-500 hidden sm:block"></i>
                    </button>
                    <div id="user-dropdown" class="dropdown hidden right-0 w-64">
                        <div class="px-4 py-3 border-b border-navy-100 dark:border-navy-800">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-harbor-600 to-harbor-500 flex items-center justify-center text-white font-semibold">
                                    {{ app.user.firstName|slice(0, 1)|upper }}{{ app.user.lastName|slice(0, 1)|upper }}
                                </div>
                                <div>
                                    <p class="font-display font-semibold text-navy-900 dark:text-white">{{ app.user.fullName }}</p>
                                    <p class="text-caption text-navy-500">{{ app.user.email }}</p>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="flex justify-between text-caption text-navy-500 mb-1">
                                    <span>4,250 XP</span>
                                    <span>7,000 XP</span>
                                </div>
                                <div class="xp-bar">
                                    <div class="xp-bar-fill" style="width: 60%;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="py-2">
                            <a href="{{ path('profile_index') }}" class="dropdown-item">
                                <i data-lucide="user" class="w-4 h-4"></i>
                                <span>My Profile</span>
                            </a>
                            <a href="{{ path('learn_index') }}" class="dropdown-item">
                                <i data-lucide="play-circle" class="w-4 h-4"></i>
                                <span>My Learning</span>
                            </a>
                            <a href="{{ path('profile_achievements') }}" class="dropdown-item">
                                <i data-lucide="award" class="w-4 h-4"></i>
                                <span>Achievements</span>
                            </a>
                            <a href="{{ path('profile_index') }}" class="dropdown-item">
                                <i data-lucide="file-badge" class="w-4 h-4"></i>
                                <span>Certificates</span>
                            </a>
                        </div>
                        <div class="border-t border-navy-100 dark:border-navy-800 py-2">
                            <a href="#" class="dropdown-item">
                                <i data-lucide="settings" class="w-4 h-4"></i>
                                <span>Settings</span>
                            </a>
                            <a href="{{ path('auth_logout') }}" class="dropdown-item text-danger-500">
                                <i data-lucide="log-out" class="w-4 h-4"></i>
                                <span>Sign Out</span>
                            </a>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</header>

{# Mobile Menu Overlay #}
<div id="mobile-overlay" onclick="closeMobileMenu()" class="hidden fixed inset-0 bg-navy-950/50 backdrop-blur-sm z-40 lg:hidden"></div>

{# Mobile Menu Drawer #}
<div id="mobile-menu" class="fixed left-0 top-0 bottom-0 w-80 bg-white dark:bg-navy-900 shadow-strong z-50 -translate-x-full transition-transform duration-300 ease-out lg:hidden overflow-y-auto custom-scrollbar">
    <div class="p-6">
        {# Close Button #}
        <div class="flex items-center justify-between mb-8">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gradient-to-br from-harbor-600 to-harbor-500 rounded-2xl flex items-center justify-center">
                    <i data-lucide="anchor" class="w-5 h-5 text-white"></i>
                </div>
                <span class="font-display font-bold text-lg text-navy-900 dark:text-white">SkillHarbor</span>
            </a>
            <button onclick="closeMobileMenu()" class="p-2 rounded-xl hover:bg-navy-100 dark:hover:bg-navy-800">
                <i data-lucide="x" class="w-5 h-5 text-navy-600 dark:text-navy-400"></i>
            </button>
        </div>

        {# Mobile Search #}
        <div class="relative mb-6">
            <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-navy-400"></i>
            <input type="search" placeholder="Search courses..." class="search-input w-full">
        </div>

        {# Mobile Navigation #}
        <nav class="space-y-1">
            <a href="{{ path('app_home') }}" class="sidebar-nav-item">
                <i data-lucide="home" class="w-5 h-5"></i>
                <span>Home</span>
            </a>
            <a href="{{ path('courses_index') }}" class="sidebar-nav-item">
                <i data-lucide="compass" class="w-5 h-5"></i>
                <span>Browse Courses</span>
            </a>
            <a href="{{ path('learn_index') }}" class="sidebar-nav-item sidebar-nav-item-active">
                <i data-lucide="play-circle" class="w-5 h-5"></i>
                <span>My Learning</span>
            </a>
            <a href="{{ path('community_index') }}" class="sidebar-nav-item">
                <i data-lucide="users" class="w-5 h-5"></i>
                <span>Community</span>
            </a>
            <a href="{{ path('events_index') }}" class="sidebar-nav-item">
                <i data-lucide="calendar" class="w-5 h-5"></i>
                <span>Events</span>
            </a>
            <a href="{{ path('quiz_index') }}" class="sidebar-nav-item">
                <i data-lucide="clipboard-check" class="w-5 h-5"></i>
                <span>Quizzes</span>
            </a>

            <div class="my-4 border-t border-navy-200 dark:border-navy-800"></div>

            <a href="{{ path('profile_index') }}" class="sidebar-nav-item">
                <i data-lucide="user" class="w-5 h-5"></i>
                <span>Profile</span>
            </a>
            <a href="{{ path('profile_achievements') }}" class="sidebar-nav-item">
                <i data-lucide="award" class="w-5 h-5"></i>
                <span>Achievements</span>
            </a>
            <a href="{{ path('profile_index') }}" class="sidebar-nav-item">
                <i data-lucide="file-badge" class="w-5 h-5"></i>
                <span>Certificates</span>
            </a>

            <div class="my-4 border-t border-navy-200 dark:border-navy-800"></div>

            <a href="{{ path('instructors_index') }}" class="sidebar-nav-item">
                <i data-lucide="graduation-cap" class="w-5 h-5"></i>
                <span>Instructors</span>
            </a>
            <a href="{{ path('studio_index') }}" class="sidebar-nav-item">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                <span>Instructor Studio</span>
            </a>

            {# Mobile Auth Buttons #}
            {% if not app.user %}
            <div class="my-4 border-t border-navy-200 dark:border-navy-800"></div>
            <div class="space-y-3 pt-2">
                <a href="{{ path('auth_login') }}" class="sidebar-nav-item">
                    <i data-lucide="log-in" class="w-5 h-5"></i>
                    <span>Sign In</span>
                </a>
                <a href="{{ path('auth_register') }}" class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-gradient-to-r from-harbor-600 to-harbor-500 text-white font-medium hover:from-harbor-700 hover:to-harbor-600 transition-all">
                    <i data-lucide="user-plus" class="w-5 h-5"></i>
                    <span>Create Account</span>
                </a>
            </div>
            {% endif %}
        </nav>
    </div>
</div>
