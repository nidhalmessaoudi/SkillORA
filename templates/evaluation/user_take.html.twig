{% extends 'layouts/user.html.twig' %}

{% block content %}

<h1 class="text-2xl font-bold mb-4">{{ evaluation.title }}</h1>

<p id="timer" class="text-red-600 font-bold mb-4"></p>

<form method="post">
  <input type="hidden" name="_token" value="{{ csrf_token('take_evaluation_' ~ evaluation.id) }}">

  {% if evaluation.type == 'EXAM' %}

    {% if evaluation.pdfPath %}
      <div class="mb-4 border rounded overflow-hidden">
        <iframe src="{{ asset(evaluation.pdfPath) ~ '?v=' ~ random() }}" width="100%" height="600"></iframe>
      </div>
    {% else %}
      <div class="p-4 bg-yellow-50 border rounded text-yellow-800">
        Aucun PDF n’a été ajouté pour cet examen.
      </div>
    {% endif %}

    <div id="plagiarism-alert" class="hidden p-3 rounded bg-red-100 text-red-700 text-sm mb-3">
      ⚠️ Copier-coller détecté. Votre réponse est en cours d’analyse pour plagiat.
      <span id="plagiarism-score"></span>
    </div>

    <textarea id="exam_response" name="exam_response" class="w-full border p-3 mt-2" rows="10" required
              placeholder="Écrivez votre réponse ici...">{{ examDraft.content ?? '' }}</textarea>

    {% if examDraft %}
      <script>
      (function() {
        const answerId = {{ examDraft.id }};
        const alertBox = document.getElementById('plagiarism-alert');
        const scoreEl = document.getElementById('plagiarism-score');

        let cooldown = false;

        async function sendIntegrity(type) {
          if (cooldown && type === 'paste') return;
          if (type === 'paste') {
            cooldown = true;
            setTimeout(() => cooldown = false, 8000);
          }

          // ✅ IMPORTANT: envoyer le contenu actuel du textarea
          const content = document.getElementById('exam_response')?.value ?? '';

          try {
            const res = await fetch(`/exam/answer/${answerId}/integrity`, {
              method: 'POST',
              headers: {'Content-Type': 'application/json'},
              body: JSON.stringify({ type, content })
            });

            const data = await res.json().catch(() => null);
            if (!data || !data.ok) return;

            if (type === 'paste') {
              alertBox.classList.remove('hidden');

              const web = data.webPlagiarismPercent ?? null;
              const ai = data.aiSuspicionPercent ?? null;

              let msg = '';
              if (web !== null) msg += ` Web: ${web}%`;
              if (ai !== null) msg += ` • IA: ${ai}%`;
              scoreEl.textContent = msg ? `(${msg.trim()})` : '';
            }
          } catch (e) {
            // ignore
          }
        }

       document.addEventListener('paste', function() {
  alertBox.classList.remove('hidden');
  setTimeout(() => sendIntegrity('paste'), 120);
});

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) sendIntegrity('tab_switch');
        });
      })();
      </script>
    {% endif %}

  {% else %}

    {% for question in questions %}
      <div class="mb-4 p-4 border rounded">
        <p class="font-semibold">{{ question.content }}</p>

        {% for ans in question.answers %}
          {% if ans.role == 'CHOICE' %}
            <label class="block mt-2">
              <input type="radio" name="answers[{{ question.id }}]" value="{{ ans.id }}" required>
              {{ ans.content }}
            </label>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}

  {% endif %}

  <button class="btn-primary mt-4">Soumettre</button>
</form>

<script>
const endTime = new Date("{{ endTime|date('Y-m-d H:i:s') }}").getTime();
const timer = document.getElementById("timer");

const interval = setInterval(() => {
  const now = new Date().getTime();
  const distance = endTime - now;

  if (distance <= 0) {
    clearInterval(interval);
    location.reload();
    return;
  }

  const minutes = Math.floor((distance % (1000*60*60)) / (1000*60));
  const seconds = Math.floor((distance % (1000*60)) / 1000);
  timer.innerText = minutes + "m " + seconds + "s";
}, 1000);
</script>

{% endblock %}