{% extends 'layouts/user.html.twig' %}

{% block title %}My Assessments{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl space-y-8 px-3 sm:px-5">
  <section class="relative overflow-hidden rounded-3xl border border-harbor-200/60 dark:border-harbor-800/60 bg-gradient-to-br from-harbor-600 via-harbor-500 to-navy-700 p-8 md:p-10 text-white shadow-medium flex items-center justify-center text-center">
    <div class="absolute -top-12 -right-12 h-40 w-40 rounded-full bg-white/20 blur-2xl"></div>
    <div class="absolute -bottom-16 -left-14 h-44 w-44 rounded-full bg-harbor-300/30 blur-2xl"></div>

    <div class="relative max-w-2xl mx-auto flex flex-col items-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold uppercase tracking-wide">
        Learning space
      </span>
      <h1 class="mt-4 text-3xl md:text-5xl font-display font-bold tracking-tight">My Assessments</h1>
      <p class="mt-3 max-w-2xl text-sm md:text-base text-white/90">
        Track your progress, launch pending assessments, and review completed results.
      </p>
      <a href="#assessments-list" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-harbor-700 hover:bg-harbor-50 transition-colors">
        View assessments
      </a>
    </div>
  </section>

  <section id="assessments-list" class="card p-4 md:p-5">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="font-display text-lg font-semibold text-navy-900 dark:text-white">Assessment List</h2>
        <p class="text-body-sm text-navy-500 dark:text-navy-400">Use filters to focus on pending or completed work.</p>
      </div>

      <div class="flex flex-wrap gap-2">
        <button type="button" data-filter="all" class="filter-pill rounded-xl px-3 py-2 text-xs font-semibold">All</button>
        <button type="button" data-filter="todo" class="filter-pill rounded-xl px-3 py-2 text-xs font-semibold">To do</button>
        <button type="button" data-filter="done" class="filter-pill rounded-xl px-3 py-2 text-xs font-semibold">Completed</button>
        <button type="button" data-filter="exam" class="filter-pill rounded-xl px-3 py-2 text-xs font-semibold">Exam</button>
        <button type="button" data-filter="quiz" class="filter-pill rounded-xl px-3 py-2 text-xs font-semibold">Quiz</button>
      </div>
    </div>
  </section>

  {% if pagination is empty %}
    <div class="card p-8 text-center text-navy-500 dark:text-navy-400">No assessments available at the moment.</div>
  {% else %}
    <div class="space-y-4">
      {% for evaluation in pagination %}
        {% set userEvaluation = evaluation.userEvaluations|filter(ue => ue.user == app.user)|first %}
        {% set done = userEvaluation is not empty and userEvaluation.submittedAt is not null %}
        {% set typeKey = evaluation.type|upper == 'EXAM' ? 'exam' : 'quiz' %}

        <article class="eval-item card p-5 md:p-6" data-status="{{ done ? 'done' : 'todo' }}" data-type="{{ typeKey }}">
          <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-display font-semibold text-navy-900 dark:text-white">{{ evaluation.title }}</h3>

                <span class="badge {{ evaluation.type|upper == 'EXAM' ? 'badge-warning' : 'badge-primary' }}">{{ evaluation.type|upper }}</span>
                <span class="badge {{ done ? 'badge-success' : 'badge-secondary' }}">{{ done ? 'Completed' : 'To do' }}</span>
              </div>

              <p class="mt-2 text-body-sm text-navy-600 dark:text-navy-300">{{ evaluation.description|default('No description provided.') }}</p>

              <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-navy-500 dark:text-navy-400">
                <span>Duration: {{ evaluation.duration }} minutes</span>
                {% if userEvaluation and userEvaluation.startedAt %}
                  <span>Started: {{ userEvaluation.startedAt|date('d/m/Y H:i') }}</span>
                {% endif %}
                {% if done and userEvaluation.submittedAt %}
                  <span>Submitted: {{ userEvaluation.submittedAt|date('d/m/Y H:i') }}</span>
                {% endif %}
              </div>
            </div>

            <div class="flex shrink-0 items-center gap-2">
              {% if done %}
                <a href="{{ path('user_evaluation_result', {'id': userEvaluation.id}) }}" class="btn-secondary btn-sm">View result</a>
              {% else %}
                <a href="{{ path('user_evaluation_take', {'id': evaluation.id}) }}" class="btn-primary btn-sm">Take assessment</a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="mt-8 flex justify-center">
      {{ knp_pagination_render(pagination, 'pagination/tailwind.html.twig') }}
    </div>
  {% endif %}
</div>

<script>
(function () {
  const activeClasses = ['bg-harbor-100', 'text-harbor-700', 'dark:bg-harbor-900/40', 'dark:text-harbor-300'];
  const inactiveClasses = ['bg-navy-100', 'text-navy-600', 'dark:bg-navy-800', 'dark:text-navy-300'];

  const pills = document.querySelectorAll('.filter-pill');
  const items = document.querySelectorAll('.eval-item');

  function setActive(btn) {
    pills.forEach((pill) => {
      pill.classList.remove(...activeClasses);
      pill.classList.add(...inactiveClasses);
    });

    btn.classList.remove(...inactiveClasses);
    btn.classList.add(...activeClasses);
  }

  function applyFilter(key) {
    items.forEach((el) => {
      const status = el.getAttribute('data-status');
      const type = el.getAttribute('data-type');
      let show = false;

      if (key === 'all') show = true;
      else if (key === 'todo') show = (status === 'todo');
      else if (key === 'done') show = (status === 'done');
      else if (key === 'exam') show = (type === 'exam');
      else if (key === 'quiz') show = (type === 'quiz');

      el.style.display = show ? '' : 'none';
    });
  }

  pills.forEach((btn) => {
    btn.classList.add(...inactiveClasses);
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-filter');
      setActive(btn);
      applyFilter(key);
    });
  });

  const first = document.querySelector('.filter-pill[data-filter="all"]');
  if (first) setActive(first);
})();
</script>
{% endblock %}
