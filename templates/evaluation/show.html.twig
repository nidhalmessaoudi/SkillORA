{% extends 'layouts/admin.html.twig' %}

{% block title %}Evaluation Details{% endblock %}

{% block admin_content %}
<h1 class="text-display-lg font-bold mb-6">Evaluation Details</h1>

<div class="card p-6 max-w-3xl">
    <dl class="grid grid-cols-2 gap-4">
        <dt class="font-medium">Title</dt>
        <dd>{{ evaluation.title }}</dd>

        <dt class="font-medium">Description</dt>
        <dd>{{ evaluation.description }}</dd>

        <dt class="font-medium">Type</dt>
        <dd>{{ evaluation.type }}</dd>

        <dt class="font-medium">Duration (min)</dt>
        <dd>{{ evaluation.duration }}</dd>

        <dt class="font-medium">Total Score</dt>
        <dd>{{ evaluation.totalScore }}</dd>

        <dt class="font-medium">Created At</dt>
        <dd>{{ evaluation.createdAt|date('Y-m-d H:i') }}</dd>
    </dl>

    <div class="mt-6 flex gap-3">
        <a href="{{ path('evaluation_edit', {'id': evaluation.id}) }}" class="btn-primary">Edit</a>
        <a href="{{ path('evaluation_index') }}" class="btn-secondary">Back</a>
    </div>
</div>
{% endblock %}
