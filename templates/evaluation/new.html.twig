{% extends 'layouts/admin.html.twig' %}

{% block title %}New Evaluation{% endblock %}

{% block admin_content %}
<h1 class="text-display-lg font-bold mb-6">Create Evaluation</h1>

<div class="card p-6 max-w-3xl">
    {{ form_start(form) }}

    {{ form_errors(form) }}

    <div class="space-y-5">
        {{ form_row(form.title) }}
        {{ form_row(form.description) }}

        <div class="grid grid-cols-2 gap-4">
            {{ form_row(form.type) }}
            {{ form_row(form.duration) }}
            {{ form_row(form.totalScore) }}
        </div>
    </div>

    <div class="mt-6 flex gap-3">
        <button class="btn-primary">Save</button>
        <a href="{{ path('evaluation_index') }}" class="btn-secondary">Cancel</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
