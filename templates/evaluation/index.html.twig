{% extends 'layouts/admin.html.twig' %}

{% block title %}Evaluations - Admin{% endblock %}

{% block admin_content %}
<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-display-lg font-bold mb-2">Evaluations</h1>
        <p class="text-navy-600">Manage quizzes and exams</p>
    </div>

    <a href="{{ path('evaluation_new') }}" class="btn-primary btn-sm">
        + New Evaluation
    </a>
</div>

<div class="card">
    <div class="p-6 border-b">
        <h2 class="text-heading-lg font-semibold">
            All Evaluations ({{ evaluations|length }})
        </h2>
    </div>

    <table class="w-full">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left">ID</th>
                <th class="px-6 py-3 text-left">Title</th>
                <th class="px-6 py-3 text-left">Type</th>
                <th class="px-6 py-3 text-left">Duration</th>
                <th class="px-6 py-3 text-left">Score</th>
                <th class="px-6 py-3 text-left">Created</th>
                <th class="px-6 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for evaluation in evaluations %}
            <tr class="border-t hover:bg-gray-50">
                <td class="px-6 py-4">#{{ evaluation.id }}</td>
                <td class="px-6 py-4 font-medium">{{ evaluation.title }}</td>
                <td class="px-6 py-4">{{ evaluation.type }}</td>
                <td class="px-6 py-4">{{ evaluation.duration }} min</td>
                <td class="px-6 py-4">{{ evaluation.totalScore }}</td>
                <td class="px-6 py-4">{{ evaluation.createdAt|date('d/m/Y') }}</td>
               <td class="px-6 py-4 text-right space-x-2">
    <a href="{{ path('evaluation_show', {id: evaluation.id}) }}" class="btn-sm">
        View
    </a>

    <a href="{{ path('evaluation_edit', {id: evaluation.id}) }}" class="btn-sm">
        Edit
    </a>

    {# 🔴 Bouton DELETE #}
    <form method="post"
          action="{{ path('evaluation_delete', {id: evaluation.id}) }}"
          class="inline-block"
          onsubmit="return confirm('Are you sure you want to delete this evaluation?');">

        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evaluation.id) }}">

        <button type="submit" class="btn-sm text-red-600 hover:text-red-800">
            Delete
        </button>
    </form>
</td>

            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="text-center py-8 text-gray-500">
                    No evaluations found
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
