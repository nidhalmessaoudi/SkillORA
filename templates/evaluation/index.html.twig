{% extends 'layouts/admin.html.twig' %}

{% block title %}Evaluations - Admin{% endblock %}

{% block admin_content %}
<div class="mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold mb-1">Evaluations</h1>
    <p class="text-gray-500">Manage quizzes and exams</p>
  </div>

  <a href="{{ path('evaluation_new') }}" class="btn-primary btn-sm">
    + New Evaluation
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  {# LEFT: EVALUATIONS LIST #}
  <div class="lg:col-span-2">
    <div class="card shadow-sm rounded-xl overflow-hidden">

      <div class="p-6 border-b flex items-center justify-between">
        <h2 class="text-lg font-semibold">
          {{ evaluations|length }} Evaluation(s)
        </h2>

        <form method="get" action="{{ path('evaluation_index') }}" class="w-80 flex justify-end">
          <select name="type"
                  onchange="this.form.submit()"
                  class="w-full border rounded-lg px-4 py-2 shadow-sm text-black focus:ring-2 focus:ring-blue-400 focus:outline-none transition">
            <option value="" {{ selectedType is empty ? 'selected' : '' }}>🔍 Filter by type</option>
            <option value="QUIZ" {{ selectedType == 'QUIZ' ? 'selected' : '' }}>Quiz</option>
            <option value="EXAM" {{ selectedType == 'EXAM' ? 'selected' : '' }}>Exam</option>
          </select>
        </form>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wider">
            <tr>
              <th class="px-6 py-3 text-left">Title</th>
              <th class="px-6 py-3 text-left">Type</th>
              <th class="px-6 py-3 text-left">Duration</th>
              <th class="px-6 py-3 text-left">Total</th>
              <th class="px-6 py-3 text-right">Actions</th>
            </tr>
          </thead>

          <tbody>
          {% for evaluation in evaluations %}
            <tr class="border-t hover:bg-gray-50 transition
              {{ selectedEvaluation and selectedEvaluation.id == evaluation.id ? 'bg-blue-50' : '' }}">

              <td class="px-6 py-4 font-semibold">
                <a class="text-blue-700 hover:underline"
                   href="{{ path('evaluation_index', { type: selectedType, evaluationId: evaluation.id }) }}">
                  {{ evaluation.title }}
                </a>
                <div class="text-xs text-gray-500 mt-1">
                  {{ evaluation.createdAt|date('d/m/Y H:i') }}
                </div>
              </td>

              <td class="px-6 py-4">
                {% if evaluation.type == 'QUIZ' %}
                  <span class="px-3 py-1 text-xs font-medium bg-blue-100 text-blue-700 rounded-full">QUIZ</span>
                {% else %}
                  <span class="px-3 py-1 text-xs font-medium bg-purple-100 text-purple-700 rounded-full">EXAM</span>
                {% endif %}
              </td>

              <td class="px-6 py-4">{{ evaluation.duration }} min</td>
              <td class="px-6 py-4 font-semibold">{{ evaluation.totalScore }}</td>

              <td class="px-6 py-4 text-right space-x-2">
                <a href="{{ path('evaluation_show', {id: evaluation.id}) }}" class="btn-sm">View</a>
                <a href="{{ path('evaluation_edit', {id: evaluation.id}) }}" class="btn-sm">Edit</a>

                <form method="post"
                      action="{{ path('evaluation_delete', {id: evaluation.id}) }}"
                      class="inline-block"
                      onsubmit="return confirm('Are you sure you want to delete this evaluation?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evaluation.id) }}">
                  <button type="submit" class="btn-sm text-red-600 hover:text-red-800">Delete</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center py-10 text-gray-400">No evaluations found</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

    </div>
  </div>

  {# RIGHT: QUESTIONS PANEL #}
  <div class="lg:col-span-1">
    <div class="card shadow-sm rounded-xl overflow-hidden">

      {# HEADER RIGHT #}
      <div class="p-6 border-b">
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-semibold">
            {{ selectedEvaluation ? (selectedEvaluation.type == 'EXAM' ? 'Exam' : 'Questions') : 'Questions' }}
          </h3>

          {% if selectedEvaluation %}
            {% if selectedEvaluation.type == 'QUIZ' %}
              <div class="flex flex-wrap items-center gap-2">

               <form method="post"
      action="{{ path('admin_eval_ai_generate_quiz', {id: selectedEvaluation.id}) }}"
      class="flex items-center gap-2">
  <input type="hidden" name="_token" value="{{ csrf_token('ai_gen_quiz_' ~ selectedEvaluation.id) }}">
  <input type="hidden" name="_csrf_token" value="{{ csrf_token('ai_gen_quiz_' ~ selectedEvaluation.id) }}">
  <input type="hidden" name="selectedType" value="{{ selectedType }}">
      
  <input name="topic"
         value="{{ app.request.get('topic') ?? 'General knowledge' }}"
         class="w-40 border border-gray-300 rounded-md px-2 py-1 text-xs"
         placeholder="Topic">

  <input name="count"
         type="number"
         value="5"
         min="1"
         max="20"
         class="w-16 border border-gray-300 rounded-md px-2 py-1 text-xs">

<button id="ai-generate-btn"
        type="submit"
        style="background:#2563EB;color:white;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;">
  Générer IA
</button>

</form>

              <div class="d-flex justify-content-end align-items-center small gap-3">
    
    <a href="{{ path('admin_question_new', {
        evaluationId: selectedEvaluation.id,
        back: path('evaluation_index', { type: selectedType, evaluationId: selectedEvaluation.id })
    }) }}"
       class="text-decoration-none text-muted fw-semibold">
        Add Questions
    </a>

    <span class="text-muted">|</span>

    <a href="{{ path('admin_answer_index', {
        evaluationId: selectedEvaluation.id,
        back: path('evaluation_index', { type: selectedType, evaluationId: selectedEvaluation.id })
    }) }}"
       class="text-decoration-none text-dark fw-semibold">
        View Answers
    </a>

</div>

              </div>
            {% else %}
              <a href="{{ path('admin_exam_manage', { id: selectedEvaluation.id }) }}"
                 class="btn-primary btn-sm">
                Manage Exam
              </a>
            {% endif %}
          {% endif %}

        </div>
      </div>

      {# BODY RIGHT #}
      <div class="p-6 space-y-4">
        {% if not selectedEvaluation %}
          <div class="text-gray-500 text-sm">
            Click on an evaluation title to view its questions.
          </div>
        {% else %}
          <div class="rounded-xl border border-slate-200 bg-gradient-to-r from-slate-50 to-blue-50 p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-[11px] uppercase tracking-wide text-slate-500 font-semibold">Selected Evaluation</p>
                <div class="font-semibold text-slate-900 mt-1 break-words">
                  {{ selectedEvaluation.title }}
                </div>
              </div>
              {% if selectedEvaluation.type == 'QUIZ' %}
                <span class="px-2 py-1 text-[11px] font-semibold bg-blue-100 text-blue-700 rounded-full">QUIZ</span>
              {% else %}
                <span class="px-2 py-1 text-[11px] font-semibold bg-purple-100 text-purple-700 rounded-full">EXAM</span>
              {% endif %}
            </div>

            <div class="grid grid-cols-3 gap-2 mt-3">
              <div class="bg-white border border-slate-200 rounded-lg p-2 text-center">
                <div class="text-[11px] text-slate-500">Questions</div>
                <div class="text-sm font-bold text-slate-900">{{ questions|length }}</div>
              </div>
              <div class="bg-white border border-slate-200 rounded-lg p-2 text-center">
                <div class="text-[11px] text-slate-500">Duration</div>
                <div class="text-sm font-bold text-slate-900">{{ selectedEvaluation.duration }}m</div>
              </div>
              <div class="bg-white border border-slate-200 rounded-lg p-2 text-center">
                <div class="text-[11px] text-slate-500">Score</div>
                <div class="text-sm font-bold text-slate-900">{{ selectedEvaluation.totalScore }}</div>
              </div>
            </div>
          </div>

          {% if selectedEvaluation.type == 'QUIZ' %}
            <div class="space-y-3">
              {% for q in questions %}
                <div class="p-3 rounded-lg border bg-white">
                  <div class="text-sm font-medium whitespace-pre-wrap">{{ q.content }}</div>

                  <div class="text-xs text-gray-500 mt-1">
                    Type: {{ q.type }} • Score: {{ q.score }}
                  </div>

                  <div class="mt-3 flex justify-end gap-2">
                    {% if q.type == 'MCQ' %}
                      <a class="btn-sm"
                         href="{{ path('admin_answer_index', {
                           evaluationId: selectedEvaluation.id,
                           back: path('evaluation_index', { type: selectedType, evaluationId: selectedEvaluation.id })
                         }) }}">
                        View Answers
                      </a>
                    {% endif %}

                    <a class="btn-sm"
                       href="{{ path('admin_question_edit', {
                         id: q.id,
                         evaluationId: selectedEvaluation.id,
                         back: path('evaluation_index', { type: selectedType, evaluationId: selectedEvaluation.id })
                       }) }}">
                      Edit
                    </a>

                    <form method="post"
                          action="{{ path('admin_question_delete', {
                            id: q.id,
                            back: path('evaluation_index', { type: selectedType, evaluationId: selectedEvaluation.id })
                          }) }}"
                          onsubmit="return confirm('Delete this question?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete_question_' ~ q.id) }}">
                      <button type="submit" class="btn-sm text-red-600 hover:text-red-800">Delete</button>
                    </form>
                  </div>
                </div>
              {% else %}
                <div class="text-gray-500 text-sm">No questions for this evaluation.</div>
              {% endfor %}
            </div>
          {% else %}
            <div class="text-gray-500 text-sm">
              This is an exam. Click <b>Manage Exam</b> to manage its questions.
            </div>
          {% endif %}
        {% endif %}
      </div>

    </div>
  </div>

</div>
{% endblock %}
