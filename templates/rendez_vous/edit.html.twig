{% extends 'layouts/admin.html.twig' %}

{% block title %}Modifier RDV #{{ rdv.id }} - Admin - SkillHarbor{% endblock %}

{% block admin_content %}
<div class="mb-8">
    <div class="flex items-center gap-3 mb-2">
        <a href="{{ path('admin_rendezvous_show', {id: rdv.id}) }}" class="text-navy-400 hover:text-navy-600 dark:hover:text-navy-300 transition">
            <i data-lucide="arrow-left" class="w-6 h-6"></i>
        </a>
        <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white">Modifier rendez-vous #{{ rdv.id }}</h1>
    </div>
    <p class="text-body-md text-navy-600 dark:text-navy-400 ml-9">Changez le créneau ou le statut du rendez-vous.</p>
</div>

<form method="post" class="space-y-6">
    <input type="hidden" name="_token" value="{{ csrf_token('rendezvous_edit') }}">
    <div class="card p-6 space-y-4">
        {# Créneau (dropdown modifiable) #}
        <div>
            <label class="input-label" for="slot_id">Créneau associé</label>
            {% if errors.slot_id is defined %}
                <p class="text-red-600 text-sm mt-1">{{ errors.slot_id }}</p>
            {% endif %}
            <select id="slot_id" name="slot_id" class="input">
                <option value="">Sélectionnez un créneau...</option>
                {% for slot in available_slots %}
                    <option value="{{ slot.id }}" {{ (form_data.slot_id|default('') == slot.id) ? 'selected' : '' }}>
                        Slot #{{ slot.id }} — {{ slot.startAt|date('d/m/Y H:i') }} → {{ slot.endAt|date('d/m/Y H:i') }}
                        {% if slot.isBooked and rdv.slot and slot.id == rdv.slot.id %}(actuel){% endif %}
                    </option>
                {% endfor %}
            </select>
            <p class="input-hint">Changer de créneau libérera automatiquement l'ancien et réservera le nouveau.</p>
        </div>

        {# Statut #}
        <div>
            <label class="input-label" for="statut">Statut</label>
            {% if errors.statut is defined %}
                <p class="text-red-600 text-sm mt-1">{{ errors.statut }}</p>
            {% endif %}
            <select id="statut" name="statut" class="input">
                <option value="en_attente" {{ form_data.statut == 'en_attente' ? 'selected' : '' }}>En attente</option>
                <option value="confirmé" {{ form_data.statut == 'confirmé' ? 'selected' : '' }}>Confirmé</option>
                <option value="rejeté" {{ form_data.statut == 'rejeté' ? 'selected' : '' }}>Rejeté</option>
            </select>
            <p class="input-hint">Rejeter un rendez-vous libérera automatiquement le créneau.</p>
        </div>
    </div>

    <div class="flex items-center gap-3">
        <button type="submit" class="btn-primary">
            <i data-lucide="save" class="w-4 h-4"></i>
            Enregistrer
        </button>
        <a href="{{ path('admin_rendezvous_show', {id: rdv.id}) }}" class="btn-ghost btn-sm">Annuler</a>
    </div>
</form>
{% endblock %}