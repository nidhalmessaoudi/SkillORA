{% extends 'layouts/admin.html.twig' %}

{% block title %}Rendez-vous - Admin - SkillHarbor{% endblock %}

{% block admin_content %}
<div class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-display-lg font-display font-bold text-navy-900 dark:text-white mb-2">Rendez-vous</h1>
            <p class="text-body-md text-navy-600 dark:text-navy-400">Gérez tous les rendez-vous liés aux créneaux de disponibilité.</p>
        </div>
        <a href="{{ path('admin_rendezvous_new') }}" class="btn-primary">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nouveau rendez-vous
        </a>
    </div>
</div>

{# Stats Cards #}
<div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
    {% set total = rendezvous_list|length %}
    {% set pending = rendezvous_list|filter(r => r.statut == 'en_attente')|length %}
    {% set confirmed = rendezvous_list|filter(r => r.statut == 'confirmé')|length %}
    {% set cancelled = rendezvous_list|filter(r => r.statut == 'rejeté')|length %}
    <div class="card p-5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-harbor-100 dark:bg-harbor-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="calendar-range" class="w-5 h-5 text-harbor-600 dark:text-harbor-400"></i>
            </div>
            <div>
                <p class="text-caption text-navy-500">Total</p>
                <p class="text-heading-lg font-display font-bold text-navy-900 dark:text-white">{{ total }}</p>
            </div>
        </div>
    </div>
    <div class="card p-5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-warning-100 dark:bg-warning-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="clock" class="w-5 h-5 text-warning-600 dark:text-warning-400"></i>
            </div>
            <div>
                <p class="text-caption text-navy-500">En attente</p>
                <p class="text-heading-lg font-display font-bold text-warning-600 dark:text-warning-400">{{ pending }}</p>
            </div>
        </div>
    </div>
    <div class="card p-5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-success-100 dark:bg-success-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="check-circle" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
            </div>
            <div>
                <p class="text-caption text-navy-500">Confirmés</p>
                <p class="text-heading-lg font-display font-bold text-success-600 dark:text-success-400">{{ confirmed }}</p>
            </div>
        </div>
    </div>
    <div class="card p-5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-danger-100 dark:bg-danger-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="x-circle" class="w-5 h-5 text-danger-600 dark:text-danger-400"></i>
            </div>
            <div>
                <p class="text-caption text-navy-500">Rejetés</p>
                <p class="text-heading-lg font-display font-bold text-danger-600 dark:text-danger-400">{{ cancelled }}</p>
            </div>
        </div>
    </div>
</div>

{# Table #}
<div class="card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-navy-100 dark:border-navy-800 bg-navy-50 dark:bg-navy-900/50">
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">ID</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Créneau</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Token</th>
                    <th class="px-6 py-3 text-left text-caption font-semibold text-navy-500 uppercase tracking-wider">Créé le</th>
                    <th class="px-6 py-3 text-right text-caption font-semibold text-navy-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-navy-100 dark:divide-navy-800">
                {% for rdv in rendezvous_list %}
                <tr class="hover:bg-navy-50 dark:hover:bg-navy-900/30 transition-colors">
                    <td class="px-6 py-4 text-body-sm font-medium text-navy-900 dark:text-white">#{{ rdv.id }}</td>
                    <td class="px-6 py-4 text-body-sm text-navy-700 dark:text-navy-300">
                        {% if rdv.slot %}
                            <a href="{{ path('admin_slots_show', {id: rdv.slot.id}) }}" class="text-harbor-600 dark:text-harbor-400 hover:underline">
                                Slot #{{ rdv.slot.id }} — {{ rdv.slot.startAt|date('d/m/Y H:i') }}
                            </a>
                        {% else %}
                            <span class="text-navy-400">—</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        {% if rdv.statut == 'confirmé' %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-success-100 text-success-700 dark:bg-success-900/30 dark:text-success-400">
                                <i data-lucide="check-circle" class="w-3 h-3"></i> Confirmé
                            </span>
                        {% elseif rdv.statut == 'rejeté' %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-danger-100 text-danger-700 dark:bg-danger-900/30 dark:text-danger-400">
                                <i data-lucide="x-circle" class="w-3 h-3"></i> Rejeté
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-warning-100 text-warning-700 dark:bg-warning-900/30 dark:text-warning-400">
                                <i data-lucide="clock" class="w-3 h-3"></i> En attente
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-body-sm text-navy-500">
                        {% if rdv.ownerToken %}
                            <code class="text-xs bg-navy-100 dark:bg-navy-800 px-2 py-0.5 rounded">{{ rdv.ownerToken|slice(0, 8) }}…</code>
                        {% else %}
                            <span class="text-navy-400">—</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-body-sm text-navy-500">
                        {{ rdv.createdAt|date('d/m/Y H:i') }}
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('admin_rendezvous_show', {id: rdv.id}) }}" class="p-1.5 rounded-lg text-navy-400 hover:text-harbor-600 hover:bg-harbor-50 dark:hover:bg-harbor-900/20 transition-colors" title="Voir">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </a>
                            <a href="{{ path('admin_rendezvous_edit', {id: rdv.id}) }}" class="p-1.5 rounded-lg text-navy-400 hover:text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors" title="Modifier">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </a>
                            <form method="post" action="{{ path('admin_rendezvous_delete', {id: rdv.id}) }}" class="inline" onsubmit="return confirmDelete('Supprimer ce rendez-vous ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rdv.id) }}">
                                <button type="submit" class="p-1.5 rounded-lg text-navy-400 hover:text-danger-600 hover:bg-danger-50 dark:hover:bg-danger-900/20 transition-colors" title="Supprimer">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                            <i data-lucide="calendar-x" class="w-12 h-12 text-navy-300 dark:text-navy-600"></i>
                            <p class="text-body-md text-navy-500">Aucun rendez-vous trouvé.</p>
                            <a href="{{ path('admin_rendezvous_new') }}" class="btn-primary btn-sm">
                                <i data-lucide="plus" class="w-4 h-4"></i> Créer un rendez-vous
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}