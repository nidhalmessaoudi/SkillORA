{% block form_row %}
  <div class="space-y-1">
    {{ form_label(form, null, {
      label_attr: {
        class: 'block text-body-sm font-medium text-navy-700 dark:text-navy-300'
      }
    }) }}

    {% set hasErrors = (form.vars.errors|length > 0) %}
    {% set type = form.vars.attr.type|default('') %}

    {% set baseClass = 'w-full rounded-xl border bg-white dark:bg-navy-900 px-4 py-2 text-body-md text-navy-900 dark:text-white focus:outline-none focus:ring-2' %}
    {% set okBorder = 'border-navy-200 dark:border-navy-700 focus:ring-harbor-500' %}
    {% set errBorder = 'border-red-300 dark:border-red-900/60 focus:ring-red-500' %}
    {% set borderClass = hasErrors ? errBorder : okBorder %}

    {% if type == 'file' %}
      {% set fileClass =
        'w-full rounded-xl border bg-white dark:bg-navy-900 text-body-md text-navy-900 dark:text-white focus:outline-none focus:ring-2 ' ~ borderClass ~ ' ' ~
        'file:mr-4 file:rounded-lg file:border-0 file:bg-navy-100 dark:file:bg-navy-800 file:px-4 file:py-2 file:text-body-sm file:font-medium file:text-navy-900 dark:file:text-white ' ~
        'hover:file:bg-navy-200 dark:hover:file:bg-navy-700 cursor-pointer px-3 py-2'
      %}
      {{ form_widget(form, { attr: form.vars.attr|merge({ class: fileClass }) }) }}
    {% else %}
      {{ form_widget(form, { attr: form.vars.attr|merge({ class: (baseClass ~ ' ' ~ borderClass)|trim }) }) }}
    {% endif %}

    {{ form_errors(form) }}

    {% if form.vars.help %}
      <p class="text-caption text-navy-500 dark:text-navy-400">
        {{ form.vars.help }}
      </p>
    {% endif %}
  </div>
{% endblock %}

{% block form_errors %}
  {% if errors|length > 0 %}
    {% set first = errors|first %}
    <div class="mt-1 text-body-sm text-red-700 dark:text-red-300 flex items-start gap-2">
      <span class="mt-2 w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>
      <span>{{ first.message }}</span>
    </div>
  {% endif %}
{% endblock %}

{% block textarea_widget %}
  {% set attr = attr|merge({ class: (attr.class|default('') ~ ' min-h-[120px] resize-y')|trim }) %}
  <textarea {{ block('widget_attributes') }}>{{ value }}</textarea>
{% endblock %}

{% block choice_widget_collapsed %}
  {% set hasErrors = (errors|length > 0) %}
  {% set baseClass = 'w-full rounded-xl border bg-white dark:bg-navy-900 px-4 py-2 text-body-md text-navy-900 dark:text-white focus:outline-none focus:ring-2' %}
  {% set okBorder = 'border-navy-200 dark:border-navy-700 focus:ring-harbor-500' %}
  {% set errBorder = 'border-red-300 dark:border-red-900/60 focus:ring-red-500' %}
  {% set class = (baseClass ~ ' ' ~ (hasErrors ? errBorder : okBorder))|trim %}

  <select {{ block('widget_attributes') }} class="{{ class }}">
    {% if placeholder is not none %}
      <option value="" {% if value is empty %}selected{% endif %} disabled>{{ placeholder }}</option>
    {% endif %}

    {% for choice in choices %}
      <option value="{{ choice.value }}" {% if choice.value == value %}selected{% endif %}>
        {{ choice.label }}
      </option>
    {% endfor %}
  </select>
{% endblock %}
