{% block form_row %}
  <div class="space-y-1">
    {{ form_label(form, null, {
      label_attr: {
        class: 'block text-body-sm font-medium text-navy-700 dark:text-navy-300'
      }
    }) }}

    {% set baseClass = 'w-full rounded-xl border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 px-4 py-2 text-body-md text-navy-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-harbor-500' %}
    {% set type = form.vars.attr.type|default('') %}

    {% if type == 'file' %}
      {% set fileClass =
        'w-full rounded-xl border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-body-md text-navy-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-harbor-500 ' ~
        'file:mr-4 file:rounded-lg file:border-0 file:bg-navy-100 dark:file:bg-navy-800 file:px-4 file:py-2 file:text-body-sm file:font-medium file:text-navy-900 dark:file:text-white ' ~
        'hover:file:bg-navy-200 dark:hover:file:bg-navy-700 cursor-pointer px-3 py-2'
      %}
      {{ form_widget(form, { attr: { class: fileClass } }) }}
    {% else %}
      {{ form_widget(form, { attr: { class: baseClass } }) }}
    {% endif %}

    {{ form_errors(form) }}

    {% if form.vars.help %}
      <p class="text-caption text-navy-500 dark:text-navy-400">
        {{ form.vars.help }}
      </p>
    {% endif %}
  </div>
{% endblock %}

{% block textarea_widget %}
  <textarea {{ block('widget_attributes') }} class="min-h-[120px] resize-y"></textarea>
{% endblock %}

{% block choice_widget_collapsed %}
  <select {{ block('widget_attributes') }} class="w-full rounded-xl border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 px-4 py-2 text-body-md text-navy-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-harbor-500">
    {% for choice in choices %}
      <option value="{{ choice.value }}" {% if choice.value == value %}selected{% endif %}>
        {{ choice.label }}
      </option>
    {% endfor %}
  </select>
{% endblock %}
