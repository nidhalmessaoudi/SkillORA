{% extends 'layouts/base.html.twig' %}
{% block title %}Edit Course | SkillORA{% endblock %}

{% block body %}
<section class="py-10">
  <div class="container mx-auto px-4 max-w-3xl">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-display-sm font-heading">Edit course</h1>
        <p class="text-body-sm text-navy-600 dark:text-navy-300 mt-1">{{ course.title }}</p>
      </div>

      <div class="flex gap-2">
        <a href="{{ path('course_builder', {id: course.id}) }}" class="btn-secondary inline-flex items-center gap-2">
          <i data-lucide="layers" class="w-4 h-4"></i> Builder
        </a>
        <a href="{{ path('course_index') }}" class="btn-secondary">Back</a>
      </div>
    </div>

    <div class="card p-6 mt-6">
      {{ form_start(form) }}
        <div class="grid gap-4">
          {{ form_row(form.title) }}
          {{ form_row(form.description) }}
          {{ form_row(form.status) }}
        </div>

        <div class="mt-6 flex items-center justify-between">
          <form method="post" action="{{ path('course_delete', {id: course.id}) }}" onsubmit="return confirm('Delete this course?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_course_' ~ course.id) }}">
            <button type="submit" class="btn-danger inline-flex items-center gap-2">
              <i data-lucide="trash-2" class="w-4 h-4"></i> Delete
            </button>
          </form>

          <button class="btn-primary inline-flex items-center gap-2">
            <i data-lucide="save" class="w-4 h-4"></i> Update
          </button>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
</section>
{% endblock %}
