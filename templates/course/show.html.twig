{% extends 'layouts/base.html.twig' %}
{% block title %}{{ course.title }} | SkillORA{% endblock %}

{% block body %}
<section class="py-10">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-display-sm font-heading">{{ course.title }}</h1>
        <div class="mt-2">
          <span class="badge">{{ course.status }}</span>
        </div>
      </div>
      <div class="flex gap-2">
        <a href="{{ path('course_builder', {id: course.id}) }}" class="btn-primary inline-flex items-center gap-2">
          <i data-lucide="layers" class="w-4 h-4"></i> Curriculum Builder
        </a>
        <a href="{{ path('course_edit', {id: course.id}) }}" class="btn-secondary">Edit</a>
      </div>
    </div>

    <div class="card p-6 mt-6">
      {% if course.description %}
        <p class="text-body-md text-navy-700 dark:text-navy-200 whitespace-pre-line">{{ course.description }}</p>
      {% else %}
        <p class="text-body-sm text-navy-500 dark:text-navy-400 italic">No description provided.</p>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
