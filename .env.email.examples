# Email Configuration Examples
# Copy the configuration you want to use and paste it into your .env file

# ============================================================================
# DEVELOPMENT / TESTING (Current Setup)
# ============================================================================
# Emails are captured locally - requires MailHog running on port 1025
# Open http://localhost:8025 to see emails
MAILER_DSN=smtp://localhost:1025
MAILER_FROM_ADDRESS=noreply@skillharbor.com
MAILER_FROM_NAME=SkillHarbor

# ============================================================================
# MAILTRAP (Online Email Testing Service)
# ============================================================================
# Free account at https://mailtrap.io
# Great for testing - captures emails online so team can see them
# MAILER_DSN=smtp://YOUR_USERNAME:YOUR_PASSWORD@smtp.mailtrap.io:2525
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example:
# MAILER_DSN=smtp://1a2b3c4d5e6f7g:9h8i7j6k5l4m3n@smtp.mailtrap.io:2525

# ============================================================================
# GMAIL (Easy Setup for Small Projects)
# ============================================================================
# Requires: Gmail account + App Password (not your regular password)
# 1. Enable 2-Step Verification on your Gmail
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create App Password for "Mail"
# 4. Use that password below (16 characters, no spaces)
# MAILER_DSN=smtp://your-email@gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:587
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example:
# MAILER_DSN=smtp://skillharbor@gmail.com:abcd efgh ijkl mnop@smtp.gmail.com:587

# Note: Gmail has sending limits:
# - 500 emails per day for free accounts
# - 2000 emails per day for Google Workspace

# ============================================================================
# SENDGRID (Recommended for Production)
# ============================================================================
# Professional email service with high deliverability
# Free tier: 100 emails/day
# Paid plans: Starting at $19.95/month for 100,000 emails/month
# Sign up: https://sendgrid.com
# MAILER_DSN=sendgrid://YOUR_API_KEY@default
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example:
# MAILER_DSN=sendgrid://SG.aBcDeFgHiJkLmNoPqRsTuVwXyZ.1234567890abcdefghijklmnopqrstuvwxyz@default

# ============================================================================
# MAILGUN (Alternative Professional Service)
# ============================================================================
# Another popular email service
# Free tier: 5,000 emails/month for 3 months
# Sign up: https://mailgun.com
# MAILER_DSN=mailgun://KEY:DOMAIN@default?region=us
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example (US region):
# MAILER_DSN=mailgun://key-1234567890abcdef:mg.skillharbor.com@default?region=us

# Example (EU region):
# MAILER_DSN=mailgun://key-1234567890abcdef:mg.skillharbor.com@default?region=eu

# ============================================================================
# AMAZON SES (Best for High Volume)
# ============================================================================
# Very cheap for high volume: $0.10 per 1,000 emails
# Requires AWS account and SES setup
# Must verify domain or individual email addresses first
# MAILER_DSN=ses+smtp://ACCESS_KEY:SECRET_KEY@default?region=us-east-1
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example:
# MAILER_DSN=ses+smtp://AKIAIOSFODNN7EXAMPLE:wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY@default?region=us-east-1

# ============================================================================
# POSTMARK (High Deliverability)
# ============================================================================
# Known for excellent deliverability rates
# Free tier: 100 emails/month
# Sign up: https://postmarkapp.com
# MAILER_DSN=postmark://YOUR_API_TOKEN@default
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example:
# MAILER_DSN=postmark://1234abcd-5678-efgh-9012-ijklmnopqrst@default

# ============================================================================
# BREVO (formerly Sendinblue) - Great Free Tier
# ============================================================================
# Excellent free tier: 300 emails/day
# Good for small to medium projects
# Sign up: https://brevo.com
# MAILER_DSN=brevo+smtp://YOUR_API_KEY@default
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example:
# MAILER_DSN=brevo+smtp://xkeysib-1234567890abcdef-zyxwvutsrqponmlkjih@default

# ============================================================================
# CUSTOM SMTP SERVER
# ============================================================================
# If you have your own SMTP server or your hosting provides one
# MAILER_DSN=smtp://username:password@smtp.example.com:587
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Common ports:
# - 25: Standard SMTP (often blocked by ISPs)
# - 587: SMTP with STARTTLS (recommended)
# - 465: SMTP with SSL
# - 2525: Alternative port (some services)

# With TLS:
# MAILER_DSN=smtp://username:password@smtp.example.com:587?encryption=tls

# With SSL:
# MAILER_DSN=smtp://username:password@smtp.example.com:465?encryption=ssl

# ============================================================================
# OFFICE 365 / OUTLOOK
# ============================================================================
# For businesses using Microsoft 365
# MAILER_DSN=smtp://your-email@yourdomain.com:YOUR_PASSWORD@smtp.office365.com:587
# MAILER_FROM_ADDRESS=noreply@skillharbor.com
# MAILER_FROM_NAME=SkillHarbor

# Example:
# MAILER_DSN=smtp://info@skillharbor.com:YourPassword123@smtp.office365.com:587

# ============================================================================
# RECOMMENDATIONS BY PROJECT SIZE
# ============================================================================

# Small Project / Testing:
# → Use MailHog or Mailtrap

# Small Project / Production (< 500 emails/day):
# → Use Gmail (free) or Brevo (300/day free)

# Medium Project (500-5000 emails/day):
# → Use SendGrid or Mailgun

# Large Project (5000+ emails/day):
# → Use Amazon SES or SendGrid Pro

# High Deliverability Requirements:
# → Use Postmark or SendGrid

# ============================================================================
# AFTER CHANGING CONFIGURATION
# ============================================================================
# Always clear cache after changing .env:
# php bin/console cache:clear

# Test email sending:
# 1. Register a new test user
# 2. Check if email is received
# 3. Monitor logs: var/log/dev.log
